<view class="page">
  <view class="header">
    <text class="header-title">日语智能老师</text>
  </view>

  <scroll-view class="chat-list" scroll-y enhanced scroll-with-animation scroll-top="{{scrollTop}}">
    <block wx:for="{{messages}}" wx:key="id">
      <view class="msg-wrap {{item.role === 'assistant' ? 'msg-left' : 'msg-right'}}">
        <view wx:if="{{item.role === 'assistant'}}" class="avatar avatar-assist">师</view>
        <view class="bubble {{item.role === 'assistant' ? 'bubble-assist' : 'bubble-user'}}">{{item.content}}</view>
        <view wx:if="{{item.role === 'user'}}" class="avatar avatar-user">我</view>
      </view>
    </block>

    <view wx:if="{{loading}}" class="msg-wrap msg-left">
      <view class="avatar avatar-assist">师</view>
      <view class="bubble bubble-assist loading-bubble">
        <view class="dot-typing">
          <view class="dot"></view>
          <view class="dot"></view>
          <view class="dot"></view>
        </view>
      </view>
    </view>
  </scroll-view>

  <view wx:if="{{messages.length <= 1}}" class="quick-section">
    <view class="quick-tag" data-q="五十音怎么学" bindtap="quickAsk">五十音怎么学</view>
    <view class="quick-tag" data-q="は・が区别" bindtap="quickAsk">は・が区别</view>
    <view class="quick-tag" data-q="日常会话翻译" bindtap="quickAsk">日常会话翻译</view>
    <view class="quick-tag" data-q="N5备考" bindtap="quickAsk">N5备考</view>
    <view class="quick-tag" data-q="动词て形" bindtap="quickAsk">动词て形</view>
    <view class="quick-tag" data-q="日语自我介绍" bindtap="quickAsk">日语自我介绍</view>
  </view>

  <view class="input-bar">
    <input class="inp" value="{{input}}" placeholder="输入问题..." bindinput="onInput" confirm-type="send" bindconfirm="sendMessage" />
    <button class="btn-send" bindtap="sendMessage" disabled="{{loading}}">发送</button>
  </view>

  <view class="bottom-nav">
    <view class="nav-item" bindtap="goToLesson">
      <text class="nav-label">闯关</text>
    </view>
    <view class="nav-item" bindtap="goToCourse">
      <text class="nav-label">课程</text>
    </view>
    <view class="nav-item active" bindtap="goToAI">
      <text class="nav-label">智能老师</text>
    </view>
    <view class="nav-item" bindtap="goToRank">
      <text class="nav-label">排行榜</text>
    </view>
  </view>
</view>
