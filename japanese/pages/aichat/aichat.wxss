/*pages/aichat/aichat.wxss*/
.container { min-height: 100vh; background-color: #f5f5f5; display: flex; flex-direction: column; padding-bottom: 110rpx; }
.header { padding: 24rpx 30rpx; background-color: #e17055; text-align: center; }
.header-title { font-size: 30rpx; color: #fff; font-weight: bold; }

.chat-list { flex: 1; padding: 20rpx; }

.message { display: flex; margin-bottom: 24rpx; align-items: flex-start; }
.message.user { flex-direction: row-reverse; }
.avatar-text {
  width: 64rpx; height: 64rpx; border-radius: 50%; background: #e17055;
  color: #fff; font-size: 28rpx; text-align: center; line-height: 64rpx;
  flex-shrink: 0; margin: 0 12rpx;
}
.message.user .avatar-text { background: #74b9ff; }

.bubble {
  max-width: 80%; padding: 20rpx 24rpx; border-radius: 16rpx;
  font-size: 28rpx; line-height: 1.6; white-space: pre-wrap; word-break: break-all;
}
.bubble.assistant { background: #fff; color: #333; border-top-left-radius: 4rpx; }
.bubble.user { background: #74b9ff; color: #fff; border-top-right-radius: 4rpx; }
.loading-dots { color: #999; }

.quick-asks { padding: 0 20rpx 20rpx; }
.quick-title { font-size: 24rpx; color: #999; }
.quick-tags { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 10rpx; }
.quick-tag {
  padding: 12rpx 20rpx; background: #fff; border: 1rpx solid #e17055;
  border-radius: 20rpx; font-size: 24rpx; color: #e17055;
}

.input-area {
  display: flex; align-items: center; padding: 16rpx 20rpx; background: #fff;
  border-top: 1rpx solid #eee;
}
.input {
  flex: 1; height: 72rpx; background: #f5f5f5; border-radius: 36rpx;
  padding: 0 30rpx; font-size: 28rpx;
}
.send-btn {
  margin-left: 16rpx; padding: 16rpx 28rpx; background: #e17055;
  border-radius: 36rpx; color: #fff; font-size: 26rpx;
}

.bottom-nav {
  position: fixed; bottom: 0; left: 0; right: 0; display: flex;
  background: #fff; box-shadow: 0 -2rpx 16rpx rgba(0,0,0,0.08);
}
.nav-item { flex: 1; padding: 16rpx 0; text-align: center; }
.nav-text { font-size: 22rpx; color: #999; }
.nav-item.active .nav-text { color: #e17055; font-weight: bold; }
