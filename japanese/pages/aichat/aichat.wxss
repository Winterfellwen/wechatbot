page {
  height: 100%;
  background: #f5f5f5;
}

.page {
  display: flex;
  flex-direction: column;
  height: 100%;
  overflow: hidden;
}

.header {
  background: #e17055;
  padding: 24rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
}

.header-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #fff;
}

.chat-list {
  flex: 1;
  padding: 120rpx 24rpx 320rpx;
  box-sizing: border-box;
}

.msg-wrap {
  display: flex;
  margin-bottom: 24rpx;
  align-items: flex-start;
  gap: 16rpx;
}

.msg-left {
  justify-content: flex-start;
}

.msg-right {
  justify-content: flex-end;
}

.avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.avatar-assist {
  background: #fab1a0;
  color: #fff;
}

.avatar-user {
  background: #74b9ff;
  color: #fff;
}

.bubble {
  max-width: 480rpx;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  line-height: 1.6;
  word-break: break-all;
}

.bubble-assist {
  background: #fff;
  color: #333;
  border-top-left-radius: 4rpx;
}

.bubble-user {
  background: #74b9ff;
  color: #fff;
  border-top-right-radius: 4rpx;
}

.loading-bubble {
  min-width: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 28rpx 32rpx;
}

.dot-typing {
  display: flex;
  gap: 10rpx;
}

.dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #ccc;
  animation: dot-blink 1.4s infinite both;
}

.dot:nth-child(2) {
  animation-delay: 0.2s;
}

.dot:nth-child(3) {
  animation-delay: 0.4s;
}

@keyframes dot-blink {
  0% { opacity: 0.2; }
  20% { opacity: 1; }
  100% { opacity: 0.2; }
}

.quick-section {
  padding: 16rpx 24rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  background: #f5f5f5;
  position: fixed;
  bottom: 220rpx;
  left: 0;
  right: 0;
  z-index: 50;
}

.quick-tag {
  padding: 12rpx 24rpx;
  border: 2rpx solid #e17055;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #e17055;
  background: #fff;
}

.input-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  padding-bottom: 24rpx;
  background: #fff;
  border-top: 1rpx solid #eee;
  position: fixed;
  bottom: 96rpx;
  left: 0;
  right: 0;
  z-index: 100;
}

.inp {
  flex: 1;
  height: 72rpx;
  background: #f5f5f5;
  border-radius: 36rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
}

.btn-send {
  width: 120rpx;
  height: 72rpx;
  margin-left: 16rpx;
  background: #e17055;
  color: #fff;
  font-size: 28rpx;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  padding: 0;
  line-height: 72rpx;
}

.bottom-nav {
  display: flex;
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 200;
  padding-bottom: 0;
  padding-bottom: env(safe-area-inset-bottom);
}

.nav-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 0 28rpx;
}

.nav-label {
  font-size: 24rpx;
  color: #999;
}

.nav-item.active .nav-label {
  color: #e17055;
  font-weight: 600;
}
