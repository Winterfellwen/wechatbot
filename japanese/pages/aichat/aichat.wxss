/*pages/aichat/aichat.wxss*/
.page { display: flex; flex-direction: column; height: 100vh; overflow: hidden; background: #F0F9FF; }

.header {
  background: linear-gradient(135deg, #0EA5E9, #38BDF8); padding: 22rpx 32rpx;
  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}
.header-title { font-size: 34rpx; font-weight: 600; color: #fff; }

.chat-list { flex: 1; padding: 20rpx 24rpx 20rpx; box-sizing: border-box; }

.msg-wrap { display: flex; margin-bottom: 24rpx; align-items: flex-start; gap: 16rpx; }
.msg-left { justify-content: flex-start; }
.msg-right { justify-content: flex-end; }

.avatar {
  width: 64rpx; height: 64rpx; border-radius: 50%; display: flex;
  align-items: center; justify-content: center; font-size: 26rpx; font-weight: 600; flex-shrink: 0;
}
.avatar-assist { background: linear-gradient(135deg, #38BDF8, #7DD3FC); color: #fff; }
.avatar-user { background: linear-gradient(135deg, #F59E0B, #FBBF24); color: #fff; }

.bubble { max-width: 500rpx; padding: 22rpx 28rpx; border-radius: 20rpx; font-size: 30rpx; line-height: 1.6; word-break: break-all; }
.bubble-assist { background: #fff; color: #0F172A; border-top-left-radius: 6rpx; box-shadow: 0 2rpx 8rpx rgba(14,165,233,0.06); }
.bubble-user { background: linear-gradient(135deg, #0EA5E9, #38BDF8); color: #fff; border-top-right-radius: 6rpx; }

.loading-bubble { min-width: 120rpx; display: flex; align-items: center; justify-content: center; padding: 28rpx 32rpx; }
.dot-typing { display: flex; gap: 12rpx; }
.dot { width: 16rpx; height: 16rpx; border-radius: 50%; background: #CBD5E1; animation: dot-blink 1.4s infinite both; }
.dot:nth-child(2) { animation-delay: 0.2s; }
.dot:nth-child(3) { animation-delay: 0.4s; }
@keyframes dot-blink { 0% { opacity: 0.2; } 20% { opacity: 1; } 100% { opacity: 0.2; } }

.quick-section {
  padding: 16rpx 24rpx; display: flex; flex-wrap: wrap; gap: 16rpx;
  background: #F0F9FF; flex-shrink: 0;
}
.quick-tag {
  padding: 14rpx 26rpx; border: 2rpx solid #0EA5E9; border-radius: 36rpx;
  font-size: 26rpx; color: #0EA5E9; background: #fff;
}

.input-bar {
  display: flex; align-items: center; padding: 16rpx 24rpx 24rpx;
  background: #fff; border-top: 1rpx solid #E0F2FE; flex-shrink: 0;
}
.inp { flex: 1; height: 76rpx; background: #F0F9FF; border-radius: 40rpx; padding: 0 28rpx; font-size: 30rpx; }
.btn-send {
  width: 128rpx; height: 76rpx; margin-left: 16rpx; background: linear-gradient(135deg, #0EA5E9, #38BDF8);
  color: #fff; font-size: 28rpx; border-radius: 40rpx; display: flex; align-items: center;
  justify-content: center; border: none; padding: 0; line-height: 76rpx;
  box-shadow: 0 4rpx 12rpx rgba(14,165,233,0.25);
}

.bottom-nav {
  display: flex; background: rgba(255,255,255,0.95); backdrop-filter: blur(10px);
  box-shadow: 0 -4rpx 24rpx rgba(14,165,233,0.08); flex-shrink: 0;
  padding: 12rpx 0 env(safe-area-inset-bottom, 12rpx);
}
.nav-item { flex: 1; display: flex; align-items: center; justify-content: center; padding: 10rpx 0 14rpx; }
.nav-label { font-size: 26rpx; color: #94A3B8; }
.nav-item.active .nav-label { color: #0EA5E9; font-weight: 600; }
