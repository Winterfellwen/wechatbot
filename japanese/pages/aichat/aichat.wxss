/*pages/aichat/aichat.wxss*/
.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  display: flex;
  flex-direction: column;
  padding-bottom: 140rpx;
}

.header {
  padding: 30rpx;
  background-color: #1890ff;
}

.header-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
}

.chat-list {
  flex: 1;
  padding: 20rpx;
  height: calc(100vh - 300rpx);
}

.message {
  display: flex;
  margin-bottom: 20rpx;
  align-items: flex-start;
}

.message.user {
  flex-direction: row-reverse;
}

.message.assistant {
  flex-direction: row;
}

.avatar {
  width: 70rpx;
  height: 70rpx;
  line-height: 70rpx;
  text-align: center;
  font-size: 36rpx;
  background-color: #e0e0e0;
  border-radius: 50%;
}

.content {
  max-width: 70%;
  padding: 20rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  line-height: 1.5;
  margin: 0 16rpx;
}

.message.user .content {
  background-color: #1890ff;
  color: #fff;
}

.message.assistant .content {
  background-color: #fff;
  color: #333;
}

.loading text {
  color: #999;
}

.input-area {
  position: fixed;
  bottom: 120rpx;
  left: 0;
  right: 0;
  display: flex;
  padding: 20rpx;
  background-color: #fff;
  box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.1);
}

.input {
  flex: 1;
  height: 72rpx;
  background-color: #f0f0f0;
  border-radius: 36rpx;
  padding: 0 30rpx;
  font-size: 28rpx;
}

.send-btn {
  margin-left: 20rpx;
  width: 120rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  background-color: #1890ff;
  color: #fff;
  border-radius: 36rpx;
  font-size: 28rpx;
}

.bottom-nav {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  padding: 20rpx;
  background-color: #fff;
  box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.1);
}

.nav-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.nav-item.active .nav-icon,
.nav-item.active .nav-text {
  color: #1890ff;
}

.nav-icon {
  font-size: 36rpx;
}

.nav-text {
  font-size: 22rpx;
  color: #666;
  margin-top: 4rpx;
}