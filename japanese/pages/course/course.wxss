/*pages/course/course.wxss - UI/UX Pro Max 统一版*/
/* 设计系统: learn 页面为基准 */
/* 主色: #2563EB | 背景: #F8FAFC | 边框: #E2E8F0 */

.container { 
  min-height: 100vh; 
  background: #F8FAFC; 
  padding-bottom: 140rpx; 
}

/* ========== 顶部标题栏 ========== */
.header {
  padding: 56rpx 40rpx 48rpx; 
  background: linear-gradient(135deg, #2563EB 0%, #3B82F6 100%);
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(37,99,235,0.25);
}
.header-title { 
  font-size: 48rpx; 
  font-weight: bold; 
  color: #fff; 
  display: block; 
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.1); 
}
.header-sub { 
  font-size: 30rpx; 
  color: rgba(255,255,255,0.85); 
  margin-top: 12rpx; 
  display: block; 
}

/* ========== 功能卡片网格 ========== */
.hub-grid { 
  padding: 24rpx; 
  display: flex; 
  flex-direction: column; 
  gap: 24rpx; 
  margin-top: -20rpx; 
}

.hub-card {
  border-radius: 24rpx; 
  padding: 44rpx 40rpx; 
  color: #fff;
  display: flex; 
  flex-direction: column; 
  position: relative; 
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.12);
  transition: all 0.2s ease;
  cursor: pointer;
  min-height: 120rpx;
}
.hub-card:active { transform: scale(0.98); opacity: 0.9; }

.hub-green { background: linear-gradient(135deg, #22C55E 0%, #16A34A 100%); }
.hub-blue { background: linear-gradient(135deg, #2563EB 0%, #3B82F6 100%); }
.hub-orange { background: linear-gradient(135deg, #F59E0B 0%, #D97706 100%); }

.hub-icon-text {
  font-size: 56rpx;
  font-weight: bold;
  margin-bottom: 12rpx;
  opacity: 0.9;
}

.hub-icon-img {
  width: 56rpx;
  height: 56rpx;
  margin-bottom: 12rpx;
  opacity: 0.9;
  filter: brightness(0) invert(1);
}
.hub-name { 
  font-size: 44rpx; 
  font-weight: bold; 
}
.hub-desc { 
  font-size: 28rpx; 
  opacity: 0.9; 
  margin-top: 10rpx; 
}
.hub-badge {
  position: absolute; 
  top: 40rpx; 
  right: 40rpx;
  background: rgba(255,255,255,0.25); 
  padding: 12rpx 28rpx;
  border-radius: 24rpx; 
  font-size: 28rpx; 
  font-weight: bold;
  min-height: 88rpx;
  display: flex;
  align-items: center;
}

/* ========== 底部导航 ========== */
.bottom-nav {
  position: fixed; 
  bottom: 0; 
  left: 0; 
  right: 0; 
  display: flex;
  background: rgba(255,255,255,0.95);
  backdrop-filter: blur(20px);
  box-shadow: 0 -4rpx 24rpx rgba(0,0,0,0.06);
  padding: 8rpx 0 16rpx;
  z-index: 999;
}

.nav-item { 
  flex: 1; 
  padding: 14rpx 0; 
  text-align: center; 
  display: flex; 
  flex-direction: column; 
  align-items: center;
  cursor: pointer;
  transition: transform 0.2s ease;
}
.nav-item:active { transform: scale(0.95); }

.nav-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  background: #F1F5F9;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 6rpx;
  transition: all 0.2s ease;
}
.nav-icon-active {
  background: linear-gradient(135deg, #2563EB 0%, #3B82F6 100%);
  box-shadow: 0 4rpx 16rpx rgba(37,99,235,0.3);
}
.nav-icon-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #64748B;
}
.nav-item.active .nav-icon-text { color: #ffffff; }

.nav-icon-img {
  width: 40rpx;
  height: 40rpx;
}
.nav-item.active .nav-icon-img {
  filter: brightness(0) invert(1);
}

.nav-text { 
  font-size: 24rpx; 
  color: #64748B; 
  transition: color 0.2s ease;
}
.nav-text-active {
  color: #2563EB;
  font-weight: 600;
}
