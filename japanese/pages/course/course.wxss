/*pages/course/course.wxss*/
.container { min-height: 100vh; background: #f5f5f5; padding-bottom: 110rpx; }

.header {
  padding: 40rpx 30rpx 30rpx; background: #fff; text-align: center;
  margin-bottom: 20rpx;
}
.header-title { font-size: 40rpx; font-weight: bold; color: #333; display: block; }
.header-sub { font-size: 26rpx; color: #999; margin-top: 8rpx; display: block; }

.hub-grid { padding: 20rpx; display: flex; flex-direction: column; gap: 20rpx; }

.hub-card {
  border-radius: 20rpx; padding: 36rpx 30rpx; color: #fff;
  display: flex; flex-direction: column; position: relative; overflow: hidden;
}
.hub-icon { font-size: 56rpx; margin-bottom: 10rpx; }
.hub-name { font-size: 36rpx; font-weight: bold; }
.hub-desc { font-size: 24rpx; opacity: 0.85; margin-top: 6rpx; }
.hub-badge {
  position: absolute; top: 30rpx; right: 30rpx;
  background: rgba(255,255,255,0.25); padding: 8rpx 20rpx;
  border-radius: 20rpx; font-size: 24rpx; font-weight: bold;
}

.bottom-nav {
  position: fixed; bottom: 0; left: 0; right: 0; display: flex;
  background: #fff; box-shadow: 0 -2rpx 16rpx rgba(0,0,0,0.08);
}
.nav-item { flex: 1; padding: 16rpx 0; text-align: center; }
.nav-text { font-size: 22rpx; color: #999; }
.nav-item.active .nav-text { color: #1890ff; font-weight: bold; }
