/*pages/course/course.wxss*/
.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 120rpx;
}

.header {
  padding: 30rpx;
  background-color: #fff;
}

.header-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
}

.category-tabs {
  display: flex;
  padding: 20rpx;
  background-color: #fff;
  margin-bottom: 10rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  font-size: 28rpx;
  color: #666;
}

.tab.active {
  color: #1890ff;
  font-weight: bold;
  border-bottom: 4rpx solid #1890ff;
}

.content {
  padding: 20rpx;
}

.book-list {
  margin-top: 20rpx;
}

.book-card {
  display: flex;
  align-items: center;
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.book-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
}

.book-desc {
  font-size: 26rpx;
  color: #999;
  margin-left: 20rpx;
}

.book-arrow {
  font-size: 32rpx;
  color: #ccc;
}

.wordbook-entry, .grammar-entry {
  display: flex;
  align-items: center;
  background-color: #fff;
  border-radius: 16rpx;
  padding: 40rpx;
  margin-bottom: 20rpx;
}

.entry-icon {
  font-size: 48rpx;
}

.entry-info {
  flex: 1;
  margin-left: 20rpx;
}

.entry-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.entry-desc {
  font-size: 26rpx;
  color: #999;
  margin-top: 8rpx;
}

.entry-arrow {
  font-size: 36rpx;
  color: #ccc;
}

.bottom-nav {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  padding: 20rpx;
  background-color: #fff;
  box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.1);
}

.nav-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.nav-item.active .nav-icon,
.nav-item.active .nav-text {
  color: #1890ff;
}

.nav-icon {
  font-size: 36rpx;
}

.nav-text {
  font-size: 22rpx;
  color: #666;
  margin-top: 4rpx;
}