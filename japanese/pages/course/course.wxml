<!--pages/course/course.wxml-->
<view class="container">
  <view class="header">
    <text class="header-title">课程中心</text>
    <text class="header-sub">日语学习资料库</text>
  </view>

  <view class="hub-grid">
    <view class="hub-card" bindtap="goToTextbook" style="background: linear-gradient(135deg, #4CAF50, #81C784)">
      <view class="hub-icon">📖</view>
      <view class="hub-name">课本</view>
      <view class="hub-desc">N5 → N1 共5册</view>
      <view class="hub-badge">76课</view>
    </view>

    <view class="hub-card" bindtap="goToWordbook" style="background: linear-gradient(135deg, #2196F3, #64B5F6)">
      <view class="hub-icon">📝</view>
      <view class="hub-name">单词本</view>
      <view class="hub-desc">1231个词汇</view>
      <view class="hub-badge">{{masteredCount}}/{{wordCount}}</view>
    </view>

    <view class="hub-card" bindtap="goToGrammar" style="background: linear-gradient(135deg, #FF9800, #FFB74D)">
      <view class="hub-icon">📚</view>
      <view class="hub-name">语法</view>
      <view class="hub-desc">N5-N1全覆盖</view>
      <view class="hub-badge">{{grammarCount}}条</view>
    </view>
  </view>

  <view class="bottom-nav">
    <view class="nav-item" bindtap="goToLesson"><text class="nav-text">闯关</text></view>
    <view class="nav-item active"><text class="nav-text">课程</text></view>
    <view class="nav-item" bindtap="goToAI"><text class="nav-text">智能老师</text></view>
    <view class="nav-item" bindtap="goToRank"><text class="nav-text">排行榜</text></view>
  </view>
</view>
