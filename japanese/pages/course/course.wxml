<!--pages/course/course.wxml-->
<view class="container">
  <view class="header">
    <text class="header-title">课程</text>
  </view>

  <view class="category-tabs">
    <view class="tab {{activeTab === 'textbook' ? 'active' : ''}}" bindtap="switchTab" data-tab="textbook">课本</view>
    <view class="tab {{activeTab === 'wordbook' ? 'active' : ''}}" bindtap="switchTab" data-tab="wordbook">单词本</view>
    <view class="tab {{activeTab === 'grammar' ? 'active' : ''}}" bindtap="switchTab" data-tab="grammar">语法</view>
  </view>

  <view wx:if="{{activeTab === 'textbook'}}" class="content">
    <view class="book-list">
      <block wx:for="{{textbooks}}" wx:key="id">
        <view class="book-card" bindtap="openBook" data-id="{{item.id}}">
          <view class="book-cover" style="background-color: {{item.cover}}"></view>
          <view class="book-info">
            <view class="book-title">{{item.title}}</view>
            <view class="book-desc">{{item.desc}}</view>
            <view class="book-subtitle">{{item.subtitle}}</view>
            <view class="book-progress-bar">
              <view class="book-progress-fill" style="width: {{item.progress}}%"></view>
            </view>
            <text class="book-progress-text">{{item.progress}}%</text>
          </view>
          <view class="book-arrow">→</view>
        </view>
      </block>
    </view>
  </view>

  <view wx:if="{{activeTab === 'wordbook'}}" class="content">
    <view class="entry-card" bindtap="goToWordbook">
      <view class="entry-info">
        <view class="entry-title">单词本</view>
        <view class="entry-desc">N5-N1 1231个词汇</view>
      </view>
      <view class="entry-arrow">→</view>
    </view>
  </view>

  <view wx:if="{{activeTab === 'grammar'}}" class="content">
    <view class="entry-card" bindtap="goToGrammar">
      <view class="entry-info">
        <view class="entry-title">日语语法</view>
        <view class="entry-desc">N5-N1 264个语法点</view>
      </view>
      <view class="entry-arrow">→</view>
    </view>
  </view>

  <view class="bottom-nav">
    <view class="nav-item {{currentTab === 'lesson' ? 'active' : ''}}" bindtap="goToLesson">
      <text class="nav-text">闯关</text>
    </view>
    <view class="nav-item {{currentTab === 'course' ? 'active' : ''}}" bindtap="goToCourse">
      <text class="nav-text">课程</text>
    </view>
    <view class="nav-item {{currentTab === 'aichat' ? 'active' : ''}}" bindtap="goToAI">
      <text class="nav-text">智能老师</text>
    </view>
    <view class="nav-item {{currentTab === 'rank' ? 'active' : ''}}" bindtap="goToRank">
      <text class="nav-text">排行榜</text>
    </view>
  </view>
</view>