<!--pages/textbook/textbook.wxml-->
<view class="container">
  <view class="header">
    <view class="header-row">
      <view class="back-btn" bindtap="goBack">
        <text class="back-icon">←</text>
      </view>
      <text class="header-title">课本</text>
      <view class="header-placeholder"></view>
    </view>
  </view>

  <view class="book-list">
    <block wx:for="{{books}}" wx:key="level">
      <view class="book-card" bindtap="openBook" data-id="{{item.firstLessonId}}">
        <view class="book-cover" style="background-color: {{item.color}}">
          <text class="book-level-badge">{{item.level}}</text>
        </view>
        <view class="book-info">
          <view class="book-title">{{item.title}}</view>
          <view class="book-meta">
            <text class="book-lesson-count">{{item.lessonCount}}课</text>
            <text class="book-completed">{{item.completedCount}}已完成</text>
          </view>
          <view class="progress-wrap">
            <view class="progress-bar">
              <view class="progress-fill" style="width: {{item.progress}}%; background-color: {{item.color}}"></view>
            </view>
            <text class="progress-text">{{item.progress}}%</text>
          </view>
        </view>
        <view class="book-arrow">
          <text class="arrow-icon">›</text>
        </view>
      </view>
    </block>
  </view>
</view>
