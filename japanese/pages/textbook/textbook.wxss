/*pages/textbook/textbook.wxss*/
.container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

.header {
  padding: 30rpx;
  background-color: #58cc02;
}

.header-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
}

.header-desc {
  font-size: 26rpx;
  color: rgba(255,255,255,0.8);
  margin-top: 8rpx;
}

.book-list {
  padding: 20rpx;
}

.book-card {
  display: flex;
  align-items: center;
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.book-cover {
  width: 120rpx;
  height: 160rpx;
  background: linear-gradient(135deg, #58cc02 0%, #89e219 100%);
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.book-num {
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
}

.book-info {
  flex: 1;
  margin-left: 24rpx;
}

.book-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.book-progress {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}

.progress-bar {
  flex: 1;
  height: 12rpx;
  background-color: #e0e0e0;
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background-color: #58cc02;
  border-radius: 6rpx;
}

.progress-text {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #999;
}

.book-action {
  width: 80rpx;
  text-align: center;
}

.action-icon {
  font-size: 40rpx;
}

.section {
  padding: 30rpx 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.resource-list {
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.resource-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.resource-item:last-child {
  border-bottom: none;
}

.resource-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.resource-info {
  flex: 1;
}

.resource-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.resource-desc {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}