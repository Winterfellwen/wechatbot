/*pages/textbook/textbook.wxss - UI/UX Pro Max 统一版*/
/* 设计系统: learn 页面为基准 */
/* 主色: #2563EB | 背景: #F8FAFC | 边框: #E2E8F0 */

.container { 
  min-height: 100vh; 
  background: #F8FAFC; 
}

/* ========== 顶部导航栏 ========== */
.header { 
  padding: 24rpx 30rpx; 
  background: #fff; 
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.04);
}
.header-row { 
  display: flex; 
  align-items: center; 
  justify-content: space-between; 
}
.back-btn { 
  width: 88rpx; 
  height: 88rpx; 
  display: flex; 
  align-items: center; 
  justify-content: center; 
  cursor: pointer;
  border-radius: 50%;
  transition: background 0.2s;
}
.back-btn:active { background: #F1F5F9; }
.back-icon { 
  font-size: 44rpx; 
  color: #2563EB; 
  font-weight: bold; 
}
.header-title { 
  font-size: 38rpx; 
  font-weight: bold; 
  color: #1E293B; 
}
.header-placeholder { 
  width: 88rpx; 
}

/* ========== 课本列表 ========== */
.book-list { 
  padding: 24rpx; 
}

.book-card {
  display: flex; 
  align-items: center; 
  background: #fff; 
  border-radius: 24rpx;
  padding: 30rpx; 
  margin-bottom: 22rpx; 
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.04);
  border: 3rpx solid #E2E8F0;
  transition: all 0.2s ease; 
  cursor: pointer; 
  min-height: 120rpx;
}
.book-card:active { transform: scale(0.98); }

.book-cover {
  width: 112rpx; 
  height: 112rpx; 
  border-radius: 24rpx;
  display: flex; 
  align-items: center; 
  justify-content: center;
  box-shadow: 0 6rpx 16rpx rgba(0,0,0,0.15);
  flex-shrink: 0;
}
.book-level-badge { 
  font-size: 38rpx; 
  font-weight: bold; 
  color: #fff; 
}
.book-info { 
  flex: 1; 
  margin-left: 30rpx; 
}
.book-title { 
  font-size: 36rpx; 
  font-weight: bold; 
  color: #1E293B; 
}
.book-meta { 
  display: flex; 
  gap: 28rpx; 
  margin-top: 12rpx; 
}
.book-lesson-count { 
  font-size: 28rpx; 
  color: #64748B; 
}
.book-completed { 
  font-size: 28rpx; 
  color: #22C55E; 
  font-weight: 600; 
}
.progress-wrap { 
  display: flex; 
  align-items: center; 
  margin-top: 16rpx; 
}
.progress-bar { 
  flex: 1; 
  height: 14rpx; 
  background: #E2E8F0; 
  border-radius: 7rpx; 
  overflow: hidden; 
}
.progress-fill { 
  height: 100%; 
  border-radius: 7rpx; 
  transition: width 0.4s; 
}
.progress-text { 
  margin-left: 22rpx; 
  font-size: 26rpx; 
  color: #64748B; 
  min-width: 68rpx; 
  font-weight: 500; 
}
.book-arrow { 
  width: 44rpx;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.arrow-icon { 
  font-size: 52rpx; 
  color: #CBD5E1; 
  font-weight: bold; 
}

/* ========== 课程列表 ========== */
.lesson-list { 
  padding: 24rpx; 
}

.lesson-row {
  display: flex; 
  align-items: center; 
  gap: 26rpx;
  background: #fff; 
  border-radius: 24rpx; 
  padding: 30rpx 32rpx;
  margin-bottom: 18rpx; 
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.04);
  border: 3rpx solid #E2E8F0;
  transition: all 0.2s ease; 
  cursor: pointer; 
  min-height: 88rpx;
}
.lesson-row:active { transform: scale(0.98); }
.lesson-row.done { 
  background: #F0FDF4;
  border-color: #22C55E;
}

.lesson-num-circle {
  width: 96rpx; 
  height: 96rpx; 
  border-radius: 50%;
  border: 4rpx solid #CBD5E1; 
  display: flex; 
  align-items: center; 
  justify-content: center;
  flex-shrink: 0; 
  background: #fff;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.08);
  min-width: 88rpx;
  min-height: 88rpx;
}
.lesson-row.done .lesson-num-circle { 
  border-color: #22C55E; 
  background: #22C55E; 
  box-shadow: 0 4rpx 16rpx rgba(34,197,94,0.3);
}
.check-icon { 
  font-size: 32rpx; 
  color: #fff; 
  font-weight: bold; 
}
.num-text { 
  font-size: 28rpx; 
  color: #94A3B8; 
  font-weight: bold; 
}
.lesson-info { 
  flex: 1; 
}
.lesson-title { 
  font-size: 32rpx; 
  font-weight: bold; 
  color: #1E293B; 
  display: block; 
}
.lesson-subtitle { 
  font-size: 26rpx; 
  color: #2563EB; 
  display: block; 
  margin-top: 4rpx; 
}
.lesson-meta { 
  font-size: 26rpx; 
  color: #64748B; 
  display: block; 
  margin-top: 6rpx; 
}
.lesson-arrow { 
  font-size: 40rpx; 
  color: #CBD5E1;
  min-height: 88rpx;
  display: flex;
  align-items: center;
}
