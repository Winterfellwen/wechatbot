/*pages/textbook/textbook.wxss*/
.container { min-height: 100vh; background: linear-gradient(180deg, #e8f4ff 0%, #f5f5f5 100%); }

.header { padding: 24rpx 30rpx; background: #fff; box-shadow: 0 4rpx 16rpx rgba(14,165,233,0.08); }
.header-row { display: flex; align-items: center; justify-content: space-between; }
.back-btn { width: 64rpx; height: 64rpx; display: flex; align-items: center; justify-content: center; }
.back-icon { font-size: 44rpx; color: #0EA5E9; font-weight: bold; }
.header-title { font-size: 38rpx; font-weight: bold; color: #0F172A; }
.header-placeholder { width: 64rpx; }

.book-list { padding: 24rpx; }

.book-card {
  display: flex; align-items: center; background: #fff; border-radius: 22rpx;
  padding: 30rpx; margin-bottom: 22rpx; box-shadow: 0 6rpx 20rpx rgba(14,165,233,0.08);
  transition: all 0.2s;
}
.book-card:active { transform: scale(0.99); }
.book-cover {
  width: 112rpx; height: 112rpx; border-radius: 22rpx;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 6rpx 16rpx rgba(0,0,0,0.15);
}
.book-level-badge { font-size: 38rpx; font-weight: bold; color: #fff; }
.book-info { flex: 1; margin-left: 30rpx; }
.book-title { font-size: 36rpx; font-weight: bold; color: #0F172A; }
.book-meta { display: flex; gap: 28rpx; margin-top: 12rpx; }
.book-lesson-count { font-size: 28rpx; color: #475569; }
.book-completed { font-size: 28rpx; color: #22C55E; font-weight: 600; }
.progress-wrap { display: flex; align-items: center; margin-top: 16rpx; }
.progress-bar { flex: 1; height: 14rpx; background: #E0F2FE; border-radius: 7rpx; overflow: hidden; }
.progress-fill { height: 100%; border-radius: 7rpx; transition: width 0.4s; }
.progress-text { margin-left: 22rpx; font-size: 26rpx; color: #64748B; min-width: 68rpx; font-weight: 500; }
.book-arrow { width: 44rpx; }
.arrow-icon { font-size: 52rpx; color: #CBD5E1; font-weight: bold; }

.book-detail-header {
  padding: 48rpx 30rpx; color: #fff; text-align: center;
  margin-bottom: 4rpx;
  box-shadow: 0 8rpx 24rpx rgba(14,165,233,0.2);
}
.detail-level { font-size: 52rpx; font-weight: bold; display: block; }
.detail-count { font-size: 30rpx; opacity: 0.9; display: block; margin-top: 10rpx; }

.lesson-list { padding: 24rpx; }

.lesson-row {
  display: flex; align-items: center; gap: 26rpx;
  background: #fff; border-radius: 20rpx; padding: 30rpx 32rpx;
  margin-bottom: 18rpx; box-shadow: 0 4rpx 14rpx rgba(14,165,233,0.06);
  transition: all 0.2s;
}
.lesson-row:active { transform: scale(0.99); }
.lesson-row.done { background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%); }
.lesson-num-circle {
  width: 76rpx; height: 76rpx; border-radius: 50%;
  border: 4rpx solid #CBD5E1; display: flex; align-items: center; justify-content: center;
  flex-shrink: 0; background: #fff;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.08);
}
.lesson-row.done .lesson-num-circle { border-color: #22C55E; background: #22C55E; box-shadow: 0 4rpx 12rpx rgba(34,197,94,0.3); }
.lesson-info { flex: 1; }
.lesson-title { font-size: 32rpx; font-weight: bold; color: #0F172A; display: block; }
.lesson-meta { font-size: 26rpx; color: #64748B; display: block; margin-top: 6rpx; }
.lesson-arrow { font-size: 40rpx; color: #CBD5E1; }