/*pages/leaderboard/leaderboard.wxss*/
.container { min-height: 100vh; background: #f5f5f5; padding-bottom: 110rpx; }

.personal-card {
  display: flex; align-items: center; gap: 20rpx;
  padding: 30rpx; background: linear-gradient(135deg, #667eea, #764ba2); color: #fff;
}
.rank-number { font-size: 48rpx; font-weight: bold; flex-shrink: 0; }
.user-info { display: flex; align-items: center; gap: 16rpx; flex: 1; }
.avatar { width: 80rpx; height: 80rpx; border-radius: 50%; background: rgba(255,255,255,0.2); }
.nickname { font-size: 30rpx; font-weight: bold; }
.stats { font-size: 24rpx; opacity: 0.8; display: block; margin-top: 4rpx; }

.tabs { display: flex; background: #fff; }
.tab {
  flex: 1; text-align: center; padding: 24rpx 0; font-size: 26rpx; color: #999;
  border-bottom: 4rpx solid transparent;
}
.tab.active { color: #764ba2; border-bottom-color: #764ba2; font-weight: bold; }

.rank-list { padding: 20rpx; }

.rank-item {
  display: flex; align-items: center; gap: 16rpx;
  background: #fff; border-radius: 12rpx; padding: 20rpx 24rpx; margin-bottom: 12rpx;
}
.rank-item.top { border-left: 6rpx solid #ffd700; }
.rank-num { width: 48rpx; font-size: 28rpx; font-weight: bold; color: #666; text-align: center; }
.rank-avatar { width: 64rpx; height: 64rpx; border-radius: 50%; background: #eee; }
.rank-info { flex: 1; }
.rank-name { font-size: 28rpx; color: #333; font-weight: bold; }
.rank-level { font-size: 22rpx; color: #999; }
.rank-score { font-size: 28rpx; font-weight: bold; color: #764ba2; }

.my-stats { display: flex; padding: 20rpx; gap: 16rpx; }
.stat-box {
  flex: 1; text-align: center; background: #fff; border-radius: 12rpx; padding: 20rpx;
}
.stat-value { font-size: 36rpx; font-weight: bold; color: #764ba2; display: block; }
.stat-label { font-size: 22rpx; color: #999; margin-top: 4rpx; display: block; }

.bottom-nav {
  position: fixed; bottom: 0; left: 0; right: 0; display: flex;
  background: #fff; box-shadow: 0 -2rpx 16rpx rgba(0,0,0,0.08);
}
.nav-item { flex: 1; padding: 16rpx 0; text-align: center; }
.nav-text { font-size: 22rpx; color: #999; }
.nav-item.active .nav-text { color: #764ba2; font-weight: bold; }
