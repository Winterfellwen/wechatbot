<!--pages/grammar/grammar.wxml-->
<view class="container">
  <view class="header">
    <text class="header-title">语法</text>
  </view>

  <view class="category-tabs">
    <view 
      wx:for="{{levels}}" 
      wx:key="*this"
      class="tab {{currentLevel === item ? 'active' : ''}}"
      bindtap="switchLevel"
      data-level="{{item}}">
      {{item}}
    </view>
  </view>

  <scroll-view scroll-y class="grammar-list">
    <block wx:for="{{grammarList}}" wx:key="id">
      <view class="grammar-card">
        <view class="grammar-header">
          <text class="grammar-title">{{item.pattern}}</text>
          <text class="grammar-level">{{item.level}}</text>
        </view>
        <view class="grammar-structure">{{item.structure}}</view>
        <view class="grammar-usage">{{item.explanation}}</view>
        <view class="grammar-example">
          <view class="example-label">例句</view>
          <view class="example-jp">{{item.example}}</view>
          <view class="example-cn">{{item.translation}}</view>
        </view>
      </view>
    </block>
  </scroll-view>
</view>