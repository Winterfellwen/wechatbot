<!--pages/grammar/grammar.wxml-->
<view class="container">
  <!-- 顶部 -->
  <view class="header">
    <text class="header-title">语法</text>
  </view>

  <!-- 语法分类 -->
  <view class="category-tabs">
    <view 
      wx:for="{{categories}}" 
      wx:key="id"
      class="tab {{currentCategory === item.id ? 'active' : ''}}"
      bindtap="switchCategory"
      data-id="{{item.id}}">
      {{item.name}}
    </view>
  </view>

  <!-- 语法列表 -->
  <scroll-view scroll-y class="grammar-list">
    <block wx:for="{{currentGrammar}}" wx:key="id">
      <view class="grammar-card">
        <view class="grammar-header">
          <text class="grammar-title">{{item.title}}</text>
          <text class="grammar-level">{{item.level}}</text>
        </view>
        <view class="grammar-usage">{{item.usage}}</view>
        <view class="grammar-example">
          <view class="example-label">例句</view>
          <view class="example-jp">{{item.example}}</view>
          <view class="example-cn">{{item.exampleCn}}</view>
        </view>
      </view>
    </block>
  </scroll-view>
</view>