/*pages/grammar/grammar.wxss - UI/UX Pro Max 统一版*/
/* 设计系统: learn 页面为基准 */
/* 主色: #2563EB | 背景: #F8FAFC | 边框: #E2E8F0 */

.container { 
  min-height: 100vh; 
  background: #F8FAFC; 
}

/* ========== 顶部导航栏 ========== */
.header { 
  padding: 24rpx 30rpx; 
  background: #fff; 
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.04);
}
.header-row { 
  display: flex; 
  align-items: center; 
  justify-content: space-between; 
}
.back-btn { 
  width: 88rpx; 
  height: 88rpx; 
  display: flex; 
  align-items: center; 
  justify-content: center; 
  cursor: pointer;
  border-radius: 50%;
  transition: background 0.2s;
}
.back-btn:active { background: #F1F5F9; }
.back-icon {
  font-size: 44rpx;
  color: #2563EB;
  font-weight: bold;
}

.back-icon-img {
  width: 44rpx;
  height: 44rpx;
}
.header-title { 
  font-size: 38rpx; 
  font-weight: bold; 
  color: #1E293B; 
}
.header-placeholder { 
  width: 88rpx; 
}

/* ========== 级别标签栏 ========== */
.level-tabs { 
  display: flex; 
  padding: 20rpx 24rpx; 
  background: #fff; 
  gap: 16rpx; 
  flex-wrap: wrap;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.04);
}
.tab { 
  padding: 16rpx 36rpx; 
  font-size: 28rpx; 
  color: #64748B; 
  background: #F1F5F9; 
  border-radius: 40rpx; 
  transition: all 0.2s;
  cursor: pointer;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.tab:active { transform: scale(0.95); }
.tab.active { 
  background: linear-gradient(135deg, #2563EB, #3B82F6); 
  color: #fff; 
  box-shadow: 0 4rpx 16rpx rgba(37,99,235,0.3);
}

/* ========== 语法列表 ========== */
.grammar-list { 
  padding: 24rpx; 
  height: calc(100vh - 280rpx); 
}

.grammar-card {
  background: #fff; 
  border-radius: 24rpx; 
  padding: 32rpx; 
  margin-bottom: 22rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.04);
  border: 3rpx solid #E2E8F0;
  transition: all 0.2s;
}
.grammar-card:active { transform: scale(0.99); }

.grammar-header { 
  display: flex; 
  justify-content: space-between; 
  align-items: center; 
  margin-bottom: 20rpx; 
}
.grammar-pattern { 
  font-size: 34rpx; 
  font-weight: bold; 
  color: #1E293B; 
}
.grammar-level-badge {
  font-size: 24rpx; 
  color: #2563EB; 
  background: #EFF6FF;
  padding: 8rpx 18rpx; 
  border-radius: 12rpx; 
  font-weight: 600;
}

.grammar-structure { 
  font-size: 28rpx; 
  color: #475569; 
  margin-bottom: 12rpx; 
}
.grammar-structure .label { 
  color: #94A3B8; 
}
.grammar-explain { 
  font-size: 28rpx; 
  color: #475569; 
  margin-bottom: 12rpx; 
  line-height: 1.7; 
}
.grammar-explain .label { 
  color: #94A3B8; 
}

.grammar-example { 
  background: #EFF6FF; 
  border-radius: 16rpx; 
  padding: 24rpx; 
  border-left: 6rpx solid #2563EB; 
}
.example-label { 
  font-size: 24rpx; 
  color: #2563EB; 
  margin-bottom: 10rpx; 
  display: block; 
  font-weight: 600; 
}
.example-jp { 
  font-size: 30rpx; 
  color: #1E293B; 
  display: block; 
  margin-bottom: 8rpx; 
}
.example-cn { 
  font-size: 26rpx; 
  color: #64748B; 
  display: block; 
}
