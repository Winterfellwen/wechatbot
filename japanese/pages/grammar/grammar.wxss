/*pages/grammar/grammar.wxss*/
.container { min-height: 100vh; background: #F0F9FF; padding-bottom: 20rpx; }

.header { padding: 20rpx 30rpx; background: #fff; box-shadow: 0 2rpx 12rpx rgba(14,165,233,0.06); }
.header-row { display: flex; align-items: center; justify-content: space-between; }
.back-btn { width: 60rpx; height: 60rpx; display: flex; align-items: center; justify-content: center; }
.back-icon { font-size: 40rpx; color: #0EA5E9; font-weight: bold; }
.header-title { font-size: 36rpx; font-weight: bold; color: #0F172A; }
.header-placeholder { width: 60rpx; }

.level-tabs { display: flex; padding: 20rpx 24rpx; background: #fff; margin-bottom: 2rpx; gap: 16rpx; flex-wrap: wrap; }
.tab { padding: 16rpx 36rpx; font-size: 28rpx; color: #64748B; background: #F1F5F9; border-radius: 36rpx; transition: all 0.2s; }
.tab.active { background: linear-gradient(135deg, #0EA5E9, #38BDF8); color: #fff; box-shadow: 0 4rpx 12rpx rgba(14,165,233,0.25); }

.grammar-list { padding: 24rpx; height: calc(100vh - 250rpx); }

.grammar-card {
  background: #fff; border-radius: 20rpx; padding: 32rpx; margin-bottom: 22rpx;
  box-shadow: 0 2rpx 12rpx rgba(14,165,233,0.04);
}
.grammar-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20rpx; }
.grammar-pattern { font-size: 34rpx; font-weight: bold; color: #0F172A; }
.grammar-level-badge {
  font-size: 24rpx; color: #0EA5E9; background: #E0F2FE;
  padding: 8rpx 18rpx; border-radius: 10rpx; font-weight: 600;
}

.grammar-structure { font-size: 28rpx; color: #475569; margin-bottom: 12rpx; }
.grammar-structure .label { color: #94A3B8; }
.grammar-explain { font-size: 28rpx; color: #475569; margin-bottom: 12rpx; line-height: 1.7; }
.grammar-explain .label { color: #94A3B8; }

.grammar-example { background: #F0F9FF; border-radius: 16rpx; padding: 24rpx; border-left: 5rpx solid #0EA5E9; }
.example-label { font-size: 24rpx; color: #0EA5E9; margin-bottom: 10rpx; display: block; font-weight: 600; }
.example-jp { font-size: 30rpx; color: #0F172A; display: block; margin-bottom: 8rpx; }
.example-cn { font-size: 26rpx; color: #64748B; display: block; }
