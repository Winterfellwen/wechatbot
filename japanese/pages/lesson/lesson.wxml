<!--pages/lesson/lesson.wxml-->
<view class="container">
  <!-- 顶部 -->
  <view class="header">
    <view class="header-left" bindtap="goBack">←</view>
    <view class="header-title">{{lessonTitle}}</view>
    <view class="header-right">{{current}}/{{total}}</view>
  </view>

  <!-- 进度条 -->
  <view class="progress-container">
    <view class="progress-bar">
      <view class="progress-fill" style="width: {{progress}}%"></view>
    </view>
  </view>

  <!-- 问题区域 -->
  <view class="question-container">
    <view class="question-number">第{{current}}题</view>
    <view class="question-text">{{currentQuestion.question}}</view>
    <view wx:if="{{currentQuestion.audio}}" class="audio-btn" bindtap="playAudio">🔊</view>
  </view>

  <!-- 选项 -->
  <view class="options-container">
    <block wx:for="{{currentQuestion.options}}" wx:key="index">
      <view 
        class="option-btn {{selectedIndex === index ? (correctIndex === index ? 'correct' : (selectedIndex === index ? 'wrong' : '')) : (showResult && correctIndex === index ? 'correct' : '')}}"
        bindtap="selectOption" 
        data-index="{{index}}"
        wx:if="{{!showResult || selectedIndex === index || correctIndex === index}}">
        <view class="option-letter">{{['A','B','C','D'][index]}}</view>
        <view class="option-text">{{item}}</view>
      </view>
    </block>
  </view>

  <!-- 结果 -->
  <view wx:if="{{showResult}}" class="result-container">
    <view wx:if="{{isCorrect}}" class="result-correct">
      <text class="result-icon">✓</text>
      <text class="result-text">正确!</text>
      <text class="result-xp">+{{currentQuestion.xp}} XP</text>
    </view>
    <view wx:else class="result-wrong">
      <text class="result-icon">✗</text>
      <text class="result-text">正确答案是: {{currentQuestion.options[correctIndex]}}</text>
    </view>
    <view class="next-btn" bindtap="nextQuestion">
      <text>{{current < total ? '下一题' : '完成!'}}</text>
    </view>
  </view>
</view>