<!--pages/lesson/lesson.wxml-->
<view class="container">
  <view wx:if="{{showComplete}}" class="complete-screen">
    <view class="complete-card">
      <view class="complete-icon">{{score >= total * 0.8 ? 'A' : 'B'}}</view>
      <text class="complete-title">课程完成!</text>
      <text class="complete-score">{{score}} / {{total}}</text>
      <text class="complete-xp">+{{xpEarned}} XP</text>
      <view class="complete-btns">
        <view class="btn-retry" bindtap="startAgain">再来一次</view>
        <view class="btn-exit" bindtap="goBack">返回</view>
      </view>
    </view>
  </view>

  <view wx:if="{{!showComplete && currentQuestion}}" class="quiz-container">
    <view class="quiz-header">
      <view class="exit-btn" bindtap="goBack">←</view>
      <view class="progress-wrap">
        <view class="progress-bar">
          <view class="progress-fill" style="width: {{progress}}%"></view>
        </view>
      </view>
      <view class="lives">{{streak}}</view>
    </view>

    <view class="quiz-body">
      <view class="question-prompt">{{currentQuestion.prompt}}</view>

      <view wx:if="{{currentQuestion.type === 'listening'}}" class="audio-btn-big" bindtap="playAudio">
        <text class="audio-icon">🔊</text>
      </view>

      <!-- Choice options -->
      <view wx:if="{{currentQuestion.type === 'choice' || currentQuestion.type === 'listening'}}" class="options-list">
        <block wx:for="{{currentQuestion.options}}" wx:key="index">
          <view class="option-btn {{showResult && index === correctIndex ? 'correct' : ''}} {{showResult && index === selectedIndex && index !== correctIndex ? 'wrong' : ''}}"
                bindtap="selectOption" data-index="{{index}}">
            <view class="option-badge">{{['A','B','C','D'][index]}}</view>
            <text class="option-text">{{item}}</text>
          </view>
        </block>
      </view>

      <!-- Fill input -->
      <view wx:if="{{currentQuestion.type === 'fill'}}" class="fill-section">
        <view wx:if="{{currentQuestion.hints}}" class="fill-hint">提示：以「{{currentQuestion.hints[0]}}」开头</view>
        <input class="fill-input" value="{{fillAnswer}}" placeholder="输入你的答案" bindinput="onFillInput" confirm-type="done" focus="{{true}}" />
        <view class="fill-submit" bindtap="checkFill">确认</view>
      </view>
    </view>

    <!-- Result overlay -->
    <view wx:if="{{showResult}}" class="result-bar">
      <view wx:if="{{isCorrect}}" class="result-correct">
        <text class="result-big">✓</text>
        <text class="result-sub">正确! {{combo > 1 ? '连续' + combo + '题!' : ''}}</text>
      </view>
      <view wx:else class="result-wrong">
        <text class="result-big">✗</text>
        <text class="result-sub" wx:if="{{currentQuestion.type === 'fill'}}">正确答案: {{currentQuestion.answer}}</text>
        <text class="result-sub" wx:else>正确答案: {{currentQuestion.options[correctIndex]}}</text>
      </view>
      <view class="next-btn" bindtap="nextQuestion">{{current < total ? '继续' : '完成!'}}</view>
    </view>
  </view>

  <view wx:if="{{!showComplete && !currentQuestion}}" class="empty-state">
    <text>这道课没有题目，请返回。</text>
    <view class="btn-exit" bindtap="goBack" style="margin-top:30rpx">返回</view>
  </view>
</view>
