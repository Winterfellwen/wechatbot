<!--pages/lesson/lesson.wxml-->
<view class="container">
  <!-- Study mode: words, grammar, text -->
  <view wx:if="{{mode === 'study'}}" class="study-container">
    <view class="study-header">
      <view class="exit-btn" bindtap="goBack">返回</view>
      <view class="title-wrap">
        <text class="study-title">{{lessonTitle}}</text>
        <text wx:if="{{lessonSubtitle}}" class="study-subtitle">{{lessonSubtitle}}</text>
      </view>
      <view class="level-tag">{{level}}</view>
    </view>

    <scroll-view scroll-y class="study-body">
      <view wx:if="{{words.length > 0}}" class="study-section">
        <text class="section-title">词汇 ({{words.length}})</text>
        <block wx:for="{{words}}" wx:for-index="wordIdx" wx:key="wordIdx">
          <view class="study-word-card">
            <view class="word-main-row" bindtap="playAudio" data-word="{{item.word}}">
              <view class="word-content">
                <view class="sw-jp {{playingWord === item.word ? 'playing' : ''}}">{{item.word}}</view>
                <view class="sw-meaning">{{item.meaning}}</view>
              </view>
              <view class="expand-btn" catchtap="toggleWordExpand" data-index="{{wordIdx}}">
                <text class="arrow {{item.expanded ? 'up' : ''}}">{{item.expanded ? '▲' : '▼'}}</text>
              </view>
            </view>
            <view wx:if="{{item.expanded}}" class="word-extra">
              <view class="sw-reading">{{item.reading}}</view>
              <view wx:if="{{item.example}}" class="sw-example {{playingWord === item.example ? 'playing' : ''}}" catchtap="playAudio" data-word="{{item.example}}">
                <text class="example-text">{{item.example}}</text>
                <view class="audio-indicator {{playingWord === item.example ? 'playing' : ''}}">
                  <view class="speaker-icon">
                    <view class="speaker-body"></view>
                    <view class="speaker-cone"></view>
                    <view class="speaker-wave wave-1" wx:if="{{playingWord === item.example}}"></view>
                    <view class="speaker-wave wave-2" wx:if="{{playingWord === item.example}}"></view>
                  </view>
                </view>
              </view>
              <view wx:if="{{item.example_translation}}" class="sw-ex-cn">{{item.example_translation}}</view>
            </view>
          </view>
        </block>
      </view>

      <view wx:if="{{grammar.length > 0}}" class="study-section">
        <text class="section-title">语法 ({{grammar.length}})</text>
        <block wx:for="{{grammar}}" wx:for-index="gIdx" wx:key="gIdx">
          <view class="study-grammar-card">
            <text class="sg-pattern">{{item.pattern}}</text>
            <text class="sg-structure">{{item.structure}}</text>
            <text class="sg-explain">{{item.explanation}}</text>
            <view class="sg-example">
              <text>{{item.example}}</text>
              <text class="sg-trans">{{item.translation}}</text>
            </view>
          </view>
        </block>
      </view>

      <view wx:if="{{textDialogue}}" class="study-section">
        <text class="section-title">课文</text>
        <view class="text-block">
          <view class="text-name-wrap">
            <text class="text-name">{{textDialogue.title}}</text>
            <text wx:if="{{textDialogue.subtitle}}" class="text-subtitle">{{textDialogue.subtitle}}</text>
          </view>
          <block wx:for="{{textDialogue.dialogue}}" wx:for-index="dIdx" wx:key="dIdx">
            <view class="dialogue-row">
              <text class="dr-speaker">{{item.speaker}}:</text>
              <text class="dr-jp">{{item.text}}</text>
              <text class="dr-cn">{{item.translation}}</text>
            </view>
          </block>
        </view>
      </view>
    </scroll-view>

    <view class="start-quiz-bar">
      <view class="start-quiz-btn" bindtap="startQuiz">开始练习</view>
    </view>
  </view>

  <!-- Quiz mode -->
  <view wx:if="{{mode === 'quiz' && !showComplete && currentQuestion}}" class="quiz-container">
    <view class="quiz-header">
      <view class="exit-btn" bindtap="goBack">返回</view>
      <view class="progress-wrap">
        <view class="progress-bar">
          <view class="progress-fill" style="width: {{progress}}%"></view>
        </view>
      </view>
      <view class="lives">{{streak}}</view>
    </view>

    <view class="quiz-body">
      <view class="question-prompt">{{currentQuestion.prompt}}</view>
      <view wx:if="{{currentQuestion.type === 'listening'}}" class="audio-btn-big {{isPlayingAudio ? 'playing' : ''}}" bindtap="playAudio">
        <view class="audio-indicator-large {{isPlayingAudio ? 'playing' : ''}}">
          <view class="speaker-icon-lg">
            <view class="speaker-body-lg"></view>
            <view class="speaker-cone-lg"></view>
            <view class="speaker-wave-lg wave-1" wx:if="{{isPlayingAudio}}"></view>
            <view class="speaker-wave-lg wave-2" wx:if="{{isPlayingAudio}}"></view>
          </view>
        </view>
      </view>

      <view wx:if="{{currentQuestion.options}}" class="options-list {{showShake ? 'shake-anim' : ''}}">
        <block wx:for="{{currentQuestion.options}}" wx:for-index="idx" wx:key="idx">
          <view class="option-btn {{showResult && idx === correctIndex ? 'correct' : ''}} {{showResult && idx === selectedIndex && idx !== correctIndex ? 'wrong' : ''}}" bindtap="selectOption" data-index="{{idx}}">
            <view class="option-badge">{{['A','B','C','D'][idx]}}</view>
            <text class="option-text">{{item}}</text>
          </view>
        </block>
      </view>

      <view wx:if="{{!currentQuestion.options}}" class="fill-section">
        <view wx:if="{{currentQuestion.hints && !showResult}}" class="fill-hint">提示：以「{{currentQuestion.hints[0]}}」开头</view>
        <input class="fill-input" value="{{fillAnswer}}" placeholder="输入你的答案" bindinput="onFillInput" confirm-type="done" focus="{{true}}" disabled="{{showResult}}" />
        <view wx:if="{{!showResult}}" class="fill-submit" bindtap="checkFill">确认</view>
      </view>
    </view>

    <view wx:if="{{showResult}}" class="result-bar">
      <view class="next-btn" bindtap="nextQuestion">
        <text class="next-text">{{current < total ? '继续' : '完成'}}</text>
      </view>
      <view class="result-card {{isCorrect ? 'result-correct' : 'result-wrong'}}">
        <view class="result-icon-wrap">
          <text class="result-icon">{{isCorrect ? 'V' : 'X'}}</text>
        </view>
        <text class="result-msg">{{isCorrect ? '回答正确' : '回答错误'}}</text>
        <text wx:if="{{isCorrect && combo > 1}}" class="result-combo">{{combo}} 连击</text>
        <view wx:if="{{!isCorrect}}" class="answer-box">
          <text class="answer-label">正确答案：</text>
          <text class="answer-value">{{currentQuestion.options ? currentQuestion.options[correctIndex] : currentQuestion.answer}}</text>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{mode === 'quiz' && !currentQuestion && !showComplete}}" class="empty-state">
    <text>暂无练习</text>
    <view class="btn-exit" bindtap="goBack" style="margin-top:30rpx">返回</view>
  </view>

  <!-- Complete screen -->
  <view wx:if="{{showComplete}}" class="complete-screen">
    <view class="complete-card">
      <view class="complete-stars">
        <text wx:for="{{completeStars.full}}" wx:for-item="star" wx:key="*this" class="star full">*</text>
        <text wx:if="{{completeStars.half}}" class="star half">*</text>
        <text wx:for="{{completeStars.empty}}" wx:for-item="star" wx:key="*this" class="star empty">-</text>
      </view>
      <text class="complete-title">课程完成</text>
      <text class="complete-score">{{score}} / {{total}}</text>
      <text class="complete-xp">+{{xpEarned}} XP</text>
      <view class="complete-btns">
        <view class="complete-btn btn-primary" bindtap="nextUnit">{{nextUnitId ? '下一单元' : '再来一次'}}</view>
        <view class="complete-btn btn-secondary" bindtap="goBack">返回</view>
      </view>
    </view>
  </view>
</view>
