<!--pages/lesson/lesson.wxml-->
<view class="container">
  <view class="header">
    <view class="header-left" bindtap="goBack">← {{level}}</view>
    <view class="header-title">{{lessonTitle}}</view>
    <view class="header-right"></view>
  </view>

  <view class="segment-tabs">
    <block wx:for="{{segments}}" wx:key="key">
      <view class="seg-tab {{segment === item.key ? 'active' : ''}}" bindtap="selectSegment" data-seg="{{item.key}}">
        {{item.label}}
      </view>
    </block>
  </view>

  <!-- Words segment -->
  <scroll-view wx:if="{{segment === 'words'}}" scroll-y class="content-area">
    <block wx:for="{{words}}" wx:key="id">
      <view class="word-card">
        <view class="word-jp">{{item.word}}</view>
        <view class="word-reading">{{item.reading}}</view>
        <view class="word-meaning">{{item.meaning}}</view>
        <view wx:if="{{item.example}}" class="word-example">
          <text>{{item.example}}</text>
          <text class="word-example-cn">{{item.example_translation}}</text>
        </view>
      </view>
    </block>
  </scroll-view>

  <!-- Grammar segment -->
  <scroll-view wx:if="{{segment === 'grammar'}}" scroll-y class="content-area">
    <block wx:for="{{grammar}}" wx:key="id">
      <view class="grammar-card">
        <text class="grammar-pattern">{{item.pattern}}</text>
        <text class="grammar-structure">{{item.structure}}</text>
        <text class="grammar-explain">{{item.explanation}}</text>
        <view class="grammar-example">
          <text>{{item.example}}</text>
          <text class="grammar-trans">{{item.translation}}</text>
        </view>
      </view>
    </block>
  </scroll-view>

  <!-- Text segment -->
  <scroll-view wx:if="{{segment === 'text'}}" scroll-y class="content-area">
    <block wx:if="{{textDialogue}}">
      <view class="text-title">{{textDialogue.title}}</view>
      <block wx:for="{{textDialogue.dialogue}}" wx:key="*this">
        <view class="dialogue-line">
          <text class="dialogue-speaker">{{item.speaker}}:</text>
          <text class="dialogue-jp">{{item.text}}</text>
          <text class="dialogue-cn">{{item.translation}}</text>
        </view>
      </block>
    </block>
    <block wx:else>
      <view class="placeholder-text">本课暂无对话</view>
    </block>
  </scroll-view>

  <!-- Quiz segment -->
  <view wx:if="{{segment === 'quiz'}}" class="quiz-area">
    <view class="progress-bar-small">
      <view class="progress-bar">
        <view class="progress-fill" style="width: {{progress}}%"></view>
      </view>
      <text>{{current}}/{{total}}</text>
    </view>

    <view class="question-box" wx:if="{{currentQuestion}}">
      <view class="question-number">第{{current}}题</view>
      <view class="question-text">{{currentQuestion.question}}</view>
    </view>

    <view class="options-list">
      <block wx:for="{{currentQuestion.options}}" wx:key="index">
        <view 
          class="option-btn {{showResult ? (index === correctIndex ? 'correct' : (index === selectedIndex ? 'wrong' : '')) : ''}}"
          bindtap="selectOption" 
          data-index="{{index}}">
          <text class="option-letter">{{['A','B','C','D'][index]}}</text>
          <text class="option-text">{{item}}</text>
        </view>
      </block>
    </view>

    <view wx:if="{{showResult}}" class="result-bar">
      <view wx:if="{{isCorrect}}" class="result-correct">✓ 正确!</view>
      <view wx:else class="result-wrong">✗ 正确答案: {{currentQuestion.options[correctIndex]}}</view>
      <view class="next-btn" bindtap="nextQuestion">
        {{current < total ? '下一题' : '完成!'}}
      </view>
    </view>
  </view>
</view>