/*pages/lesson/lesson.wxss*/
.container { min-height: 100vh; background: #fff; }

.quiz-header {
  display: flex; align-items: center; padding: 16rpx 24rpx;
  background: #fff; border-bottom: 1rpx solid #eee; gap: 16rpx;
}
.exit-btn { font-size: 36rpx; color: #999; width: 60rpx; }
.progress-wrap { flex: 1; }
.progress-bar { height: 14rpx; background: #e0e0e0; border-radius: 7rpx; overflow: hidden; }
.progress-fill { height: 100%; background: #58cc02; border-radius: 7rpx; transition: width 0.3s; }
.lives { width: 60rpx; text-align: center; font-size: 24rpx; color: #ff6b6b; font-weight: bold; }

.quiz-body { padding: 40rpx 30rpx; }

.question-prompt {
  font-size: 36rpx; font-weight: bold; color: #333; line-height: 1.6;
  text-align: center; margin-bottom: 40rpx; white-space: pre-wrap;
}

.audio-btn-big {
  width: 120rpx; height: 120rpx; border-radius: 50%; background: #e8f5e9;
  display: flex; align-items: center; justify-content: center; margin: 20rpx auto 40rpx;
}
.audio-icon { font-size: 48rpx; }

.options-list { display: flex; flex-direction: column; gap: 20rpx; }

.option-btn {
  display: flex; align-items: center; padding: 24rpx 28rpx; border-radius: 16rpx;
  border: 3rpx solid #e0e0e0; background: #fff; transition: all 0.15s;
}
.option-btn.correct { background: #d4edda; border-color: #58cc02; }
.option-btn.wrong { background: #ffe0e0; border-color: #ff6b6b; }
.option-badge {
  width: 56rpx; height: 56rpx; border-radius: 50%; background: #f0f0f0;
  color: #666; font-size: 26rpx; font-weight: bold;
  display: flex; align-items: center; justify-content: center; margin-right: 20rpx; flex-shrink: 0;
}
.option-btn.correct .option-badge { background: #58cc02; color: #fff; }
.option-btn.wrong .option-badge { background: #ff6b6b; color: #fff; }
.option-text { flex: 1; font-size: 30rpx; color: #333; line-height: 1.4; }

.fill-section { margin-top: 20rpx; }
.fill-hint { font-size: 24rpx; color: #999; text-align: center; margin-bottom: 24rpx; }
.fill-input {
  border: 3rpx solid #58cc02; border-radius: 16rpx; padding: 24rpx 30rpx;
  font-size: 32rpx; text-align: center; width: 100%; box-sizing: border-box;
}
.fill-submit {
  margin-top: 30rpx; padding: 24rpx; background: #58cc02; border-radius: 16rpx;
  color: #fff; font-size: 30rpx; font-weight: bold; text-align: center;
}

.result-bar {
  padding: 40rpx; text-align: center;
}
.result-correct { color: #58cc02; }
.result-wrong { color: #ff6b6b; }
.result-big { font-size: 64rpx; display: block; }
.result-sub { font-size: 28rpx; margin-top: 10rpx; display: block; }
.next-btn {
  margin-top: 40rpx; padding: 24rpx 80rpx; background: #58cc02;
  border-radius: 16rpx; color: #fff; font-size: 30rpx; font-weight: bold;
  display: inline-block;
}

.empty-state { padding: 100rpx 40rpx; text-align: center; color: #999; font-size: 28rpx; }

.complete-screen {
  min-height: 100vh; display: flex; align-items: center; justify-content: center;
  background: linear-gradient(135deg, #58cc02, #89e219);
}
.complete-card {
  text-align: center; background: #fff; border-radius: 24rpx; padding: 60rpx 50rpx;
  width: 560rpx;
}
.complete-icon {
  width: 120rpx; height: 120rpx; border-radius: 50%; background: #ffd700;
  color: #fff; font-size: 56rpx; font-weight: bold; line-height: 120rpx;
  text-align: center; margin: 0 auto 24rpx;
}
.complete-title { font-size: 36rpx; font-weight: bold; color: #333; display: block; }
.complete-score { font-size: 56rpx; font-weight: bold; color: #58cc02; display: block; margin-top: 10rpx; }
.complete-xp { font-size: 32rpx; color: #ffd700; font-weight: bold; display: block; margin-top: 8rpx; }
.complete-btns { display: flex; gap: 20rpx; margin-top: 40rpx; }
.btn-retry {
  flex: 1; padding: 24rpx; background: #58cc02; border-radius: 16rpx;
  color: #fff; font-size: 28rpx; font-weight: bold; text-align: center;
}
.btn-exit {
  flex: 1; padding: 24rpx; background: #eee; border-radius: 16rpx;
  color: #999; font-size: 28rpx; text-align: center;
}
