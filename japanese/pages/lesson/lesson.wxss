/*pages/lesson/lesson.wxss*/
.container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  background-color: #58cc02;
}

.header-left, .header-right {
  width: 100rpx;
  font-size: 36rpx;
  color: #fff;
}

.header-title {
  flex: 1;
  text-align: center;
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
}

.progress-container {
  padding: 20rpx 30rpx;
  background-color: #58cc02;
}

.progress-bar {
  height: 12rpx;
  background-color: rgba(255,255,255,0.3);
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background-color: #fff;
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

.question-container {
  padding: 40rpx 30rpx;
  text-align: center;
}

.question-number {
  font-size: 28rpx;
  color: #999;
}

.question-text {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-top: 20rpx;
}

.audio-btn {
  margin-top: 20rpx;
  font-size: 48rpx;
}

.options-container {
  padding: 30rpx;
}

.option-btn {
  display: flex;
  align-items: center;
  background-color: #fff;
  border: 4rpx solid #e0e0e0;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.option-btn.correct {
  background-color: #e8f5e9;
  border-color: #58cc02;
}

.option-btn.wrong {
  background-color: #ffebee;
  border-color: #f44336;
}

.option-letter {
  width: 60rpx;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: bold;
  color: #58cc02;
  background-color: #e8f5e9;
  border-radius: 50%;
  margin-right: 20rpx;
}

.option-btn.correct .option-letter {
  background-color: #58cc02;
  color: #fff;
}

.option-btn.wrong .option-letter {
  background-color: #f44336;
  color: #fff;
}

.option-text {
  flex: 1;
  font-size: 32rpx;
  color: #333;
}

.result-container {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0,0,0,0.8);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.result-correct, .result-wrong {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.result-icon {
  font-size: 120rpx;
}

.result-correct .result-icon {
  color: #58cc02;
}

.result-wrong .result-icon {
  color: #f44336;
}

.result-text {
  margin-top: 20rpx;
  font-size: 40rpx;
  color: #fff;
}

.result-xp {
  margin-top: 10rpx;
  font-size: 32rpx;
  color: #ffd700;
}

.next-btn {
  margin-top: 60rpx;
  padding: 30rpx 80rpx;
  background-color: #58cc02;
  border-radius: 16rpx;
}

.next-btn text {
  font-size: 32rpx;
  color: #fff;
}