/*pages/lesson/lesson.wxss*/
.container { min-height: 100vh; background: #F0F9FF; }

/* === STUDY MODE === */
.study-container { min-height: 100vh; display: flex; flex-direction: column; }
.study-header {
  display: flex; align-items: center; padding: 20rpx 28rpx;
  background: linear-gradient(135deg, #0EA5E9, #38BDF8); gap: 16rpx;
  flex-shrink: 0;
}
.exit-btn { font-size: 28rpx; color: #fff; flex-shrink: 0; padding: 8rpx 0; }
.study-title { flex: 1; font-size: 32rpx; font-weight: bold; color: #fff; text-align: center; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.level-tag { font-size: 22rpx; color: rgba(255,255,255,0.8); background: rgba(255,255,255,0.2); padding: 6rpx 16rpx; border-radius: 20rpx; }

.study-body { flex: 1; padding: 24rpx 28rpx 40rpx; }

.study-section { margin-bottom: 32rpx; }
.section-title { font-size: 30rpx; font-weight: bold; color: #0EA5E9; display: block; margin-bottom: 16rpx; padding-left: 8rpx; border-left: 5rpx solid #0EA5E9; }

.study-word-card {
  background: #fff; border-radius: 16rpx; padding: 24rpx 28rpx; margin-bottom: 14rpx;
  box-shadow: 0 2rpx 8rpx rgba(14,165,233,0.04); border-left: 5rpx solid #38BDF8;
}
.sw-jp { font-size: 34rpx; font-weight: bold; color: #0F172A; }
.sw-reading { font-size: 26rpx; color: #64748B; margin-top: 4rpx; }
.sw-meaning { font-size: 28rpx; color: #475569; margin-top: 8rpx; }
.sw-example { font-size: 26rpx; color: #64748B; margin-top: 10rpx; padding: 10rpx 16rpx; background: #F0F9FF; border-radius: 8rpx; }
.sw-ex-cn { font-size: 24rpx; color: #94A3B8; margin-top: 4rpx; padding-left: 16rpx; }

.study-grammar-card {
  background: #fff; border-radius: 16rpx; padding: 24rpx 28rpx; margin-bottom: 14rpx;
  box-shadow: 0 2rpx 8rpx rgba(14,165,233,0.04);
}
.sg-pattern { font-size: 32rpx; font-weight: bold; color: #F59E0B; display: block; }
.sg-structure { font-size: 26rpx; color: #64748B; display: block; margin-top: 8rpx; background: #FFF7ED; padding: 10rpx 16rpx; border-radius: 8rpx; }
.sg-explain { font-size: 26rpx; color: #475569; display: block; margin-top: 10rpx; line-height: 1.7; }
.sg-example { margin-top: 10rpx; padding: 14rpx 18rpx; background: #F0F9FF; border-radius: 10rpx; font-size: 26rpx; }
.sg-trans { display: block; font-size: 24rpx; color: #94A3B8; margin-top: 6rpx; }

.text-block { background: #fff; border-radius: 16rpx; padding: 24rpx 28rpx; }
.text-name { font-size: 34rpx; font-weight: bold; color: #0F172A; text-align: center; display: block; margin-bottom: 20rpx; }
.dialogue-row { margin-bottom: 16rpx; }
.dr-speaker { font-weight: bold; color: #F59E0B; font-size: 28rpx; }
.dr-jp { display: block; font-size: 32rpx; color: #0F172A; margin-top: 6rpx; }
.dr-cn { display: block; font-size: 26rpx; color: #94A3B8; margin-top: 4rpx; }

.start-quiz-bar { padding: 40rpx 0 20rpx; text-align: center; }
.start-quiz-btn {
  display: inline-block; padding: 28rpx 80rpx;
  background: linear-gradient(135deg, #0EA5E9, #38BDF8); border-radius: 24rpx;
  color: #fff; font-size: 34rpx; font-weight: bold;
  box-shadow: 0 8rpx 24rpx rgba(14,165,233,0.3);
}

/* === QUIZ MODE === */
.quiz-container { min-height: 100vh; }
.quiz-header {
  display: flex; align-items: center; padding: 20rpx 28rpx;
  background: #fff; border-bottom: 1rpx solid #E0F2FE; gap: 20rpx;
}
.quiz-header .exit-btn { color: #64748B; }
.progress-wrap { flex: 1; }
.progress-bar { height: 14rpx; background: #E0F2FE; border-radius: 7rpx; overflow: hidden; }
.progress-fill { height: 100%; background: linear-gradient(90deg, #0EA5E9, #38BDF8); border-radius: 7rpx; transition: width 0.3s; }
.lives { width: 60rpx; text-align: center; font-size: 26rpx; color: #F59E0B; font-weight: bold; }

.quiz-body { padding: 48rpx 36rpx; }
.question-prompt { font-size: 38rpx; font-weight: bold; color: #0F172A; line-height: 1.7; text-align: center; margin-bottom: 48rpx; white-space: pre-wrap; }
.audio-btn-big { width: 128rpx; height: 128rpx; border-radius: 50%; background: #E0F2FE; display: flex; align-items: center; justify-content: center; margin: 24rpx auto 48rpx; box-shadow: 0 4rpx 16rpx rgba(14,165,233,0.15); }
.audio-icon { font-size: 52rpx; }

.options-list { display: flex; flex-direction: column; gap: 24rpx; }
.option-btn { display: flex; align-items: center; padding: 28rpx 32rpx; border-radius: 20rpx; border: 3rpx solid #E0F2FE; background: #fff; transition: all 0.15s; box-shadow: 0 2rpx 8rpx rgba(14,165,233,0.04); }
.option-btn.correct { background: #F0FDF4; border-color: #22C55E; }
.option-btn.wrong { background: #FFF1F1; border-color: #EF4444; }
.option-badge { width: 60rpx; height: 60rpx; border-radius: 50%; background: #F1F5F9; color: #64748B; font-size: 28rpx; font-weight: bold; display: flex; align-items: center; justify-content: center; margin-right: 24rpx; flex-shrink: 0; }
.option-btn.correct .option-badge { background: #22C55E; color: #fff; }
.option-btn.wrong .option-badge { background: #EF4444; color: #fff; }
.option-text { flex: 1; font-size: 32rpx; color: #0F172A; line-height: 1.4; }

.fill-section { margin-top: 24rpx; }
.fill-hint { font-size: 26rpx; color: #64748B; text-align: center; margin-bottom: 28rpx; }
.fill-input { border: 3rpx solid #0EA5E9; border-radius: 16rpx; padding: 28rpx 32rpx; height: 106rpx; font-size: 36rpx; text-align: center; width: 100%; box-sizing: border-box; background: #fff; box-shadow: 0 4rpx 16rpx rgba(14,165,233,0.1); }
.fill-submit { margin-top: 32rpx; padding: 28rpx; background: linear-gradient(135deg, #0EA5E9, #38BDF8); border-radius: 20rpx; color: #fff; font-size: 32rpx; font-weight: bold; text-align: center; box-shadow: 0 6rpx 20rpx rgba(14,165,233,0.25); }

.result-bar { padding: 48rpx; text-align: center; }
.result-correct { color: #22C55E; }
.result-wrong { color: #EF4444; }
.result-big { font-size: 72rpx; display: block; }
.result-sub { font-size: 30rpx; margin-top: 12rpx; display: block; }
.next-btn { margin-top: 48rpx; padding: 28rpx 88rpx; background: linear-gradient(135deg, #0EA5E9, #38BDF8); border-radius: 24rpx; color: #fff; font-size: 32rpx; font-weight: bold; display: inline-block; box-shadow: 0 6rpx 20rpx rgba(14,165,233,0.25); }

.empty-state { padding: 120rpx 40rpx; text-align: center; color: #94A3B8; font-size: 30rpx; }
.btn-exit { display: inline-block; padding: 28rpx 60rpx; background: #F1F5F9; border-radius: 20rpx; color: #64748B; font-size: 30rpx; text-align: center; }

.complete-screen { min-height: 100vh; display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg, #0EA5E9, #38BDF8, #7DD3FC); }
.complete-card { text-align: center; background: #fff; border-radius: 32rpx; padding: 64rpx 56rpx; width: 580rpx; box-shadow: 0 20rpx 60rpx rgba(14,165,233,0.2); }
.complete-icon { width: 128rpx; height: 128rpx; border-radius: 50%; background: linear-gradient(135deg, #FFD700, #F59E0B); color: #fff; font-size: 60rpx; font-weight: bold; line-height: 128rpx; text-align: center; margin: 0 auto 28rpx; box-shadow: 0 8rpx 24rpx rgba(245,158,11,0.3); }
.complete-title { font-size: 40rpx; font-weight: bold; color: #0F172A; display: block; }
.complete-score { font-size: 64rpx; font-weight: bold; color: #0EA5E9; display: block; margin-top: 12rpx; }
.complete-xp { font-size: 34rpx; color: #F59E0B; font-weight: bold; display: block; margin-top: 8rpx; }
.complete-btns { display: flex; gap: 24rpx; margin-top: 48rpx; }
.btn-retry { flex: 1; padding: 28rpx; background: linear-gradient(135deg, #0EA5E9, #38BDF8); border-radius: 20rpx; color: #fff; font-size: 30rpx; font-weight: bold; text-align: center; box-shadow: 0 6rpx 20rpx rgba(14,165,233,0.25); }
