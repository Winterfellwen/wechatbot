/*pages/lesson/lesson.wxss - UI/UX Pro Max 统一版*/
/* 设计系统: learn 页面为基准 */
/* 主色: #2563EB | 背景: #F8FAFC | 边框: #E2E8F0 */

.container { 
  min-height: 100vh; 
  background: #F8FAFC; 
}

/* 隐藏的 Canvas */
.icon-canvas-hidden {
  position: fixed;
  left: -9999px;
  top: -9999px;
  width: 128px;
  height: 128px;
}

/* ========== STUDY MODE ========== */
.study-container { 
  min-height: 100vh; 
  display: flex; 
  flex-direction: column; 
}

.study-header {
  display: flex; 
  align-items: center; 
  padding: 24rpx 28rpx;
  background: linear-gradient(135deg, #2563EB 0%, #3B82F6 100%);
  gap: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(37,99,235,0.25);
}
.exit-btn { 
  font-size: 30rpx; 
  color: #fff; 
  flex-shrink: 0; 
  padding: 10rpx 0; 
  font-weight: 500;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  cursor: pointer;
}
.title-wrap { 
  flex: 1; 
  display: flex; 
  flex-direction: column; 
  align-items: center; 
}
.study-title { 
  font-size: 34rpx; 
  font-weight: bold; 
  color: #fff; 
  text-align: center; 
}
.study-subtitle { 
  font-size: 24rpx; 
  color: rgba(255,255,255,0.8); 
  text-align: center; 
  margin-top: 4rpx; 
}
.level-tag { 
  font-size: 22rpx; 
  color: rgba(255,255,255,0.9); 
  background: rgba(255,255,255,0.2); 
  padding: 8rpx 18rpx; 
  border-radius: 20rpx; 
  font-weight: 500;
  min-height: 88rpx;
  display: flex;
  align-items: center;
}

.study-body { 
  flex: 1; 
  padding: 24rpx 28rpx 160rpx; 
}

.study-section { 
  margin-bottom: 32rpx; 
}
.section-title { 
  font-size: 32rpx; 
  font-weight: bold; 
  color: #2563EB; 
  display: block; 
  margin-bottom: 18rpx; 
  padding-left: 12rpx; 
  border-left: 6rpx solid #2563EB; 
}

.study-word-card {
  background: #fff; 
  border-radius: 24rpx; 
  padding: 26rpx 30rpx; 
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.04);
  border: 3rpx solid #E2E8F0;
  transition: all 0.2s ease;
  cursor: pointer;
}
.study-word-card:active { transform: scale(0.98); }

.word-main-row { 
  display: flex; 
  justify-content: space-between; 
  align-items: center; 
  min-height: 88rpx;
}
.word-content { 
  flex: 1; 
}
.sw-jp { 
  font-size: 36rpx; 
  font-weight: bold; 
  color: #1E293B; 
}
.sw-meaning { 
  font-size: 30rpx; 
  color: #475569; 
  margin-top: 10rpx; 
  font-weight: 500; 
}
.expand-btn {
  padding: 8rpx; 
  flex-shrink: 0;
  margin-right: 32rpx;
  min-width: 88rpx;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
}
.expand-btn .arrow { 
  font-size: 40rpx; 
  color: #94A3B8; 
  transition: transform 0.2s; 
}
.expand-btn .arrow.up { transform: rotate(180deg); }
.word-extra { 
  margin-top: 16rpx; 
  padding-top: 16rpx; 
  border-top: 1rpx solid #E2E8F0; 
}
.sw-reading { 
  font-size: 28rpx; 
  color: #64748B; 
  margin-top: 6rpx; 
}
.sw-example { 
  font-size: 28rpx; 
  color: #2563EB; 
  margin-top: 12rpx; 
  padding: 12rpx 18rpx; 
  background: #EFF6FF; 
  border-radius: 12rpx; 
  display: flex; 
  align-items: center; 
  gap: 8rpx; 
  font-weight: 500;
  cursor: pointer;
}
.sw-ex-cn { 
  font-size: 24rpx; 
  color: #94A3B8; 
  margin-top: 6rpx; 
  padding-left: 18rpx; 
}

.study-grammar-card {
  background: #fff; 
  border-radius: 24rpx; 
  padding: 26rpx 30rpx; 
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.04);
  border: 3rpx solid #E2E8F0;
}
.sg-pattern { 
  font-size: 34rpx; 
  font-weight: bold; 
  color: #F59E0B; 
  display: block; 
}
.sg-structure { 
  font-size: 28rpx; 
  color: #64748B; 
  display: block; 
  margin-top: 10rpx; 
  background: #FFFBEB; 
  padding: 12rpx 18rpx; 
  border-radius: 12rpx; 
  font-weight: 500; 
}
.sg-explain { 
  font-size: 28rpx; 
  color: #475569; 
  display: block; 
  margin-top: 12rpx; 
  line-height: 1.7; 
}
.sg-example { 
  margin-top: 12rpx; 
  padding: 16rpx 20rpx; 
  background: #EFF6FF; 
  border-radius: 12rpx; 
  font-size: 28rpx; 
}
.sg-trans { 
  display: block; 
  font-size: 26rpx; 
  color: #94A3B8; 
  margin-top: 8rpx; 
}

.text-block { 
  background: #fff; 
  border-radius: 24rpx; 
  padding: 26rpx 30rpx; 
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.04);
  border: 3rpx solid #E2E8F0;
}
.text-name { 
  font-size: 36rpx; 
  font-weight: bold; 
  color: #1E293B; 
  text-align: center; 
  display: block; 
  margin-bottom: 24rpx; 
}
.dialogue-row { 
  margin-bottom: 18rpx; 
}
.dr-speaker { 
  font-weight: bold; 
  color: #F59E0B; 
  font-size: 30rpx; 
}
.dr-jp { 
  display: block; 
  font-size: 34rpx; 
  color: #1E293B; 
  margin-top: 8rpx; 
}
.dr-cn { 
  display: block; 
  font-size: 28rpx; 
  color: #94A3B8; 
  margin-top: 6rpx; 
}

.start-quiz-bar { 
  position: fixed; 
  bottom: 0; 
  left: 0; 
  right: 0; 
  padding: 40rpx 28rpx; 
  text-align: center;
  background: rgba(255,255,255,0.95);
  backdrop-filter: blur(20px);
  box-shadow: 0 -4rpx 24rpx rgba(0,0,0,0.06);
}
.start-quiz-btn {
  display: inline-block; 
  padding: 30rpx 100rpx;
  background: linear-gradient(135deg, #2563EB 0%, #3B82F6 100%);
  border-radius: 28rpx;
  color: #fff; 
  font-size: 36rpx; 
  font-weight: bold;
  box-shadow: 0 8rpx 24rpx rgba(37,99,235,0.35);
  transition: all 0.2s;
  cursor: pointer;
  min-height: 88rpx;
}
.start-quiz-btn:active { 
  transform: scale(0.98); 
  box-shadow: 0 4rpx 16rpx rgba(37,99,235,0.3); 
}

/* ========== QUIZ MODE ========== */
.quiz-container { 
  min-height: 100vh; 
  background: #F8FAFC; 
}
.quiz-header {
  display: flex; 
  align-items: center; 
  padding: 22rpx 28rpx;
  background: #fff;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
  gap: 20rpx;
}
.quiz-header .exit-btn { color: #64748B; }
.progress-wrap { flex: 1; }
.progress-bar { 
  height: 16rpx; 
  background: #E2E8F0; 
  border-radius: 8rpx; 
  overflow: hidden; 
}
.progress-fill { 
  height: 100%; 
  background: linear-gradient(90deg, #2563EB, #3B82F6); 
  border-radius: 8rpx; 
  transition: width 0.4s ease; 
}
.lives { 
  width: 80rpx; 
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center; 
  font-size: 28rpx; 
  color: #F59E0B; 
  font-weight: bold;
  cursor: pointer;
}

.quiz-body { 
  padding: 48rpx 36rpx; 
}
.question-prompt { 
  font-size: 40rpx; 
  font-weight: bold; 
  color: #1E293B; 
  line-height: 1.7; 
  text-align: center; 
  margin-bottom: 48rpx; 
  white-space: pre-wrap; 
}
.audio-btn-big { 
  width: 140rpx; 
  height: 140rpx; 
  border-radius: 50%; 
  background: linear-gradient(135deg, #EFF6FF 0%, #DBEAFE 100%); 
  display: flex; 
  align-items: center; 
  justify-content: center; 
  margin: 24rpx auto 48rpx; 
  box-shadow: 0 8rpx 24rpx rgba(37,99,235,0.2); 
  transition: all 0.2s;
  cursor: pointer;
  min-width: 88rpx;
  min-height: 88rpx;
}
.audio-btn-big:active { transform: scale(0.95); }
.audio-btn-big.playing {
  background: linear-gradient(135deg, #2563EB 0%, #3B82F6 100%);
  box-shadow: 0 8rpx 24rpx rgba(37,99,235,0.35);
}

/* 扬声器图标 - 小号（例句用） */
.audio-indicator {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
}

.speaker-img {
  width: 32rpx;
  height: 32rpx;
}

/* 扬声器图标 - 大号（听力题用） */
.audio-btn-big.playing {
  background: linear-gradient(135deg, #2563EB 0%, #3B82F6 100%);
  box-shadow: 0 8rpx 24rpx rgba(37,99,235,0.35);
  animation: audioPulse 1s ease-in-out infinite;
}

@keyframes audioPulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.08); }
}

.speaker-img-lg {
  width: 64rpx;
  height: 64rpx;
}

@keyframes pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.2); }
}

.options-list { 
  display: flex; 
  flex-direction: column; 
  gap: 20rpx; 
}
.option-btn { 
  display: flex; 
  align-items: center; 
  padding: 28rpx 34rpx; 
  border-radius: 24rpx; 
  border: 3rpx solid #E2E8F0; 
  background: #fff; 
  transition: all 0.2s;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.04);
  cursor: pointer;
  min-height: 88rpx;
}
.option-btn:active { transform: scale(0.98); }
.option-btn.correct { 
  background: #F0FDF4; 
  border-color: #22C55E; 
  box-shadow: 0 4rpx 20rpx rgba(34,197,94,0.15);
}
.option-btn.wrong { 
  background: #FEF2F2; 
  border-color: #EF4444; 
  box-shadow: 0 4rpx 20rpx rgba(239,68,68,0.15);
}
.option-badge { 
  width: 64rpx; 
  height: 64rpx; 
  border-radius: 50%; 
  background: #F1F5F9; 
  color: #64748B; 
  font-size: 30rpx; 
  font-weight: bold; 
  display: flex; 
  align-items: center; 
  justify-content: center; 
  margin-right: 24rpx; 
  flex-shrink: 0; 
}
.option-btn.correct .option-badge { 
  background: #22C55E; 
  color: #fff; 
  box-shadow: 0 4rpx 12rpx rgba(34,197,94,0.3); 
}
.option-btn.wrong .option-badge { 
  background: #EF4444; 
  color: #fff; 
  box-shadow: 0 4rpx 12rpx rgba(239,68,68,0.3); 
}
.option-text { 
  flex: 1; 
  font-size: 34rpx; 
  color: #1E293B; 
  line-height: 1.4; 
  font-weight: 500; 
}

.fill-hint { 
  font-size: 28rpx; 
  color: #64748B; 
  margin-bottom: 16rpx; 
  padding: 12rpx 20rpx; 
  background: #F1F5F9; 
  border-radius: 12rpx; 
  display: block; 
}
.fill-input {
  width: 100%; 
  padding: 0 28rpx; 
  border-radius: 24rpx; 
  border: 3rpx solid #E2E8F0;
  background: #fff; 
  font-size: 36rpx; 
  line-height: 100rpx; 
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.04);
  box-sizing: border-box; 
  height: 100rpx;
}
.fill-input:focus { border-color: #2563EB; }

.fill-submit { 
  display: flex; 
  align-items: center; 
  justify-content: center; 
  height: 100rpx; 
  background: linear-gradient(135deg, #2563EB 0%, #3B82F6 100%); 
  color: #fff; 
  border: none; 
  border-radius: 24rpx; 
  font-size: 34rpx; 
  font-weight: bold; 
  box-shadow: 0 6rpx 20rpx rgba(37,99,235,0.35);
  margin-top: 24rpx;
  cursor: pointer;
  min-height: 88rpx;
}
.fill-submit:active { transform: scale(0.98); }

/* ========== RESULT & COMPLETE ========== */
.result-bar { 
  display: flex; 
  flex-direction: column; 
  align-items: center; 
  gap: 24rpx; 
  margin-top: 32rpx; 
  width: 100%; 
}
.result-card { 
  width: 100%; 
  padding: 32rpx; 
  border-radius: 24rpx; 
  text-align: center; 
  animation: slideUp 0.4s ease-out; 
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.1); 
}
.result-correct { 
  background: linear-gradient(135deg, #22C55E 0%, #16A34A 100%); 
}
.result-wrong { 
  background: linear-gradient(135deg, #EF4444 0%, #DC2626 100%); 
}
.result-icon-wrap { 
  width: 100rpx; 
  height: 100rpx; 
  border-radius: 50%; 
  background: rgba(255,255,255,0.25); 
  display: flex; 
  align-items: center; 
  justify-content: center; 
  margin: 0 auto 20rpx; 
}
.result-icon { 
  font-size: 52rpx; 
  color: #fff; 
  font-weight: bold; 
}
.result-msg { 
  display: block; 
  font-size: 36rpx; 
  font-weight: bold; 
  color: #fff; 
  margin-bottom: 12rpx; 
}
.result-combo { 
  display: inline-block; 
  font-size: 28rpx; 
  color: #FDE047; 
  font-weight: bold; 
  background: rgba(0,0,0,0.15); 
  padding: 8rpx 24rpx; 
  border-radius: 20rpx; 
  margin-bottom: 16rpx; 
}
.answer-box { 
  display: inline-flex; 
  align-items: center; 
  gap: 10rpx; 
  padding: 16rpx 28rpx; 
  background: rgba(255,255,255,0.2); 
  border-radius: 16rpx; 
  margin-top: 16rpx; 
  border: 2rpx solid rgba(255,255,255,0.3); 
}
.answer-label { 
  font-size: 26rpx; 
  color: rgba(255,255,255,0.9); 
}
.answer-value { 
  font-size: 32rpx; 
  color: #fff; 
  font-weight: bold; 
}

.next-btn { 
  display: inline-flex; 
  align-items: center; 
  justify-content: center; 
  gap: 10rpx; 
  padding: 20rpx 48rpx; 
  border-radius: 40rpx; 
  background: linear-gradient(135deg, #2563EB 0%, #3B82F6 100%); 
  color: #fff; 
  font-size: 30rpx; 
  font-weight: bold; 
  box-shadow: 0 6rpx 16rpx rgba(37,99,235,0.35); 
  transition: all 0.2s;
  cursor: pointer;
  min-height: 88rpx;
}
.next-btn:active { transform: scale(0.96); }
.next-text { }

/* ========== COMPLETE SCREEN ========== */
.complete-screen {
  min-height: 100vh;
  background: #F8FAFC;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}
.complete-card { 
  background: #fff; 
  border-radius: 28rpx; 
  padding: 50rpx; 
  text-align: center; 
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.08);
  border: 3rpx solid #E2E8F0;
  width: 100%;
}
.complete-stars { 
  margin-bottom: 20rpx; 
  display: flex; 
  justify-content: center; 
  gap: 8rpx; 
}
.complete-stars .star { 
  font-size: 48rpx; 
  line-height: 1; 
}
.complete-stars .star.full { color: #F59E0B; }
.complete-stars .star.half { color: #F59E0B; opacity: 0.5; }
.complete-stars .star.empty { color: #E2E8F0; }

.complete-title { 
  font-size: 44rpx; 
  font-weight: bold; 
  color: #1E293B; 
  display: block; 
  margin-bottom: 20rpx; 
}
.complete-score {
  font-size: 32rpx;
  color: #64748B;
  display: block;
  margin-bottom: 12rpx;
}
.complete-xp { 
  font-size: 32rpx; 
  color: #F59E0B; 
  font-weight: bold; 
  display: block; 
  margin-bottom: 30rpx; 
}
.complete-btns { 
  display: flex; 
  gap: 20rpx; 
  justify-content: center; 
  margin-top: 20rpx; 
}
.complete-btn { 
  padding: 24rpx 48rpx; 
  border-radius: 24rpx; 
  font-size: 32rpx; 
  font-weight: bold;
  transition: all 0.2s;
  cursor: pointer;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.complete-btn:active { transform: scale(0.98); }
.btn-primary { 
  background: linear-gradient(135deg, #2563EB 0%, #3B82F6 100%);
  color: #fff; 
  box-shadow: 0 6rpx 20rpx rgba(37,99,235,0.35);
}
.btn-secondary { 
  background: #F1F5F9; 
  color: #64748B;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.06);
}

/* ========== EMPTY STATE ========== */
.empty-state {
  min-height: 100vh;
  background: #F8FAFC;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.empty-state text {
  font-size: 32rpx;
  color: #64748B;
}
.btn-exit {
  padding: 20rpx 60rpx;
  background: linear-gradient(135deg, #2563EB 0%, #3B82F6 100%);
  color: #fff;
  border-radius: 24rpx;
  font-size: 32rpx;
  font-weight: bold;
  cursor: pointer;
  margin-top: 30rpx;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ========== ANIMATIONS ========== */
@keyframes slideUp {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes shake {
  0%, 100% { transform: translateX(0); }
  10%, 30%, 50%, 70%, 90% { transform: translateX(-10rpx); }
  20%, 40%, 60%, 80% { transform: translateX(10rpx); }
}
.shake-anim { animation: shake 0.5s ease-in-out; }

@keyframes firework {
  0% { transform: scale(0); opacity: 1; }
  50% { transform: scale(3); opacity: 0.8; }
  100% { transform: scale(5); opacity: 0; }
}
.firework-overlay { 
  position: fixed; 
  top: 0; 
  left: 0; 
  right: 0; 
  bottom: 0; 
  pointer-events: none; 
  z-index: 1000; 
  overflow: hidden; 
}
.firework { 
  position: absolute; 
  width: 20rpx; 
  height: 20rpx; 
  border-radius: 50%; 
  animation: firework 1s ease-out forwards; 
}
