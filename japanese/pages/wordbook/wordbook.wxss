/*pages/wordbook/wordbook.wxss - UI/UX Pro Max 统一版*/
/* 设计系统: learn 页面为基准 */
/* 主色: #2563EB | 背景: #F8FAFC | 边框: #E2E8F0 */

.container { 
  min-height: 100vh; 
  background: #F8FAFC; 
}

/* ========== 顶部导航栏 ========== */
.header { 
  padding: 24rpx 30rpx; 
  background: #fff; 
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.04);
}
.header-row { 
  display: flex; 
  align-items: center; 
  justify-content: space-between; 
}
.back-btn { 
  width: 88rpx; 
  height: 88rpx; 
  display: flex; 
  align-items: center; 
  justify-content: center; 
  cursor: pointer;
  border-radius: 50%;
  transition: background 0.2s;
}
.back-btn:active { background: #F1F5F9; }
.back-icon {
  font-size: 44rpx;
  color: #2563EB;
  font-weight: bold;
}

.back-icon-img {
  width: 44rpx;
  height: 44rpx;
}
.header-title { 
  font-size: 38rpx; 
  font-weight: bold; 
  color: #1E293B; 
}
.header-placeholder { 
  width: 88rpx; 
}

/* ========== 搜索栏 ========== */
.search-bar { 
  padding: 22rpx; 
  background: #fff; 
  position: relative; 
}
.search-input { 
  height: 88rpx; 
  background: #F1F5F9; 
  border-radius: 44rpx; 
  padding: 0 64rpx 0 48rpx; 
  font-size: 30rpx; 
  border: 3rpx solid #E2E8F0;
  transition: border-color 0.2s;
}
.search-input:focus { border-color: #2563EB; }
.clear-btn { 
  position: absolute; 
  right: 44rpx; 
  top: 50%; 
  transform: translateY(-50%); 
  width: 52rpx; 
  height: 52rpx; 
  line-height: 48rpx; 
  text-align: center; 
  font-size: 40rpx; 
  color: #94A3B8; 
  cursor: pointer;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ========== 统计卡片 ========== */
.stats-bar {
  display: flex; 
  padding: 36rpx; 
  margin: 24rpx; 
  background: linear-gradient(135deg, #2563EB 0%, #3B82F6 100%);
  border-radius: 24rpx; 
  box-shadow: 0 8rpx 24rpx rgba(37,99,235,0.25);
}
.stat-item { 
  flex: 1; 
  text-align: center; 
}
.stat-divider { 
  border-left: 2rpx solid rgba(255,255,255,0.3); 
  border-right: 2rpx solid rgba(255,255,255,0.3); 
}
.stat-num { 
  display: block; 
  font-size: 48rpx; 
  font-weight: bold; 
  color: #fff; 
}
.stat-label { 
  display: block; 
  font-size: 28rpx; 
  color: rgba(255,255,255,0.9); 
  margin-top: 8rpx; 
}

/* ========== 单词列表 ========== */
.word-list { 
  padding: 0 24rpx; 
  height: calc(100vh - 400rpx); 
}

.word-card { 
  display: flex; 
  align-items: flex-start; 
  background: #fff; 
  border-radius: 24rpx; 
  padding: 30rpx; 
  margin-bottom: 20rpx; 
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.04);
  border: 3rpx solid #E2E8F0;
  transition: all 0.2s ease; 
  cursor: pointer; 
}
.word-card:active { transform: scale(0.99); }
.word-main { 
  flex: 1; 
}
.word-row { 
  display: flex; 
  align-items: center; 
  flex-wrap: wrap; 
}
.word-japanese { 
  font-size: 40rpx; 
  font-weight: bold; 
  color: #1E293B; 
  display: flex; 
  align-items: center; 
  gap: 10rpx; 
}
.word-reading { 
  font-size: 28rpx; 
  color: #64748B; 
  margin-left: 16rpx; 
}
.word-meaning { 
  font-size: 32rpx; 
  color: #475569; 
  margin-top: 12rpx; 
  font-weight: 500; 
}

.word-example { 
  margin-top: 16rpx; 
  padding: 16rpx 20rpx; 
  background: #EFF6FF; 
  border-radius: 16rpx; 
  border-left: 6rpx solid #2563EB; 
}
.example-jp { 
  font-size: 28rpx; 
  color: #475569; 
  display: block; 
}
.example-cn { 
  font-size: 26rpx; 
  color: #94A3B8; 
  display: block; 
  margin-top: 6rpx; 
}

.word-star { 
  width: 88rpx; 
  height: 88rpx; 
  display: flex; 
  align-items: center; 
  justify-content: center; 
  flex-shrink: 0; 
  margin-left: 20rpx; 
  cursor: pointer;
  border-radius: 50%;
  transition: background 0.2s;
}
.word-star:active { background: #F1F5F9; }
.star-icon { 
  font-size: 44rpx; 
  color: #CBD5E1; 
  transition: all 0.2s ease; 
}
.word-star.starred .star-icon { 
  color: #F59E0B; 
  text-shadow: 0 2rpx 8rpx rgba(245,158,11,0.4); 
}
.star-icon.active { 
  transform: scale(1.1); 
}
