/*pages/wordbook/wordbook.wxss*/
.container { min-height: 100vh; background: linear-gradient(180deg, #e8f4ff 0%, #f5f5f5 100%); padding-bottom: 20rpx; }

.header { padding: 24rpx 30rpx; background: #fff; box-shadow: 0 4rpx 16rpx rgba(14,165,233,0.08); }
.header-row { display: flex; align-items: center; justify-content: space-between; }
.back-btn { width: 64rpx; height: 64rpx; display: flex; align-items: center; justify-content: center; cursor: pointer; }
.back-icon { font-size: 44rpx; color: #0EA5E9; font-weight: bold; }
.header-title { font-size: 38rpx; font-weight: bold; color: #0F172A; }
.header-placeholder { width: 64rpx; }

.search-bar { padding: 22rpx; background: #fff; position: relative; margin-bottom: 2rpx; }
.search-input { height: 80rpx; background: #f0f9ff; border-radius: 44rpx; padding: 0 64rpx 0 48rpx; font-size: 30rpx; border: 2rpx solid #e0f2fe; }
.clear-btn { position: absolute; right: 44rpx; top: 50%; transform: translateY(-50%); width: 52rpx; height: 52rpx; line-height: 48rpx; text-align: center; font-size: 40rpx; color: #94A3B8; cursor: pointer; }

.stats-bar {
  display: flex; padding: 36rpx; margin: 24rpx; background: linear-gradient(135deg, #0EA5E9 0%, #38BDF8 100%);
  border-radius: 22rpx; box-shadow: 0 8rpx 24rpx rgba(14,165,233,0.25);
}
.stat-item { flex: 1; text-align: center; }
.stat-divider { border-left: 2rpx solid rgba(255,255,255,0.3); border-right: 2rpx solid rgba(255,255,255,0.3); }
.stat-num { display: block; font-size: 48rpx; font-weight: bold; color: #fff; }
.stat-label { display: block; font-size: 28rpx; color: rgba(255,255,255,0.9); margin-top: 8rpx; }

.word-list { padding: 0 24rpx; height: calc(100vh - 380rpx); }

.word-card { display: flex; align-items: flex-start; background: #fff; border-radius: 22rpx; padding: 30rpx; margin-bottom: 20rpx; box-shadow: 0 4rpx 14rpx rgba(14,165,233,0.08); transition: all 0.2s ease; cursor: pointer; }
.word-card:active { transform: scale(0.99); }
.word-main { flex: 1; }
.word-row { display: flex; align-items: center; flex-wrap: wrap; }
.word-japanese { font-size: 40rpx; font-weight: bold; color: #0F172A; display: flex; align-items: center; gap: 10rpx; }
.word-reading { font-size: 28rpx; color: #64748B; margin-left: 16rpx; }
.word-meaning { font-size: 32rpx; color: #475569; margin-top: 12rpx; font-weight: 500; }

.word-example { margin-top: 16rpx; padding: 16rpx 20rpx; background: #f0f9ff; border-radius: 14rpx; border-left: 6rpx solid #0EA5E9; }
.example-jp { font-size: 28rpx; color: #475569; display: block; }
.example-cn { font-size: 26rpx; color: #94A3B8; display: block; margin-top: 6rpx; }

.word-star { width: 68rpx; height: 68rpx; display: flex; align-items: center; justify-content: center; flex-shrink: 0; margin-left: 20rpx; cursor: pointer; }
.star-icon { font-size: 44rpx; color: #CBD5E1; transition: all 0.2s ease; }
.word-star.starred .star-icon { color: #F59E0B; text-shadow: 0 2rpx 8rpx rgba(245,158,11,0.4); }
.star-icon.active { transform: scale(1.1); }
