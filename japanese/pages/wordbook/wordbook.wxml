<!--pages/wordbook/wordbook.wxml-->
<view class="container">
  <!-- 搜索栏 -->
  <view class="search-bar">
    <input class="search-input" placeholder="搜索单词" bindinput="onSearch" value="{{searchKey}}" />
    <view wx:if="{{searchKey}}" class="clear-btn" bindtap="clearSearch">×</view>
  </view>

  <!-- 统计栏 -->
  <view class="stats-bar">
    <view class="stat-item">
      <text class="stat-num">{{totalWords}}</text>
      <text class="stat-label">总单词</text>
    </view>
    <view class="stat-item">
      <text class="stat-num">{{masteredWords}}</text>
      <text class="stat-label">已掌握</text>
    </view>
    <view class="stat-item">
      <text class="stat-num">{{learningWords}}</text>
      <text class="stat-label">学习中</text>
    </view>
  </view>

  <!-- 词表 -->
  <scroll-view scroll-y class="word-list">
    <block wx:for="{{filteredWords}}" wx:key="word">
      <view class="word-card" bindtap="playAudio" data-word="{{item.word}}">
        <view class="word-main">
          <view class="word-japanese">{{item.word}}</view>
          <view class="word-chinese">{{item.meaning}}</view>
          <view wx:if="{{item.reading}}" class="word-reading">[{{item.reading}}]</view>
        </view>
        <view class="word-actions">
          <view class="action-btn {{item.mastered ? 'mastered' : ''}}" catchtap="toggleMaster" data-word="{{item.word}}">
            {{item.mastered ? '✓' : '☆'}}
          </view>
        </view>
      </view>
    </block>
  </scroll-view>
</view>