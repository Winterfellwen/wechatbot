<!--pages/learn/learn.wxml-->
<view class="container">
  <view class="top-bar">
    <view class="level-badge">Lv.{{level}}</view>
    <view class="exp-bar-wrap">
      <view class="exp-bar">
        <view class="exp-fill" style="width: {{exp % 100}}%"></view>
      </view>
      <text class="exp-text">{{exp}} XP</text>
    </view>
    <view class="overall-circle">
      <text class="overall-pct">{{totalProgress}}%</text>
    </view>
  </view>
  <view class="level-bar">
    <picker mode="selector" range="{{levelOptions}}" value="{{selectedLevelIndex}}" bindchange="onLevelChange">
      <view class="level-picker">
        <text class="level-label">{{selectedLevel}}</text>
        <text class="picker-arrow">▼</text>
      </view>
    </picker>
  </view>

  <scroll-view scroll-y class="path-scroll" scroll-top="{{scrollTop}}" scroll-with-animation>
    <view class="path-container">
      <block wx:for="{{pathNodes}}" wx:key="id">
        <!-- Unit header -->
        <view wx:if="{{item.type === 'header'}}" class="unit-header">
          <view class="unit-title-row">
            <view class="unit-color-dot" style="background: {{item.color}}"></view>
            <text class="unit-title-text">{{item.label}}</text>
          </view>
          <text class="unit-count">{{item.lessonCount}} 课</text>
        </view>

        <!-- Lesson node -->
        <view wx:if="{{item.type === 'node'}}" class="path-row" id="node-{{item.id}}">
          <view class="node-wrap {{item.done ? 'done' : ''}} {{item.current ? 'current' : ''}} {{!item.done && !item.current ? 'locked' : ''}}"
                bindtap="startLesson" data-id="{{item.id}}">
            <view class="node-circle">
              <image wx:if="{{item.done}}" class="node-icon-img check-img" src="/images/icons/check-48-success.png" mode="aspectFit"></image>
              <image wx:if="{{!item.done && item.current}}" class="node-icon-img star-img" src="/images/icons/play-48-primary.png" mode="aspectFit"></image>
              <text wx:if="{{!item.done && !item.current}}" class="node-num">{{item.number}}</text>
            </view>
            <view class="node-info">
              <text class="node-title">{{item.title}}</text>
              <text class="node-meta" wx:if="{{item.words}}">{{item.words}}词 · {{item.grammar}}语法</text>
            </view>
            <view wx:if="{{item.jpScore > 0}}" class="jp-star-rating">
              <text wx:for="{{item.jpStarData.full}}" wx:for-item="star" wx:key="*this" class="jp-star full">★</text>
              <text wx:if="{{item.jpStarData.half}}" class="jp-star half">★</text>
              <text wx:for="{{item.jpStarData.empty}}" wx:for-item="star" wx:key="*this" class="jp-star empty">☆</text>
            </view>
          </view>
          <!-- Connector line (not for the last item) -->
          <view wx:if="{{index < pathNodes.length - 1}}" class="connector {{item.done ? 'conn-done' : ''}}"></view>
        </view>
      </block>
    </view>
  </scroll-view>

  <view class="bottom-nav">
    <view class="nav-item active">
      <view class="nav-icon-wrap nav-icon-active">
        <image class="nav-icon-img" src="/images/icons/swords-48-dark.png" mode="aspectFit"></image>
      </view>
      <text class="nav-text nav-text-active">闯关</text>
    </view>
    <view class="nav-item" bindtap="goToCourse">
      <view class="nav-icon-wrap">
        <image class="nav-icon-img" src="/images/icons/book-open-text-48-dark.png" mode="aspectFit"></image>
      </view>
      <text class="nav-text">课程</text>
    </view>
    <view class="nav-item" bindtap="goToRank">
      <view class="nav-icon-wrap">
        <image class="nav-icon-img" src="/images/icons/trophy-48-primary.png" mode="aspectFit"></image>
      </view>
      <text class="nav-text">排行榜</text>
    </view>
  </view>
</view>
