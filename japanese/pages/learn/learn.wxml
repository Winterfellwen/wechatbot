<!--pages/learn/learn.wxml-->
<view class="container">
  <view class="top-bar">
    <view class="level-badge">Lv.{{level}}</view>
    <view class="exp-bar-wrap">
      <view class="exp-bar">
        <view class="exp-fill" style="width: {{exp % 100}}%"></view>
      </view>
      <text class="exp-text">{{exp}} XP</text>
    </view>
  </view>

  <view class="unit-selector">
    <scroll-view scroll-x class="unit-scroll">
      <block wx:for="{{units}}" wx:key="id">
        <view class="unit-tab {{activeUnit === item.id ? 'active' : ''}}" bindtap="switchUnit" data-id="{{item.id}}" style="border-color: {{item.color}}">
          <view class="unit-name" style="color: {{item.color}}">{{item.name}}</view>
          <view class="unit-sub">{{item.subtitle}}</view>
          <view class="unit-progress-wrap">
            <view class="unit-bar"><view class="unit-bar-fill" style="width: {{item.progress}}%; background: {{item.color}}"></view></view>
            <text class="unit-pct">{{item.progress}}%</text>
          </view>
        </view>
      </block>
    </scroll-view>
  </view>

  <scroll-view scroll-y class="lesson-path">
    <block wx:for="{{units}}" wx:key="id" wx:for-item="unit">
      <view wx:if="{{activeUnit === unit.id}}" class="path-body">
        <block wx:for="{{unit.lessons}}" wx:key="id">
          <view class="path-row">
            <view class="path-node {{item.completed ? 'done' : ''}} {{item.active ? 'current' : ''}} {{!item.completed && !item.active ? 'locked' : ''}}"
                  bindtap="startLesson" data-id="{{item.id}}">
              <view class="node-circle">
                <text wx:if="{{item.completed}}" class="node-check">&#10003;</text>
                <text wx:elif="{{item.active}}" class="node-star">&#9733;</text>
                <text wx:else class="node-num">{{index + 1}}</text>
              </view>
              <view class="node-label">{{item.title}}</view>
            </view>
            <view wx:if="{{index < unit.lessons.length - 1}}" class="path-connector {{item.completed ? 'conn-done' : ''}}">
              <view class="conn-line"></view>
            </view>
          </view>
        </block>
      </view>
    </block>
  </scroll-view>

  <view class="bottom-nav">
    <view class="nav-item active"><text class="nav-text">闯关</text></view>
    <view class="nav-item" bindtap="goToCourse"><text class="nav-text">课程</text></view>
    <view class="nav-item" bindtap="goToAI"><text class="nav-text">智能老师</text></view>
    <view class="nav-item" bindtap="goToRank"><text class="nav-text">排行榜</text></view>
  </view>
</view>
