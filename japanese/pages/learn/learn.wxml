<!--pages/learn/learn.wxml-->
<view class="container">
  <view class="top-bar">
    <view class="level-badge">Lv.{{level}}</view>
    <view class="exp-bar-wrap">
      <view class="exp-bar">
        <view class="exp-fill" style="width: {{exp % 100}}%"></view>
      </view>
      <text class="exp-text">{{exp}} XP</text>
    </view>
    <view class="progress-circle">
      <text class="progress-text">{{overallProgress}}%</text>
    </view>
  </view>

  <view class="unit-selector">
    <scroll-view scroll-x class="unit-scroll">
      <block wx:for="{{units}}" wx:key="id">
        <view class="unit-tab {{activeUnit === item.id ? 'active' : ''}}" bindtap="switchUnit" data-id="{{item.id}}" style="background: {{item.color}}">
          <view class="unit-name">{{item.name}}</view>
          <view class="unit-sub">{{item.subtitle}}</view>
          <view wx:if="{{item.progress > 0}}" class="unit-bar"><view class="unit-bar-fill" style="width: {{item.progress}}%"></view></view>
        </view>
      </block>
    </scroll-view>
  </view>

  <scroll-view scroll-y class="lesson-path">
    <block wx:for="{{units}}" wx:key="id" wx:for-item="unit">
      <view wx:if="{{activeUnit === unit.id}}" class="path-column">
        <block wx:for="{{unit.lessons}}" wx:key="id">
          <view class="path-step {{item.completed ? 'completed' : ''}} {{item.active ? 'active' : ''}}" bindtap="startLesson" data-id="{{item.id}}">
            <view class="step-dot" style="background: {{item.completed ? '#58cc02' : (item.active ? '#ffd700' : '#e0e0e0')}}">
              <text wx:if="{{item.completed}}">✓</text>
              <text wx:elif="{{item.active}}"></text>
            </view>
            <view class="step-info">
              <text class="step-title">{{item.title}}</text>
              <text wx:if="{{item.completed}}" class="step-done">已完成</text>
            </view>
          </view>
          <view wx:if="{{index < unit.total - 1}}" class="path-line" style="background: {{item.completed ? '#58cc02' : '#e0e0e0'}}"></view>
        </block>
      </view>
    </block>
  </scroll-view>

  <view class="bottom-nav">
    <view class="nav-item active"><text class="nav-text">闯关</text></view>
    <view class="nav-item" bindtap="goToCourse"><text class="nav-text">课程</text></view>
    <view class="nav-item" bindtap="goToAI"><text class="nav-text">智能老师</text></view>
    <view class="nav-item" bindtap="goToRank"><text class="nav-text">排行榜</text></view>
  </view>
</view>
