/*pages/learn/learn.wxss*/
.container { min-height: 100vh; background: #fff; padding-bottom: 110rpx; }

.top-bar {
  display: flex; align-items: center; gap: 16rpx;
  padding: 20rpx 24rpx; background: #58cc02;
}
.level-badge {
  width: 80rpx; height: 80rpx; border-radius: 50%; background: rgba(255,255,255,0.2);
  color: #fff; font-size: 24rpx; font-weight: bold; text-align: center; line-height: 80rpx;
  flex-shrink: 0;
}
.exp-bar-wrap { flex: 1; }
.exp-bar { height: 14rpx; background: rgba(255,255,255,0.3); border-radius: 7rpx; overflow: hidden; }
.exp-fill { height: 100%; background: #ffd700; border-radius: 7rpx; transition: width 0.3s; }
.exp-text { font-size: 20rpx; color: #fff; margin-top: 4rpx; display: block; }

.unit-selector { padding: 16rpx 0; background: #f9f9f9; }
.unit-scroll { white-space: nowrap; display: flex; padding: 0 16rpx; }
.unit-tab {
  display: inline-flex; flex-direction: column; justify-content: center;
  min-width: 200rpx; padding: 20rpx 24rpx; margin: 0 8rpx;
  border-radius: 16rpx; background: #fff; border: 3rpx solid #e0e0e0;
  flex-shrink: 0;
}
.unit-tab.active { border-width: 3rpx; box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.08); }
.unit-name { font-size: 30rpx; font-weight: bold; }
.unit-sub { font-size: 22rpx; color: #999; margin-top: 4rpx; }
.unit-progress-wrap { display: flex; align-items: center; gap: 10rpx; margin-top: 10rpx; }
.unit-bar { flex: 1; height: 6rpx; background: #eee; border-radius: 3rpx; overflow: hidden; }
.unit-bar-fill { height: 100%; border-radius: 3rpx; transition: width 0.3s; }
.unit-pct { font-size: 20rpx; color: #bbb; }

.lesson-path { padding: 0; height: calc(100vh - 300rpx); }
.path-body { display: flex; flex-direction: column; padding: 30rpx; }

.path-row { display: flex; align-items: center; }
.path-node {
  flex-shrink: 0; width: 120rpx; display: flex; flex-direction: column; align-items: center;
  padding: 16rpx 8rpx;
}
.node-circle {
  width: 88rpx; height: 88rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  border: 5rpx solid #e0e0e0; background: #fff; font-size: 28rpx;
  font-weight: bold; color: #bbb;
}
.path-node.done .node-circle { border-color: #58cc02; background: #58cc02; }
.path-node.done .node-check { color: #fff; font-size: 36rpx; }
.path-node.current .node-circle { border-color: #ffd700; background: #fff; box-shadow: 0 0 0 8rpx rgba(255,215,0,0.15); }
.path-node.current .node-star { color: #ffd700; font-size: 32rpx; }
.path-node.locked .node-circle { border-color: #e8e8e8; background: #fafafa; }
.path-node.locked .node-num { color: #ddd; }
.node-label { font-size: 20rpx; color: #999; margin-top: 8rpx; text-align: center; line-height: 1.3; width: 140rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.path-connector { flex: 1; height: 40rpx; display: flex; align-items: center; padding: 0 8rpx; }
.conn-line { flex: 1; height: 5rpx; background: #e0e0e0; border-radius: 3rpx; }
.path-connector.conn-done .conn-line { background: #58cc02; }

.bottom-nav {
  position: fixed; bottom: 0; left: 0; right: 0; display: flex;
  background: #fff; box-shadow: 0 -2rpx 16rpx rgba(0,0,0,0.08);
}
.nav-item { flex: 1; padding: 16rpx 0; text-align: center; }
.nav-text { font-size: 22rpx; color: #999; }
.nav-item.active .nav-text { color: #58cc02; font-weight: bold; }
