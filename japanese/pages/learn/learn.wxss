/*pages/learn/learn.wxss*/
.container { min-height: 100vh; background: #fff; padding-bottom: 110rpx; }

.top-bar {
  display: flex; align-items: center; gap: 16rpx;
  padding: 20rpx 24rpx; background: #58cc02;
}
.level-badge {
  width: 80rpx; height: 80rpx; border-radius: 50%;
  background: rgba(255,255,255,0.2); color: #fff;
  font-size: 24rpx; font-weight: bold; text-align: center; line-height: 80rpx; flex-shrink: 0;
}
.exp-bar-wrap { flex: 1; }
.exp-bar { height: 14rpx; background: rgba(255,255,255,0.3); border-radius: 7rpx; overflow: hidden; }
.exp-fill { height: 100%; background: #ffd700; border-radius: 7rpx; transition: width 0.3s; }
.exp-text { font-size: 20rpx; color: #fff; margin-top: 4rpx; display: block; }
.overall-circle {
  width: 72rpx; height: 72rpx; border-radius: 50%;
  border: 5rpx solid #ffd700; display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}
.overall-pct { font-size: 20rpx; color: #ffd700; font-weight: bold; }

.path-scroll { height: calc(100vh - 200rpx); }
.path-container { padding: 20rpx 30rpx 40rpx; }

.unit-header {
  display: flex; align-items: center; justify-content: space-between;
  padding: 30rpx 0 20rpx;
}
.unit-header:first-child { padding-top: 10rpx; }
.unit-title-row { display: flex; align-items: center; gap: 12rpx; }
.unit-color-dot { width: 16rpx; height: 16rpx; border-radius: 50%; }
.unit-title-text { font-size: 32rpx; font-weight: bold; color: #333; }
.unit-count { font-size: 24rpx; color: #999; }

.path-row { position: relative; }

.node-wrap {
  display: flex; align-items: center; gap: 20rpx;
  padding: 20rpx; background: #fff; border-radius: 16rpx;
  border: 3rpx solid #eee; margin-bottom: 0;
  position: relative; z-index: 1;
}
.node-wrap.done { border-color: #58cc02; background: #f0fff0; }
.node-wrap.current { border-color: #ffd700; box-shadow: 0 0 0 6rpx rgba(255,215,0,0.12); }
.node-wrap.locked { border-color: #f0f0f0; background: #fafafa; }

.node-circle {
  width: 80rpx; height: 80rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0; border: 4rpx solid #e0e0e0; background: #fff;
}
.node-wrap.done .node-circle { border-color: #58cc02; background: #58cc02; }
.node-wrap.current .node-circle { border-color: #ffd700; background: #fff; }
.node-wrap.locked .node-circle { border-color: #eee; background: #fafafa; }

.node-icon { font-size: 36rpx; color: #fff; }
.node-wrap.current .node-icon { color: #ffd700; }
.node-num { font-size: 28rpx; color: #ccc; font-weight: bold; }
.node-wrap.locked .node-num { color: #ddd; }

.node-info { flex: 1; min-width: 0; }
.node-title { font-size: 28rpx; font-weight: bold; color: #333; display: block; line-height: 1.3; }
.node-wrap.locked .node-title { color: #ccc; }
.node-meta { font-size: 22rpx; color: #999; margin-top: 4rpx; display: block; }

.connector {
  width: 4rpx; height: 30rpx; background: #e0e0e0; margin-left: 60rpx;
}
.connector.conn-done { background: #58cc02; }

.bottom-nav {
  position: fixed; bottom: 0; left: 0; right: 0; display: flex;
  background: #fff; box-shadow: 0 -2rpx 16rpx rgba(0,0,0,0.08);
}
.nav-item { flex: 1; padding: 16rpx 0; text-align: center; }
.nav-text { font-size: 22rpx; color: #999; }
.nav-item.active .nav-text { color: #58cc02; font-weight: bold; }
