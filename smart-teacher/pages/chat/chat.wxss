/* smart-teacher/pages/chat/chat.wxss - UI/UX Pro Max 统一版 */
/* 主色: #2563EB | 背景: #F8FAFC | 边框: #E2E8F0 */

.chat-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #F8FAFC;
}

/* ========== 消息列表 ========== */
.msg-list {
  flex: 1;
  padding: 20rpx 24rpx;
  overflow-y: auto;
}

.msg-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 28rpx;
}

.msg-row.ai {
  flex-direction: row;
}

.msg-row.user {
  flex-direction: row-reverse;
}

/* ========== 头像 ========== */
.avatar {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.ai-avatar {
  background: linear-gradient(135deg, #2563EB 0%, #3B82F6 100%);
  margin-right: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(37,99,235,0.25);
}

.user-avatar {
  background: linear-gradient(135deg, #6366F1 0%, #8B5CF6 100%);
  margin-left: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(99,102,241,0.25);
}

.avatar-text {
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
}

/* ========== 气泡 ========== */
.bubble {
  max-width: 70%;
  padding: 20rpx 28rpx;
  border-radius: 20rpx;
  word-break: break-all;
  transition: all 0.2s ease;
}

.ai-bubble {
  background-color: #ffffff;
  border-top-left-radius: 8rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.04);
  border: 3rpx solid #E2E8F0;
}

.user-bubble {
  background: linear-gradient(135deg, #2563EB 0%, #3B82F6 100%);
  border-top-right-radius: 8rpx;
  box-shadow: 0 4rpx 16rpx rgba(37,99,235,0.25);
}

.bubble-text {
  font-size: 28rpx;
  line-height: 1.7;
}

.ai-bubble .bubble-text {
  color: #1E293B;
}

.user-bubble .bubble-text {
  color: #ffffff;
}

/* ========== 图片消息 ========== */
.msg-image {
  width: 300rpx;
  border-radius: 16rpx;
  margin-bottom: 12rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.08);
}

/* ========== 输入动画 ========== */
.typing-bubble {
  padding: 24rpx 36rpx;
}

.typing-dots {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background-color: #94A3B8;
  animation: dotBounce 1.2s infinite ease-in-out;
}

.dot:nth-child(2) {
  animation-delay: 0.2s;
}

.dot:nth-child(3) {
  animation-delay: 0.4s;
}

@keyframes dotBounce {
  0%, 80%, 100% {
    transform: scale(0.6);
    opacity: 0.4;
  }
  40% {
    transform: scale(1);
    opacity: 1;
  }
}

/* ========== 快捷提问 ========== */
.quick-asks {
  white-space: nowrap;
  padding: 0 24rpx 16rpx;
}

.quick-tag {
  display: inline-block;
  padding: 12rpx 28rpx;
  background-color: #ffffff;
  border-radius: 32rpx;
  font-size: 24rpx;
  color: #2563EB;
  margin-right: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
  border: 2rpx solid #E2E8F0;
  cursor: pointer;
  transition: all 0.2s ease;
  min-height: 88rpx;
  display: inline-flex;
  align-items: center;
}

.quick-tag:active {
  opacity: 0.7;
  transform: scale(0.97);
  background: #EFF6FF;
  border-color: #2563EB;
}

/* ========== 底部输入栏 ========== */
.input-bar {
  background-color: #ffffff;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  border-top: 3rpx solid #E2E8F0;
  box-shadow: 0 -4rpx 24rpx rgba(0,0,0,0.04);
}

.input-bar-inner {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.image-btn {
  width: 68rpx;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background-color: #F1F5F9;
  flex-shrink: 0;
  cursor: pointer;
  transition: all 0.2s ease;
}

.image-btn:active {
  background-color: #E2E8F0;
  transform: scale(0.95);
}

.image-btn-icon {
  font-size: 36rpx;
  color: #64748B;
}

.msg-input {
  flex: 1;
  height: 72rpx;
  background-color: #F1F5F9;
  border-radius: 36rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
  color: #1E293B;
  border: 3rpx solid transparent;
  transition: all 0.2s ease;
}

.msg-input:focus {
  border-color: #2563EB;
  background: #ffffff;
}

.send-btn {
  height: 64rpx;
  padding: 0 28rpx;
  border-radius: 32rpx;
  background-color: #E2E8F0;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: all 0.2s ease;
  cursor: pointer;
}

.send-btn.active {
  background: linear-gradient(135deg, #2563EB 0%, #3B82F6 100%);
  box-shadow: 0 4rpx 16rpx rgba(37,99,235,0.3);
}

.send-btn:active {
  transform: scale(0.95);
}

.send-btn-text {
  font-size: 26rpx;
  color: #94A3B8;
  font-weight: 500;
}

.send-btn.active .send-btn-text {
  color: #ffffff;
}

/* ========== 图片预览条 ========== */
.preview-bar {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  padding: 12rpx 16rpx;
  background-color: #F1F5F9;
  border-radius: 16rpx;
  position: relative;
}

.preview-thumb {
  width: 100rpx;
  height: 100rpx;
  border-radius: 12rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.08);
}

.preview-remove {
  position: absolute;
  top: 4rpx;
  right: 8rpx;
  width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #ffffff;
  background-color: rgba(0,0,0,0.4);
  border-radius: 50%;
  cursor: pointer;
  transition: all 0.2s ease;
}

.preview-remove:active {
  transform: scale(0.9);
  background-color: rgba(0,0,0,0.6);
}
