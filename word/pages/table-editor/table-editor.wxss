.page {
  display: flex; flex-direction: column; height: 100vh; background: #f5f5f5;
}
.header {
  display: flex; justify-content: space-between; align-items: center;
  padding: 20rpx 30rpx; background: #fff; border-bottom: 1rpx solid #eee;
}
.title { font-size: 34rpx; font-weight: bold; color: #333; }
.header-actions { display: flex; gap: 20rpx; }
.btn-cancel { padding: 12rpx 24rpx; font-size: 28rpx; color: #999; }
.btn-confirm {
  padding: 12rpx 24rpx; font-size: 28rpx; color: #fff;
  background: #07c160; border-radius: 8rpx;
}
.controls {
  display: flex; justify-content: center; gap: 60rpx;
  padding: 24rpx; background: #fff; margin: 16rpx; border-radius: 12rpx;
}
.ctrl-row { display: flex; align-items: center; gap: 12rpx; }
.ctrl-label { font-size: 26rpx; color: #666; }
.num-btn {
  width: 56rpx; height: 56rpx; display: flex; align-items: center; justify-content: center;
  background: #eee; border-radius: 8rpx; font-size: 32rpx; color: #333;
}
.num-val { font-size: 30rpx; font-weight: bold; min-width: 40rpx; text-align: center; }
.table-scroll {
  flex: 1; margin: 0 16rpx 16rpx; background: #fff; border-radius: 12rpx; overflow: hidden;
}
.table-grid { padding: 4rpx; }
.grid-row { display: flex; }
.grid-cell {
  flex: 1; min-width: 140rpx; border: 1rpx solid #e0e0e0; padding: 2rpx;
}
.cell-input {
  width: 100%; height: 80rpx; font-size: 26rpx; text-align: center;
  padding: 0 8rpx; box-sizing: border-box;
}
