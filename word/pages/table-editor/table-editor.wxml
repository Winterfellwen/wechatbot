<view class="page">
  <view class="header">
    <text class="title">编辑表格</text>
    <view class="header-actions">
      <view class="btn-cancel" bindtap="cancel">取消</view>
      <view class="btn-confirm" bindtap="confirm">确定</view>
    </view>
  </view>

  <view class="controls">
    <view class="ctrl-row">
      <text class="ctrl-label">行数:</text>
      <view class="num-btn" bindtap="changeRows" data-delta="-1">-</view>
      <text class="num-val">{{rows}}</text>
      <view class="num-btn" bindtap="changeRows" data-delta="1">+</view>
    </view>
    <view class="ctrl-row">
      <text class="ctrl-label">列数:</text>
      <view class="num-btn" bindtap="changeCols" data-delta="-1">-</view>
      <text class="num-val">{{cols}}</text>
      <view class="num-btn" bindtap="changeCols" data-delta="1">+</view>
    </view>
  </view>

  <scroll-view class="table-scroll" scroll-x="true">
    <view class="table-grid" style="min-width:{{cols * 140}}rpx;">
      <view class="grid-row" wx:for="{{grid}}" wx:for-index="r" wx:key="r">
        <view class="grid-cell" wx:for="{{item}}" wx:for-index="c" wx:key="c">
          <input class="cell-input" placeholder="{{r === 0 ? '列' + (c + 1) : '内容'}}"
            value="{{grid[r][c]}}"
            data-row="{{r}}" data-col="{{c}}"
            bindinput="onCellInput" />
        </view>
      </view>
    </view>
  </scroll-view>
</view>
