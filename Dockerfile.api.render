FROM node:20-slim

# Install build dependencies for native modules
RUN apt-get update && apt-get install -y \
    python3 \
    make \
    g++ \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy package files
COPY apps/api/package*.json ./
RUN npm install --legacy-peer-deps

# Copy source code
COPY apps/api .

# Build TypeScript
RUN npm run build

EXPOSE 8765

CMD ["node", "dist/index.js"]
