page {
  background-color: #F8FAFC;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  color: #1E293B;
}

.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.card {
  background: #FFFFFF;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
  margin: 24rpx;
  padding: 32rpx;
}

.btn-primary {
  background: linear-gradient(135deg, #2563EB 0%, #3B82F6 100%);
  color: #FFFFFF;
  border-radius: 12rpx;
  padding: 24rpx 0;
  text-align: center;
  font-weight: 600;
  font-size: 30rpx;
}

.btn-primary:active {
  opacity: 0.9;
  transform: scale(0.98);
}

.entry-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 40rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(37, 99, 235, 0.08);
  transition: all 0.2s ease;
}

.entry-card:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(37, 99, 235, 0.12);
}

.entry-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1E293B;
}

.entry-desc {
  font-size: 22rpx;
  color: #64748B;
  margin-top: 8rpx;
}