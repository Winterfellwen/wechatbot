page {
  background-color: #f5f5f5;
  font-size: 28rpx;
  color: #333;
}

.container {
  height: 100%;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.btn-primary {
  background-color: #1890ff;
  color: #fff;
  border-radius: 10rpx;
  padding: 20rpx 0;
  text-align: center;
}

.btn-default {
  background-color: #fff;
  color: #333;
  border: 1rpx solid #d9d9d9;
  border-radius: 10rpx;
  padding: 20rpx 0;
  text-align: center;
}