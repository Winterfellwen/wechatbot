/*pdf/pages/convert/convert.wxss*/
.container { min-height: 100vh; background: #F8FAFC; }
.header { display: flex; align-items: center; padding: 20rpx 30rpx; background: #fff; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06); }
.back-btn { width: 100rpx; font-size: 28rpx; color: #6366F1; }
.header-title { flex: 1; text-align: center; font-size: 32rpx; font-weight: bold; color: #333; }
.header-placeholder { width: 100rpx; }

.file-display { padding: 24rpx 30rpx; background: #fff; margin: 2rpx 0; }
.file-label { font-size: 24rpx; color: #94A3B8; display: block; }
.file-value { font-size: 28rpx; color: #333; font-weight: bold; display: block; margin-top: 4rpx; }
.no-file { padding: 60rpx; text-align: center; color: #94A3B8; font-size: 28rpx; }

.convert-area { padding: 30rpx; }
.section-title { font-size: 26rpx; color: #64748B; display: block; margin-bottom: 12rpx; }
.format-tabs { display: flex; gap: 16rpx; }
.fmt-tab { flex: 1; text-align: center; padding: 20rpx; background: #fff; border: 2rpx solid #E2E8F0; border-radius: 14rpx; font-size: 28rpx; color: #64748B; font-weight: bold; }
.fmt-tab.active { border-color: #6366F1; background: #EEF2FF; color: #6366F1; }
.arrow-big { text-align: center; font-size: 40rpx; color: #CBD5E1; padding: 20rpx 0; }

.convert-btn-wrap { padding: 20rpx 30rpx; }
.convert-btn { background: linear-gradient(135deg, #6366F1, #8B5CF6); border-radius: 16rpx; padding: 28rpx; text-align: center; color: #fff; font-size: 32rpx; font-weight: bold; box-shadow: 0 6rpx 20rpx rgba(99,102,241,0.25); }
.convert-btn.disabled { opacity: 0.5; }

.result-section { padding: 30rpx; text-align: center; }
.result-title { font-size: 30rpx; color: #22C55E; font-weight: bold; display: block; }
.download-btn { margin-top: 20rpx; background: #22C55E; border-radius: 14rpx; padding: 24rpx; color: #fff; font-size: 28rpx; font-weight: bold; display: inline-block; }
