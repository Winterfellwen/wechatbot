/*pdf/pages/index/index.wxss*/
.container { min-height: 100vh; background: #F8FAFC; padding-bottom: 120rpx; }

.header { padding: 40rpx 30rpx 30rpx; background: linear-gradient(135deg, #6366F1, #8B5CF6); color: #fff; text-align: center; }
.header-title { font-size: 40rpx; font-weight: bold; display: block; }
.header-sub { font-size: 26rpx; opacity: 0.8; display: block; margin-top: 8rpx; }

.upload-section { padding: 60rpx 24rpx; }
.upload-btn { border: 4rpx dashed #CBD5E1; border-radius: 24rpx; padding: 80rpx 20rpx; text-align: center; background: #fff; }
.upload-icon { font-size: 72rpx; color: #6366F1; display: block; font-weight: bold; }
.upload-text { font-size: 34rpx; color: #333; display: block; margin-top: 16rpx; font-weight: bold; }
.upload-hint { font-size: 26rpx; color: #94A3B8; display: block; margin-top: 10rpx; }

.convert-section { padding: 30rpx 24rpx; }

.file-card { display: flex; align-items: center; background: #fff; border-radius: 18rpx; padding: 28rpx 30rpx; margin-bottom: 30rpx; box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06); }
.file-info { flex: 1; min-width: 0; }
.file-name { font-size: 30rpx; color: #333; font-weight: bold; display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.file-type { font-size: 24rpx; color: #6366F1; margin-top: 6rpx; display: block; }
.file-del { width: 56rpx; height: 56rpx; text-align: center; line-height: 56rpx; font-size: 36rpx; color: #EF4444; font-weight: bold; }

.section-label { font-size: 28rpx; color: #64748B; display: block; margin-bottom: 16rpx; font-weight: bold; }

.target-list { display: flex; flex-direction: column; gap: 14rpx; margin-bottom: 40rpx; }
.target-card {
  padding: 28rpx 30rpx; background: #fff; border: 2rpx solid #E2E8F0;
  border-radius: 16rpx; text-align: center;
}
.target-card.active { border-color: #6366F1; background: #EEF2FF; }
.target-label { font-size: 30rpx; color: #333; font-weight: bold; }
.target-card.active .target-label { color: #6366F1; }

.convert-btn-wrap { text-align: center; }
.convert-btn { display: inline-block; width: 100%; padding: 28rpx; background: linear-gradient(135deg, #6366F1, #8B5CF6); border-radius: 16rpx; color: #fff; font-size: 34rpx; font-weight: bold; box-shadow: 0 8rpx 24rpx rgba(99,102,241,0.3); text-align: center; }
.convert-btn.loading { opacity: 0.5; }

.result-section { padding: 30rpx 24rpx; }
.result-card { background: #fff; border-radius: 18rpx; padding: 30rpx; box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06); margin-bottom: 20rpx; }
.result-header { display: flex; align-items: center; margin-bottom: 16rpx; }
.result-icon { width: 48rpx; height: 48rpx; line-height: 48rpx; text-align: center; background: #10B981; color: #fff; border-radius: 50%; font-size: 28rpx; margin-right: 16rpx; flex-shrink: 0; }
.result-title { font-size: 28rpx; font-weight: bold; color: #1E293B; flex: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.result-del { width: 48rpx; height: 48rpx; line-height: 44rpx; text-align: center; color: #94A3B8; font-size: 36rpx; flex-shrink: 0; }
.result-btn.open { width: 100%; padding: 24rpx 0; text-align: center; background: linear-gradient(135deg, #6366F1, #8B5CF6); color: #fff; border-radius: 14rpx; font-size: 30rpx; font-weight: bold; box-shadow: 0 6rpx 20rpx rgba(99,102,241,0.3); }
.result-hint { display: block; text-align: center; font-size: 22rpx; color: #94A3B8; margin-top: 16rpx; }

.bottom-nav { position: fixed; bottom: 0; left: 0; right: 0; display: flex; background: #fff; box-shadow: 0 -2rpx 16rpx rgba(0,0,0,0.08); padding: 12rpx 0 env(safe-area-inset-bottom,12rpx); }
.nav-item { flex: 1; padding: 10rpx 0 14rpx; text-align: center; }
.nav-text { font-size: 26rpx; color: #94A3B8; }
.nav-item.active .nav-text { color: #6366F1; font-weight: bold; }
