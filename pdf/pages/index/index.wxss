/* pdf/pages/index/index.wxss - UI/UX Pro Max 优化版 */
/* 设计系统: Glassmorphism, Primary #6366F1 */

page {
  --primary: #6366F1;
  --primary-light: #818cf8;
  --primary-dark: #4f46e5;
  --success: #10b981;
  --danger: #ef4444;
  --warning: #f59e0b;
  --bg-page: #f8fafc;
  --bg-card: #ffffff;
  --text-primary: #1e293b;
  --text-secondary: #64748b;
  --text-muted: #94a3b8;
  --border: #e2e8f0;
  --shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
  --radius-lg: 28rpx;
  --radius-md: 20rpx;
  --radius-sm: 12rpx;
}

.container { 
  min-height: 100vh; 
  background: var(--bg-page); 
  padding-bottom: 140rpx; 
}

/* ========== 顶部标题区 ========== */
.header { 
  padding: 36rpx 32rpx 28rpx; 
  background: linear-gradient(135deg, #6366F1, #8B5CF6);
  color: #fff;
  text-align: center;
  position: relative;
  overflow: hidden;
}

.header::before {
  content: '';
  position: absolute;
  width: 300rpx;
  height: 300rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
  top: -100rpx;
  right: -60rpx;
}

.header::after {
  content: '';
  position: absolute;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.05);
  bottom: -80rpx;
  left: -40rpx;
}

.header-title { 
  font-size: 40rpx; 
  font-weight: 700; 
  display: block;
  position: relative;
  z-index: 1;
}

.header-sub { 
  font-size: 24rpx; 
  opacity: 0.85; 
  display: block; 
  margin-top: 8rpx;
  position: relative;
  z-index: 1;
}

/* ========== 上传区域 ========== */
.upload-section { 
  padding: 40rpx 32rpx; 
}

.upload-btn { 
  border: 3rpx dashed var(--border); 
  border-radius: var(--radius-md);
  padding: 40rpx 32rpx; 
  text-align: center; 
  background: var(--bg-card);
  position: relative;
  overflow: hidden;
  transition: all 0.2s ease;
  cursor: pointer;
}

.upload-btn:active {
  transform: scale(0.98);
  border-color: var(--primary);
  background: #fafbff;
}

.upload-btn::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 6rpx;
  background: linear-gradient(90deg, var(--primary), var(--primary-light));
}

.upload-icon { 
  font-size: 64rpx; 
  color: var(--primary);
  display: block;
  font-weight: 200;
  line-height: 1;
}

.upload-text { 
  font-size: 30rpx; 
  color: var(--text-primary); 
  display: block; 
  margin-top: 16rpx; 
  font-weight: 600;
}

.upload-hint { 
  font-size: 24rpx; 
  color: var(--text-muted); 
  display: block; 
  margin-top: 8rpx; 
}

/* ========== Tab 切换 ========== */
.tab-bar {
  display: flex;
  margin: 0 32rpx 24rpx;
  background: var(--bg-card);
  border-radius: var(--radius-sm);
  padding: 6rpx;
  box-shadow: var(--shadow);
}
.tab-item {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-secondary);
  border-radius: 10rpx;
  transition: all 0.2s;
}
.tab-item.active {
  background: var(--primary);
  color: #fff;
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(99, 102, 241, 0.3);
}

/* ========== 编辑区域 ========== */
.edit-section { padding: 0 32rpx 24rpx; }
.edit-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: var(--bg-card);
  border: 2rpx solid var(--border);
  border-radius: var(--radius-sm);
  padding: 24rpx;
  margin-bottom: 16rpx;
  transition: all 0.2s;
}
.edit-card:active {
  transform: scale(0.98);
  border-color: var(--primary);
  background: #fafbff;
}
.edit-card-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 14rpx;
  background: #f1f5f9;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: var(--primary);
  flex-shrink: 0;
}
.edit-card-info { flex: 1; min-width: 0; }
.edit-card-title { font-size: 28rpx; font-weight: 600; color: var(--text-primary); display: block; }
.edit-card-desc { font-size: 24rpx; color: var(--text-muted); display: block; margin-top: 4rpx; }
.edit-card-arrow { font-size: 36rpx; color: var(--text-muted); flex-shrink: 0; }
.edit-tip { font-size: 22rpx; color: var(--text-muted); text-align: center; margin-top: 8rpx; }

/* ========== 转换区域 ========== */
.convert-section { 
  padding: 32rpx; 
}

.file-card { 
  display: flex; 
  align-items: center; 
  background: var(--bg-card); 
  border-radius: var(--radius-md); 
  padding: 24rpx; 
  margin-bottom: 24rpx; 
  box-shadow: var(--shadow);
  position: relative;
  overflow: hidden;
}

.file-card::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 8rpx;
  background: linear-gradient(180deg, var(--primary), var(--primary-light));
}

.file-info { 
  flex: 1; 
  min-width: 0; 
  padding-left: 16rpx;
}

.file-name { 
  font-size: 32rpx; 
  color: var(--text-primary); 
  font-weight: 600; 
  display: block; 
  white-space: nowrap; 
  overflow: hidden; 
  text-overflow: ellipsis;
}

.file-type { 
  font-size: 24rpx; 
  color: var(--primary); 
  margin-top: 8rpx; 
  display: block;
  font-weight: 500;
}

.file-del { 
  width: 52rpx; 
  height: 52rpx;
  text-align: center; 
  line-height: 50rpx; 
  font-size: 32rpx; 
  color: var(--danger); 
  font-weight: 300;
  background: rgba(239, 68, 68, 0.08);
  border-radius: 50%;
  flex-shrink: 0;
  cursor: pointer;
  transition: all 0.2s ease;
  display: flex;
  align-items: center;
  justify-content: center;
}

.file-del:active {
  transform: scale(0.95);
  background: rgba(239, 68, 68, 0.15);
}

.section-label { 
  font-size: 26rpx; 
  color: var(--text-secondary); 
  display: block; 
  margin-bottom: 12rpx; 
  font-weight: 500;
  padding-left: 4rpx;
}

.target-list { 
  display: flex; 
  flex-direction: column; 
  gap: 8rpx; 
  margin-bottom: 24rpx; 
}

.target-card {
  padding: 14rpx 24rpx; 
  background: var(--bg-card); 
  border: 2rpx solid var(--border);
  border-radius: 10rpx; 
  text-align: center;
  transition: all 0.2s ease;
  position: relative;
  cursor: pointer;
  min-height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.target-card:active {
  transform: scale(0.98);
}

.target-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: var(--border);
  transition: background 0.2s ease;
}

.target-card.active { 
  border-color: var(--primary); 
  background: linear-gradient(180deg, #fafbff, #f0f1ff);
  box-shadow: 0 4rpx 20rpx rgba(99, 102, 241, 0.15);
}

.target-card.active::before {
  background: linear-gradient(90deg, var(--primary), var(--primary-light));
}

.target-label { 
  font-size: 26rpx; 
  color: var(--text-primary); 
  font-weight: 500; 
}

.target-card.active .target-label { 
  color: var(--primary); 
}

.convert-btn-wrap { 
  display: flex;
  justify-content: center;
}

.convert-btn { 
  display: flex;
  align-items: center;
  justify-content: center;
  width: auto;
  min-width: 360rpx;
  padding: 0 48rpx;
  background: linear-gradient(135deg, #6366F1, #8B5CF6);
  border-radius: var(--radius-sm); 
  color: #fff; 
  font-size: 30rpx; 
  font-weight: 600;
  box-shadow: 0 4rpx 20rpx rgba(99, 102, 241, 0.25);
  transition: all 0.2s ease;
  cursor: pointer;
  min-height: 80rpx;
}

.convert-btn:active {
  transform: scale(0.97);
  box-shadow: 0 4rpx 16rpx rgba(99, 102, 241, 0.25);
}

.convert-btn.loading { 
  opacity: 0.6;
  background: linear-gradient(135deg, #94a3b8, #64748b);
  box-shadow: none;
  cursor: not-allowed;
}

/* ========== 结果区域 ========== */
.result-section { 
  padding: 24rpx 32rpx; 
}

.result-card { 
  background: var(--bg-card); 
  border-radius: var(--radius-sm); 
  padding: 20rpx;
  box-shadow: var(--shadow);
  margin-bottom: 16rpx;
  position: relative;
  overflow: hidden;
}

.result-card::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 6rpx;
  background: var(--success);
}

.result-header { 
  display: flex; 
  align-items: center; 
  margin-bottom: 12rpx; 
}

.result-icon { 
  width: 48rpx; 
  height: 48rpx;
  line-height: 48rpx; 
  text-align: center; 
  background: var(--success); 
  color: #fff; 
  border-radius: 50%; 
  font-size: 24rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
  box-shadow: 0 2rpx 8rpx rgba(16, 185, 129, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
}

.result-title { 
  font-size: 26rpx; 
  font-weight: 500; 
  color: var(--text-primary);
  flex: 1; 
  white-space: nowrap; 
  overflow: hidden; 
  text-overflow: ellipsis; 
}

.result-del { 
  width: 48rpx; 
  height: 48rpx;
  line-height: 44rpx; 
  text-align: center; 
  color: var(--text-muted); 
  font-size: 32rpx; 
  flex-shrink: 0;
  font-weight: 200;
  cursor: pointer;
  transition: all 0.2s ease;
  display: flex;
  align-items: center;
  justify-content: center;
}

.result-del:active {
  transform: scale(0.95);
  color: var(--danger);
}

/* ========== 底部导航 ========== */
.bottom-nav { 
  position: fixed; 
  bottom: 0; 
  left: 0; 
  right: 0; 
  display: flex; 
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20px);
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.06);
  padding: 8rpx 0 20rpx;
  z-index: 100;
}

.nav-item { 
  flex: 1; 
  padding: 14rpx 0 18rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  cursor: pointer;
  transition: transform 0.2s ease;
}

.nav-item:active {
  transform: scale(0.95);
}

.nav-icon {
  font-size: 48rpx;
  margin-bottom: 4rpx;
}

.nav-text { 
  font-size: 24rpx; 
  color: var(--text-muted);
  font-weight: 500;
}

.nav-item.active .nav-text { 
  color: var(--primary); 
  font-weight: 600;
}
