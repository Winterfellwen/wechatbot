/*pdf/pages/index/index.wxss*/
.container { min-height: 100vh; background: #F8FAFC; padding-bottom: 120rpx; }

.header { padding: 40rpx 30rpx 30rpx; background: linear-gradient(135deg, #6366F1, #8B5CF6); color: #fff; text-align: center; }
.header-title { font-size: 40rpx; font-weight: bold; display: block; }
.header-sub { font-size: 26rpx; opacity: 0.8; display: block; margin-top: 8rpx; }

.tool-cards { padding: 24rpx; display: flex; gap: 20rpx; margin-top: -16rpx; }
.tool-card { flex: 1; border-radius: 20rpx; padding: 32rpx 24rpx; color: #fff; text-align: center; box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.1); }
.tool-card.card-green { background: linear-gradient(135deg, #22C55E, #4ADE80); }
.tool-card.card-blue { background: linear-gradient(135deg, #3B82F6, #60A5FA); }
.tool-icon { font-size: 48rpx; display: block; }
.tool-name { font-size: 30rpx; font-weight: bold; display: block; margin-top: 8rpx; }
.tool-desc { font-size: 22rpx; opacity: 0.85; display: block; margin-top: 4rpx; }

.upload-section { padding: 20rpx 24rpx; }
.upload-btn { 
  border: 3rpx dashed #CBD5E1; border-radius: 20rpx; padding: 50rpx 20rpx;
  text-align: center; background: #fff;
}
.upload-icon { font-size: 60rpx; color: #6366F1; display: block; font-weight: bold; }
.upload-text { font-size: 30rpx; color: #333; display: block; margin-top: 12rpx; font-weight: bold; }
.upload-hint { font-size: 24rpx; color: #94A3B8; display: block; margin-top: 8rpx; }

.file-list { padding: 0 24rpx; }
.list-title { font-size: 26rpx; color: #64748B; display: block; margin-bottom: 12rpx; padding-left: 8rpx; }
.file-item { display: flex; align-items: center; background: #fff; border-radius: 14rpx; padding: 20rpx 24rpx; margin-bottom: 12rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04); }
.file-info { flex: 1; min-width: 0; }
.file-name { font-size: 28rpx; color: #333; font-weight: bold; display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.file-meta { font-size: 22rpx; color: #94A3B8; margin-top: 4rpx; display: block; }
.file-actions { display: flex; gap: 16rpx; flex-shrink: 0; }
.file-action { font-size: 24rpx; padding: 8rpx 20rpx; border-radius: 8rpx; }
.file-action.convert { background: #F0FDF4; color: #22C55E; }
.file-action.edit { background: #EFF6FF; color: #3B82F6; }
.file-action.del { background: #FEF2F2; color: #EF4444; padding: 8rpx 14rpx; }

.bottom-nav {
  position: fixed; bottom: 0; left: 0; right: 0; display: flex;
  background: #fff; box-shadow: 0 -2rpx 16rpx rgba(0,0,0,0.08);
  padding: 12rpx 0 env(safe-area-inset-bottom,12rpx);
}
.nav-item { flex: 1; padding: 10rpx 0 14rpx; text-align: center; }
.nav-text { font-size: 26rpx; color: #94A3B8; }
.nav-item.active .nav-text { color: #6366F1; font-weight: bold; }
