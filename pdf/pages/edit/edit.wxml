<view class="container">
  <view class="header">
    <view class="back-btn" bindtap="goBack">← 返回</view>
    <text class="header-title">合并 PDF</text>
    <view class="header-placeholder"></view>
  </view>

  <!-- 文件 1 -->
  <view class="file-slot">
    <text class="slot-label">第一个文件</text>
    <view wx:if="{{file1Name}}" class="slot-content">
      <text class="slot-name">{{file1Name}}</text>
      <text class="slot-del" bindtap="clearFile1">×</text>
    </view>
    <view wx:else class="slot-add" bindtap="uploadFile1">+ 选择 PDF</view>
  </view>

  <!-- 交换按钮 -->
  <view class="swap-btn" bindtap="swapFiles">
    <text class="swap-icon">⇅</text>
    <text class="swap-text">交换顺序</text>
  </view>

  <!-- 文件 2 -->
  <view class="file-slot">
    <text class="slot-label">第二个文件</text>
    <view wx:if="{{file2Name}}" class="slot-content">
      <text class="slot-name">{{file2Name}}</text>
      <text class="slot-del" bindtap="clearFile2">×</text>
    </view>
    <view wx:else class="slot-add" bindtap="uploadFile2">+ 选择 PDF</view>
  </view>

  <!-- 合并按钮 -->
  <view class="do-btn-wrap">
    <view class="do-btn {{processing ? 'disabled' : ''}}" bindtap="doMerge">
      {{processing ? (progressText || '处理中...') : '开始合并'}}
    </view>
  </view>

  <!-- 结果 -->
  <view wx:if="{{resultUrl}}" class="result-section">
    <text class="result-title">合并完成</text>
    <view class="download-btn" bindtap="downloadResult">下载并打开文件</view>
  </view>
</view>
