/*pdf/pages/edit/edit.wxss*/
.container { min-height: 100vh; background: #F8FAFC; }
.header { display: flex; align-items: center; padding: 20rpx 30rpx; background: #fff; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06); }
.back-btn { width: 100rpx; font-size: 28rpx; color: #6366F1; }
.header-title { flex: 1; text-align: center; font-size: 32rpx; font-weight: bold; color: #333; }
.header-placeholder { width: 100rpx; }
.file-display { padding: 24rpx 30rpx; background: #fff; margin: 2rpx 0; }
.file-display-2 { border-top: 2rpx dashed #E2E8F0; }
.fl { font-size: 24rpx; color: #94A3B8; display: block; }
.fv { font-size: 28rpx; color: #333; font-weight: bold; display: block; margin-top: 4rpx; word-break: break-all; }
.fv-row { display: flex; align-items: center; justify-content: space-between; }
.fv-del { font-size: 40rpx; color: #94A3B8; padding: 0 10rpx; }
.fv-add { font-size: 28rpx; color: #6366F1; margin-top: 4rpx; }
.no-file { padding: 60rpx; text-align: center; color: #94A3B8; font-size: 28rpx; }
.op-list { padding: 30rpx; display: flex; flex-direction: column; gap: 16rpx; }
.op-card { display: flex; align-items: center; gap: 24rpx; background: #fff; border: 2rpx solid #E2E8F0; border-radius: 16rpx; padding: 28rpx; }
.op-card.selected { border-color: #6366F1; background: #EEF2FF; }
.op-icon { width: 72rpx; height: 72rpx; border-radius: 16rpx; background: #F1F5F9; display: flex; align-items: center; justify-content: center; font-size: 36rpx; color: #6366F1; flex-shrink: 0; }
.op-card.selected .op-icon { background: #6366F1; color: #fff; }
.op-info { flex: 1; }
.op-name { font-size: 30rpx; font-weight: bold; color: #333; display: block; }
.op-desc { font-size: 24rpx; color: #94A3B8; display: block; margin-top: 4rpx; }
.options-panel { padding: 0 30rpx 20rpx; }
.opt-label { font-size: 26rpx; color: #64748B; display: block; margin-bottom: 12rpx; }
.opt-input { border: 2rpx solid #E2E8F0; border-radius: 12rpx; padding: 20rpx 24rpx; font-size: 30rpx; background: #fff; }
.do-btn-wrap { padding: 20rpx 30rpx; }
.do-btn { background: linear-gradient(135deg, #6366F1, #8B5CF6); border-radius: 16rpx; padding: 28rpx; text-align: center; color: #fff; font-size: 32rpx; font-weight: bold; }
.do-btn.disabled { opacity: 0.5; }
.result-section { padding: 30rpx; text-align: center; }
.result-title { font-size: 30rpx; color: #22C55E; font-weight: bold; display: block; }
.download-btn { margin-top: 20rpx; background: #22C55E; border-radius: 14rpx; padding: 24rpx; color: #fff; font-size: 28rpx; display: inline-block; }
