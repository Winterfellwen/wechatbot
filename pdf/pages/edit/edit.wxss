/*pdf/pages/edit/edit.wxss - 合并 PDF 专用样式*/
.container { min-height: 100vh; background: #F8FAFC; padding-bottom: 40rpx; }
.header { display: flex; align-items: center; padding: 20rpx 30rpx; background: #fff; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06); }
.back-btn { width: 100rpx; font-size: 28rpx; color: #6366F1; }
.back-btn:active { opacity: 0.7; }
.header-title { flex: 1; text-align: center; font-size: 32rpx; font-weight: bold; color: #333; }
.header-placeholder { width: 100rpx; }

.file-slot { margin: 24rpx 30rpx; background: #fff; border-radius: 16rpx; padding: 24rpx; }
.slot-label { font-size: 24rpx; color: #94A3B8; display: block; margin-bottom: 12rpx; }
.slot-content { display: flex; align-items: center; justify-content: space-between; }
.slot-name { font-size: 28rpx; color: #333; font-weight: bold; flex: 1; word-break: break-all; }
.slot-del { font-size: 40rpx; color: #94A3B8; padding: 12rpx 16rpx; }
.slot-del:active { opacity: 0.6; }
.slot-add { font-size: 28rpx; color: #6366F1; text-align: center; padding: 20rpx 0; }
.slot-add:active { opacity: 0.7; }

.swap-btn { display: flex; align-items: center; justify-content: center; margin: 16rpx 30rpx; padding: 16rpx; background: #EEF2FF; border-radius: 12rpx; }
.swap-icon { font-size: 32rpx; color: #6366F1; margin-right: 8rpx; }
.swap-text { font-size: 26rpx; color: #6366F1; }
.swap-btn:active { opacity: 0.7; transform: scale(0.97); }

.do-btn-wrap { padding: 20rpx 30rpx; }
.do-btn { background: linear-gradient(135deg, #6366F1, #8B5CF6); border-radius: 16rpx; padding: 28rpx; text-align: center; color: #fff; font-size: 32rpx; font-weight: bold; }
.do-btn:active { opacity: 0.85; transform: scale(0.97); }
.do-btn.disabled { opacity: 0.5; }

.result-section { padding: 30rpx; text-align: center; }
.result-title { font-size: 30rpx; color: #22C55E; font-weight: bold; display: block; }
.download-btn { margin-top: 20rpx; background: #22C55E; border-radius: 14rpx; padding: 24rpx; color: #fff; font-size: 28rpx; display: inline-block; }
.download-btn:active { opacity: 0.85; }
