  },
  "entries": {
    "正官格": {
      "category": "格局",
      "key": "正官格",
      "取格": "月令透出正官，或月支正官藏透，日主与官星生克有情",
      "喜": "印绶护官，财星生官",
      "忌": "伤官（伤官见官），刑冲月令",
      "口诀": "旺官持世平步青云，父旺官生叨蒙赠爵——《增删卜易》",
      "出处": "子平真诠",
      "tags": [
        "正官",
        "格局"
      ],
      "典型": "甲日庚月（庚为七杀非正官）；癸日甲月（甲为伤官，伤官见官大忌）",
      "取法": "月令透出正官",
      "贵格": "官印双清，天干无混杂"
    },
    "偏官格": {
      "category": "格局",
      "key": "偏官格",
      "取格": "七杀月令透出，日主须有力制杀或合杀",
      "喜": [
        "食神制杀（食神制杀最为上）",
        "印绶化杀（杀印相生）",
        "身旺任杀"
      ],
      "忌": [
        "官杀混杂",
        "财星生杀（财生杀旺）",
        "日主太弱无制"
      ],
      "口诀": "杀重身轻先富后贫，制杀太过贫夭双至",
      "出处": "子平真诠",
      "tags": [
        "偏官",
        "格局"
      ],
      "典型": "甲日庚月（庚金七杀）须丙丁制庚或戊己合杀"
    },
    "正印格": {
      "category": "格局",
      "key": "正印格",
      "取格": "月令透出正印，印星生扶日主",
      "喜": "官生印，身强为用",
      "忌": "财破印，印旺无官",
      "口诀": "印旺逢财主祖业破败，印弱需财反成富贵",
      "出处": "子平真诠",
      "tags": [
        "正印",
        "格局"
      ],
      "典型": "甲日亥月（亥中壬水为正印）",
      "取法": "月令透出正印",
      "贵格": "官印双清（文官贵格）"
    },
    "偏印格": {
      "category": "格局",
      "key": "偏印格",
      "取格": "月令透出偏印（枭神），偏印克食神为枭神夺食",
      "喜": "有制（官制偏印），食神制之",
      "忌": "食神被枭，孤独偏激",
      "口诀": "枭神夺食主孤克，有制则贵无制则凶",
      "出处": "子平真诠",
      "tags": [
        "偏印",
        "格局"
      ],
      "取法": "月令透出偏印",
      "贵格": "偏印配官（偏才出众）"
    },
    "正财格": {
      "category": "格局",
      "key": "正财格",
      "取格": "月令透出正财，财星旺相有力",
      "喜": "身强能任财，比劫不现或有制",
      "忌": "比劫夺财，财星入墓",
      "口诀": "财旺身弱枉为劳，身旺财旺富贵全",
      "出处": "子平真诠",
      "tags": [
        "正财",
        "格局"
      ],
      "取法": "月令透出正财",
      "贵格": "财官双美，身财两停"
    },
    "偏财格": {
      "category": "格局",
      "key": "偏财格",
      "取格": "月令透出偏财，偏财主意外财、父缘、商贸",
      "喜": "身强，财旺有库",
      "忌": "比劫多（群劫争财）",
      "口诀": "偏财格主经商贸易，身旺最宜，比劫最忌",
      "出处": "子平真诠",
      "tags": [
        "偏财",
        "格局"
      ],
      "取法": "月令透出偏财",
      "贵格": "偏财生官，广结人脉"
    },
    "食神格": {
      "category": "格局",
      "key": "食神格",
      "取格": "月令透出食神，食神为我所生之秀气",
      "喜": "生财，制杀",
      "忌": "枭神（偏印）夺食，逢官（伤官见官同论）",
      "口诀": "食神有财谓之进神，食神制杀谓之英雄，食神见枭谓之夺食大凶",
      "出处": "子平真诠",
      "tags": [
        "食神",
        "格局"
      ],
      "取法": "月令透出食神",
      "贵格": "食神制杀（最贵），食神生财（富格）"
    },
    "伤官格": {
      "category": "格局",
      "key": "伤官格",
      "取格": "月令透出伤官，伤官为日主所生之泄气神",
      "喜": "佩印（伤官配印），生财",
      "忌": "见官（伤官见官非灾即祸）",
      "口诀": "伤官见官果难辨，可见不可见——《滴天髓》",
      "出处": "子平真诠",
      "tags": [
        "伤官",
        "格局"
      ],
      "取法": "月令透出伤官",
      "贵格": "伤官佩印（聪明贵格），伤官生财"
    },
    "从财格": {
      "category": "格局",
      "key": "从财格",
      "取格": "日主极弱，财星极旺，无比劫印星救助，弃命从财",
      "喜": [
        "财星旺相",
        "官星（财生官）",
        "无比劫印星破格"
      ],
      "忌": [
        "比劫出现（破格）",
        "印星出现（印制从）"
      ],
      "口诀": "真从之象有几人，假从亦可发其身——《滴天髓》",
      "出处": "子平真诠",
      "tags": [
        "从财",
        "格局"
      ]
    },
    "从杀格": {
      "category": "格局",
      "key": "从杀格",
      "取格": "日主极弱，杀星极旺，弃命从杀",
      "喜": [
        "七杀旺相",
        "财星生杀",
        "无比劫印绶"
      ],
      "忌": [
        "食伤出现（食伤制杀破格）",
        "印星出现（印化杀破格）"
      ],
      "口诀": "从杀格忌食伤制杀，宜顺其势而行",
      "出处": "子平真诠",
      "tags": [
        "从杀",
        "格局"
      ]
    },
    "从儿格": {
      "category": "格局",
      "key": "从儿格",
      "取格": "日主极弱，食伤极旺，弃命从儿（从食伤）",
      "喜": [
        "食伤旺相有根",
        "财星（食伤生财）",
        "无印绶"
      ],
      "忌": [
        "印绶出现（印克食伤）",
        "官杀出现"
      ],
      "口诀": "一出门来只见儿，吾儿成气构门闾，从儿不管身强弱，只要吾儿又得儿——《滴天髓》",
      "出处": "子平真诠",
      "tags": [
        "从儿",
        "格局"
      ]
    },
    "专旺格": {
      "category": "格局",
      "key": "专旺格",
      "取格": "命局五行一气专旺（曲直/炎上/从革/润下/稼穑），不可破",
      "喜": [],
      "忌": [],
      "口诀": "专旺格忌破，破则大凶。顺则一生富贵，逆则困苦终身",
      "出处": "子平真诠",
      "tags": [
        "专旺",
        "格局"
      ],
      "分类": {
        "曲直格": "甲乙木日主，地支寅卯辰全，天干无金，木势专旺",
        "炎上格": "丙丁火日主，地支寅午戌全，木多火旺，无水制",
        "从革格": "庚辛金日主，地支申酉戌全，无火木",
        "润下格": "壬癸水日主，地支亥子丑全，无土制",
        "稼穑格": "戊己土日主，地支辰戌丑未全，无木疏"
      }
    },
    "化格": {
      "category": "格局",
      "key": "化格",
      "取格": "日主与月干合化，化神成格。五化：甲己化土、乙庚化金、丙辛化水、丁壬化木、戊癸化火",
      "喜": [],
      "忌": [],
      "口诀": "化得真者只论化，化神还有几般话——《滴天髓》",
      "出处": "子平真诠",
      "tags": [
        "化",
        "格局"
      ],
      "成格条件": "须月令支持化神、化神透干、无阻隔"
    },
    "七杀格": {
      "category": "格局",
      "key": "七杀格",
      "出处": "子平真诠",
      "tags": [
        "七杀",
        "格局"
      ],
      "取法": "月令透出七杀",
      "喜": "食神制杀，印化杀",
      "忌": "制杀太过（杀被制死），逢比劫帮杀",
      "贵格": "食神制杀（英雄格），杀印相生"
    },
    "用神_扶抑": {
      "category": "用神",
      "key": "扶抑",
      "原文": "扶弱抑强，日主弱则用印比帮身，强则用官杀食伤泄耗",
      "出处": "子平真诠",
      "tags": [
        "扶抑",
        "用神"
      ]
    },
    "用神_调候": {
      "category": "用神",
      "key": "调候",
      "原文": "《穷通宝鉴》寒暖燥湿调和，主要参考月令气候",
      "出处": "子平真诠",
      "tags": [
        "调候",
        "用神"
      ]
    },
    "用神_通关": {
      "category": "用神",
      "key": "通关",
      "原文": "两神争战，取通关之神化解",
      "出处": "子平真诠",
      "tags": [
        "通关",
        "用神"
      ]
    },
    "用神_病药": {
      "category": "用神",
      "key": "病药",
      "原文": "命局有病，取药神为用；有病有药才是贵命",
      "出处": "子平真诠",
      "tags": [
        "病药",
        "用神"
      ]
    },
    "用神_专旺": {
      "category": "用神",
      "key": "专旺",
      "原文": "五行一气专旺，随势为用",
      "出处": "子平真诠",
      "tags": [
        "专旺",
        "用神"
      ]
    },
    "月令_说明": {
      "category": "月令",
      "key": "说明",
      "原文": "月令是格局的根本，月令所藏之干透出则成格；月令为四柱之提纲",
      "出处": "子平真诠",
      "tags": [
        "说明",
        "月令"
      ]
    },
    "月令_透干成格": {
      "category": "月令",
      "key": "透干成格",
      "原文": "月支藏干透出天干，以该干定格",
      "出处": "子平真诠",
      "tags": [
        "透干成格",
        "月令"
      ]
    },
    "月令_多干取格": {
      "category": "月令",
      "key": "多干取格",
      "原文": "月支多藏干均透出，以最旺者定格",
      "出处": "子平真诠",
      "tags": [
        "多干取格",
        "月令"
      ]
    },
    "月令_不透取藏": {
      "category": "月令",
      "key": "不透取藏",
      "原文": "月支藏干无一透出，则看藏干中最旺者成变格",
      "出处": "子平真诠",
      "tags": [
        "不透取藏",
        "月令"
      ]
    }
  }
}