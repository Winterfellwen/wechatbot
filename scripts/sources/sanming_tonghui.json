    "年柱": {
      "category": "宫位",
      "key": "年柱",
      "宫位": "祖宗、先天根基、家族背景、早年运势（0-15岁）",
      "六亲": "年干为祖父，年支为祖母（男命）；女命年干为祖父，年支为祖母",
      "断法": "年柱有财则祖上有财，有印则书香门第，有杀则有官职背景",
      "出处": "三命通会",
      "tags": [
        "年柱",
        "宫位",
        "六亲"
      ]
    },
    "月柱": {
      "category": "宫位",
      "key": "月柱",
      "宫位": "父母兄弟、工作事业、中年运（15-35岁），月令为格局之本",
      "六亲": "月干为父（男命）、兄弟；月支为母（含义丰富）",
      "断法": "月柱最重要，格局取用皆看月令，月支为命主之胎元所在",
      "出处": "三命通会",
      "tags": [
        "月柱",
        "宫位",
        "六亲"
      ]
    },
    "日柱": {
      "category": "宫位",
      "key": "日柱",
      "宫位": "本人、婚姻宫、夫妻关系（日支为配偶宫），中年运（35-50岁）",
      "六亲": "日干为命主自身，日支为配偶宫",
      "断法": "日支旺相则婚姻稳固，日支受冲刑则婚姻动荡",
      "出处": "三命通会",
      "tags": [
        "日柱",
        "宫位",
        "六亲"
      ]
    },
    "时柱": {
      "category": "宫位",
      "key": "时柱",
      "宫位": "子女、晚年运（50岁以后）、晚景",
      "六亲": "时干为长子，时支为子女",
      "断法": "时柱有子孙星旺则子女多且孝顺，时柱受克则晚年孤苦",
      "出处": "三命通会",
      "tags": [
        "时柱",
        "宫位",
        "六亲"
      ]
    },
    "六亲_父母": {
      "category": "六亲",
      "key": "父母",
      "原文": "正印偏印为母，正财偏财为父（男命）；年柱为祖辈宫位",
      "出处": "三命通会",
      "tags": [
        "父母",
        "六亲"
      ]
    },
    "六亲_配偶": {
      "category": "六亲",
      "key": "配偶",
      "原文": "男命正财为妻，偏财为妾/外遇；女命正官为夫，七杀为情人。日支为配偶宫",
      "出处": "三命通会",
      "tags": [
        "配偶",
        "六亲"
      ]
    },
    "六亲_子女": {
      "category": "六亲",
      "key": "子女",
      "原文": "男命食神伤官为子女；女命官杀为子女。时柱为子女宫",
      "出处": "三命通会",
      "tags": [
        "子女",
        "六亲"
      ]
    },
    "六亲_兄弟": {
      "category": "六亲",
      "key": "兄弟",
      "原文": "比肩劫财为兄弟姐妹，月柱为兄弟宫",
      "出处": "三命通会",
      "tags": [
        "兄弟",
        "六亲"
      ]
    },
    "六亲_财运": {
      "category": "六亲",
      "key": "财运",
      "原文": "正财偏财代表财富，财旺身强则富，财多身弱则为财所累",
      "出处": "三命通会",
      "tags": [
        "财运",
        "六亲"
      ]
    },
    "六亲_官运": {
      "category": "六亲",
      "key": "官运",
      "原文": "正官七杀代表权威地位，官旺印绶护身则贵，官杀混杂则纷扰",
      "出处": "三命通会",
      "tags": [
        "官运",
        "六亲"
      ]
    },
