.container { min-height: 100vh; background: #F8FAFC; padding: 30rpx; }

.header { padding: 40rpx 30rpx; background: linear-gradient(135deg, #6366F1, #8B5CF6); border-radius: 20rpx; text-align: center; margin-bottom: 40rpx; }
.title { font-size: 40rpx; font-weight: bold; color: #fff; display: block; }
.subtitle { font-size: 26rpx; color: rgba(255,255,255,0.8); display: block; margin-top: 8rpx; }

.upload-section { margin-bottom: 40rpx; }
.upload-box { border: 4rpx dashed #CBD5E1; border-radius: 20rpx; padding: 80rpx 20rpx; text-align: center; background: #fff; }
.upload-icon { font-size: 80rpx; color: #6366F1; display: block; }
.upload-text { font-size: 32rpx; color: #333; display: block; margin-top: 16rpx; font-weight: bold; }
.upload-hint { font-size: 24rpx; color: #94A3B8; display: block; margin-top: 10rpx; }

.process-section { background: #fff; border-radius: 16rpx; padding: 30rpx; margin-bottom: 40rpx; box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06); }
.file-info { margin-bottom: 20rpx; }
.file-name { font-size: 30rpx; color: #333; font-weight: bold; display: block; }
.file-size { font-size: 24rpx; color: #94A3B8; display: block; margin-top: 6rpx; }

.convert-btn { width: 100%; padding: 24rpx; background: linear-gradient(135deg, #6366F1, #8B5CF6); border-radius: 14rpx; color: #fff; font-size: 32rpx; font-weight: bold; text-align: center; box-shadow: 0 6rpx 20rpx rgba(99,102,241,0.3); border: none; line-height: 1.5; }
.convert-btn[disabled] { opacity: 0.5; }

.history-section { margin-bottom: 40rpx; }
.section-title { font-size: 28rpx; color: #64748B; display: block; margin-bottom: 16rpx; font-weight: bold; }
.history-list { background: #fff; border-radius: 16rpx; overflow: hidden; box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06); }
.history-item { padding: 28rpx 30rpx; border-bottom: 2rpx solid #F1F5F9; display: flex; justify-content: space-between; align-items: center; }
.history-item:last-child { border-bottom: none; }
.history-name { font-size: 28rpx; color: #333; }
.history-status { font-size: 24rpx; color: #10B981; }

.tips { background: #fff; border-radius: 16rpx; padding: 30rpx; box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06); }
.tips-title { font-size: 28rpx; font-weight: bold; color: #333; display: block; margin-bottom: 16rpx; }
.tips-item { font-size: 26rpx; color: #64748B; display: block; line-height: 1.8; }