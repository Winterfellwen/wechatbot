<view class="container">
  <view class="toolbar">
    <button class="tool-btn" bindtap="togglePreview">
      {{previewMode ? '✎ 编辑' : '👁 预览'}}
    </button>
    <button class="tool-btn export-btn" bindtap="showExportMenu">导出</button>
  </view>

  <view class="loading" wx:if="{{loading}}">加载中...</view>

  <!-- 编辑模式 -->
  <view class="editor-wrap" wx:if="{{!previewMode && !loading}}">
    <editor
      id="editor"
      class="editor"
      placeholder="文档内容..."
      show-img-size
      show-img-toolbar
      bindready="onEditorReady"
      bindinput="onEditorInput"
    ></editor>
  </view>

  <!-- 预览模式 -->
  <view class="preview-wrap" wx:if="{{previewMode && !loading}}">
    <rich-text nodes="{{previewNodes}}" class="preview-content"></rich-text>
  </view>

  <!-- 底部提示 -->
  <view class="bottom-tip" wx:if="{{!loading}}">
    <text>提示：点击"编辑"可修改内容，修改后再导出</text>
  </view>
</view>