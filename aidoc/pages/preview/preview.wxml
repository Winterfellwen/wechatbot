<view class="container">
  <view class="toolbar">
    <button class="tool-btn" bindtap="aiReview" disabled="{{reviewing}}">
      {{reviewing ? 'AI修正中...' : 'AI修正'}}
    </button>
    <button class="tool-btn download-btn" bindtap="downloadPdf">下载PDF</button>
  </view>

  <view class="preview-wrap">
    <rich-text nodes="{{htmlNodes}}" class="preview-content"></rich-text>
  </view>
</view>