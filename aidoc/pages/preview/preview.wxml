<view class="container">
  <view class="toolbar">
    <button class="tool-btn" bindtap="toggleEdit" disabled="{{loading}}">
      {{editMode ? '👁 预览' : '✎ 编辑'}}
    </button>
    <button class="tool-btn export-btn" bindtap="showExportMenu">导出</button>
  </view>

  <view class="loading" wx:if="{{loading}}">加载中...</view>

  <!-- 编辑模式：显示HTML可编辑 -->
  <view class="webview-wrap" wx:if="{{editMode && !loading}}">
    <web-view src="{{editUrl}}"></web-view>
  </view>

  <!-- 预览模式：显示HTML只读 -->
  <view class="webview-wrap" wx:if="{{!editMode && !loading}}">
    <web-view src="{{htmlUrl}}"></web-view>
  </view>

  <view class="tip" wx:if="{{!loading}}">
    <text>{{editMode ? '在页面中直接点击文字可编辑' : '预览模式，无法编辑'}}</text>
  </view>
</view>