<view class="container">
  <view class="toolbar">
    <button class="tool-btn" bindtap="aiReview" disabled="{{reviewing}}">
      {{reviewing ? 'AI修正中...' : 'AI修正'}}
    </button>
    <button class="tool-btn download-btn" bindtap="openPdf">查看PDF</button>
  </view>

  <view class="info">
    <text class="info-text">文件已转换完成</text>
    <text class="info-hint">点击"查看PDF"用手机自带查看器打开</text>
  </view>

  <view class="tips">
    <text class="tips-title">使用说明</text>
    <text class="tips-item">1. 点击"查看PDF"打开文档</text>
    <text class="tips-item">2. 支持左右滑动翻页</text>
    <text class="tips-item">3. 双指缩放查看细节</text>
    <text class="tips-item">4. 点击"AI修正"优化格式后再导出</text>
  </view>
</view>