.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f5f5f5;
}

.toolbar {
  display: flex;
  gap: 20rpx;
  padding: 20rpx;
  background: #fff;
  border-bottom: 2rpx solid #eee;
}

.tool-btn {
  flex: 1;
  padding: 20rpx;
  background: #1890ff;
  color: #fff;
  border: none;
  border-radius: 10rpx;
  font-size: 28rpx;
}

.export-btn {
  background: #52c41a;
}

.loading {
  padding: 100rpx;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}

.editor-wrap {
  flex: 1;
  background: #fff;
}

.editor {
  width: 100%;
  height: 100%;
  min-height: 500rpx;
}

.preview-wrap {
  flex: 1;
  padding: 30rpx;
  background: #fff;
  overflow-y: auto;
}

.preview-content {
  font-size: 28rpx;
  line-height: 1.8;
  color: #333;
}

.preview-content img {
  max-width: 100%;
  height: auto;
}

.bottom-tip {
  padding: 20rpx;
  text-align: center;
  background: #fff;
  border-top: 2rpx solid #eee;
}

.bottom-tip text {
  font-size: 24rpx;
  color: #999;
}