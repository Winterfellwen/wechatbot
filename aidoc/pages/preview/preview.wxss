.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f5f5f5;
}

.toolbar {
  display: flex;
  gap: 20rpx;
  padding: 20rpx;
  background: #fff;
  border-bottom: 2rpx solid #eee;
  flex-shrink: 0;
}

.tool-btn {
  flex: 1;
  padding: 20rpx;
  background: #1890ff;
  color: #fff;
  border: none;
  border-radius: 10rpx;
  font-size: 28rpx;
}

.export-btn {
  background: #52c41a;
}

.webview-wrap {
  flex: 1;
  width: 100%;
}

.loading {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999;
  font-size: 28rpx;
}

.tip {
  padding: 20rpx;
  text-align: center;
  background: #fff;
  font-size: 24rpx;
  color: #666;
  flex-shrink: 0;
}