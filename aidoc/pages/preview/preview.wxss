.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  display: flex;
  flex-direction: column;
}

.toolbar {
  flex-shrink: 0;
  display: flex;
  gap: 20rpx;
  padding: 20rpx;
  background-color: #fff;
  border-bottom: 2rpx solid #eee;
}

.tool-btn {
  flex: 1;
  padding: 20rpx;
  background-color: #1890ff;
  color: #fff;
  border: none;
  border-radius: 10rpx;
  font-size: 28rpx;
}

.tool-btn[disabled] {
  background-color: #ccc;
}

.download-btn {
  background-color: #52c41a;
}

.preview-wrap {
  flex: 1;
  padding: 30rpx;
  background-color: #fff;
}

.preview-content {
  display: block;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  line-height: 1.8;
  color: #333;
}

.preview-content page {
  display: block;
  margin-bottom: 30rpx;
  padding: 20rpx;
  border: 2rpx solid #ddd;
  background: #fff;
}

.preview-content h3 {
  margin: 20rpx 0 10rpx;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.preview-content pre {
  white-space: pre-wrap;
  word-wrap: break-word;
  margin: 10rpx 0;
  font-family: inherit;
  font-size: inherit;
  line-height: inherit;
}

.preview-content img {
  max-width: 100%;
  height: auto;
  display: block;
  margin: 20rpx 0;
}