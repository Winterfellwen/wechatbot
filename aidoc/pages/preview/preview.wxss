.container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

.toolbar {
  display: flex;
  padding: 10px 20px;
  background-color: #fff;
  border-bottom: 1px solid #eee;
  position: sticky;
  top: 0;
  z-index: 100;
}

.tool-btn {
  flex: 1;
  margin: 0 5px;
  padding: 10px;
  background-color: #1890ff;
  color: #fff;
  border: none;
  border-radius: 5px;
  font-size: 14px;
}

.tool-btn[disabled] {
  background-color: #ccc;
}

.html-content {
  padding: 20px;
  background-color: #fff;
  min-height: calc(100vh - 60px);
}

.loading {
  padding: 40px;
  text-align: center;
  color: #999;
  font-size: 14px;
}