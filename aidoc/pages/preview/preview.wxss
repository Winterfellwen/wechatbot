.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

.toolbar {
  flex-shrink: 0;
  display: flex;
  gap: 20rpx;
  padding: 20rpx;
  background: #fff;
  border-bottom: 2rpx solid #eee;
}

.tool-btn {
  flex: 1;
  padding: 20rpx;
  background: #1890ff;
  color: #fff;
  border: none;
  border-radius: 10rpx;
  font-size: 28rpx;
}

.tool-btn[disabled] {
  background: #ccc;
}

.download-btn {
  background: #52c41a;
}

.webview-wrap {
  flex: 1;
  width: 100%;
}
