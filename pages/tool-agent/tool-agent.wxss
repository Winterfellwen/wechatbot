/* pages/tool-agent/tool-agent.wxss */

.container {
  min-height: 100vh;
  background: #F8FAFC;
  padding-bottom: env(safe-area-inset-bottom);
}

.page-header {
  padding: 48rpx 32rpx 24rpx;
  display: flex;
  flex-direction: column;
}

.page-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1E293B;
}

.page-subtitle {
  font-size: 24rpx;
  color: #64748B;
  margin-top: 8rpx;
}

.section {
  padding: 0 24rpx;
  margin-top: 16rpx;
}

.entry-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.entry-card {
  width: calc(50% - 12rpx);
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx 24rpx;
  margin-bottom: 20rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
  position: relative;
  overflow: hidden;
  cursor: pointer;
  min-height: 220rpx;
}

.entry-card:active {
  transform: scale(0.96);
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.entry-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4rpx;
}

.card-word::before { background: linear-gradient(90deg, #2563EB, #3B82F6); }
.card-pdf::before { background: linear-gradient(90deg, #ff922b, #f76707); }
.card-ai-order::before { background: linear-gradient(90deg, #f093fb, #f5576c); }

.entry-card::after {
  content: '';
  position: absolute;
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  top: -40rpx;
  right: -40rpx;
  opacity: 0.06;
  transition: opacity 0.2s ease;
}

.card-word::after { background: #339af0; }
.card-pdf::after { background: #ff922b; }
.card-ai-order::after { background: #f5576c; }

.entry-card:active::after {
  opacity: 0.1;
}

.card-icon-wrap {
  width: 100rpx;
  height: 100rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
  min-width: 88rpx;
  min-height: 88rpx;
  transition: transform 0.2s ease;
}

.entry-card:active .card-icon-wrap {
  transform: scale(0.95);
}

.icon-bg-word {
  background: linear-gradient(135deg, #eff6ff, #dbeafe);
  box-shadow: 0 6rpx 20rpx rgba(37, 99, 235, 0.2);
}

.icon-bg-pdf {
  background: linear-gradient(135deg, #fff7ed, #ffedd5);
  box-shadow: 0 6rpx 20rpx rgba(255, 146, 43, 0.2);
}

.icon-bg-ai-order {
  background: linear-gradient(135deg, #fff0f3, #ffe0e6);
  box-shadow: 0 6rpx 20rpx rgba(245, 87, 108, 0.2);
}

.icon-word-body {
  width: 56rpx;
  height: 56rpx;
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #2563EB, #3B82F6);
  border-radius: 8rpx;
}

.icon-word-fold {
  position: absolute;
  top: 0;
  right: 0;
  width: 16rpx;
  height: 16rpx;
  background: linear-gradient(225deg, rgba(255,255,255,0.1) 50%, rgba(255,255,255,0.3) 50%);
}

.icon-word-letter {
  color: #ffffff;
  font-size: 32rpx;
  font-weight: bold;
  font-family: Georgia, serif;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.15);
}

.icon-ai-order-text {
  font-size: 48rpx;
}

.entry-icon {
  width: 56rpx;
  height: 56rpx;
}

.entry-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1E293B;
  margin-bottom: 8rpx;
}

.entry-desc {
  font-size: 22rpx;
  color: #64748B;
  margin-top: 8rpx;
  line-height: 1.4;
}
