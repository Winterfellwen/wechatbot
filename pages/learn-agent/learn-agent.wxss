/* pages/learn-agent/learn-agent.wxss */

.container {
  min-height: 100vh;
  background: #F8FAFC;
  padding-bottom: env(safe-area-inset-bottom);
}

.page-header {
  padding: 48rpx 32rpx 24rpx;
  display: flex;
  flex-direction: column;
}

.page-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1E293B;
}

.page-subtitle {
  font-size: 24rpx;
  color: #64748B;
  margin-top: 8rpx;
}

.section {
  padding: 0 24rpx;
  margin-top: 16rpx;
}

.entry-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.entry-card {
  width: calc(50% - 12rpx);
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx 24rpx;
  margin-bottom: 20rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
  position: relative;
  overflow: hidden;
  cursor: pointer;
  min-height: 220rpx;
}

.entry-card:active {
  transform: scale(0.96);
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.entry-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4rpx;
}

.card-japanese::before { background: linear-gradient(90deg, #ff6b6b, #ee5a24); }
.card-german::before { background: linear-gradient(90deg, #51cf66, #37b24d); }
.card-teacher::before { background: linear-gradient(90deg, #2563EB, #764ba2); }

.entry-card::after {
  content: '';
  position: absolute;
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  top: -40rpx;
  right: -40rpx;
  opacity: 0.06;
  transition: opacity 0.2s ease;
}

.card-japanese::after { background: #ff6b6b; }
.card-german::after { background: #51cf66; }
.card-teacher::after { background: #764ba2; }

.entry-card:active::after {
  opacity: 0.1;
}

.card-icon-wrap {
  width: 100rpx;
  height: 100rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
  min-width: 88rpx;
  min-height: 88rpx;
  transition: transform 0.2s ease;
}

.entry-card:active .card-icon-wrap {
  transform: scale(0.95);
}

.icon-bg-japanese {
  background: linear-gradient(135deg, #fff5f5, #ffe0e0);
  box-shadow: 0 6rpx 20rpx rgba(255, 107, 107, 0.2);
}

.icon-bg-german {
  background: linear-gradient(135deg, #fffbeb, #fef3c7);
  box-shadow: 0 6rpx 20rpx rgba(81, 207, 102, 0.2);
}

.icon-bg-teacher {
  background: linear-gradient(135deg, #eff6ff, #ede9fe);
  box-shadow: 0 6rpx 20rpx rgba(37, 99, 235, 0.2);
}

.entry-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 12rpx;
}

.entry-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1E293B;
  margin-bottom: 8rpx;
}

.entry-desc {
  font-size: 22rpx;
  color: #64748B;
  margin-top: 8rpx;
  line-height: 1.4;
}
