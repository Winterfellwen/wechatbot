<view class="container">
  <view class="hero">
    <image class="hero-icon" src="{{heroIcon}}" mode="aspectFit"></image>
    <text class="hero-title">学习Agent</text>
    <text class="hero-desc">选择你想学习的外语</text>
  </view>

  <view class="grid">
    <view class="card {{entry.cardClass}}" bindtap="handleEntryTap" data-type="{{entry.type}}" wx:for="{{entries}}" wx:for-item="entry" wx:key="type">
      <view class="card-icon-wrap {{entry.bgClass}}">
        <image class="entry-icon" src="{{entry.icon}}" mode="aspectFit"></image>
      </view>
      <text class="card-title">{{entry.title}}</text>
      <text class="card-desc">{{entry.desc}}</text>
    </view>
  </view>

  <view class="footer">
    <text class="footer-text">更多语言学习即将推出</text>
  </view>
</view>
