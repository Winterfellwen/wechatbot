.container {
  min-height: 100vh;
  background: #F8FAFC;
  padding-bottom: env(safe-area-inset-bottom);
}

.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 30rpx 40rpx;
}

.hero-icon {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 20rpx;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1E293B;
  margin-bottom: 12rpx;
}

.hero-desc {
  font-size: 26rpx;
  color: #64748B;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  padding: 0 24rpx;
}

.card {
  width: calc(50% - 12rpx);
  background: #ffffff;
  border-radius: 24rpx;
  padding: 40rpx 24rpx;
  margin-bottom: 20rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.06);
  position: relative;
  overflow: hidden;
  cursor: pointer;
}

.card:active {
  transform: scale(0.96);
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.08);
}

.card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4rpx;
}

.card-japanese::before { background: linear-gradient(90deg, #ff6b6b, #ee5a24); }
.card-german::before { background: linear-gradient(90deg, #51cf66, #37b24d); }

.card-icon-wrap {
  width: 100rpx;
  height: 100rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  min-width: 88rpx;
  min-height: 88rpx;
}

.bg-japanese {
  background: linear-gradient(135deg, #fff5f5, #ffe0e0);
  box-shadow: 0 6rpx 20rpx rgba(255,107,107,0.2);
}

.bg-german {
  background: linear-gradient(135deg, #fffbeb, #fef3c7);
  box-shadow: 0 6rpx 20rpx rgba(81,207,102,0.2);
}

.entry-icon {
  width: 56rpx;
  height: 56rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1E293B;
  margin-bottom: 8rpx;
}

.card-desc {
  font-size: 22rpx;
  color: #64748B;
}

.footer {
  text-align: center;
  padding: 40rpx 24rpx 80rpx;
}

.footer-text {
  font-size: 22rpx;
  color: #94A3B8;
}
