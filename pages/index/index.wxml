<!--pages/index/index.wxml-->
<view class="container">
  <!-- 顶部用户信息栏 -->
  <view class="user-header" bindtap="handleUserTap">
    <view class="header-bg"></view>
    <view class="user-info">
      <view class="avatar-wrap">
        <image class="user-avatar" src="{{displayUserInfo.avatarUrl}}" mode="aspectFill" binderror="onAvatarError"></image>
      </view>
      <view class="user-detail">
        <text class="user-greeting">{{greeting}}</text>
        <text class="user-nickname">{{displayUserInfo.nickName}}</text>
        <text class="user-status">{{isLoggedIn ? '欢迎回来' : '点击头像登录'}}</text>
      </view>
    </view>
  </view>

  <!-- 快捷功能区 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">AI功能</text>
    </view>
    <view class="entry-grid">
      <view class="entry-card card-learn" bindtap="handleEntryTap" data-type="learn">
        <view class="card-icon-wrap icon-bg-learn">
          <text class="icon-learn-text">📚</text>
        </view>
        <text class="entry-title">学习Agent</text>
        <text class="entry-desc">日语、德语、智能老师</text>
      </view>

      <view class="entry-card card-tool" bindtap="handleEntryTap" data-type="tool">
        <view class="card-icon-wrap icon-bg-tool">
          <text class="icon-tool-text">🛠️</text>
        </view>
        <text class="entry-title">工具Agent</text>
        <text class="entry-desc">Word、PDF、AI点菜</text>
      </view>

      <view class="entry-card card-cloud" bindtap="handleEntryTap" data-type="cloud">
        <view class="card-icon-wrap icon-bg-cloud">
          <text class="icon-cloud-text">☁️</text>
        </view>
        <text class="entry-title">AI云管理</text>
        <text class="entry-desc">多云服务管理面板</text>
      </view>
    </view>
  </view>

  <!-- 底部注脚 -->
  <view class="footer">
    <text class="footer-text">温信锐(Peter Wen)AI功能测试小程序</text>
  </view>
</view>
