<!--pages/index/index.wxml-->
<view class="container">
  <!-- 顶部用户信息栏 -->
  <view class="user-header" bindtap="handleUserTap">
    <view class="header-bg"></view>
    <view class="user-info">
      <view class="avatar-wrap">
        <image class="user-avatar" src="{{displayUserInfo.avatarUrl}}" mode="aspectFill" binderror="onAvatarError"></image>
      </view>
      <view class="user-detail">
        <text class="user-greeting">{{greeting}}</text>
        <text class="user-nickname">{{displayUserInfo.nickName}}</text>
        <text class="user-status">{{isLoggedIn ? '欢迎回来' : '点击头像登录'}}</text>
      </view>
    </view>
  </view>

  <!-- 快捷功能区 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">学习工具</text>
    </view>
    <view class="entry-grid">
      <view class="entry-card card-learn" bindtap="handleEntryTap" data-type="learn-hub">
        <view class="card-icon-wrap icon-bg-learn">
          <canvas type="2d" id="icon-learn" class="icon-canvas"></canvas>
        </view>
        <text class="entry-title">学习Agent</text>
        <text class="entry-desc">日语 / 德语学习</text>
      </view>

      <view class="entry-card card-tool" bindtap="handleEntryTap" data-type="tool-hub">
        <view class="card-icon-wrap icon-bg-tool">
          <canvas type="2d" id="icon-tool" class="icon-canvas"></canvas>
        </view>
        <text class="entry-title">办公Agent</text>
        <text class="entry-desc">Word / PDF工具</text>
      </view>

      <view class="entry-card card-ai-order" bindtap="handleEntryTap" data-type="ai-order">
        <view class="card-icon-wrap icon-bg-ai-order">
          <canvas type="2d" id="icon-order" class="icon-canvas"></canvas>
        </view>
        <text class="entry-title">AI点菜</text>
        <text class="entry-desc">智能推荐菜品</text>
      </view>
    </view>
  </view>

  <!-- 智能老师 - 突出卡片 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">智能助手</text>
    </view>
    <view class="teacher-card {{teacherVisible ? 'visible' : ''}}" bindtap="handleEntryTap" data-type="assistant">
      <view class="teacher-left">
        <view class="teacher-icon-wrap">
          <image class="teacher-icon" src="/images/avatar-teacher.jpg" mode="aspectFill"></image>
        </view>
      </view>
      <view class="teacher-info">
        <text class="teacher-title">智能助手</text>
        <text class="teacher-desc">反馈小程序问题，问学习问题，找到需要的功能</text>
      </view>
      <view class="teacher-arrow">
        <text class="arrow-icon"></text>
      </view>
    </view>
  </view>

  <!-- 底部注脚 -->
  <view class="footer">
    <text class="footer-text">温信锐(Peter Wen)AI功能测试小程序</text>
  </view>
</view>
