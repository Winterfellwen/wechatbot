<!--pages/index/index.wxml-->
<view class="container">
  <!-- 顶部用户信息栏 -->
  <view class="user-header" bindtap="handleUserTap">
    <view class="user-info">
      <image class="user-avatar" src="{{userInfo.avatarUrl || '/images/avatar-default.png'}}" mode="aspectFill"></image>
      <view class="user-detail">
        <text class="user-nickname">{{userInfo.nickName || '游客'}}</text>
        <text class="user-status">{{isLoggedIn ? '已登录' : '点击头像登录'}}</text>
      </view>
    </view>
  </view>

  <!-- 入口卡片区 -->
  <view class="entry-container">
    <view class="entry-grid">
      <view class="entry-card" bindtap="handleEntryTap" data-type="learn">
        <image class="entry-icon" src="/images/icon-learn.png" mode="aspectFit"></image>
        <text class="entry-title">日语学习</text>
        <text class="entry-desc">闯关学习</text>
      </view>

      <view class="entry-card" bindtap="handleEntryTap" data-type="wordbook">
        <image class="entry-icon" src="/images/icon-book.png" mode="aspectFit"></image>
        <text class="entry-title">单词本</text>
        <text class="entry-desc">背单词</text>
      </view>

      <view class="entry-card" bindtap="handleEntryTap" data-type="grammar">
        <image class="entry-icon" src="/images/icon-grammar.png" mode="aspectFit"></image>
        <text class="entry-title">语法</text>
        <text class="entry-desc">语法点</text>
      </view>

      <view class="entry-card" bindtap="handleEntryTap" data-type="leaderboard">
        <image class="entry-icon" src="/images/icon-rank.png" mode="aspectFit"></image>
        <text class="entry-title">排行榜</text>
        <text class="entry-desc">学习排名</text>
      </view>
    </view>
  </view>
</view>