/*pages/index/index.wxss*/
.header {
  background: linear-gradient(135deg, #FFFFFF 0%, #F1F5F9 100%);
  padding: 40rpx 32rpx;
  display: flex;
  align-items: center;
}

.user-info {
  display: flex;
  align-items: center;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background-color: #E2E8F0;
  border: 4rpx solid #FFFFFF;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.user-detail {
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
}

.nickname {
  font-size: 34rpx;
  font-weight: 600;
  color: #1E293B;
}

.status {
  font-size: 24rpx;
  color: #64748B;
  margin-top: 6rpx;
}

.header-arrow {
  width: 32rpx;
  height: 32rpx;
  margin-left: auto;
  opacity: 0.5;
}

.entry-container {
  padding: 16rpx 24rpx;
}

.entry-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.entry-card {
  width: calc(50% - 12rpx);
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 40rpx 24rpx;
  margin-bottom: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(37, 99, 235, 0.08);
  transition: all 0.2s ease;
}

.entry-card:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(37, 99, 235, 0.12);
}

.entry-icon {
  width: 96rpx;
  height: 96rpx;
  margin-bottom: 20rpx;
}

.entry-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1E293B;
}

.entry-desc {
  font-size: 22rpx;
  color: #64748B;
  margin-top: 8rpx;
}