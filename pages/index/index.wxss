/*pages/index/index.wxss*/

/* ========== 顶部用户区域 ========== */
.user-header {
  position: relative;
  padding: 40rpx 30rpx 50rpx;
  overflow: hidden;
}

.header-bg {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  z-index: 0;
}

.header-bg::after {
  content: '';
  position: absolute;
  width: 300rpx;
  height: 300rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
  top: -80rpx;
  right: -40rpx;
}

.header-bg::before {
  content: '';
  position: absolute;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.05);
  bottom: -60rpx;
  left: 40rpx;
}

.user-info {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
}

.avatar-wrap {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  padding: 4rpx;
  background: rgba(255, 255, 255, 0.3);
  flex-shrink: 0;
}

.user-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.2);
  border: 3rpx solid rgba(255, 255, 255, 0.5);
}

.user-detail {
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
}

.user-greeting {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.75);
  margin-bottom: 4rpx;
}

.user-nickname {
  font-size: 34rpx;
  font-weight: bold;
  color: #fff;
}

.user-status {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-top: 6rpx;
}

/* ========== 内容分区 ========== */
.section {
  padding: 0 24rpx;
  margin-top: 24rpx;
}

.section-header {
  margin-bottom: 16rpx;
  padding: 0 8rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  position: relative;
  padding-left: 16rpx;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 4rpx;
  bottom: 4rpx;
  width: 6rpx;
  border-radius: 3rpx;
  background: linear-gradient(180deg, #667eea 0%, #764ba2 100%);
}

/* ========== 功能卡片网格 ========== */
.entry-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.entry-card {
  width: calc(50% - 12rpx);
  background-color: #fff;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 20rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
  transition: transform 0.2s;
  position: relative;
  overflow: hidden;
}

.entry-card:active {
  transform: scale(0.97);
}

/* 卡片右上角装饰圆 */
.entry-card::after {
  content: '';
  position: absolute;
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  top: -40rpx;
  right: -40rpx;
  opacity: 0.08;
}

.card-japanese::after { background: #ff6b6b; }
.card-german::after { background: #51cf66; }
.card-word::after { background: #339af0; }
.card-pdf::after { background: #ff922b; }

/* 图标背景容器 */
.card-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}

.icon-bg-japanese {
  background: linear-gradient(135deg, #ff6b6b 0%, #ee5a24 100%);
  box-shadow: 0 6rpx 16rpx rgba(255, 107, 107, 0.3);
}

.icon-bg-german {
  background: linear-gradient(135deg, #51cf66 0%, #37b24d 100%);
  box-shadow: 0 6rpx 16rpx rgba(81, 207, 102, 0.3);
}

.icon-bg-word {
  background: linear-gradient(135deg, #339af0 0%, #1c7ed6 100%);
  box-shadow: 0 6rpx 16rpx rgba(51, 154, 240, 0.3);
}

.icon-bg-pdf {
  background: linear-gradient(135deg, #ff922b 0%, #f76707 100%);
  box-shadow: 0 6rpx 16rpx rgba(255, 146, 43, 0.3);
}

.entry-icon {
  width: 52rpx;
  height: 52rpx;
}

/* Word 图标特殊处理 */
.icon-word-body {
  width: 52rpx;
  height: 52rpx;
  position: relative;
  overflow: hidden;
}

.icon-word-fold {
  position: absolute;
  top: 0;
  right: 0;
  width: 16rpx;
  height: 16rpx;
  background: linear-gradient(225deg, rgba(255,255,255,0.1) 50%, rgba(255,255,255,0.25) 50%);
}

.icon-word-letter {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  text-align: center;
  color: #fff;
  font-size: 36rpx;
  font-weight: bold;
  font-family: Georgia, serif;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.15);
}

.entry-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a2e;
}

.entry-desc {
  font-size: 22rpx;
  color: #aaa;
  margin-top: 8rpx;
}

.entry-card.disabled { opacity: 0.5; }
.entry-card.disabled .entry-title { color: #999; }
.entry-icon.gray { filter: grayscale(100%); }

/* ========== 智能老师卡片 ========== */
.teacher-card {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  box-shadow: 0 8rpx 30rpx rgba(102, 126, 234, 0.3);
  position: relative;
  overflow: hidden;
}

.teacher-card:active {
  transform: scale(0.97);
}

.teacher-card::after {
  content: '';
  position: absolute;
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.06);
  top: -80rpx;
  right: -40rpx;
}

.teacher-card::before {
  content: '';
  position: absolute;
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.04);
  bottom: -50rpx;
  right: 80rpx;
}

.teacher-left {
  flex-shrink: 0;
}

.teacher-icon-wrap {
  width: 96rpx;
  height: 96rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(10rpx);
}

.teacher-emoji {
  font-size: 48rpx;
}

.teacher-info {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  position: relative;
  z-index: 1;
}

.teacher-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 8rpx;
}

.teacher-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.75);
  line-height: 1.4;
}

.teacher-arrow {
  flex-shrink: 0;
  margin-left: 16rpx;
  position: relative;
  z-index: 1;
}

.arrow-icon {
  font-size: 48rpx;
  color: rgba(255, 255, 255, 0.6);
  font-weight: 300;
}