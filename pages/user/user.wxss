/* pages/user/user.wxss - UI/UX Pro Max 优化版 */
/* 设计系统: Glassmorphism, Primary #2563EB */

.page {
  min-height: 100vh;
  background: #F8FAFC;
}

/* ========== 未登录区域 ========== */
.login-section {
  position: relative;
  min-height: 100vh;
  box-sizing: border-box;
}

.login-bg {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  height: 520rpx;
  background: linear-gradient(135deg, #2563EB 0%, #764ba2 100%);
  z-index: 0;
}

.login-bg::after {
  content: '';
  position: absolute;
  width: 300rpx;
  height: 300rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
  top: -60rpx;
  right: -40rpx;
  animation: pulse 3s ease-in-out infinite;
}

.login-content {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 180rpx;
}

.login-avatar-wrap {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  padding: 6rpx;
  background: rgba(255, 255, 255, 0.3);
}

.login-avatar {
  width: 148rpx;
  height: 148rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(255, 255, 255, 0.5);
}

.login-desc {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  margin: 30rpx 0 40rpx;
}

.login-btn {
  width: 400rpx;
  height: 88rpx;
  line-height: 88rpx;
  background: rgba(255, 255, 255, 0.25);
  color: #fff;
  border: 2rpx solid rgba(255, 255, 255, 0.4);
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 500;
  text-align: center;
  backdrop-filter: blur(10px);
  cursor: pointer;
  transition: all 0.2s ease;
  min-height: 88rpx;
}

.login-btn:active {
  transform: scale(0.97);
  background: rgba(255, 255, 255, 0.35);
}

.login-btn::after { border: 0; }

/* ========== 已登录 - 头部 ========== */
.profile-section {
  min-height: 100vh;
}

.profile-header {
  position: relative;
  padding: 60rpx 36rpx 48rpx;
  overflow: hidden;
}

.profile-bg {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, #2563EB 0%, #764ba2 100%);
  z-index: 0;
}

.profile-bg::after {
  content: '';
  position: absolute;
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
  top: -60rpx;
  right: -30rpx;
  animation: pulse 3.5s ease-in-out infinite 0.3s;
}

.profile-info {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
}

.avatar-btn {
  width: 128rpx;
  height: 128rpx;
  padding: 0;
  border: 0;
  background: transparent;
  line-height: 1;
  flex-shrink: 0;
  cursor: pointer;
  transition: transform 0.2s ease;
  min-width: 88rpx;
  min-height: 88rpx;
}

.avatar-btn:active {
  transform: scale(0.95);
}

.avatar-btn::after { border: 0; }

.profile-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.4);
  background: rgba(255, 255, 255, 0.2);
}

.profile-name-area {
  flex: 1;
  margin-left: 28rpx;
}

.nick-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.nickname {
  font-size: 38rpx;
  font-weight: 600;
  color: #fff;
}

.edit-badge {
  padding: 8rpx 20rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 20rpx;
  cursor: pointer;
  transition: background 0.2s ease, transform 0.2s ease;
  min-height: 44rpx;
  display: flex;
  align-items: center;
  animation: pulse 2s ease-in-out 3;
}

.edit-badge:active {
  background: rgba(255, 255, 255, 0.3);
  transform: scale(0.95);
}

.edit-badge-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.9);
}

.nick-input-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.nick-input {
  flex: 1;
  height: 72rpx;
  background: rgba(255, 255, 255, 0.15);
  border: 2rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  color: #fff;
}

.nick-input::placeholder {
  color: rgba(255, 255, 255, 0.6);
}

.btn-cancel {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
  padding: 12rpx 20rpx;
  cursor: pointer;
  transition: color 0.2s ease;
  min-height: 44rpx;
  display: flex;
  align-items: center;
}

.btn-cancel:active {
  color: rgba(255, 255, 255, 0.4);
}

.btn-confirm {
  font-size: 26rpx;
  color: #fff;
  font-weight: 600;
  padding: 12rpx 20rpx;
  cursor: pointer;
  transition: opacity 0.2s ease;
  min-height: 44rpx;
  display: flex;
  align-items: center;
}

.btn-confirm:active {
  opacity: 0.7;
}

/* ========== 操作卡片 ========== */
.action-card {
  margin: 24rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 0 8rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
}

.action-item {
  display: flex;
  align-items: center;
  padding: 32rpx 20rpx;
  cursor: pointer;
  transition: background 0.2s ease, transform 0.2s ease;
  min-height: 100rpx;
}

.action-item:active {
  background: #F8FAFC;
  transform: scale(0.97);
}

.action-item-danger:active {
  background: #FEF2F2;
  transform: scale(0.97);
}

.action-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  min-width: 88rpx;
  min-height: 88rpx;
}

.icon-logout {
  background: linear-gradient(135deg, #EFF6FF 0%, #DBEAFE 100%);
}

.icon-danger {
  background: linear-gradient(135deg, #FEF2F2 0%, #FEE2E2 100%);
}

.action-icon-text {
  font-size: 28rpx;
  font-weight: 600;
}

.icon-logout .action-icon-text {
  color: #2563EB;
}

.icon-danger .action-icon-text {
  color: #EF4444;
}

.action-text {
  flex: 1;
  margin-left: 20rpx;
  font-size: 30rpx;
  color: #1E293B;
  font-weight: 500;
}

.text-danger {
  color: #EF4444;
}

.action-arrow {
  font-size: 36rpx;
  color: #CBD5E1;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.action-divider {
  height: 1rpx;
  background: #F1F5F9;
  margin-left: 116rpx;
}

/* ========== 首次登录完善资料 ========== */
.first-setup-card {
  margin: 40rpx 30rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 50rpx 40rpx 40rpx;
  text-align: center;
  box-shadow: 0 8rpx 32rpx rgba(37, 99, 235, 0.08);
}

.first-setup-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1E293B;
  display: block;
  margin-bottom: 12rpx;
}

.first-setup-desc {
  font-size: 26rpx;
  color: #94A3B8;
  display: block;
  margin-bottom: 40rpx;
}

.setup-avatar-btn {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  padding: 0;
  margin: 0 auto 30rpx;
  position: relative;
  overflow: visible;
  border: none;
  background: transparent;
}
.setup-avatar-btn::after { border: none; }

.setup-avatar-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 4rpx solid #E2E8F0;
}

.setup-avatar-overlay {
  position: absolute;
  bottom: -8rpx;
  left: 50%;
  transform: translateX(-50%);
  background: #2563EB;
  border-radius: 20rpx;
  padding: 6rpx 24rpx;
  white-space: nowrap;
}

.setup-avatar-hint {
  font-size: 20rpx;
  color: #fff;
}

.setup-nick-row {
  margin-bottom: 36rpx;
}

.setup-nick-input {
  width: 100%;
  height: 88rpx;
  border: 2rpx solid #E2E8F0;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  text-align: center;
  box-sizing: border-box;
  background: #F8FAFC;
}

.setup-buttons {
  display: flex;
  gap: 20rpx;
}

.setup-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  padding: 0;
}

.setup-btn-skip {
  background: #F1F5F9;
  color: #64748B;
}

.setup-btn-save {
  background: #2563EB;
  color: #fff;
}
