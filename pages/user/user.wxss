/*pages/user/user.wxss*/
.user-header {
  background: linear-gradient(135deg, #FFFFFF 0%, #F1F5F9 100%);
  padding: 40rpx 32rpx;
  display: flex;
  align-items: center;
  border: none;
  margin: 0;
  width: 100%;
}

.user-header::after {
  display: none;
}

.user-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background-color: #E2E8F0;
  border: 4rpx solid #FFFFFF;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.user-info {
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
}

.user-nickname {
  font-size: 34rpx;
  font-weight: 600;
  color: #1E293B;
}

.user-status {
  font-size: 24rpx;
  color: #64748B;
  margin-top: 6rpx;
}

.user-content {
  padding: 24rpx;
}

.info-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 8rpx 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
}

.info-item {
  display: flex;
  justify-content: space-between;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #F1F5F9;
}

.info-item:last-child {
  border-bottom: none;
}

.info-label {
  color: #64748B;
  font-size: 28rpx;
}

.info-value {
  color: #1E293B;
  font-size: 28rpx;
  font-weight: 500;
}

.btn-group {
  margin-top: 32rpx;
  padding: 0;
}

.btn-primary {
  background: linear-gradient(135deg, #2563EB 0%, #3B82F6 100%);
  color: #FFFFFF;
  border-radius: 12rpx;
  padding: 24rpx 0;
  text-align: center;
  font-weight: 600;
  font-size: 30rpx;
}

.btn-primary:active {
  opacity: 0.9;
  transform: scale(0.98);
}