/*pages/user/user.wxss*/
.user-header {
  background-color: #fff;
  padding: 30rpx;
  display: flex;
  align-items: center;
}

.user-info {
  display: flex;
  align-items: center;
}

.avatar-btn {
  padding: 0; margin: 0; border: none; background: transparent;
  line-height: 1; width: 100rpx; height: 100rpx;
}
.avatar-btn::after { border: none; }
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background-color: #f0f0f0;
}

.user-detail {
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
}

.user-nickname {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.nickname-wrap { margin-bottom: 4rpx; }
.nickname-input {
  font-size: 32rpx; font-weight: bold; color: #333;
  height: 44rpx; line-height: 44rpx; padding: 0;
  background: transparent; border: none;
}
.nickname-input::placeholder { color: #bbb; font-weight: normal; }

.user-status {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.user-content {
  padding: 20rpx;
}

.info-card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 20rpx 30rpx;
}

.info-item {
  display: flex;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-item:last-child {
  border-bottom: none;
}

.info-label {
  color: #999;
  font-size: 28rpx;
}

.info-value {
  color: #333;
  font-size: 28rpx;
}

.info-value-wrap {
  display: flex;
  align-items: center;
}

.info-arrow {
  margin-left: 10rpx;
  color: #999;
}

.btn-group {
  margin-top: 40rpx;
  padding: 0 20rpx;
}

.btn-group + .btn-group {
  margin-top: 20rpx;
}

.btn-primary {
  background-color: #1890ff;
  color: #fff;
  border-radius: 10rpx;
  padding: 24rpx 0;
  text-align: center;
  font-size: 30rpx;
}

.btn-danger {
  background-color: #ff4d4f;
  color: #fff;
  border-radius: 10rpx;
  padding: 24rpx 0;
  text-align: center;
  font-size: 30rpx;
}