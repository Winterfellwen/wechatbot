<!--pages/user/user.wxml-->
<view class="container">
  <view class="user-header" bindtap="handleUserTap">
    <view class="user-info">
      <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar" wx:if="{{isLoggedIn}}">
        <image class="user-avatar" src="{{userInfo.avatarUrl || '/images/avatar-default.png'}}" mode="aspectFill"></image>
      </button>
      <image wx:else class="user-avatar" src="/images/avatar-default.png" mode="aspectFill"></image>
      <view class="user-detail">
        <view wx:if="{{isLoggedIn}}" class="nickname-wrap">
          <input class="nickname-input" type="nickname" value="{{userInfo.nickName}}" bindblur="onNicknameBlur" placeholder="点击设置昵称" />
        </view>
        <text wx:else class="user-nickname">游客</text>
        <text class="user-status">{{isLoggedIn ? '已登录' : '点击头像登录'}}</text>
      </view>
    </view>
  </view>

  <view class="user-content">
    <view class="info-card" wx:if="{{isLoggedIn}}">
      <view class="info-item" bindtap="handleNicknameTap">
        <text class="info-label">昵称</text>
        <view class="info-value-wrap">
          <text class="info-value">{{userInfo.nickName || '-'}}</text>
          <text class="info-arrow">></text>
        </view>
      </view>
      <view class="info-item" bindtap="onChooseAvatarTap">
        <text class="info-label">头像</text>
        <text class="info-value">{{userInfo.avatarUrl ? '已设置' : '点击更换'}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">状态</text>
        <text class="info-value">已登录</text>
      </view>
    </view>

    <view class="btn-group">
      <button class="btn-primary" bindtap="handleLogout" wx:if="{{isLoggedIn}}">退出登录</button>
    </view>
    <view class="btn-group">
      <button class="btn-danger" bindtap="handleDeleteAccount" wx:if="{{isLoggedIn}}">注销账号</button>
    </view>
  </view>
</view>