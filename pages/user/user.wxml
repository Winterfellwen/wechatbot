<view class="container">
  <view class="user-header" bindtap="handleUserTap">
    <view class="user-info">
      <image class="user-avatar" src="{{userInfo.avatarUrl || '/images/avatar-default.png'}}" mode="aspectFill" bindtap="handleChooseAvatarTap"></image>
      <view class="user-detail">
        <text class="user-nickname">{{userInfo.nickName || '游客'}}</text>
        <text class="user-status">{{isLoggedIn ? '已登录' : '点击头像登录'}}</text>
      </view>
    </view>
  </view>

  <view class="user-content">
    <view class="btn-group" wx:if="{{!isLoggedIn}}">
      <button class="btn-primary" bindtap="login">微信一键登录</button>
    </view>

    <view class="info-card" wx:if="{{isLoggedIn}}">
      <view class="info-item" bindtap="handleNicknameTap">
        <text class="info-label">昵称</text>
        <view class="info-value-wrap">
          <text class="info-value">{{userInfo.nickName || '-'}}</text>
          <text class="info-arrow">></text>
        </view>
      </view>
      <view class="info-item" bindtap="handleChooseAvatarTap">
        <text class="info-label">头像</text>
        <text class="info-value">{{userInfo.avatarUrl ? '已设置' : '点击设置'}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">状态</text>
        <text class="info-value">已登录</text>
      </view>
    </view>

    <view class="btn-group">
      <button class="btn-primary" bindtap="handleLogout" wx:if="{{isLoggedIn}}">退出登录</button>
    </view>
    <view class="btn-group">
      <button class="btn-danger" bindtap="handleDeleteAccount" wx:if="{{isLoggedIn}}">注销账号</button>
    </view>
  </view>
</view>