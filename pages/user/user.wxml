<!--pages/user/user.wxml - UI/UX Pro Max 优化版-->
<view class="page">
  <!-- 未登录 -->
  <view class="login-section" wx:if="{{!isLoggedIn}}">
    <view class="login-bg"></view>
    <view class="login-content">
      <view class="login-avatar-wrap">
        <image class="login-avatar" src="/images/avatar-default.png" mode="aspectFill"></image>
      </view>
      <text class="login-desc">登录后同步你的学习数据</text>
      <button class="login-btn" bindtap="handleLogin">微信登录</button>
    </view>
  </view>

  <!-- 已登录 -->
  <view class="profile-section" wx:if="{{isLoggedIn}}">
    <!-- 头部信息 -->
    <view class="profile-header">
      <view class="profile-bg"></view>
      <view class="profile-info">
        <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
          <image class="profile-avatar" src="{{displayUserInfo.avatarUrl}}" mode="aspectFill" binderror="onAvatarError"></image>
        </button>
        <view class="profile-name-area">
          <view class="nick-row" wx:if="{{!showNickInput}}">
            <text class="nickname">{{displayUserInfo.nickName}}</text>
            <view class="edit-badge" bindtap="showNickInput">
              <text class="edit-badge-text">编辑</text>
            </view>
          </view>
          <view class="nick-input-row" wx:if="{{showNickInput}}">
            <input class="nick-input" type="nickname" placeholder="输入昵称" value="{{nickName}}" bindinput="onNickInput" focus="{{true}}" />
            <text class="btn-cancel" bindtap="cancelNickname">取消</text>
            <text class="btn-confirm" bindtap="confirmNickname">保存</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 功能列表 -->
    <view class="action-card">
      <view class="action-item" bindtap="handleLogout">
        <view class="action-icon-wrap icon-logout">
          <text class="action-icon-text">⏻</text>
        </view>
        <text class="action-text">退出登录</text>
        <text class="action-arrow">›</text>
      </view>
      <view class="action-divider"></view>
      <view class="action-item action-item-danger" bindtap="handleDeleteAccount">
        <view class="action-icon-wrap icon-danger">
          <text class="action-icon-text">✕</text>
        </view>
        <text class="action-text text-danger">注销账号</text>
        <text class="action-arrow">›</text>
      </view>
    </view>
  </view>
</view>
