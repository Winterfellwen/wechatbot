/*pages/grammar/grammar.wxss*/
.container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

.header {
  padding: 30rpx;
  background-color: #fff;
}

.header-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
}

.category-tabs {
  display: flex;
  padding: 20rpx;
  background-color: #fff;
  margin-bottom: 10rpx;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tab {
  padding: 16rpx 32rpx;
  font-size: 26rpx;
  color: #666;
  background-color: #f0f0f0;
  border-radius: 32rpx;
}

.tab.active {
  background-color: #58cc02;
  color: #fff;
}

.grammar-list {
  padding: 20rpx;
  height: calc(100vh - 250rpx);
}

.grammar-card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.grammar-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.grammar-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.grammar-level {
  font-size: 24rpx;
  color: #58cc02;
  background-color: #e8f5e9;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
}

.grammar-usage {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 20rpx;
}

.grammar-example {
  background-color: #f9f9f9;
  border-radius: 12rpx;
  padding: 20rpx;
}

.example-label {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 10rpx;
}

.example-jp {
  font-size: 30rpx;
  color: #333;
}

.example-cn {
  font-size: 26rpx;
  color: #666;
  margin-top: 8rpx;
}