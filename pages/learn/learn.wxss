/*pages/learn/learn.wxss*/
.container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

.progress-header {
  padding: 30rpx;
  background-color: #58cc02;
  display: flex;
  align-items: center;
}

.back-btn {
  font-size: 40rpx;
  color: #fff;
  margin-right: 20rpx;
}

.progress-bar {
  height: 16rpx;
  background-color: #e0e0e0;
  border-radius: 8rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #58cc02 0%, #89e219 100%);
  border-radius: 8rpx;
  transition: width 0.3s ease;
}

.progress-text {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #666;
  text-align: right;
}

.lesson-tabs {
  display: flex;
  padding: 20rpx;
  background-color: #fff;
  margin-bottom: 10rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  font-size: 28rpx;
  color: #666;
  border-radius: 16rpx;
}

.tab-item.active {
  background-color: #58cc02;
  color: #fff;
  font-weight: bold;
}

.lesson-list {
  padding: 20rpx;
  height: calc(100vh - 380rpx);
}

.bottom-nav {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  padding: 20rpx;
  background-color: #fff;
  box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.1);
}

.nav-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.nav-item.active .nav-icon,
.nav-item.active .nav-text {
  color: #1890ff;
}

.nav-icon {
  font-size: 36rpx;
}

.nav-text {
  font-size: 22rpx;
  color: #666;
  margin-top: 4rpx;
}