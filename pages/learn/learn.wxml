<!--pages/learn/learn.wxml-->
<view class="container">
  <!-- 顶部进度条 -->
  <view class="progress-header">
    <view class="back-btn" bindtap="goBack">←</view>
    <view class="progress-bar">
      <view class="progress-fill" style="width: {{progress}}%"></view>
    </view>
    <view class="progress-text">Lv.{{level}} · {{exp}}XP</view>
  </view>

  <!-- 课程选择 -->
  <view class="lesson-tabs">
    <view 
      wx:for="{{lessons}}" 
      wx:key="id" 
      class="tab-item {{currentLesson === item.id ? 'active' : ''}}"
      bindtap="switchLesson" 
      data-id="{{item.id}}">
      {{item.name}}
    </view>
  </view>

  <!-- 闯关列表 -->
  <scroll-view scroll-y class="lesson-list">
    <block wx:for="{{currentLessonData}}" wx:key="id">
      <view class="lesson-card {{item.completed ? 'completed' : ''}}" bindtap="startLesson" data-id="{{item.id}}">
        <view class="lesson-number">{{item.number}}</view>
        <view class="lesson-info">
          <view class="lesson-title">{{item.title}}</view>
          <view class="lesson-desc">{{item.description}}</view>
          <view class="lesson-stats">
            <text class="xp">+{{item.xp}} XP</text>
            <text wx:if="{{item.completed}}" class="checkmark">✓</text>
          </view>
        </view>
        <view class="lesson-icon">
          <text wx:if="{{item.completed}}">⭐</text>
          <text wx:else>▶</text>
        </view>
      </view>
    </block>
  </scroll-view>

  <!-- 底部导航 -->
  <view class="bottom-nav">
    <view class="nav-item" bindtap="goToWords">
      <text class="nav-icon">📝</text>
      <text class="nav-text">单词本</text>
    </view>
    <view class="nav-item" bindtap="goToGrammar">
      <text class="nav-icon">📖</text>
      <text class="nav-text">语法</text>
    </view>
    <view class="nav-item" bindtap="goToTextbook">
      <text class="nav-icon">📚</text>
      <text class="nav-text">课本</text>
    </view>
    <view class="nav-item" bindtap="goToRank">
      <text class="nav-icon">🏆</text>
      <text class="nav-text">排行榜</text>
    </view>
  </view>
</view>