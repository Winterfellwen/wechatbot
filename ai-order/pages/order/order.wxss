.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: linear-gradient(180deg, #FFF7ED 0%, #FFFBEB 100%);
  position: relative;
}

/* ===== Header ===== */
.header {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  padding-top: calc(20rpx + 88rpx);
  background: rgba(255,255,255,0.85);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border-bottom: 1rpx solid rgba(0,0,0,0.04);
  flex-shrink: 0;
}

.back-btn {
  font-size: 30rpx;
  color: #059669;
  padding: 8rpx 16rpx;
  margin-left: -16rpx;
  font-weight: 600;
  transition: opacity 0.2s;
}
.back-btn:active { opacity: 0.6; }

.title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  font-weight: 700;
  color: #1E293B;
  margin-right: 60rpx;
  letter-spacing: 2rpx;
}

/* ===== Body ===== */
.order-body {
  flex: 1;
  padding: 24rpx;
  padding-bottom: 0;
}

.section {
  background: rgba(255,255,255,0.9);
  backdrop-filter: blur(10rpx);
  -webkit-backdrop-filter: blur(10rpx);
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 24rpx rgba(217,119,6,0.06), 0 1rpx 4rpx rgba(0,0,0,0.04);
  border: 1rpx solid rgba(217,119,6,0.06);
  animation: fadeUp 0.4s ease-out;
}

@keyframes fadeUp {
  from { opacity: 0; transform: translateY(24rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.section-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #1E293B;
  margin-bottom: 16rpx;
  letter-spacing: 1rpx;
}

.dish-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(0,0,0,0.04);
  transition: background 0.2s;
}
.dish-item:last-child { border-bottom: none; }

.dish-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.dish-name {
  font-size: 28rpx;
  color: #1E293B;
  font-weight: 500;
}

.dish-qty {
  font-size: 24rpx;
  color: #94A3B8;
  background: rgba(0,0,0,0.04);
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
}

.dish-price {
  font-size: 28rpx;
  font-weight: 700;
  color: #059669;
}

.dish-item-empty {
  justify-content: center;
  padding: 48rpx 0;
}

.empty-text {
  font-size: 26rpx;
  color: #94A3B8;
}

/* ===== Note ===== */
.note-text {
  font-size: 26rpx;
  color: #64748B;
  line-height: 1.6;
  background: rgba(217,119,6,0.05);
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  border-left: 4rpx solid #D97706;
}

/* ===== Total ===== */
.total-section {
  background: rgba(255,255,255,0.9);
  backdrop-filter: blur(10rpx);
  -webkit-backdrop-filter: blur(10rpx);
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 4rpx 24rpx rgba(217,119,6,0.06);
  border: 1rpx solid rgba(217,119,6,0.06);
  animation: fadeUp 0.4s ease-out 0.1s both;
}

.total-label {
  font-size: 28rpx;
  color: #64748B;
}

.total-price {
  font-size: 40rpx;
  font-weight: 800;
  color: #D97706;
  letter-spacing: 2rpx;
}

/* ===== Hint ===== */
.hint-section {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  background: rgba(217,119,6,0.06);
  border: 1rpx solid rgba(217,119,6,0.12);
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
  animation: fadeUp 0.4s ease-out 0.2s both;
}

.hint-icon {
  font-size: 28rpx;
  flex-shrink: 0;
  margin-top: 2rpx;
}

.hint-text {
  font-size: 24rpx;
  color: #92400E;
  line-height: 1.5;
}

/* ===== Bottom ===== */
.bottom-bar {
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255,255,255,0.92);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border-top: 1rpx solid rgba(0,0,0,0.04);
  flex-shrink: 0;
}

.pay-btn {
  background: linear-gradient(135deg, #059669, #10B981);
  border-radius: 48rpx;
  padding: 26rpx 0;
  text-align: center;
  font-size: 32rpx;
  font-weight: 700;
  color: #FFFFFF;
  box-shadow: 0 6rpx 24rpx rgba(5,150,105,0.3);
  transition: all 0.25s ease;
  letter-spacing: 2rpx;
}
.pay-btn:active {
  transform: scale(0.97);
  box-shadow: 0 4rpx 16rpx rgba(5,150,105,0.2);
}