/* ai-order/pages/customer/customer.wxss - Customer AI Chat */

.chat-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: linear-gradient(180deg, #FFFFFF 0%, #F5F5F7 100%);
  position: relative;
}

/* ========== 消息列表 ========== */
.msg-list {
  flex: 1;
  padding: 24rpx 0;
  overflow-y: auto;
  overflow-x: hidden;
  -webkit-overflow-scrolling: touch;
}

.list-bottom {
  height: 20rpx;
}

/* ========== 消息行 ========== */
.msg-wrapper {
  margin-bottom: 32rpx;
  animation: fadeInUp 0.3s ease-out;
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.msg-row {
  display: flex;
  padding: 0 32rpx;
  box-sizing: border-box;
}

.msg-row.ai {
  align-items: flex-start;
}

.msg-row.user {
  flex-direction: row;
  justify-content: flex-end;
}

/* ========== 头像 ========== */
.ai-avatar-wrapper,
.user-avatar-wrapper {
  flex-shrink: 0;
  margin-top: 4rpx;
}

.msg-row.ai .ai-avatar-wrapper {
  margin-right: 20rpx;
}

.msg-row.user .user-avatar-wrapper {
  margin-left: 24rpx;
}

.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: transform 0.2s ease;
}

.avatar:active {
  transform: scale(0.92);
}

.ai-avatar {
  background: linear-gradient(135deg, #f5576c 0%, #ff6b81 50%, #f093fb 100%);
  box-shadow: 0 6rpx 20rpx rgba(245, 87, 108, 0.3);
}

.user-avatar {
  background: linear-gradient(135deg, #6366F1 0%, #8B5CF6 50%, #A78BFA 100%);
  box-shadow: 0 6rpx 20rpx rgba(99, 102, 241, 0.3);
}

.avatar-text {
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 700;
}

.avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

/* ========== 消息内容 ========== */
.msg-content {
  max-width: 80%;
  display: flex;
  flex-direction: column;
}

.user-msg-content {
  align-items: flex-end;
}

/* ========== 气泡 ========== */
.bubble {
  padding: 22rpx 28rpx;
  border-radius: 28rpx;
  word-break: break-word;
  line-height: 1.6;
  position: relative;
}

.ai-bubble {
  background: #FFFFFF;
  border: 1rpx solid rgba(0, 0, 0, 0.06);
  border-top-left-radius: 8rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.user-bubble {
  background: linear-gradient(135deg, #f5576c 0%, #ff6b81 100%);
  border-top-right-radius: 8rpx;
  box-shadow: 0 6rpx 20rpx rgba(245, 87, 108, 0.25);
}

.bubble-text {
  font-size: 30rpx;
  line-height: 1.6;
  user-select: true;
  -webkit-user-select: true;
}

.ai-bubble .bubble-text {
  color: #1A1A1A;
}

.user-bubble .bubble-text {
  color: #FFFFFF;
}

/* ========== 正在输入动画 ========== */
.typing-bubble {
  padding: 24rpx 32rpx;
  min-width: 100rpx;
}

.typing-indicator {
  display: flex;
  align-items: center;
  gap: 8rpx;
  height: 36rpx;
}

.typing-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #94A3B8;
  animation: typingBounce 1.4s infinite ease-in-out;
}

.typing-dot:nth-child(1) {
  animation-delay: 0s;
}

.typing-dot:nth-child(2) {
  animation-delay: 0.2s;
}

.typing-dot:nth-child(3) {
  animation-delay: 0.4s;
}

@keyframes typingBounce {
  0%, 60%, 100% {
    transform: translateY(0);
    opacity: 0.4;
  }
  30% {
    transform: translateY(-8rpx);
    opacity: 1;
  }
}

/* ========== 快捷问题 ========== */
.quick-replies {
  padding: 16rpx 24rpx 0;
  flex-shrink: 0;
  background: rgba(255,255,255,0.95);
}

.quick-reply-title {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.quick-reply-scroll {
  display: flex;
  flex-direction: row;
  white-space: nowrap;
  padding-bottom: 16rpx;
}

.quick-reply-tag {
  display: inline-flex;
  padding: 14rpx 28rpx;
  background: #fff0f3;
  border: 1rpx solid #ffd6dd;
  border-radius: 40rpx;
  margin-right: 16rpx;
  font-size: 26rpx;
  color: #f5576c;
  flex-shrink: 0;
}

.quick-reply-tag:active {
  background: #f5576c;
  color: #fff;
  border-color: #f5576c;
}

/* ========== 底部输入区 ========== */
.input-section {
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border-top: 1rpx solid rgba(0, 0, 0, 0.06);
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  flex-shrink: 0;
}

.input-bar {
  display: flex;
  align-items: center;
  background: #F2F2F7;
  border-radius: 48rpx;
  padding: 8rpx 8rpx 8rpx 12rpx;
  min-height: 88rpx;
}

.input-center {
  flex: 1;
  min-height: 72rpx;
  display: flex;
  align-items: center;
}

.msg-input {
  flex: 1;
  height: 72rpx;
  padding: 0 20rpx;
  font-size: 30rpx;
  color: #1A1A1A;
  background: transparent;
}

.input-placeholder {
  color: #999999;
  font-size: 30rpx;
}

.send-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #D1D5DB;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: all 0.25s ease;
}

.send-btn.active {
  background: linear-gradient(135deg, #f5576c 0%, #ff6b81 100%);
  box-shadow: 0 6rpx 20rpx rgba(245, 87, 108, 0.35);
}

.send-btn-hover {
  transform: scale(0.9);
  opacity: 0.9;
}

.icon-send {
  font-size: 36rpx;
  color: #FFFFFF;
  font-weight: 600;
  line-height: 1;
}

/* ========== 推荐菜品卡片 ========== */
.dish-cards {
  margin-top: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.dish-card {
  display: flex;
  align-items: center;
  background: #fff;
  border: 1rpx solid rgba(0, 0, 0, 0.06);
  border-radius: 16rpx;
  padding: 20rpx;
  gap: 16rpx;
}

.dish-img-wrap {
  width: 100rpx;
  height: 100rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #fff0f3, #ffe0e6);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.dish-img-text {
  font-size: 40rpx;
  font-weight: 700;
  color: #f5576c;
}

.dish-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.dish-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.dish-price {
  font-size: 32rpx;
  font-weight: 700;
  color: #f5576c;
}

.dish-tags {
  display: flex;
  gap: 8rpx;
  flex-wrap: wrap;
}

.dish-tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  color: #666;
}

.taste-tag {
  background: #fff0f3;
  color: #f5576c;
}

.spicy-tag {
  background: #fff7ed;
  color: #ea580c;
}

.dish-order-btn {
  flex-shrink: 0;
  padding: 12rpx 24rpx;
  background: linear-gradient(135deg, #f5576c, #ff6b81);
  color: #fff;
  border-radius: 12rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.dish-order-btn:active {
  opacity: 0.8;
  transform: scale(0.96);
}

/* ========== 购物车摘要 ========== */
.cart-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #1A1A1A;
  border-radius: 24rpx 24rpx 0 0;
  flex-shrink: 0;
}

.cart-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.cart-text {
  font-size: 24rpx;
  color: rgba(255,255,255,0.7);
}

.cart-total {
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
}

.cart-order-btn {
  padding: 16rpx 40rpx;
  background: linear-gradient(135deg, #f5576c, #ff6b81);
  color: #fff;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.cart-order-btn:active {
  opacity: 0.8;
  transform: scale(0.96);
}

/* ========== 订单确认弹窗 ========== */
.order-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.order-dialog {
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx;
  width: 80%;
  max-height: 60vh;
  overflow-y: auto;
}

.order-dialog-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1A1A1A;
  margin-bottom: 24rpx;
  text-align: center;
}

.order-dish-item {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  font-size: 28rpx;
}

.order-dish-item:last-child {
  border-bottom: none;
}

.order-total-row {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 0 0;
  margin-top: 12rpx;
  border-top: 2rpx solid #1A1A1A;
  font-size: 32rpx;
  font-weight: 700;
}

.order-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}

.order-cancel-btn {
  flex: 1;
  padding: 20rpx;
  background: #f5f5f5;
  color: #666;
  border-radius: 12rpx;
  font-size: 28rpx;
  text-align: center;
  font-weight: 600;
}

.order-confirm-btn {
  flex: 1;
  padding: 20rpx;
  background: linear-gradient(135deg, #f5576c, #ff6b81);
  color: #fff;
  border-radius: 12rpx;
  font-size: 28rpx;
  text-align: center;
  font-weight: 600;
}

.order-confirm-btn:active, .order-cancel-btn:active {
  opacity: 0.8;
  transform: scale(0.96);
}

/* ========== 安全区域适配 ========== */
@supports (padding-bottom: env(safe-area-inset-bottom)) {
  .chat-container {
    padding-bottom: env(safe-area-inset-bottom);
  }
}
