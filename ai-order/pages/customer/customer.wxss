/* ai-order/pages/customer/customer.wxss - Split Screen Explorer */
/* Z-index scale: 1=dish-grid, 46=voice-chat-compact, 47=voice-chips, 50=voice-mic, 100=chat-overlay, 999=cart-panel, 9999=loading-aurora */

.customer-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: linear-gradient(180deg, #FFF7ED 0%, #FFFBEB 50%, #F0FDF4 100%);
  overflow: hidden;
  position: relative;
}

/* Subtle background decoration */
.customer-container::before {
  content: '';
  position: fixed;
  top: -300rpx; right: -200rpx;
  width: 600rpx; height: 600rpx;
  background: rgba(5,150,105,0.04);
  border-radius: 50%;
  filter: blur(140rpx);
  pointer-events: none;
  z-index: 0;
}

/* ====== Dish grid area ====== */
.dish-grid-wrapper {
  flex: 1;
  min-height: 0;
  overflow: hidden;
  position: relative;
  background: rgba(255,255,255,0.85);
  backdrop-filter: blur(10rpx);
  -webkit-backdrop-filter: blur(10rpx);
  box-shadow: 0 4rpx 24rpx rgba(217,119,6,0.04);
  z-index: 1;
}

.dish-grid-wrapper.chat-expanded {
  max-height: 40vh;
}

.dish-grid-area {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  overflow: hidden;
}



.grid-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx 8rpx;
}

.grid-header-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.group-picker {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 16rpx;
  background: #F2F2F7;
  border-radius: 24rpx;
}

.group-picker-label {
  font-size: 24rpx;
  color: #c9304a;
  font-weight: 600;
}

.group-picker-arrow {
  font-size: 18rpx;
  color: #c9304a;
}

.taste-zone {
  margin-bottom: 24rpx;
}

.taste-header {
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  margin-bottom: 12rpx;
}

.taste-indicator {
  width: 8rpx;
  height: 32rpx;
  border-radius: 4rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.taste-label {
  font-size: 28rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.dish-row {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  padding: 0 16rpx;
  padding-bottom: 8rpx;
}

.dish-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 176rpx;
  background: #FFFFFF;
  border: 2rpx solid rgba(0,0,0,0.04);
  border-radius: 20rpx;
  padding: 20rpx 12rpx 16rpx;
  margin: 0 8rpx;
  flex-shrink: 0;
  transition: all 0.3s ease;
  position: relative;
}

.dish-card.pulse {
  border-color: #f5576c;
  animation: dishGlow 1.2s ease-in-out infinite;
  box-shadow: 0 0 20rpx rgba(245,87,108,0.25);
}

@keyframes dishGlow {
  0%, 100% { box-shadow: 0 0 12rpx rgba(245,87,108,0.2); }
  50% { box-shadow: 0 0 32rpx rgba(245,87,108,0.5), 0 0 60rpx rgba(245,87,108,0.15); }
}

.dish-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 8rpx;
  box-shadow: 0 6rpx 20rpx rgba(0,0,0,0.1);
}

.dish-avatar-char {
  font-size: 52rpx;
  font-weight: 700;
  color: #FFFFFF;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.15);
}

.dish-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  margin-bottom: 8rpx;
  box-shadow: 0 6rpx 20rpx rgba(0,0,0,0.1);
}

.cart-btn {
  width: 100%;
  background: linear-gradient(135deg, #f5576c, #ff6b6b);
  border-radius: 24rpx;
  padding: 10rpx 0;
  margin-top: 10rpx;
  text-align: center;
}

.cart-btn:active {
  opacity: 0.7;
}

.cart-btn-text {
  font-size: 22rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.cart-btn.loading {
  opacity: 0.6;
  pointer-events: none;
}

.cart-btn.disabled {
  opacity: 0.4;
  pointer-events: none;
}

.dish-qty-controls {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin-top: 10rpx;
  width: 100%;
}

.dish-qty-btn {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #F2F2F7;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
  color: #666;
}

.dish-qty-btn:active {
  background: #E0E0E0;
}

.dish-qty-plus {
  background: #FFF0F3;
  color: #f5576c;
}

.dish-qty-num {
  font-size: 28rpx;
  font-weight: 700;
  color: #1A1A1A;
  min-width: 32rpx;
  text-align: center;
}

.dish-card-name {
  font-size: 24rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-bottom: 4rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 100%;
}

.dish-card-price {
  font-size: 28rpx;
  font-weight: 700;
  color: #f5576c;
}

.spicy-indicator {
  display: flex;
  flex-direction: row;
  font-size: 16rpx;
  margin-top: 4rpx;
  min-height: 32rpx;
}

.grid-bottom-spacer {
  height: 600rpx;
}

.voice-mode .grid-bottom-spacer {
  height: 700rpx;
}

.voice-mode.cart-visible .grid-bottom-spacer {
  height: 760rpx;
}

.grid-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 0;
}

.grid-empty-text {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.grid-empty-btn {
  padding: 14rpx 32rpx;
  background: linear-gradient(135deg, #f5576c, #ff6b81);
  color: #fff;
  border-radius: 32rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.grid-empty-btn:active {
  opacity: 0.8;
}

.grid-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60rpx 0;
}

.grid-loading-text {
  font-size: 26rpx;
  color: #666;
}

/* ====== Quick chips ====== */
.quick-chips {
  position: absolute;
  left: 0;
  right: 0;
  bottom: calc(202rpx + env(safe-area-inset-bottom, 0px));
  z-index: 47;
  padding: 8rpx 16rpx;
  background: #FFFFFF;
  border-bottom: 1rpx solid rgba(0,0,0,0.04);
}

.chips-scroll {
  display: flex;
  flex-direction: row;
  white-space: nowrap;
}

.chip {
  display: inline-flex;
  padding: 14rpx 28rpx;
  background: linear-gradient(135deg, #6366F1 0%, #8B5CF6 100%);
  border-radius: 36rpx;
  margin-right: 12rpx;
  font-size: 24rpx;
  color: #FFFFFF;
  font-weight: 600;
  flex-shrink: 0;
  box-shadow: 0 4rpx 16rpx rgba(99, 102, 241, 0.3);
}

.chip:active {
  opacity: 0.85;
  transform: scale(0.96);
}

.chip-reorder {
  background: linear-gradient(135deg, #f5576c 0%, #ff6b81 100%);
  color: #FFFFFF;
  box-shadow: 0 4rpx 16rpx rgba(245, 87, 108, 0.35);
}

.chip-reorder:active {
  opacity: 0.85;
  transform: scale(0.96);
}

/* ====== Chat expanded overlay (fixed bottom sheet) ====== */
.chat-area {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 100;
  height: 75vh;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  background: #F8F9FA;
  border-radius: 16rpx 16rpx 0 0;
  box-shadow: 0 -4rpx 24rpx rgba(0,0,0,0.08);
  pointer-events: none;
  /* transform is set via inline style (data: chatSlideY) */
  /* transition is set via inline style to avoid clash with drag */
}

.chat-area.expanded {
  pointer-events: auto;
}

/* Compact inner bar (in page flow) */
.chat-compact-inner {
  position: absolute;
  bottom: calc(270rpx + env(safe-area-inset-bottom, 0px));
  left: 16rpx;
  right: 16rpx;
  z-index: 46;
  display: flex;
  align-items: center;
  padding: 8rpx 20rpx;
  gap: 12rpx;
  min-height: 72rpx;
  background: linear-gradient(135deg, #F8FAFC, #F1F5F9);
  border-radius: 20rpx;
  border: 2rpx solid rgba(124,58,237,0.2);
  box-shadow: 0 6rpx 32rpx rgba(124,58,237,0.2);
}

.chat-compact-inner:active {
  background: #F8F9FA;
}

.compact-preview {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
  overflow: hidden;
}

.compact-ai-avatar {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #7C3AED, #4F46E5);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.compact-ai-text {
  font-size: 16rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.compact-preview-text {
  font-size: 24rpx;
  font-weight: 600;
  color: #4F46E5;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 4;
  line-height: 1.4;
  max-height: calc(24rpx * 1.4 * 4);
}

.compact-hint {
  display: flex;
  align-items: center;
  gap: 6rpx;
  flex-shrink: 0;
}

.compact-hint-icon {
  font-size: 24rpx;
}

.compact-hint-text {
  font-size: 22rpx;
  font-weight: 500;
  color: #7C3AED;
  white-space: nowrap;
}

.compact-expand-hint {
  position: absolute;
  bottom: 100%;
  right: 0;
  margin-bottom: 8rpx;
  z-index: 48;
  padding: 8rpx 16rpx;
  background: rgba(79, 70, 229, 0.9);
  border-radius: 20rpx;
  font-size: 20rpx;
  color: #FFFFFF;
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(79, 70, 229, 0.4);
  backdrop-filter: blur(10rpx);
}

.voice-mode .compact-expand-hint {
  background: rgba(79, 70, 229, 0.95);
  box-shadow: 0 6rpx 24rpx rgba(79, 70, 229, 0.5);
}

/* Expanded inner view */
.chat-expanded-inner {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.chat-expand-header {
  flex-shrink: 0;
  padding: 12rpx 0;
  display: flex;
  justify-content: center;
  background: #FFFFFF;
  border-bottom: 1rpx solid rgba(0,0,0,0.04);
}

.collapse-bar {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 14rpx 32rpx;
  border-radius: 32rpx;
  background: #F2F2F7;
}

.collapse-bar:active {
  background: #E0E0E0;
}

.collapse-arrow {
  font-size: 20rpx;
  color: #666;
}

.collapse-text {
  font-size: 24rpx;
  color: #666;
  font-weight: 500;
}

.chat-scroll-view {
  flex: 1;
  padding: 16rpx 0;
  overflow: hidden;
  position: relative;
}

.chat-msg-list {
  padding-bottom: 80rpx;
}

.chat-bottom-bar {
  flex-shrink: 0;
  background: #FFFFFF;
  border-top: 1rpx solid rgba(0,0,0,0.06);
}

.chat-bottom-row {
  display: flex;
  align-items: center;
  padding: 8rpx 12rpx;
  gap: 8rpx;
}

.chat-quick-chips {
  flex: 1;
  min-width: 0;
}

.chat-quick-chips .chips-scroll {
  white-space: nowrap;
}

.chat-input-bubble {
  display: flex;
  align-items: center;
  background: #4F46E5;
  border-radius: 40rpx;
  padding: 4rpx 4rpx 4rpx 16rpx;
  flex-shrink: 0;
  min-width: 160rpx;
  box-shadow: 0 4rpx 16rpx rgba(79, 70, 229, 0.3);
}

.chat-bubble-input {
  flex: 1;
  height: 56rpx;
  font-size: 24rpx;
  color: #FFFFFF;
  background: transparent;
  min-width: 80rpx;
}

.chat-input-bubble .chat-send-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-left: 4rpx;
}

.chat-input-bubble .chat-send-btn.active {
  background: rgba(255,255,255,0.35);
}

.chat-input-bubble .chat-icon-send {
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: 600;
  line-height: 1;
}

.chat-mode-toggle-bottom {
  text-align: right;
  padding: 4rpx 20rpx 8rpx;
}

.chat-msg-input {
  flex: 1;
  height: 64rpx;
  font-size: 28rpx;
  color: #1A1A1A;
  background: transparent;
}

.chat-send-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #D1D5DB;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: all 0.25s ease;
}

.chat-send-btn.active {
  background: linear-gradient(135deg, #f5576c, #ff6b81);
  box-shadow: 0 4rpx 16rpx rgba(245,87,108,0.3);
}

.chat-icon-send {
  font-size: 32rpx;
  color: #FFFFFF;
  font-weight: 600;
  line-height: 1;
}

.chat-mode-toggle {
  align-self: flex-end;
  padding: 16rpx 12rpx;
}

.chat-mode-toggle-label {
  font-size: 22rpx;
  color: #666;
}

.chat-mode-toggle-label:active {
  color: #f5576c;
}

.chat-voice-input-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0 0;
}

.chat-mic-btn {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: #F2F2F7;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}

.chat-mic-btn.recording {
  background: linear-gradient(135deg, #f5576c, #ff6b81);
  animation: micPulse 0.8s ease-in-out infinite;
}

.chat-mic-btn.rainbow {
  background: 
    linear-gradient(105deg,
      transparent 35%,
      rgba(180, 200, 255, 0.08) 42%,
      rgba(200, 220, 255, 0.15) 48%,
      rgba(180, 200, 255, 0.08) 54%,
      transparent 61%
    ),
    linear-gradient(135deg, #0f0c29 0%, #302b63 50%, #24243e 100%);
  background-size: 250% 100%, 100% 100%;
  background-position: 150% 0, 0 0;
  box-shadow:
    0 0 24rpx rgba(102, 126, 234, 0.25),
    0 0 50rpx rgba(118, 75, 162, 0.15);
  animation: lightSweep 3s ease-in-out infinite;
}

.chat-mic-btn.rainbow .chat-icon-mic,
.chat-mic-btn.rainbow .chat-mic-label {
  color: #FFFFFF;
}

.chat-icon-mic {
  font-size: 64rpx;
  line-height: 1;
  margin-bottom: 6rpx;
}

.chat-mic-btn.recording .chat-icon-mic {
  color: #FFFFFF;
}

.chat-mic-label {
  font-size: 20rpx;
  color: #666;
}

.chat-mic-btn.recording .chat-mic-label {
  color: #FFFFFF;
}

.msg-wrapper {
  margin-bottom: 16rpx;
  animation: fadeInUp 0.25s ease-out;
}

@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(12rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.msg-row {
  display: flex;
  padding: 0 20rpx;
  align-items: flex-start;
}

.msg-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.ai-avatar {
  background: linear-gradient(135deg, #7C3AED, #4F46E5);
  margin-right: 12rpx;
  box-shadow: 0 2rpx 12rpx rgba(124, 58, 237, 0.3);
}

.user-avatar {
  background: #D1D5DB;
  margin-left: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1);
}

.msg-avatar-text {
  font-size: 20rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.msg-row.user {
  justify-content: flex-end;
}

.bubble {
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  word-break: break-word;
  line-height: 1.5;
  font-size: 26rpx;
}

.ai-bubble {
  max-width: 75%;
  background: linear-gradient(135deg, #7C3AED 0%, #4F46E5 100%);
  border-top-left-radius: 4rpx;
  box-shadow: 0 4rpx 24rpx rgba(124, 58, 237, 0.35), inset 0 1rpx 0 rgba(255,255,255,0.15);
}

.user-bubble {
  background: linear-gradient(135deg, #f5576c, #ff6b81);
  border-top-right-radius: 4rpx;
  max-width: 70%;
}

.bubble-text {
  line-height: 1.5;
  user-select: true;
  -webkit-user-select: true;
}

.ai-bubble .bubble-text {
  color: #FFFFFF;
  font-weight: 600;
}

.user-bubble-text {
  color: #FFFFFF;
}

.typing-bubble {
  padding: 20rpx 24rpx;
  min-width: 80rpx;
}

.typing-indicator {
  display: flex;
  align-items: center;
  gap: 6rpx;
  height: 28rpx;
}

.typing-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #94A3B8;
  animation: typingBounce 1.4s infinite ease-in-out;
}

.typing-dot:nth-child(1) { animation-delay: 0s; }
.typing-dot:nth-child(2) { animation-delay: 0.2s; }
.typing-dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes typingBounce {
  0%, 60%, 100% { transform: translateY(0); opacity: 0.4; }
  30% { transform: translateY(-8rpx); opacity: 1; }
}

.chat-bottom {
  height: 16rpx;
}



@keyframes lightSweep {
  0% { background-position: 150% 0, 0 0; }
  50% { background-position: -50% 0, 0 0; }
  100% { background-position: 150% 0, 0 0; }
}

.mode-toggle {
  align-self: flex-end;
  padding: 16rpx 12rpx;
}

.mode-toggle-corner {
  position: absolute;
  bottom: 4rpx;
  right: 0;
}

.mode-toggle-label {
  font-size: 22rpx;
  color: #666;
}

.mode-toggle-label:active {
  color: #f5576c;
}

@keyframes micPulse {
  0%, 100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(245,87,108,0.4); }
  50% { transform: scale(1.1); box-shadow: 0 0 0 12rpx rgba(245,87,108,0); }
}

/* ====== Cart bar ====== */
.cart-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 32rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #1E293B;
  flex-shrink: 0;
  position: relative;
  z-index: 10;
}

.input-section {
  display: none;
}

.collapsed-input-area {
  position: absolute;
  left: 0;
  right: 0;
  bottom: calc(98rpx + env(safe-area-inset-bottom));
  z-index: 10;
  background: transparent;
  height: auto;
}

.voice-mic-btn-wrap {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  bottom: 40rpx;
  width: 180rpx;
  height: 180rpx;
  z-index: 12;
  border-radius: 50%;
  background: transparent;
}

.voice-keyboard-wrap {
  position: absolute;
  right: 200rpx;
  bottom: 152rpx;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #F2F2F7;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  z-index: 12;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1);
}

.voice-keyboard-wrap:active {
  background: #E0E0E0;
}

.voice-mode .chat-compact-inner {
  bottom: 320rpx;
  z-index: 50;
  background: linear-gradient(135deg, #F8FAFC, #F1F5F9);
  border: 2rpx solid rgba(124,58,237,0.3);
  box-shadow: 0 8rpx 40rpx rgba(124,58,237,0.25);
}

.voice-mode .quick-chips {
  bottom: 250rpx;
  z-index: 49;
  background: rgba(255,255,255,0.95);
  backdrop-filter: blur(10rpx);
}

.voice-compact-row {
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
}

.voice-mic-compact {
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  background: #F2F2F7;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 72rpx;
  transition: all 0.2s ease;
}

.voice-mic-compact:active {
  transform: scale(0.92);
  background: #E0E0E0;
}

.voice-mic-compact.recording {
  background: linear-gradient(135deg, #f5576c, #ff6b81);
  animation: micPulse 0.8s ease-in-out infinite;
}

.text-pill-row {
  padding: 10rpx 20rpx;
}

.text-input-pill {
  display: flex;
  align-items: center;
  background: #F2F2F7;
  border-radius: 44rpx;
  padding: 4rpx 4rpx 4rpx 20rpx;
  min-height: 72rpx;
}

.pill-input {
  flex: 1;
  height: 56rpx;
  font-size: 28rpx;
  color: #1A1A1A;
  background: transparent;
}

.pill-send-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #D1D5DB;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: 24rpx;
  color: #FFFFFF;
  font-weight: 600;
  transition: all 0.25s ease;
}

.pill-send-btn.active {
  background: linear-gradient(135deg, #f5576c, #ff6b81);
  box-shadow: 0 4rpx 16rpx rgba(245,87,108,0.3);
}

.pill-voice-toggle {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: 28rpx;
  margin-left: 4rpx;
}

.pill-voice-toggle:active {
  background: rgba(0,0,0,0.05);
}





.cart-bar-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.cart-icon-wrap {
  position: relative;
}

.cart-icon {
  font-size: 48rpx;
}

.cart-badge {
  position: absolute;
  top: -10rpx;
  right: -14rpx;
  background: #f5576c;
  color: #fff;
  font-size: 20rpx;
  font-weight: 700;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cart-summary {
  display: flex;
  flex-direction: column;
}

.cart-label {
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
}

.cart-total {
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.cart-checkout-btn {
  padding: 16rpx 36rpx;
  background: linear-gradient(135deg, #059669, #10B981);
  color: #fff;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 700;
  box-shadow: 0 4rpx 16rpx rgba(5,150,105,0.3);
}

.cart-checkout-btn:active {
  opacity: 0.85;
  transform: scale(0.96);
}

/* ====== Order panel ====== */
.cart-panel-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.4);
  z-index: 999;
  display: flex;
  align-items: flex-end;
  animation: fadeIn 0.2s ease;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.cart-panel {
  width: 100%;
  max-height: 70vh;
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  animation: slideUp 0.3s ease-out;
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.panel-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.panel-close {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #F2F2F7;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #666;
}

.panel-close:active {
  background: #E0E0E0;
}

.panel-dish-list {
  max-height: 40vh;
  overflow-y: auto;
}

.panel-dish-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F2F2F7;
}

.panel-dish-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.panel-dish-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.panel-dish-price {
  font-size: 24rpx;
  color: #f5576c;
  font-weight: 600;
}

.panel-qty-controls {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.qty-btn {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #F2F2F7;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #666;
}

.qty-btn:active {
  background: #E0E0E0;
}

.qty-plus {
  background: #FFF0F3;
  color: #f5576c;
}

.qty-num {
  font-size: 28rpx;
  font-weight: 700;
  color: #1A1A1A;
  min-width: 32rpx;
  text-align: center;
}

.panel-note {
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  background: #F2F2F7;
  border-radius: 16rpx;
  font-size: 26rpx;
  color: #1A1A1A;
}

.panel-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid #1A1A1A;
}

.panel-total {
  font-size: 32rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.panel-confirm-btn {
  padding: 16rpx 48rpx;
  background: linear-gradient(135deg, #f5576c, #ff6b81);
  color: #fff;
  border-radius: 36rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.panel-confirm-btn:active {
  opacity: 0.85;
  transform: scale(0.96);
}

.typing-cursor {
  display: inline;
  font-size: 28rpx;
  line-height: 1.6;
  color: #FFFFFF;
  animation: blink-cursor 0.8s step-end infinite;
}

@keyframes blink-cursor {
  0%, 100% { opacity: 1; }
  50% { opacity: 0; }
}

/* ====== Full-screen rainbow aurora overflow ====== */
.fullscreen-loading {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
  overflow: hidden;
  pointer-events: none;
  animation: fsFadeIn 0.3s ease;
}

@keyframes fsFadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.aurora-blob {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}

/* Center-bottom burst — rainbow overflow from mic area */
.aurora-burst {
  width: 700rpx;
  height: 600rpx;
  background: radial-gradient(ellipse at center bottom, 
    rgba(255, 255, 255, 0.2) 0%,
    rgba(255, 200, 50, 0.25) 15%,
    rgba(255, 50, 150, 0.2) 30%,
    rgba(50, 150, 255, 0.15) 50%,
    transparent 75%);
  bottom: 40rpx;
  left: 50%;
  margin-left: -350rpx;
  animation: burstPulse 2.5s ease-in-out infinite;
}

/* top-left rainbow */
.aurora-tl {
  width: 800rpx;
  height: 750rpx;
  background: radial-gradient(circle at 30% 30%,
    rgba(255, 100, 0, 0.35) 0%,
    rgba(255, 200, 0, 0.25) 25%,
    rgba(0, 200, 100, 0.15) 50%,
    transparent 70%);
  top: -320rpx;
  left: -280rpx;
  animation: driftTL 7s ease-in-out infinite alternate;
}

/* top-right rainbow */
.aurora-tr {
  width: 700rpx;
  height: 700rpx;
  background: radial-gradient(circle at 70% 30%,
    rgba(200, 50, 255, 0.35) 0%,
    rgba(255, 50, 150, 0.25) 25%,
    rgba(255, 100, 0, 0.15) 50%,
    transparent 70%);
  top: -280rpx;
  right: -240rpx;
  animation: driftTR 8s ease-in-out infinite alternate;
}

/* bottom-left rainbow */
.aurora-bl {
  width: 750rpx;
  height: 700rpx;
  background: radial-gradient(circle at 30% 70%,
    rgba(30, 200, 255, 0.35) 0%,
    rgba(50, 100, 255, 0.25) 25%,
    rgba(200, 50, 255, 0.15) 50%,
    transparent 70%);
  bottom: -300rpx;
  left: -260rpx;
  animation: driftBL 9s ease-in-out infinite alternate;
}

/* bottom-right rainbow */
.aurora-br {
  width: 720rpx;
  height: 680rpx;
  background: radial-gradient(circle at 70% 70%,
    rgba(255, 50, 200, 0.35) 0%,
    rgba(255, 200, 50, 0.25) 25%,
    rgba(50, 200, 50, 0.15) 50%,
    transparent 70%);
  bottom: -270rpx;
  right: -260rpx;
  animation: driftBR 7.5s ease-in-out infinite alternate;
}

@keyframes burstPulse {
  0% { transform: scale(1); opacity: 0.6; }
  50% { transform: scale(1.3); opacity: 1; }
  100% { transform: scale(1); opacity: 0.6; }
}

@keyframes driftTL {
  0% { transform: translate(0, 0) scale(1); opacity: 0.5; }
  100% { transform: translate(160rpx, 100rpx) scale(1.3); opacity: 0.95; }
}

@keyframes driftTR {
  0% { transform: translate(0, 0) scale(1); opacity: 0.45; }
  100% { transform: translate(-140rpx, 80rpx) scale(1.25); opacity: 0.9; }
}

@keyframes driftBL {
  0% { transform: translate(0, 0) scale(1); opacity: 0.4; }
  50% { transform: translate(120rpx, -90rpx) scale(1.2); opacity: 0.85; }
  100% { transform: translate(80rpx, -140rpx) scale(1.15); opacity: 0.65; }
}

@keyframes driftBR {
  0% { transform: translate(0, 0) scale(1); opacity: 0.5; }
  50% { transform: translate(-100rpx, -110rpx) scale(1.25); opacity: 0.95; }
  100% { transform: translate(-150rpx, -60rpx) scale(1.1); opacity: 0.75; }
}

/* ====== Reduced motion ====== */
@media (prefers-reduced-motion: reduce) {
  .dish-card.pulse,
  .dish-card.rec-glow,
  .typing-dot,
  .aurora-blob,
  .mic-btn-large.recording,
  .mic-btn-large.rainbow {
    animation: none !important;
  }
  .msg-wrapper {
    animation: none !important;
  }
  .fullscreen-loading {
    display: none !important;
  }
  .cart-panel {
    animation: none !important;
  }
  .cart-panel-overlay {
    animation: none !important;
  }
}

/* ====== Recommended dish persistent glow ====== */
.dish-card.rec-glow {
  animation: recGlow 1.0s ease-in-out infinite;
  border-color: #667eea;
  box-shadow: 0 0 24rpx rgba(102,126,234,0.4);
}

@keyframes recGlow {
  0%, 100% {
    box-shadow: 0 0 16rpx rgba(102,126,234,0.3), 0 0 40rpx rgba(102,126,234,0.1);
    transform: scale(1);
  }
  50% {
    box-shadow: 0 0 32rpx rgba(102,126,234,0.6), 0 0 80rpx rgba(102,126,234,0.2);
    transform: scale(1.04);
  }
}
