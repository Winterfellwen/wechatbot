<!--ai-order/pages/customer/customer.wxml-->
<view class="customer-container {{inputMode === 'voice' ? 'voice-mode' : ''}} {{cartItemCount > 0 ? 'cart-visible' : ''}}" bindtouchmove="onChatTouchMove">

  <!-- Dish grid area -->
      <scroll-view class="dish-grid-area {{chatExpanded ? 'chat-expanded' : ''}}" scroll-y show-scrollbar="{{false}}" scroll-into-view="{{scrollToDishZone}}" scroll-with-animation bindscroll="onDishGridScroll" catchtap="collapseChat">
        <view class="grid-header">
          <text class="grid-header-title">菜单</text>
          <picker mode="selector" range="{{groupModes}}" range-key="label" bindchange="onGroupModeChange">
            <view class="group-picker">
              <text class="group-picker-label">{{groupModeLabel}}</text>
              <text class="group-picker-arrow">▼</text>
            </view>
          </picker>
        </view>
        <view wx:for="{{tasteGroups}}" wx:for-item="zone" wx:key="taste" class="taste-zone" id="zone-{{zone.taste}}">
          <view class="taste-header">
            <view class="taste-indicator" style="background: {{zone.bgColor}}"></view>
            <text class="taste-label">{{zone.taste}}</text>
          </view>
          <view class="dish-row">
            <view wx:for="{{zone.dishes}}" wx:key="id" id="dish-{{item.id}}" class="dish-card {{highlightedDishId === item.id ? 'pulse' : ''}} {{showRecGlow && zone.taste === 'AI推荐' && recDishIds[item.id] ? 'rec-glow' : ''}}" catchtap="onDishTap" data-dishid="{{item.id}}">
                <view wx:if="{{!item.imageUrl}}" class="dish-avatar" style="background: {{item.bgStyle}}">
                  <text class="dish-avatar-char">{{item.avatarChar}}</text>
                </view>
                <image wx:else class="dish-image" src="{{item.imageUrl}}" mode="aspectFill" catchtap="previewImage" data-url="{{item.imageUrl}}"></image>
                <text class="dish-card-name">{{item.name}}</text>
                <text class="dish-card-price">¥{{item.price}}</text>
                <view class="spicy-indicator">
                  <block wx:if="{{item.spicyLevel > 0}}">
                    <text wx:for="{{item.spicyLevel}}" wx:key="index">🌶</text>
                  </block>
                </view>
                <view wx:if="{{cartQtyMap[item.id] > 0}}" class="dish-qty-controls">
                  <view class="dish-qty-btn" catchtap="updateItemQty" data-dishid="{{item.id}}" data-delta="{{-1}}">−</view>
                  <text class="dish-qty-num">{{cartQtyMap[item.id]}}</text>
                  <view class="dish-qty-btn dish-qty-plus" catchtap="updateItemQty" data-dishid="{{item.id}}" data-delta="{{1}}">+</view>
                </view>
                <view wx:else class="cart-btn" catchtap="addToCart" data-dishid="{{item.id}}" data-name="{{item.name}}" data-price="{{item.price}}">
                  <text class="cart-btn-text">加入购物车</text>
                </view>
              </view>
        </view>
        <view wx:if="{{tasteGroups.length === 0 && !menuLoading}}" class="grid-empty">
          <text class="grid-empty-text">暂无菜单数据</text>
          <view class="grid-empty-btn" catchtap="loadMenu">重新加载</view>
        </view>
        <view wx:if="{{menuLoading}}" class="grid-loading">
          <text class="grid-loading-text">加载菜单中...</text>
        </view>
        <view class="grid-bottom-spacer"></view>
      </scroll-view>

  <!-- Chat compact bar: triggers drag expansion -->
  <view wx:if="{{!chatExpanded}}" class="chat-compact-inner" bindtouchstart="onChatTouchStart" data-chat-trigger="1">
    <view class="compact-preview" wx:if="{{lastAiContent}}">
      <view class="compact-ai-avatar">
        <text class="compact-ai-text">AI</text>
      </view>
      <text class="compact-preview-text">{{lastAiContent}}</text>
    </view>
    <view class="compact-hint" wx:if="{{!lastAiContent}}">
      <text class="compact-hint-icon">💬</text>
      <text class="compact-hint-text">点我咨询菜品</text>
    </view>
  </view>

  <!-- Chat expanded overlay: fixed, slides from below -->
  <view class="chat-area {{chatExpanded ? 'expanded' : ''}}" 
        style="transform: translateY({{chatSlideY}}); transition: {{chatSliding ? 'none' : 'transform 0.25s cubic-bezier(0.32, 0.72, 0, 1)'}}">
    <view class="chat-expanded-inner">
      <view class="chat-expand-header" catchtap="collapseChat">
        <view class="collapse-bar">
          <text class="collapse-arrow">▼</text>
          <text class="collapse-text">收起</text>
        </view>
      </view>
      <scroll-view class="chat-scroll-view" scroll-y enhanced show-scrollbar="{{false}}" scroll-into-view="{{scrollToView}}">
        <view class="chat-msg-list">
          <view wx:for="{{messages}}" wx:key="id" class="msg-wrapper" id="msg-{{item.id}}">
            <view wx:if="{{item.role === 'ai'}}" class="msg-row ai">
              <view class="msg-avatar ai-avatar">
                <text class="msg-avatar-text">AI</text>
              </view>
              <view class="bubble ai-bubble" bindlongpress="copyText" data-text="{{item.content}}">
                <text class="bubble-text" selectable="true" user-select="true">{{item.content}}</text>
              </view>
            </view>
            <view wx:if="{{item.role === 'user'}}" class="msg-row user">
              <view class="bubble user-bubble" bindlongpress="copyText" data-text="{{item.content}}">
                <text class="bubble-text user-bubble-text" selectable="true" user-select="true">{{item.content}}</text>
              </view>
              <view class="msg-avatar user-avatar">
                <text class="msg-avatar-text">我</text>
              </view>
            </view>
          </view>
          <view wx:if="{{streamingText}}" class="msg-wrapper">
            <view class="msg-row ai">
              <view class="msg-avatar ai-avatar">
                <text class="msg-avatar-text">AI</text>
              </view>
              <view class="bubble ai-bubble">
                <text class="bubble-text" selectable="true" user-select="true">{{streamingText}}</text>
                <text class="typing-cursor">▋</text>
              </view>
            </view>
          </view>
          <view wx:elif="{{loading}}" class="msg-wrapper">
            <view class="msg-row ai">
              <view class="msg-avatar ai-avatar">
                <text class="msg-avatar-text">AI</text>
              </view>
              <view class="bubble ai-bubble typing-bubble">
                <view class="typing-indicator">
                  <view class="typing-dot"></view>
                  <view class="typing-dot"></view>
                  <view class="typing-dot"></view>
                </view>
              </view>
            </view>
          </view>
          <view class="chat-bottom" id="chat-bottom"></view>
        </view>
      </scroll-view>
      <!-- Chips + input inside chat when expanded -->
      <view wx:if="{{chatExpanded}}" class="chat-bottom-bar">
        <view class="chat-quick-chips">
          <scroll-view scroll-x enhanced show-scrollbar="{{false}}" class="chips-scroll">
            <view wx:for="{{quickReplies}}" wx:key="index" class="chip" catchtap="onQuickReply" data-text="{{item}}">
              <text>{{item}}</text>
            </view>
            <view wx:if="{{lastOrder && lastOrder.dishes && lastOrder.dishes.length > 0}}" class="chip chip-reorder" catchtap="showLastOrder">
              <text>🔄 再来一单</text>
            </view>
          </scroll-view>
        </view>
        <view class="chat-input-section {{inputMode === 'voice' ? 'voice-mode' : ''}}">
          <view wx:if="{{inputMode === 'voice'}}" class="chat-voice-input-area">
            <view class="chat-mic-btn {{isRecording ? 'recording' : ''}} {{loading ? 'rainbow' : ''}}" bindtouchstart="_startVoiceInput" bindtouchend="_stopVoiceInput">
              <text class="chat-icon-mic">🎤</text>
              <text class="chat-mic-label">{{isRecording ? '正在聆听...' : '按住说话'}}</text>
            </view>
            <view class="chat-mode-toggle" catchtap="_switchToText">
              <text class="chat-mode-toggle-label">键盘输入</text>
            </view>
          </view>
          <view wx:else class="chat-text-input-area">
            <view class="chat-input-bar">
              <input class="chat-msg-input" placeholder="输入想吃的口味..." value="{{inputText}}" bindinput="onInput" confirm-type="send" bindconfirm="onSend" cursor-spacing="20" />
              <view class="chat-send-btn {{hasInput ? 'active' : ''}}" catchtap="onSend">
                <text class="chat-icon-send">↑</text>
              </view>
            </view>
            <view class="chat-mode-toggle" catchtap="_switchToVoice">
              <text class="chat-mode-toggle-label">语音输入</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- Quick chips (page flow, hidden when chat expanded) -->
  <view wx:if="{{!chatExpanded}}" class="quick-chips">
    <scroll-view scroll-x enhanced show-scrollbar="{{false}}" class="chips-scroll">
      <view wx:for="{{quickReplies}}" wx:key="index" class="chip" catchtap="onQuickReply" data-text="{{item}}">
        <text>{{item}}</text>
      </view>
      <view wx:if="{{lastOrder && lastOrder.dishes && lastOrder.dishes.length > 0}}" class="chip chip-reorder" catchtap="showLastOrder">
        <text>🔄 再来一单</text>
      </view>
    </scroll-view>
  </view>

  <!-- Input bar (page flow, hidden when chat expanded) -->
  <view wx:if="{{!chatExpanded}}" class="input-section {{inputMode === 'voice' ? 'voice-mode' : ''}}">
    <view wx:if="{{inputMode === 'voice'}}" class="voice-input-area">
      <view class="mic-btn-large {{isRecording ? 'recording' : ''}} {{loading ? 'rainbow' : ''}}" bindtouchstart="_startVoiceInput" bindtouchend="_stopVoiceInput">
        <text class="icon-mic-large">🎤</text>
        <text class="mic-label">{{isRecording ? '正在聆听...' : '按住说话'}}</text>
      </view>
      <view class="mode-toggle mode-toggle-corner" catchtap="_switchToText">
        <text class="mode-toggle-label">键盘输入</text>
      </view>
    </view>
    <view wx:else class="text-input-area">
      <view class="input-bar">
        <input class="msg-input" placeholder="输入想吃的口味..." value="{{inputText}}" bindinput="onInput" bindfocus="expandChat" bindblur="onChatBlur" confirm-type="send" bindconfirm="onSend" cursor-spacing="20" />
        <view class="send-btn {{hasInput ? 'active' : ''}}" catchtap="onSend">
          <text class="icon-send">↑</text>
        </view>
      </view>
      <view class="mode-toggle" catchtap="_switchToVoice">
        <text class="mode-toggle-label">语音输入</text>
      </view>
    </view>
  </view>

  <!-- Cart bar (tap anywhere to open) -->
  <view wx:if="{{cartItemCount > 0}}" class="cart-bar" catchtap="onCartTap">
    <view class="cart-bar-left">
      <view class="cart-icon-wrap">
        <text class="cart-icon">🛒</text>
        <text class="cart-badge">{{cartItemCount}}</text>
      </view>
      <view class="cart-summary">
        <text class="cart-label">购物车</text>
        <text class="cart-total">¥{{totalPrice}}</text>
      </view>
    </view>
    <view class="cart-checkout-btn">
      <text>去下单</text>
    </view>
  </view>

  <!-- Cart order panel (slide-up) -->
  <view wx:if="{{showCartPanel}}" class="cart-panel-overlay" catchtap="onCloseCartPanel">
    <view class="cart-panel" catchtap="">
      <view class="panel-header">
        <text class="panel-title">确认订单</text>
        <view class="panel-close" catchtap="onCloseCartPanel">
          <text>✕</text>
        </view>
      </view>
      <scroll-view class="panel-dish-list" scroll-y>
        <view wx:for="{{cart}}" wx:key="id" class="panel-dish-item">
          <view class="panel-dish-info">
            <text class="panel-dish-name">{{item.name}}</text>
            <text class="panel-dish-price">¥{{item.price}}</text>
          </view>
          <view class="panel-qty-controls">
            <view class="qty-btn" catchtap="updateItemQty" data-dishid="{{item.id}}" data-delta="{{-1}}">−</view>
            <text class="qty-num">{{item.quantity}}</text>
            <view class="qty-btn qty-plus" catchtap="updateItemQty" data-dishid="{{item.id}}" data-delta="{{1}}">+</view>
          </view>
        </view>
      </scroll-view>
      <input class="panel-note" placeholder="备注（选填）" value="{{orderNote}}" bindinput="onOrderNoteInput" />
      <view class="panel-footer">
        <text class="panel-total">合计：¥{{totalPrice}}</text>
        <view class="panel-confirm-btn" catchtap="onSubmitOrder">确认下单</view>
      </view>
    </view>
  </view>

  <!-- Full-screen aurora edge glow -->
  <view wx:if="{{loading}}" class="fullscreen-loading">
    <view class="aurora-blob aurora-burst"></view>
    <view class="aurora-blob aurora-tl"></view>
    <view class="aurora-blob aurora-tr"></view>
    <view class="aurora-blob aurora-bl"></view>
    <view class="aurora-blob aurora-br"></view>
  </view>

</view>
