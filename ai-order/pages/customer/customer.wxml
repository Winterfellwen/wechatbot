<!--ai-order/pages/customer/customer.wxml-->
<view class="chat-container">
  <!-- 消息列表 -->
  <scroll-view
    class="msg-list"
    scroll-y
    scroll-top="{{scrollTop}}"
    scroll-with-animation
    enhanced
    bounces
    show-scrollbar="{{false}}">

    <!-- 消息列表 -->
    <view wx:for="{{messages}}" wx:key="id" id="msg-{{item.id}}" class="msg-wrapper">
      <!-- AI 消息 -->
      <view wx:if="{{item.role === 'ai'}}" class="msg-row ai">
        <view class="ai-avatar-wrapper">
          <view class="avatar ai-avatar">
            <image class="avatar-img" src="/images/avatar-default.png" mode="aspectFill"></image>
          </view>
        </view>
        <view class="msg-content">
          <view class="bubble ai-bubble" bindlongpress="copyText" data-text="{{item.content}}">
            <text class="bubble-text" selectable="true" user-select="true">{{item.content}}</text>
          </view>
          <!-- 推荐菜品卡片 -->
          <view wx:if="{{item.recommendations && item.recommendations.length > 0}}" class="dish-cards">
            <view wx:for="{{item.recommendations}}" wx:key="id" class="dish-card" data-dish="{{item}}">
              <view class="dish-info">
                <text class="dish-name">{{item.name}}</text>
                <text class="dish-price">¥{{item.price}}</text>
                <view class="dish-tags">
                  <text class="dish-tag taste-tag">{{item.taste}}</text>
                  <text wx:if="{{item.spicyLevel > 0}}" class="dish-tag spicy-tag">辣度: {{item.spicyLevel}}</text>
                </view>
              </view>
              <view class="dish-order-btn" catchtap="onOrderDish" data-dishid="{{item.id}}" data-name="{{item.name}}" data-price="{{item.price}}">点这个</view>
            </view>
          </view>
        </view>
      </view>

      <!-- 用户消息 -->
      <view wx:if="{{item.role === 'user'}}" class="msg-row user">
        <view class="msg-content user-msg-content">
          <view class="bubble user-bubble" bindlongpress="copyText" data-text="{{item.content}}">
            <text class="bubble-text" selectable="true" user-select="true">{{item.content}}</text>
          </view>
        </view>
        <view class="user-avatar-wrapper">
          <view class="avatar user-avatar">
            <text class="avatar-text">我</text>
          </view>
        </view>
      </view>
    </view>

    <!-- AI 正在输入 -->
    <view wx:if="{{loading}}" class="msg-wrapper">
      <view class="msg-row ai">
        <view class="ai-avatar-wrapper">
          <view class="avatar ai-avatar">
            <image class="avatar-img" src="/images/avatar-default.png" mode="aspectFill"></image>
          </view>
        </view>
        <view class="msg-content">
          <view class="bubble ai-bubble typing-bubble">
            <view class="typing-indicator">
              <view class="typing-dot"></view>
              <view class="typing-dot"></view>
              <view class="typing-dot"></view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="list-bottom" id="msg-bottom"></view>
  </scroll-view>

  <!-- 购物车摘要 -->
  <view wx:if="{{cart.length > 0}}" class="cart-bar">
    <view class="cart-info">
      <text class="cart-text">已选 {{cart.length}} 道菜</text>
      <text class="cart-total">合计: ¥{{totalPrice}}</text>
    </view>
    <view class="cart-order-btn" catchtap="onConfirmOrder">确认下单</view>
  </view>

  <!-- 订单确认弹窗 -->
  <view wx:if="{{showOrderDialog}}" class="order-overlay" catchtap="onCloseOrder">
    <view class="order-dialog" catchtap="">
      <text class="order-dialog-title">确认订单</text>
      <view wx:for="{{cart}}" wx:key="id" class="order-dish-item">
        <text>{{item.name}}</text>
        <text>¥{{item.price}}</text>
      </view>
      <view class="order-total-row">
        <text>合计</text>
        <text>¥{{totalPrice}}</text>
      </view>
      <view class="order-actions">
        <view class="order-cancel-btn" catchtap="onCloseOrder">取消</view>
        <view class="order-confirm-btn" catchtap="onSubmitOrder">确认下单</view>
      </view>
    </view>
  </view>

  <!-- 快捷问题 -->
  <view wx:if="{{quickReplies.length > 0 && messages.length <= 1}}" class="quick-replies">
    <view class="quick-reply-title">快捷提问</view>
    <scroll-view class="quick-reply-scroll" scroll-x enhanced show-scrollbar="{{false}}">
      <view wx:for="{{quickReplies}}" wx:key="index" class="quick-reply-tag" catchtap="onQuickReply" data-text="{{item}}">
        <text>{{item}}</text>
      </view>
    </scroll-view>
  </view>

  <!-- 底部输入栏 -->
  <view class="input-section">
    <view class="input-bar">
      <view class="input-center">
        <input
          class="msg-input"
          placeholder="输入您想吃的口味..."
          placeholder-class="input-placeholder"
          value="{{inputText}}"
          bindinput="onInput"
          confirm-type="send"
          bindconfirm="onSend"
          cursor-spacing="20"
        />
      </view>
      <view
        class="send-btn {{hasInput ? 'active' : ''}}"
        bindtap="onSend"
        hover-class="{{hasInput ? 'send-btn-hover' : ''}}">
        <text class="icon-send">↑</text>
      </view>
    </view>
  </view>
</view>
