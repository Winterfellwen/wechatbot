/* ===== 温暖有机的东方食肆美学 ===== */
.container {
  padding: 40rpx 32rpx;
  background: linear-gradient(180deg, #fef9f2 0%, #f8f2e8 100%);
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  position: relative;
  overflow: hidden;
}

.container::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 240rpx;
  background: linear-gradient(135deg, rgba(190, 106, 70, 0.08) 0%, rgba(70, 120, 90, 0.04) 100%);
  z-index: 0;
}

.header {
  padding: 20rpx 0 40rpx;
  position: relative;
  z-index: 1;
}

.header-title {
  font-size: 48rpx;
  font-weight: 800;
  color: #3e2c1a;
  letter-spacing: -0.5rpx;
  position: relative;
  display: inline-block;
}

.header-title::after {
  content: '';
  position: absolute;
  bottom: -8rpx;
  left: 0;
  width: 80rpx;
  height: 6rpx;
  background: linear-gradient(90deg, #be6a46 0%, #46785a 100%);
  border-radius: 3rpx;
}

.section-label {
  font-size: 28rpx;
  color: #8c7a65;
  margin-bottom: 28rpx;
  padding-left: 12rpx;
  font-weight: 500;
  position: relative;
  z-index: 1;
}

.section-label::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 4rpx;
  height: 20rpx;
  background: #be6a46;
  border-radius: 2rpx;
}

.loading-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  position: relative;
  z-index: 1;
}

.loading-text {
  color: #a69580;
  font-size: 30rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
}

.merchant-scroll {
  flex: 1;
  max-height: 65vh;
  position: relative;
  z-index: 1;
}

/* ===== 商家卡片 ===== */
.merchant-card {
  position: relative;
  background: rgba(255, 253, 248, 0.95);
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid rgba(190, 106, 70, 0.12);
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  box-shadow: 
    0 4rpx 16rpx rgba(62, 44, 26, 0.04),
    0 1rpx 4rpx rgba(62, 44, 26, 0.02);
  backdrop-filter: blur(10rpx);
}

.merchant-card:active {
  transform: translateY(-2rpx);
  box-shadow: 
    0 8rpx 32rpx rgba(62, 44, 26, 0.08),
    0 2rpx 8rpx rgba(62, 44, 26, 0.04);
}

.merchant-card.selected {
  border-color: #be6a46;
  background: rgba(255, 248, 240, 0.98);
  box-shadow: 
    0 8rpx 32rpx rgba(190, 106, 70, 0.12),
    0 2rpx 8rpx rgba(190, 106, 70, 0.06),
    inset 0 0 0 1rpx rgba(190, 106, 70, 0.2);
}

.card-top {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.card-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #3e2c1a;
  letter-spacing: -0.3rpx;
  line-height: 1.3;
}

.card-badge {
  margin-left: 16rpx;
  padding: 6rpx 16rpx;
  background: rgba(70, 120, 90, 0.12);
  color: #46785a;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 0.5rpx;
  border: 1rpx solid rgba(70, 120, 90, 0.2);
}

.card-desc {
  font-size: 28rpx;
  color: #8c7a65;
  margin-bottom: 16rpx;
  display: block;
  line-height: 1.5;
  font-weight: 400;
}

.card-dishes {
  font-size: 26rpx;
  color: #a69580;
  font-weight: 500;
  letter-spacing: 0.5rpx;
}

.card-note {
  display: block;
  margin-top: 10rpx;
  padding: 12rpx 16rpx;
  font-size: 22rpx;
  color: #8c7a65;
  background: rgba(190, 106, 70, 0.06);
  border-left: 4rpx solid #be6a46;
  border-radius: 6rpx;
  line-height: 1.5;
}

.card-check {
  position: absolute;
  right: 32rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 56rpx;
  height: 56rpx;
  background: linear-gradient(135deg, #be6a46 0%, #d88a66 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 20rpx rgba(190, 106, 70, 0.3);
  transition: all 0.3s ease;
}

.merchant-card:not(.selected) .card-check {
  opacity: 0;
  transform: translateY(-50%) scale(0.8);
}

.check-icon {
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
}

/* ===== 新建商家入口 ===== */
.create-card {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 36rpx 32rpx;
  background: rgba(255, 255, 255, 0.7);
  border-radius: 24rpx;
  border: 2rpx dashed rgba(190, 106, 70, 0.3);
  margin-bottom: 24rpx;
  transition: all 0.3s ease;
  backdrop-filter: blur(8rpx);
}

.create-card:active {
  background: rgba(255, 255, 255, 0.9);
  border-color: rgba(190, 106, 70, 0.5);
  transform: scale(0.98);
}

.create-icon {
  font-size: 44rpx;
  color: #be6a46;
  margin-right: 16rpx;
  font-weight: 300;
  transition: all 0.3s ease;
}

.create-card:active .create-icon {
  transform: scale(1.1);
}

.create-text {
  font-size: 32rpx;
  color: #be6a46;
  font-weight: 600;
  letter-spacing: 0.5rpx;
}

/* ===== 底部操作按钮 ===== */
.bottom-buttons {
  display: flex;
  gap: 24rpx;
  margin-top: auto;
  padding: 32rpx 0 20rpx;
  position: relative;
  z-index: 1;
}

.btn {
  flex: 1;
  padding: 32rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  color: #fff;
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  box-shadow: 
    0 6rpx 24rpx rgba(62, 44, 26, 0.12),
    0 2rpx 8rpx rgba(62, 44, 26, 0.06);
  position: relative;
  overflow: hidden;
}

.btn::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, rgba(255,255,255,0.15) 0%, rgba(255,255,255,0) 100%);
  opacity: 0;
  transition: opacity 0.3s ease;
}

.btn:active {
  transform: translateY(2rpx);
  box-shadow: 
    0 3rpx 12rpx rgba(62, 44, 26, 0.12),
    0 1rpx 4rpx rgba(62, 44, 26, 0.06);
}

.btn:active::before {
  opacity: 1;
}

.btn-merchant {
  background: linear-gradient(135deg, #3e2c1a 0%, #5a4530 100%);
  border: 1rpx solid rgba(62, 44, 26, 0.2);
}

.btn-customer {
  background: linear-gradient(135deg, #46785a 0%, #5d9472 100%);
  border: 1rpx solid rgba(70, 120, 90, 0.2);
}

.btn-icon {
  font-size: 36rpx;
  filter: drop-shadow(0 2rpx 4rpx rgba(0,0,0,0.1));
}

.btn-label {
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 0.5rpx;
}

/* ===== 弹窗 - 有机美学 ===== */
.modal-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(62, 44, 26, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  backdrop-filter: blur(8rpx);
  animation: fadeIn 0.3s ease;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.modal-content {
  background: rgba(255, 253, 248, 0.98);
  border-radius: 32rpx;
  padding: 48rpx 40rpx;
  width: 680rpx;
  max-width: 90vw;
  box-shadow: 
    0 32rpx 96rpx rgba(62, 44, 26, 0.2),
    0 8rpx 32rpx rgba(62, 44, 26, 0.1);
  border: 1rpx solid rgba(190, 106, 70, 0.15);
  backdrop-filter: blur(20rpx);
  animation: modalSlideIn 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  position: relative;
  overflow: hidden;
}

.modal-content::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 6rpx;
  background: linear-gradient(90deg, #be6a46 0%, #46785a 100%);
  border-radius: 3rpx 3rpx 0 0;
}

@keyframes modalSlideIn {
  from { 
    opacity: 0;
    transform: translateY(40rpx) scale(0.95);
  }
  to { 
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.modal-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #3e2c1a;
  margin-bottom: 48rpx;
  display: block;
  text-align: center;
  letter-spacing: -0.5rpx;
  position: relative;
  padding-bottom: 20rpx;
}

.modal-title::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 80rpx;
  height: 4rpx;
  background: #be6a46;
  border-radius: 2rpx;
}

.modal-input {
  width: 100%;
  padding: 28rpx 24rpx;
  border: 1rpx solid rgba(190, 106, 70, 0.2);
  border-radius: 16rpx;
  font-size: 32rpx;
  margin-bottom: 28rpx;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.8);
  transition: all 0.3s ease;
  height: 88rpx;
  line-height: 32rpx;
  color: #3e2c1a;
  font-weight: 500;
}

.modal-input::placeholder {
  color: #a69580;
  font-weight: 400;
}

.modal-input:focus {
  border-color: #be6a46;
  background: #fff;
  box-shadow: 
    0 0 0 4rpx rgba(190, 106, 70, 0.1),
    inset 0 0 0 1rpx rgba(190, 106, 70, 0.3);
  transform: translateY(-2rpx);
}

.modal-input-desc {
  font-size: 30rpx;
  color: #8c7a65;
  margin-bottom: 36rpx;
}

.modal-buttons {
  display: flex;
  gap: 28rpx;
  margin-top: 48rpx;
}

.modal-btn {
  flex: 1;
  padding: 28rpx;
  border-radius: 16rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 700;
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  border: none;
  letter-spacing: 0.5rpx;
  position: relative;
  overflow: hidden;
}

.modal-btn::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, rgba(255,255,255,0.15) 0%, rgba(255,255,255,0) 100%);
  opacity: 0;
  transition: opacity 0.3s ease;
}

.modal-btn:active::before {
  opacity: 1;
}

.modal-btn-cancel {
  background: rgba(140, 122, 101, 0.1);
  color: #8c7a65;
  border: 1rpx solid rgba(140, 122, 101, 0.2);
}

.modal-btn-cancel:active {
  background: rgba(140, 122, 101, 0.2);
  transform: translateY(2rpx);
}

.modal-btn-confirm {
  background: linear-gradient(135deg, #be6a46 0%, #d88a66 100%);
  color: #fff;
  box-shadow: 
    0 8rpx 32rpx rgba(190, 106, 70, 0.3),
    0 2rpx 8rpx rgba(190, 106, 70, 0.2);
  border: 1rpx solid rgba(190, 106, 70, 0.3);
}

.modal-btn-confirm.disabled {
  opacity: 0.5;
  box-shadow: none;
  filter: grayscale(0.3);
}

.modal-btn-confirm:active:not(.disabled) {
  transform: translateY(2rpx);
  box-shadow: 
    0 4rpx 16rpx rgba(190, 106, 70, 0.3),
    0 1rpx 4rpx rgba(190, 106, 70, 0.2);
}

/* ===== 复制演示商家 - 有机样式 ===== */
.copy-demo-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx 0;
  margin-bottom: 12rpx;
  transition: all 0.2s ease;
}

.copy-demo-check {
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
  border: 2rpx solid rgba(190, 106, 70, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #fff;
  flex-shrink: 0;
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  background: rgba(255, 255, 255, 0.8);
}

.copy-demo-check.checked {
  background: linear-gradient(135deg, #46785a 0%, #5d9472 100%);
  border-color: #46785a;
  box-shadow: 0 4rpx 16rpx rgba(70, 120, 90, 0.3);
}

.copy-demo-label {
  font-size: 30rpx;
  color: #3e2c1a;
  font-weight: 600;
  letter-spacing: 0.3rpx;
}

.copy-demo-hint {
  font-size: 26rpx;
  color: #a69580;
  margin-left: 4rpx;
  font-weight: 400;
}

/* ===== 演示商家标签选择器 - 有机样式 ===== */
.demo-tags {
  margin: 0 0 40rpx;
}

.demo-tags-scroll {
  white-space: nowrap;
  width: 100%;
}

.demo-tags-container {
  display: inline-flex;
  gap: 20rpx;
  padding: 8rpx 4rpx;
}

.demo-tag {
  flex-shrink: 0;
  padding: 24rpx 36rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.8);
  border: 1rpx solid rgba(190, 106, 70, 0.2);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 172rpx;
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  box-shadow: 
    0 2rpx 8rpx rgba(62, 44, 26, 0.04),
    0 1rpx 2rpx rgba(62, 44, 26, 0.02);
}

.demo-tag:active {
  transform: translateY(-2rpx);
  box-shadow: 
    0 6rpx 24rpx rgba(62, 44, 26, 0.08),
    0 2rpx 6rpx rgba(62, 44, 26, 0.04);
}

.demo-tag.selected {
  background: linear-gradient(135deg, #3e2c1a 0%, #5a4530 100%);
  border-color: #3e2c1a;
  box-shadow: 
    0 8rpx 32rpx rgba(62, 44, 26, 0.25),
    0 2rpx 8rpx rgba(62, 44, 26, 0.15);
}

.demo-tag-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #3e2c1a;
  margin-bottom: 8rpx;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 136rpx;
  transition: color 0.3s ease;
}

.demo-tag.selected .demo-tag-name {
  color: #fff;
}

.demo-tag-count {
  font-size: 24rpx;
  color: #a69580;
  font-weight: 500;
  transition: color 0.3s ease;
}

.demo-tag.selected .demo-tag-count {
  color: rgba(255, 255, 255, 0.7);
}
