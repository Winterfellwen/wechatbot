/* ===== Modern Glassmorphism on White ===== */

.page {
  min-height: 100vh;
  background: #fafafa;
  padding: 0 32rpx 40rpx;
  position: relative;
  display: flex;
  flex-direction: column;
}

/* Subtle dot-grid background for glass depth */
.page::before {
  content: '';
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background-image: radial-gradient(rgba(0,0,0,0.04) 1.5rpx, transparent 1.5rpx);
  background-size: 32rpx 32rpx;
  pointer-events: none;
  z-index: 0;
}

/* Decorative soft gradient orbs */
.bg-orb {
  position: fixed;
  border-radius: 50%;
  filter: blur(100rpx);
  z-index: 0;
  pointer-events: none;
}
.bg-orb-1 {
  width: 500rpx; height: 500rpx;
  background: rgba(245,158,11,0.08);
  top: -200rpx; right: -100rpx;
}
.bg-orb-2 {
  width: 400rpx; height: 400rpx;
  background: rgba(20,184,166,0.06);
  bottom: 50rpx; left: -150rpx;
}

/* ===== Header ===== */
.header {
  position: relative;
  z-index: 2;
  padding: 56rpx 0 40rpx;
}
.header-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #0f172a;
  display: block;
}
.header-subtitle {
  font-size: 26rpx;
  color: #94a3b8;
  margin-top: 10rpx;
  display: block;
  font-weight: 400;
}

/* ===== Section ===== */
.section {
  position: relative;
  z-index: 2;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.section-label {
  font-size: 24rpx;
  color: #94a3b8;
  font-weight: 600;
  letter-spacing: 1.5rpx;
  text-transform: uppercase;
}

/* ===== Loading ===== */
.loading-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  z-index: 2;
}
.loading-glass {
  background: rgba(255,255,255,0.6);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border: 1rpx solid rgba(0,0,0,0.04);
  border-radius: 24rpx;
  padding: 40rpx 72rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.loading-text {
  font-size: 26rpx;
  color: #94a3b8;
  letter-spacing: 1rpx;
}

/* ===== Merchant Scroll ===== */
.merchant-scroll {
  flex: 1;
  max-height: 62vh;
  position: relative;
  z-index: 2;
}

/* ===== Merchant Card ===== */
.merchant-card {
  position: relative;
  background: rgba(255,255,255,0.75);
  backdrop-filter: blur(16rpx);
  -webkit-backdrop-filter: blur(16rpx);
  border: 1rpx solid rgba(0,0,0,0.04);
  border-radius: 24rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 20rpx;
  transition: all 0.3s ease;
  box-shadow: 0 1rpx 8rpx rgba(0,0,0,0.02);
}

.merchant-card:active {
  transform: scale(0.97);
  box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.04);
}

.merchant-card.selected {
  border-color: rgba(245,158,11,0.25);
  background: rgba(255,255,255,0.9);
  box-shadow: 0 2rpx 20rpx rgba(245,158,11,0.06), 0 0 0 1rpx rgba(245,158,11,0.08);
}

.card-content {
  position: relative;
  z-index: 1;
}

.card-top {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.card-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #0f172a;
}

.card-badge {
  margin-left: 12rpx;
  padding: 2rpx 16rpx;
  background: rgba(245,158,11,0.1);
  color: #d97706;
  border-radius: 16rpx;
  font-size: 20rpx;
  font-weight: 500;
  border: 1rpx solid rgba(245,158,11,0.12);
}

.card-desc {
  font-size: 26rpx;
  color: #64748b;
  margin-bottom: 12rpx;
  display: block;
  line-height: 1.5;
}

.card-meta {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.card-dishes {
  font-size: 24rpx;
  color: #94a3b8;
  font-weight: 400;
}

.card-note {
  display: block;
  margin-top: 14rpx;
  padding: 12rpx 16rpx;
  font-size: 22rpx;
  color: #64748b;
  background: rgba(245,158,11,0.04);
  border-left: 3rpx solid rgba(245,158,11,0.2);
  border-radius: 4rpx;
  line-height: 1.5;
}

.card-check {
  position: absolute;
  right: 24rpx;
  top: 24rpx;
  width: 40rpx;
  height: 40rpx;
  background: linear-gradient(135deg, #f59e0b, #d97706);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transform: scale(0.5);
  transition: all 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
  box-shadow: 0 2rpx 12rpx rgba(245,158,11,0.3);
}
.card-check.visible {
  opacity: 1;
  transform: scale(1);
}

.check-icon {
  color: #fff;
  font-size: 24rpx;
  font-weight: bold;
}

/* ===== Create Card ===== */
.create-card {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  background: rgba(255,255,255,0.5);
  backdrop-filter: blur(12rpx);
  -webkit-backdrop-filter: blur(12rpx);
  border-radius: 24rpx;
  border: 1.5rpx dashed rgba(0,0,0,0.08);
  margin-bottom: 20rpx;
  transition: all 0.3s ease;
}

.create-card:active {
  background: rgba(255,255,255,0.7);
  border-color: rgba(245,158,11,0.2);
  transform: scale(0.98);
}

.create-icon {
  font-size: 36rpx;
  color: rgba(245,158,11,0.5);
  margin-right: 12rpx;
  font-weight: 300;
}

.create-text {
  font-size: 28rpx;
  color: #94a3b8;
  font-weight: 500;
}

/* ===== Bottom Glass Bar ===== */
.bottom-bar {
  position: relative;
  z-index: 2;
  display: flex;
  gap: 20rpx;
  margin-top: auto;
  padding: 20rpx 0 16rpx;
}

.bottom-btn {
  flex: 1;
  padding: 26rpx 20rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  transition: all 0.25s ease;
  border: 1rpx solid rgba(0,0,0,0.06);
}

.bottom-btn:active {
  transform: translateY(2rpx);
}

.btn-merchant {
  background: rgba(245,158,11,0.1);
  backdrop-filter: blur(12rpx);
  -webkit-backdrop-filter: blur(12rpx);
  border-color: rgba(245,158,11,0.15);
  color: #d97706;
}
.btn-merchant:active {
  background: rgba(245,158,11,0.16);
}

.btn-customer {
  background: rgba(20,184,166,0.08);
  backdrop-filter: blur(12rpx);
  -webkit-backdrop-filter: blur(12rpx);
  border-color: rgba(20,184,166,0.12);
  color: #0d9488;
}
.btn-customer:active {
  background: rgba(20,184,166,0.14);
}

.btn-icon-wrap {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-icon-symbol {
  font-size: 32rpx;
  opacity: 0.75;
}

.btn-label {
  font-size: 26rpx;
  font-weight: 600;
}

/* ===== Modal ===== */
.modal-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(15,23,42,0.3);
  backdrop-filter: blur(6rpx);
  -webkit-backdrop-filter: blur(6rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  animation: fadeIn 0.25s ease;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.modal-content {
  background: rgba(255,255,255,0.85);
  backdrop-filter: blur(32rpx);
  -webkit-backdrop-filter: blur(32rpx);
  border-radius: 28rpx;
  padding: 40rpx 36rpx;
  width: 640rpx;
  max-width: 88vw;
  border: 1rpx solid rgba(255,255,255,0.9);
  box-shadow: 0 20rpx 80rpx rgba(0,0,0,0.06);
  animation: modalSlideIn 0.35s cubic-bezier(0.22, 1, 0.36, 1);
}

@keyframes modalSlideIn {
  from { opacity: 0; transform: translateY(30rpx) scale(0.96); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

.modal-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #0f172a;
  margin-bottom: 36rpx;
  display: block;
  text-align: center;
}

.modal-input {
  width: 100%;
  padding: 24rpx 22rpx;
  background: rgba(255,255,255,0.5);
  border: 1rpx solid rgba(0,0,0,0.06);
  border-radius: 16rpx;
  font-size: 28rpx;
  margin-bottom: 20rpx;
  box-sizing: border-box;
  color: #0f172a;
  font-weight: 450;
  height: 76rpx;
  transition: all 0.25s ease;
}
.modal-input::placeholder {
  color: #94a3b8;
}
.modal-input:focus {
  border-color: rgba(245,158,11,0.3);
  background: rgba(255,255,255,0.7);
  box-shadow: 0 0 0 3rpx rgba(245,158,11,0.04);
}

.modal-input-desc {
  margin-bottom: 28rpx;
}

/* Copy demo row */
.copy-demo-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 0;
  margin-bottom: 4rpx;
}
.copy-demo-check {
  width: 40rpx;
  height: 40rpx;
  border-radius: 10rpx;
  border: 2rpx solid rgba(0,0,0,0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #fff;
  flex-shrink: 0;
  transition: all 0.25s ease;
  background: rgba(255,255,255,0.3);
}
.copy-demo-check.checked {
  background: linear-gradient(135deg, #f59e0b, #d97706);
  border-color: #f59e0b;
  box-shadow: 0 2rpx 12rpx rgba(245,158,11,0.2);
}
.copy-demo-label {
  font-size: 26rpx;
  color: #475569;
  font-weight: 500;
}
.copy-demo-hint {
  font-size: 22rpx;
  color: #94a3b8;
}

/* Demo tags */
.demo-tags {
  margin: 0 0 32rpx;
}
.demo-tags-scroll {
  white-space: nowrap;
  width: 100%;
}
.demo-tags-container {
  display: inline-flex;
  gap: 14rpx;
  padding: 6rpx 2rpx;
}
.demo-tag {
  flex-shrink: 0;
  padding: 20rpx 28rpx;
  border-radius: 18rpx;
  background: rgba(255,255,255,0.4);
  border: 1rpx solid rgba(0,0,0,0.04);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 140rpx;
  transition: all 0.25s ease;
}
.demo-tag:active {
  background: rgba(255,255,255,0.6);
  transform: translateY(-2rpx);
}
.demo-tag.selected {
  background: rgba(245,158,11,0.08);
  border-color: rgba(245,158,11,0.2);
  box-shadow: 0 2rpx 12rpx rgba(245,158,11,0.04);
}
.demo-tag-name {
  font-size: 26rpx;
  font-weight: 500;
  color: #334155;
  margin-bottom: 4rpx;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 110rpx;
}
.demo-tag.selected .demo-tag-name {
  color: #d97706;
}
.demo-tag-count {
  font-size: 20rpx;
  color: #94a3b8;
}

/* Modal buttons */
.modal-buttons {
  display: flex;
  gap: 20rpx;
  margin-top: 36rpx;
}
.modal-btn {
  flex: 1;
  padding: 24rpx;
  border-radius: 16rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  transition: all 0.25s ease;
}
.modal-btn-cancel {
  background: rgba(0,0,0,0.03);
  color: #94a3b8;
  border: 1rpx solid rgba(0,0,0,0.04);
}
.modal-btn-cancel:active {
  background: rgba(0,0,0,0.05);
}
.modal-btn-confirm {
  background: linear-gradient(135deg, #f59e0b, #d97706);
  color: #fff;
  box-shadow: 0 2rpx 16rpx rgba(245,158,11,0.15);
}
.modal-btn-confirm:active:not(.disabled) {
  transform: translateY(2rpx);
  box-shadow: 0 1rpx 8rpx rgba(245,158,11,0.15);
}
.modal-btn-confirm.disabled {
  opacity: 0.35;
}
