/* ai-order/pages/index/index.wxss */
.container {
  padding: 40rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.merchant-selector {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 40rpx;
}

.merchant-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.change-btn {
  padding: 10rpx 24rpx;
  background: #764ba2;
  color: #fff;
  border-radius: 8rpx;
  font-size: 24rpx;
}

.entry-buttons {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.entry-btn {
  padding: 40rpx;
  border-radius: 16rpx;
  color: #fff;
}

.merchant-btn {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.customer-btn {
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
}

.btn-title {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.btn-desc {
  display: block;
  font-size: 24rpx;
  opacity: 0.8;
}
