<view class="container">
  <view class="top-bar">
    <text class="top-title">排行榜</text>
    <text class="top-sub">德语学习排名</text>
  </view>

  <view class="personal-card">
    <view class="rank-badge">{{myRank === '-' ? '-' : '#' + myRank}}</view>
    <view class="user-info">
      <view class="avatar-placeholder">
        <text class="avatar-text">{{userInitial}}</text>
      </view>
      <view class="user-detail">
        <text class="nickname">{{nickName || '游客'}}</text>
        <text class="stats">{{totalScore}} 分 · Lv.{{level}}</text>
      </view>
    </view>
  </view>

  <view class="tabs">
    <view class="tab {{currentTab === 'score' ? 'active' : ''}}" bindtap="switchTab" data-tab="score">得分</view>
    <view class="tab {{currentTab === 'words' ? 'active' : ''}}" bindtap="switchTab" data-tab="words">词汇</view>
    <view class="tab {{currentTab === 'streak' ? 'active' : ''}}" bindtap="switchTab" data-tab="streak">连续</view>
  </view>

  <scroll-view scroll-y class="rank-list">
    <view class="rank-item" wx:for="{{rankList}}" wx:key="index">
      <view class="rank-num {{index < 3 ? 'top' : ''}}">{{index + 1}}</view>
      <view class="rank-avatar">
        <text class="rank-avatar-text">{{item.initial || '?'}}</text>
      </view>
      <view class="rank-info">
        <text class="rank-name">{{item.name}}</text>
        <text class="rank-level">Lv.{{item.level}}</text>
      </view>
      <view class="rank-score">{{item.score}}分</view>
    </view>
    <view wx:if="{{rankList.length === 0}}" class="empty-state">
      <view class="empty-icon-wrap">
        <image class="empty-icon-img" src="/images/icons/trophy-48-primary.png" mode="aspectFit"></image>
      </view>
      <text class="empty-title">暂无排名数据</text>
      <text class="empty-desc">开始学习后即可上榜</text>
    </view>
  </scroll-view>
</view>