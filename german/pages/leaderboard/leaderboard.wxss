.container {
  min-height: 100vh;
  background: #F8FAFC;
}

.top-bar {
  padding: 40rpx 24rpx;
  background: linear-gradient(135deg, #2563EB 0%, #764ba2 100%);
  text-align: center;
}

.top-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #fff;
  display: block;
}

.top-sub {
  font-size: 24rpx;
  color: rgba(255,255,255,0.7);
  margin-top: 8rpx;
  display: block;
}

.personal-card {
  display: flex;
  align-items: center;
  margin: -40rpx 24rpx 24rpx;
  padding: 28rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.08);
  position: relative;
  z-index: 10;
}

.rank-badge {
  width: 80rpx;
  height: 64rpx;
  background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 800;
  color: #fff;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.user-info {
  display: flex;
  align-items: center;
  flex: 1;
}

.avatar-placeholder {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #2563EB 0%, #3B82F6 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
}

.avatar-text {
  font-size: 32rpx;
  font-weight: 800;
  color: #fff;
}

.user-detail {
  flex: 1;
}

.nickname {
  font-size: 32rpx;
  font-weight: 700;
  color: #1E293B;
  display: block;
}

.stats {
  font-size: 24rpx;
  color: #64748B;
  margin-top: 4rpx;
  display: block;
}

.tabs {
  display: flex;
  margin: 0 24rpx 20rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 8rpx;
  border: 2rpx solid #E2E8F0;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 16rpx;
  font-size: 26rpx;
  color: #64748B;
  border-radius: 14rpx;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.2s ease;
}

.tab.active {
  background: linear-gradient(135deg, #2563EB 0%, #3B82F6 100%);
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(37,99,235,0.2);
}

.rank-list {
  height: calc(100vh - 420rpx);
  padding: 0 24rpx;
}

.rank-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: #fff;
  border-radius: 20rpx;
  margin-bottom: 12rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  border: 2rpx solid #E2E8F0;
  transition: all 0.2s ease;
}

.rank-item:active {
  transform: scale(0.99);
}

.rank-num {
  width: 48rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #94A3B8;
  text-align: center;
  margin-right: 16rpx;
}

.rank-num.top {
  color: #FFD700;
}

.rank-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #E2E8F0;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
}

.rank-avatar-text {
  font-size: 28rpx;
  font-weight: 700;
  color: #64748B;
}

.rank-info {
  flex: 1;
}

.rank-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1E293B;
  display: block;
}

.rank-level {
  font-size: 22rpx;
  color: #94A3B8;
  margin-top: 4rpx;
  display: block;
}

.rank-score {
  font-size: 30rpx;
  font-weight: 700;
  color: #2563EB;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
}

.empty-icon-wrap {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #EFF6FF 0%, #DBEAFE 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.empty-icon-text {
  font-size: 52rpx;
  font-weight: 800;
  color: #2563EB;
}

.empty-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1E293B;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #94A3B8;
}