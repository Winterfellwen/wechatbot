.container { height: 100vh; background: #f5f5f5; }
.header { padding: 40rpx 30rpx; background: #2196F3; color: #fff; }
.title { font-size: 36rpx; font-weight: bold; }
.rank-list { padding: 20rpx; }
.rank-item { display: flex; align-items: center; padding: 30rpx; background: #fff; margin-bottom: 20rpx; border-radius: 16rpx; }
.rank-num { width: 60rpx; font-size: 32rpx; font-weight: bold; color: #2196F3; }
.rank-name { flex: 1; font-size: 28rpx; }
.rank-exp { color: #999; font-size: 24rpx; }
.tab-bar { display: flex; background: #fff; padding: 20rpx 0; position: fixed; bottom: 0; width: 100%; border-top: 1rpx solid #eee; }
.tab { flex: 1; text-align: center; color: #999; font-size: 28rpx; }
.tab.active { color: #2196F3; font-weight: bold; }