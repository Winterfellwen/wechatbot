<view class="container">
  <!-- 级别选择 -->
  <view class="level-selector">
    <scroll-view class="level-scroll" scroll-x>
      <view 
        wx:for="{{levels}}" 
        wx:key="id"
        class="level-item {{currentLevel === item.id ? 'active' : ''}}"
        bindtap="selectLevel"
        data-id="{{item.id}}">
        {{item.name}}
      </view>
    </scroll-view>
  </view>

  <!-- 单元选择 -->
  <view class="unit-selector">
    <view class="current-unit" bindtap="toggleUnitSelector">
      <text>第 {{currentUnit}} 单元</text>
      <text class="arrow">{{showUnitSelector ? '上' : '下'}}</text>
    </view>
    <view class="unit-list" wx:if="{{showUnitSelector}}">
      <view 
        wx:for="{{15}}" 
        wx:key="*this"
        class="unit-item {{currentUnit === index + 1 ? 'active' : ''}}"
        bindtap="selectUnit"
        data-unit="{{index + 1}}">
        单元 {{index + 1}}
      </view>
    </view>
  </view>

  <!-- 单词 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">单词</text>
      <text class="section-count">{{vocabList.length}} 个</text>
    </view>
    <view class="vocab-list">
      <view class="vocab-card" wx:for="{{vocabList}}" wx:key="index">
        <!-- 单词信息 -->
        <view class="vocab-main">
          <view class="vocab-left">
            <view class="vocab-word">{{item.word}}</view>
            <view class="vocab-ipa" wx:if="{{item.ipa}}">{{item.ipa}}</view>
            <view class="vocab-phonetic" wx:if="{{item.phonetic}}">{{item.phonetic}}</view>
            <view class="vocab-meta" wx:if="{{item.pos}}">
              <text wx:if="{{item.gender}}" class="gender-tag {{item.gender}}">
                {{item.gender === 'm' ? 'der' : item.gender === 'f' ? 'die' : 'das'}}
              </text>
              <text class="pos-tag">{{item.pos}}</text>
              <text wx:if="{{item.plural}}" class="plural-tag">{{item.plural}}</text>
            </view>
            <view class="vocab-translation">{{item.translation}}</view>
          </view>
          
          <!-- 操作按钮 -->
          <view class="vocab-actions">
            <!-- 播音按钮 -->
            <view 
              class="audio-btn {{playingWord === item.word ? 'playing' : ''}}"
              bindtap="playAudio" 
              data-word="{{item.word}}">
              <image class="audio-icon-img" src="/images/icons/volume-2-48-dark.png" mode="aspectFit"></image>
            </view>
            
            <!-- 生词本按钮 -->
            <view 
              class="wordbook-btn {{item.isInWordBook ? 'added' : ''}}"
              bindtap="addToWordBook" 
              data-word="{{item}}">
              <image class="wordbook-icon-img" wx:if="{{item.isInWordBook}}" src="/images/icons/check-48-success.png" mode="aspectFit"></image>
              <image class="wordbook-icon-img" wx:else src="/images/icons/plus-48-dark.png" mode="aspectFit"></image>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 语法 -->
  <view class="section" wx:if="{{grammarList.length > 0}}">
    <view class="section-header">
      <text class="section-title">语法</text>
      <text class="section-count">{{grammarList.length}} 个</text>
    </view>
    <view class="grammar-list">
      <view class="grammar-item" wx:for="{{grammarList}}" wx:key="index">
        <view class="grammar-title">{{item.title}}</view>
        <view class="grammar-content">{{item.content}}</view>
      </view>
    </view>
  </view>

  <!-- 发音 -->
  <view class="section" wx:if="{{pronunciationList.length > 0}}">
    <view class="section-header">
      <text class="section-title">发音</text>
      <text class="section-count">{{pronunciationList.length}} 个</text>
    </view>
    <view class="pronunciation-list">
      <view class="pronunciation-item" wx:for="{{pronunciationList}}" wx:key="index">
        <view class="pronunciation-rule">{{item.rule}}</view>
        <view class="pronunciation-desc">{{item.description}}</view>
        <view class="pronunciation-example" bindtap="playAudio" data-word="{{item.example}}">
            <text>{{item.example}}</text>
          <view class="audio-btn-small {{playingWord === item.example ? 'playing' : ''}}">
              <image class="audio-icon-small-img" src="/images/icons/volume-2-48-dark.png" mode="aspectFit"></image>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 课文 -->
  <view class="section" wx:if="{{textList.length > 0}}">
    <view class="section-header">
      <text class="section-title">课文</text>
      <text class="section-count">{{textList.length}} 篇</text>
    </view>
    <view class="text-list">
      <view class="text-item" wx:for="{{textList}}" wx:key="index">
        <view class="text-title">{{item.title}}</view>
        <view class="text-content">{{item.content}}</view>
        <view class="text-translation">{{item.translation}}</view>
      </view>
    </view>
  </view>

  <!-- 底部导航 -->
  <view class="bottom-nav">
    <view class="nav-item" bindtap="goToLearn">
      <view class="nav-icon-wrap">
        <image class="nav-icon-img" src="/images/icons/swords-48-dark.png" mode="aspectFit"></image>
      </view>
      <text class="nav-text">闯关</text>
    </view>
    <view class="nav-item active">
      <view class="nav-icon-wrap nav-icon-active">
        <image class="nav-icon-img" src="/images/icons/book-open-text-48-dark.png" mode="aspectFit"></image>
      </view>
      <text class="nav-text nav-text-active">课程</text>
    </view>
    <view class="nav-item" bindtap="goToWordbook">
      <view class="nav-icon-wrap">
        <image class="nav-icon-img" src="/images/icons/book-marked-48-dark.png" mode="aspectFit"></image>
      </view>
      <text class="nav-text">生词本</text>
    </view>
  </view>
</view>
