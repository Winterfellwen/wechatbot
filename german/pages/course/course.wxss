.container {
  min-height: 100vh;
  background: #F8FAFC;
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
}

/* ========== 级别选择器 ========== */
.level-selector {
  background: #fff;
  padding: 20rpx 24rpx;
  border-bottom: 3rpx solid #E2E8F0;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.04);
}

.level-scroll {
  white-space: nowrap;
}

.level-item {
  display: inline-block;
  padding: 18rpx 36rpx;
  margin-right: 16rpx;
  background: #F1F5F9;
  border-radius: 24rpx;
  font-size: 28rpx;
  color: #64748B;
  font-weight: 500;
  transition: all 0.2s ease;
  cursor: pointer;
  min-height: 88rpx;
}

.level-item:active {
  transform: scale(0.96);
  opacity: 0.9;
}

.level-item.active {
  background: linear-gradient(135deg, #2563EB 0%, #3B82F6 100%);
  color: #fff;
  box-shadow: 0 4rpx 16rpx rgba(37,99,235,0.3);
}

/* ========== 单元选择器 ========== */
.unit-selector {
  background: #fff;
  padding: 24rpx;
  position: relative;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.04);
  border-radius: 24rpx;
  margin: 20rpx;
}

.current-unit {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 32rpx;
  color: #1E293B;
  font-weight: bold;
  cursor: pointer;
  min-height: 88rpx;
}

.arrow {
  font-size: 24rpx;
  color: #94A3B8;
}

.unit-list {
  position: absolute;
  top: 90rpx;
  left: 24rpx;
  right: 24rpx;
  background: #fff;
  border: 3rpx solid #E2E8F0;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.12);
  z-index: 10;
  max-height: 500rpx;
  overflow-y: auto;
}

.unit-item {
  padding: 22rpx;
  text-align: center;
  border-bottom: 1rpx solid #F1F5F9;
  font-size: 30rpx;
  color: #64748B;
  cursor: pointer;
  transition: all 0.2s ease;
}

.unit-item:active {
  background: #F8FAFC;
}

.unit-item:last-child {
  border-bottom: none;
}

.unit-item.active {
  color: #2563EB;
  font-weight: bold;
  background: #EFF6FF;
}

/* ========== 内容区块 ========== */
.section {
  background: #fff;
  margin: 20rpx;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.04);
  border: 3rpx solid #E2E8F0;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #E2E8F0;
}

.section-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #1E293B;
}

.section-count {
  font-size: 24rpx;
  color: #64748B;
  background: #F1F5F9;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

/* ========== 词汇卡片网格 ========== */
.vocab-scroll {
  width: 100%;
}

.vocab-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.vocab-card {
  width: calc(50% - 8rpx);
  background: linear-gradient(135deg, #fff 0%, #F8FAFC 100%);
  border-radius: 24rpx;
  padding: 18rpx;
  box-sizing: border-box;
  position: relative;
  border: 3rpx solid #E2E8F0;
  transition: all 0.2s ease;
}

.vocab-card:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.vocab-word {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 32rpx;
  font-weight: bold;
  color: #1E293B;
  cursor: pointer;
  min-height: 88rpx;
}

.audio-icon {
  font-size: 30rpx;
  color: #2563EB;
  padding: 8rpx;
}

.vocab-translation {
  font-size: 26rpx;
  color: #64748B;
  margin-top: 10rpx;
}

.vocab-phonetic {
  font-size: 22rpx;
  color: #94A3B8;
  margin-top: 6rpx;
}

.add-btn {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  background: linear-gradient(135deg, #2563EB 0%, #3B82F6 100%);
  color: #fff;
  border-radius: 22rpx;
  font-size: 28rpx;
  padding: 0;
  box-shadow: 0 2rpx 8rpx rgba(37,99,235,0.3);
  cursor: pointer;
  transition: all 0.2s ease;
  min-width: 44rpx;
  min-height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.add-btn:active {
  transform: scale(0.9);
}

/* ========== 语法列表 ========== */
.grammar-list {
  max-height: 500rpx;
  overflow-y: auto;
}

.grammar-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F1F5F9;
  cursor: pointer;
  transition: all 0.2s ease;
}

.grammar-item:active {
  background: #F8FAFC;
}

.grammar-item:last-child {
  border-bottom: none;
}

.grammar-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #1E293B;
  margin-bottom: 10rpx;
}

.grammar-content {
  font-size: 28rpx;
  color: #64748B;
  margin-top: 8rpx;
  line-height: 1.6;
}

/* ========== 发音规则列表 ========== */
.pronunciation-list {
  max-height: 400rpx;
  overflow-y: auto;
}

.pronunciation-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F1F5F9;
  cursor: pointer;
  transition: all 0.2s ease;
}

.pronunciation-item:active {
  background: #F8FAFC;
}

.pronunciation-item:last-child {
  border-bottom: none;
}

.pronunciation-rule {
  font-size: 30rpx;
  font-weight: bold;
  color: #1E293B;
}

.pronunciation-desc {
  font-size: 28rpx;
  color: #64748B;
  margin-top: 10rpx;
}

.pronunciation-example {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 26rpx;
  color: #2563EB;
  margin-top: 12rpx;
  font-weight: 500;
  cursor: pointer;
  min-height: 88rpx;
}

/* ========== 课文列表 ========== */
.text-list {
  max-height: 500rpx;
  overflow-y: auto;
}

.text-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F1F5F9;
  cursor: pointer;
  transition: all 0.2s ease;
}

.text-item:active {
  background: #F8FAFC;
}

.text-item:last-child {
  border-bottom: none;
}

.text-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #1E293B;
  margin-bottom: 12rpx;
}

.text-content {
  font-size: 28rpx;
  color: #1E293B;
  margin-top: 10rpx;
  line-height: 1.6;
}

.text-translation {
  font-size: 24rpx;
  color: #94A3B8;
  margin-top: 10rpx;
}
