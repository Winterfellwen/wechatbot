/* german/pages/course/course.wxss - UI/UX Pro Max 优化版 */
/* 设计系统: Glassmorphism, Primary #2563EB */

page {
  background: #F8FAFC;
}

/* ========== 基础容器 ========== */
.container {
  min-height: 100vh;
  background: #F8FAFC;
  padding-bottom: calc(150rpx + env(safe-area-inset-bottom));
}

/* 隐藏的 Canvas */
.icon-canvas-hidden {
  position: fixed;
  left: -9999px;
  top: -9999px;
  width: 256px;
  height: 256px;
}

/* ========== 级别选择器 ========== */
.level-selector {
  background: #fff;
  padding: 16rpx 24rpx;
  border-bottom: 2rpx solid #E2E8F0;
  position: sticky;
  top: 0;
  z-index: 100;
}

.level-scroll {
  white-space: nowrap;
}

.level-item {
  display: inline-block;
  padding: 12rpx 28rpx;
  margin-right: 12rpx;
  background: #F1F5F9;
  border-radius: 20rpx;
  font-size: 26rpx;
  color: #64748B;
  font-weight: 500;
  transition: all 0.2s ease;
  cursor: pointer;
}

.level-item:active {
  transform: scale(0.96);
  opacity: 0.9;
}

.level-item.active {
  background: linear-gradient(135deg, #2563EB 0%, #3B82F6 100%);
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(37,99,235,0.3);
}

/* ========== 单元选择器 ========== */
.unit-selector {
  background: #fff;
  padding: 16rpx 24rpx;
  margin: 16rpx;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  position: relative;
  z-index: 10;
}

.current-unit {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 30rpx;
  color: #1E293B;
  font-weight: 600;
  cursor: pointer;
}

.arrow {
  font-size: 22rpx;
  color: #94A3B8;
  padding: 8rpx 16rpx;
  background: #F1F5F9;
  border-radius: 12rpx;
}

.unit-list {
  position: absolute;
  top: 100%;
  left: 24rpx;
  right: 24rpx;
  background: #fff;
  border: 2rpx solid #E2E8F0;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.12);
  z-index: 20;
  max-height: 400rpx;
  overflow-y: auto;
}

.unit-item {
  padding: 16rpx 20rpx;
  text-align: center;
  border-bottom: 1rpx solid #F1F5F9;
  font-size: 28rpx;
  color: #64748B;
  cursor: pointer;
  transition: all 0.2s ease;
}

.unit-item:active {
  background: #F8FAFC;
}

.unit-item:last-child {
  border-bottom: none;
}

.unit-item.active {
  color: #2563EB;
  font-weight: 600;
  background: #EFF6FF;
}

/* ========== 内容区块 ========== */
.section {
  background: #fff;
  margin: 16rpx;
  border-radius: 20rpx;
  padding: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  padding-bottom: 12rpx;
  border-bottom: 2rpx solid #F1F5F9;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1E293B;
}

.section-count {
  font-size: 22rpx;
  color: #64748B;
  background: #F1F5F9;
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
}

/* ========== 词汇卡片列表 ========== */
.vocab-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.vocab-card {
  background: linear-gradient(135deg, #fff 0%, #F8FAFC 100%);
  border-radius: 16rpx;
  padding: 16rpx;
  border: 2rpx solid #E2E8F0;
  transition: all 0.2s ease;
}

.vocab-card:active {
  transform: scale(0.99);
  box-shadow: 0 1rpx 8rpx rgba(0,0,0,0.06);
}

.vocab-main {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.vocab-left {
  flex: 1;
  min-width: 0;
}

.vocab-word {
  font-size: 32rpx;
  font-weight: 700;
  color: #1E293B;
  line-height: 1.3;
}

.vocab-phonetic {
  font-size: 22rpx;
  color: #94A3B8;
  margin-top: 4rpx;
}

.vocab-ipa {
  font-size: 24rpx;
  color: #2563EB;
  font-weight: 600;
  margin-top: 4rpx;
  font-family: 'Segoe UI', sans-serif;
}

.vocab-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8rpx;
  margin-top: 6rpx;
}

.gender-tag {
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  font-weight: 600;
}

.gender-tag.m {
  background: #DBEAFE;
  color: #2563EB;
}

.gender-tag.f {
  background: #FCE7F3;
  color: #DB2777;
}

.gender-tag.n {
  background: #D1FAE5;
  color: #059669;
}

.pos-tag {
  font-size: 20rpx;
  color: #64748B;
  background: #F1F5F9;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
}

.plural-tag {
  font-size: 20rpx;
  color: #7C3AED;
  background: #F3E8FF;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
}

.vocab-translation {
  font-size: 26rpx;
  color: #64748B;
  margin-top: 6rpx;
}

/* ========== 操作按钮组 ========== */
.vocab-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

/* 播音按钮 */
.audio-btn {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #EFF6FF 0%, #DBEAFE 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
  cursor: pointer;
}

.audio-btn:active {
  transform: scale(0.92);
}

.audio-btn.playing {
  background: linear-gradient(135deg, #2563EB 0%, #3B82F6 100%);
  box-shadow: 0 4rpx 16rpx rgba(37,99,235,0.35);
  animation: audioPulse 1s ease-in-out infinite;
}

@keyframes audioPulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.08); }
}

.audio-icon {
  width: 72rpx;
  height: 72rpx;
}

/* 生词本按钮 */
.wordbook-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #F1F5F9 0%, #E2E8F0 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
  cursor: pointer;
}

.wordbook-btn:active {
  transform: scale(0.9);
}

.wordbook-btn.added {
  background: linear-gradient(135deg, #22C55E 0%, #16A34A 100%);
  box-shadow: 0 4rpx 12rpx rgba(34,197,94,0.25);
}

.wordbook-icon {
  font-size: 28rpx;
  font-weight: 700;
  color: #64748B;
  transition: all 0.2s ease;
}

.wordbook-btn.added .wordbook-icon {
  color: #fff;
}

/* 小播音按钮（发音列表用） */
.audio-btn-small {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #EFF6FF 0%, #DBEAFE 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 12rpx;
  transition: all 0.2s ease;
}

.audio-btn-small.playing {
  background: linear-gradient(135deg, #2563EB 0%, #3B82F6 100%);
}

.audio-icon-small {
  width: 58rpx;
  height: 58rpx;
}

/* ========== 语法列表 ========== */
.grammar-list {
  max-height: 400rpx;
  overflow-y: auto;
}

.grammar-item {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F1F5F9;
}

.grammar-item:last-child {
  border-bottom: none;
}

.grammar-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1E293B;
  margin-bottom: 8rpx;
}

.grammar-content {
  font-size: 26rpx;
  color: #64748B;
  line-height: 1.6;
}

/* ========== 发音规则列表 ========== */
.pronunciation-list {
  max-height: 350rpx;
  overflow-y: auto;
}

.pronunciation-item {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F1F5F9;
}

.pronunciation-item:last-child {
  border-bottom: none;
}

.pronunciation-rule {
  font-size: 28rpx;
  font-weight: 600;
  color: #1E293B;
}

.pronunciation-desc {
  font-size: 24rpx;
  color: #64748B;
  margin-top: 6rpx;
}

.pronunciation-example {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #2563EB;
  margin-top: 10rpx;
  cursor: pointer;
}

/* ========== 课文列表 ========== */
.text-list {
  max-height: 400rpx;
  overflow-y: auto;
}

.text-item {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F1F5F9;
}

.text-item:last-child {
  border-bottom: none;
}

.text-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1E293B;
  margin-bottom: 8rpx;
}

.text-content {
  font-size: 26rpx;
  color: #1E293B;
  line-height: 1.6;
}

.text-translation {
  font-size: 22rpx;
  color: #94A3B8;
  margin-top: 8rpx;
}

/* ========== 底部导航 ========== */
.bottom-nav {
  position: fixed; 
  bottom: 0; 
  left: 0; 
  right: 0; 
  display: flex;
  background: rgba(255,255,255,0.95);
  backdrop-filter: blur(20px);
  box-shadow: 0 -4rpx 24rpx rgba(0,0,0,0.06);
  padding: 8rpx 0 env(safe-area-inset-bottom, 8rpx);
  z-index: 999;
}

.nav-item { 
  flex: 1; 
  padding: 12rpx 0; 
  text-align: center; 
  display: flex; 
  flex-direction: column; 
  align-items: center;
  cursor: pointer;
  transition: transform 0.2s ease;
}

.nav-item:active {
  transform: scale(0.95);
}

.nav-icon-wrap {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  background: #F1F5F9;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 4rpx;
  transition: all 0.2s ease;
}

.nav-icon-active {
  background: linear-gradient(135deg, #2563EB 0%, #3B82F6 100%);
  box-shadow: 0 4rpx 12rpx rgba(37,99,235,0.25);
}

.nav-icon-text {
  font-size: 24rpx;
  font-weight: 600;
  color: #64748B;
}

.nav-item.active .nav-icon-text {
  color: #ffffff;
}

.nav-text { 
  font-size: 22rpx; 
  color: #64748B; 
  transition: color 0.2s ease;
}

.nav-text-active {
  color: #2563EB;
  font-weight: 600;
}

.nav-item.active .nav-text {
  color: #2563EB;
  font-weight: 600;
}
