.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 40rpx;
}

.level-selector {
  background: #fff;
  padding: 20rpx;
  border-bottom: 1rpx solid #e0e0e0;
}

.level-scroll {
  white-space: nowrap;
}

.level-item {
  display: inline-block;
  padding: 16rpx 32rpx;
  margin-right: 16rpx;
  background: #f5f5f5;
  border-radius: 30rpx;
  font-size: 28rpx;
  color: #666;
}

.level-item.active {
  background: #1890ff;
  color: #fff;
}

.unit-selector {
  background: #fff;
  padding: 20rpx;
  position: relative;
}

.current-unit {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 30rpx;
  color: #333;
}

.arrow {
  font-size: 24rpx;
  color: #999;
}

.unit-list {
  position: absolute;
  top: 80rpx;
  left: 20rpx;
  right: 20rpx;
  background: #fff;
  border: 1rpx solid #e0e0e0;
  border-radius: 12rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
  z-index: 10;
  max-height: 400rpx;
  overflow-y: auto;
}

.unit-item {
  padding: 20rpx;
  text-align: center;
  border-bottom: 1rpx solid #f5f5f5;
  font-size: 28rpx;
}

.unit-item:last-child {
  border-bottom: none;
}

.unit-item.active {
  color: #1890ff;
  font-weight: bold;
}

.section {
  background: #fff;
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 20rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.section-count {
  font-size: 24rpx;
  color: #999;
}

.vocab-scroll {
  width: 100%;
}

.vocab-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.vocab-card {
  width: calc(50% - 8rpx);
  background: #f9f9f9;
  border-radius: 12rpx;
  padding: 16rpx;
  box-sizing: border-box;
  position: relative;
}

.vocab-word {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.audio-icon {
  font-size: 28rpx;
}

.vocab-translation {
  font-size: 26rpx;
  color: #666;
  margin-top: 8rpx;
}

.vocab-phonetic {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.add-btn {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  background: #1890ff;
  color: #fff;
  border-radius: 20rpx;
  font-size: 28rpx;
  padding: 0;
}

.grammar-list {
  max-height: 500rpx;
  overflow-y: auto;
}

.grammar-item {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.grammar-item:last-child {
  border-bottom: none;
}

.grammar-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.grammar-content {
  font-size: 26rpx;
  color: #666;
  margin-top: 8rpx;
}

.pronunciation-list {
  max-height: 400rpx;
  overflow-y: auto;
}

.pronunciation-item {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.pronunciation-item:last-child {
  border-bottom: none;
}

.pronunciation-rule {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.pronunciation-desc {
  font-size: 26rpx;
  color: #666;
  margin-top: 8rpx;
}

.pronunciation-example {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #1890ff;
  margin-top: 8rpx;
}

.text-list {
  max-height: 500rpx;
  overflow-y: auto;
}

.text-item {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.text-item:last-child {
  border-bottom: none;
}

.text-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.text-content {
  font-size: 26rpx;
  color: #333;
  margin-top: 8rpx;
  line-height: 1.5;
}

.text-translation {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}