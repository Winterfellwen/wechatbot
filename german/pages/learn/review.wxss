.container {
  padding: 30rpx;
  min-height: 100vh;
  background: #f5f5f5;
}

.progress-bar {
  height: 50rpx;
  background: #e0e0e0;
  border-radius: 25rpx;
  position: relative;
  overflow: hidden;
  margin-bottom: 20rpx;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #1890ff, #52c41a);
  transition: width 0.3s ease;
}

.progress-text {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 26rpx;
  color: #333;
  font-weight: bold;
}

.stats {
  display: flex;
  justify-content: center;
  gap: 40rpx;
  margin-bottom: 30rpx;
  font-size: 28rpx;
}

.correct-count {
  color: #52c41a;
}

.wrong-count {
  color: #ff4d4f;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 60rpx 40rpx;
  text-align: center;
  margin-bottom: 40rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.1);
}

.word {
  font-size: 60rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.phonetic {
  font-size: 32rpx;
  color: #999;
  margin-bottom: 30rpx;
}

.answer-section {
  margin: 40rpx 0;
  padding: 30rpx;
  background: #f6ffed;
  border-radius: 16rpx;
  border: 2rpx solid #52c41a;
}

.translation {
  font-size: 36rpx;
  color: #52c41a;
  font-weight: bold;
}

.show-btn {
  background: #e6f7ff;
  color: #1890ff;
  border: 2rpx solid #1890ff;
  border-radius: 12rpx;
  padding: 24rpx 60rpx;
  font-size: 30rpx;
  margin-top: 30rpx;
}

.actions {
  display: flex;
  gap: 30rpx;
}

.action-btn {
  flex: 1;
  padding: 30rpx;
  border-radius: 16rpx;
  font-size: 32rpx;
}

.action-btn.correct {
  background: #52c41a;
  color: #fff;
}

.action-btn.wrong {
  background: #fff;
  color: #ff4d4f;
  border: 2rpx solid #ff4d4f;
}

.empty-state {
  text-align: center;
  padding: 100rpx 40rpx;
  background: #fff;
  border-radius: 24rpx;
  margin-bottom: 40rpx;
}

.empty-icon {
  font-size: 100rpx;
  display: block;
  margin-bottom: 30rpx;
}

.empty-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 20rpx;
}

.empty-desc {
  font-size: 28rpx;
  color: #666;
}

.back-btn {
  background: #1890ff;
  color: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  font-size: 32rpx;
}

.finish-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 60rpx 40rpx;
  text-align: center;
  margin-bottom: 40rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.1);
}

.finish-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 20rpx;
}

.finish-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 40rpx;
}

.finish-stats {
  display: flex;
  justify-content: center;
  gap: 60rpx;
  margin-bottom: 30rpx;
}

.stat {
  text-align: center;
}

.stat-num {
  font-size: 48rpx;
  font-weight: bold;
  display: block;
}

.stat-num.correct {
  color: #52c41a;
}

.stat-num.wrong {
  color: #ff4d4f;
}

.stat-label {
  font-size: 26rpx;
  color: #999;
  margin-top: 10rpx;
  display: block;
}

.finish-message {
  font-size: 28rpx;
  color: #666;
  margin-top: 20rpx;
}

.finish-actions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.finish-actions .action-btn {
  padding: 28rpx;
  border-radius: 16rpx;
  font-size: 32rpx;
  background: #fff;
  color: #333;
  border: 2rpx solid #d9d9d9;
}

.finish-actions .action-btn.primary {
  background: #1890ff;
  color: #fff;
  border: none;
}