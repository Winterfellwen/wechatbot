.container {
  padding: 24rpx;
  min-height: 100vh;
  background: linear-gradient(180deg, #e8f4ff 0%, #f5f5f5 100%);
}

.progress-bar {
  height: 56rpx;
  background: #fff;
  border-radius: 28rpx;
  position: relative;
  overflow: hidden;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.06);
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #2563EB, #22C55E);
  transition: width 0.4s ease;
  border-radius: 28rpx;
}

.progress-text {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 26rpx;
  color: #333;
  font-weight: bold;
}

.stats {
  display: flex;
  justify-content: center;
  gap: 60rpx;
  margin-bottom: 30rpx;
  font-size: 30rpx;
  background: #fff;
  padding: 20rpx;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.06);
}

.correct-count {
  color: #22C55E;
  font-weight: bold;
}

.wrong-count {
  color: #EF4444;
  font-weight: bold;
}

.card {
  background: #fff;
  border-radius: 28rpx;
  padding: 70rpx 40rpx;
  text-align: center;
  margin-bottom: 40rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.1);
}

.word {
  font-size: 68rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
}

.phonetic {
  font-size: 34rpx;
  color: #64748B;
  margin-bottom: 32rpx;
}

.answer-section {
  margin: 40rpx 0;
  padding: 32rpx;
  background: linear-gradient(135deg, #F0FDF4 0%, #DCFCE7 100%);
  border-radius: 18rpx;
  border: 3rpx solid #22C55E;
}

.translation {
  font-size: 40rpx;
  color: #22C55E;
  font-weight: bold;
}

.show-btn {
  background: linear-gradient(135deg, #EFF6FF 0%, #DBEAFE 100%);
  color: #2563EB;
  border: 2rpx solid #2563EB;
  border-radius: 16rpx;
  padding: 26rpx 60rpx;
  font-size: 32rpx;
  font-weight: bold;
  box-shadow: 0 4rpx 12rpx rgba(37,99,235,0.2);
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}

.show-btn:active {
  transform: scale(0.97);
  background: linear-gradient(135deg, #DBEAFE 0%, #BFDBFE 100%);
}

.actions {
  display: flex;
  gap: 24rpx;
}

.action-btn {
  flex: 1;
  padding: 30rpx;
  border-radius: 18rpx;
  font-size: 34rpx;
  font-weight: bold;
}

.action-btn.correct {
  background: linear-gradient(135deg, #22C55E 0%, #16A34A 100%);
  color: #fff;
  box-shadow: 0 4rpx 16rpx rgba(34,197,94,0.3);
}

.action-btn.wrong {
  background: #fff;
  color: #EF4444;
  border: 2rpx solid #EF4444;
  box-shadow: 0 4rpx 12rpx rgba(239,68,68,0.2);
}

.empty-state {
  text-align: center;
  padding: 120rpx 40rpx;
  background: #fff;
  border-radius: 28rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.1);
}

.empty-icon {
  font-size: 140rpx;
  display: block;
  margin-bottom: 32rpx;
}

.empty-title {
  font-size: 44rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 24rpx;
}

.empty-desc {
  font-size: 28rpx;
  color: #475569;
}

.back-btn {
  background: linear-gradient(135deg, #2563EB 0%, #3B82F6 100%);
  color: #fff;
  border-radius: 18rpx;
  padding: 28rpx;
  font-size: 34rpx;
  font-weight: bold;
  box-shadow: 0 4rpx 16rpx rgba(37,99,235,0.3);
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}

.back-btn:active {
  transform: scale(0.97);
}

.finish-card {
  background: #fff;
  border-radius: 28rpx;
  padding: 60rpx 40rpx;
  text-align: center;
  margin-bottom: 40rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.1);
}

.finish-icon {
  font-size: 100rpx;
  display: block;
  margin-bottom: 24rpx;
}

.finish-title {
  font-size: 44rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 40rpx;
}

.finish-stats {
  display: flex;
  justify-content: center;
  gap: 80rpx;
  margin-bottom: 32rpx;
}

.stat {
  text-align: center;
}

.stat-num {
  font-size: 56rpx;
  font-weight: bold;
  display: block;
}

.stat-num.correct {
  color: #22C55E;
}

.stat-num.wrong {
  color: #EF4444;
}

.stat-label {
  font-size: 26rpx;
  color: #64748B;
  margin-top: 12rpx;
  display: block;
}

.finish-message {
  font-size: 30rpx;
  color: #475569;
  margin-top: 24rpx;
}

.finish-actions {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.finish-actions .action-btn {
  padding: 28rpx;
  border-radius: 18rpx;
  font-size: 32rpx;
  background: #fff;
  color: #333;
  border: 2rpx solid #d9d9d9;
  font-weight: 500;
}

.finish-actions .action-btn.primary {
  background: linear-gradient(135deg, #2563EB 0%, #3B82F6 100%);
  color: #fff;
  border: none;
  box-shadow: 0 4rpx 16rpx rgba(37,99,235,0.3);
}

.finish-actions .action-btn {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}

.finish-actions .action-btn:active {
  transform: scale(0.97);
}