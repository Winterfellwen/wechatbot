.container {
  padding: 24rpx;
  min-height: 100vh;
  background: linear-gradient(180deg, #e8f4ff 0%, #f5f5f5 100%);
}

.result-card {
  background: #fff;
  border-radius: 28rpx;
  padding: 50rpx;
  text-align: center;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.1);
}

.result-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.result-icon-img {
  width: 96rpx;
  height: 96rpx;
  margin-bottom: 24rpx;
}

.result-title {
  font-size: 44rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 30rpx;
}

.result-score {
  display: flex;
  align-items: baseline;
  justify-content: center;
  margin-bottom: 24rpx;
}

.score-num {
  font-size: 88rpx;
  font-weight: bold;
  background: linear-gradient(135deg, #2563EB 0%, #3B82F6 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.score-divider {
  font-size: 44rpx;
  color: #999;
  margin: 0 12rpx;
}

.score-total {
  font-size: 44rpx;
  color: #999;
}

.result-percent {
  font-size: 34rpx;
  color: #22C55E;
  font-weight: bold;
  margin-bottom: 24rpx;
}

.result-message {
  font-size: 28rpx;
  color: #666;
}

.wrong-review {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #f5f5f5;
}

.wrong-list {
  max-height: 500rpx;
  overflow-y: auto;
}

.wrong-item {
  padding: 22rpx;
  background: linear-gradient(135deg, #fff7e6 0%, #fffbe6 100%);
  border-radius: 14rpx;
  margin-bottom: 16rpx;
  border-left: 8rpx solid #faad14;
}

.wrong-word {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}

.wrong-translation {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 14rpx;
}

.wrong-answer, .correct-answer {
  font-size: 24rpx;
  margin-top: 10rpx;
}

.wrong-answer .label, .correct-answer .label {
  color: #999;
}

.wrong-answer .value {
  color: #EF4444;
  font-weight: 500;
}

.correct-answer .value {
  color: #22C55E;
  font-weight: 500;
}

.actions {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.action-btn {
  padding: 28rpx;
  border-radius: 16rpx;
  font-size: 32rpx;
  background: #fff;
  color: #333;
  border: 2rpx solid #d9d9d9;
  font-weight: 500;
}

.action-btn.primary {
  background: linear-gradient(135deg, #2563EB 0%, #3B82F6 100%);
  color: #fff;
  border: none;
  box-shadow: 0 4rpx 16rpx rgba(37,99,235,0.3);
}

.action-btn {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}

.action-btn:active {
  transform: scale(0.97);
}