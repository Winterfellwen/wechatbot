<!-- german/pages/learn/learn.wxml - 路径学习模式 -->
<view class="container">
  <!-- 顶部状态栏 -->
  <view class="top-bar">
    <view class="level-badge">Lv.{{currentLevelIndex}}</view>
    <view class="exp-bar-wrap">
      <view class="exp-bar">
        <view class="exp-fill" style="width: {{userProgress.exp % 100}}%"></view>
      </view>
      <text class="exp-text">{{userProgress.totalPoints || 0}} XP</text>
    </view>
    <view class="stats-pill">
      <image class="stats-pill-icon-img" src="/images/icons/flame-48-danger.png" mode="aspectFit"></image>
      <text class="stats-pill-text">{{userProgress.streakDays || 0}}</text>
    </view>
  </view>

  <!-- 级别选择器 -->
  <view class="level-bar">
    <picker mode="selector" range="{{levelOptions}}" value="{{selectedLevelIndex}}" bindchange="onLevelChange">
      <view class="level-picker">
        <text class="level-label">{{selectedLevel}}</text>
        <text class="picker-arrow">▼</text>
      </view>
    </picker>
  </view>

  <!-- 学习路径 -->
  <scroll-view scroll-y class="path-scroll">
    <view class="path-container">
      <block wx:for="{{pathNodes}}" wx:key="id">
        <!-- 关卡节点 -->
        <view class="path-row" id="node-{{item.id}}">
          <view class="node-wrap {{item.done ? 'done' : ''}} {{item.current ? 'current' : ''}} {{!item.done && !item.current ? 'locked' : ''}}"
                bindtap="startChallenge" data-index="{{item.number}}">
            <view class="node-circle">
              <image wx:if="{{item.done}}" class="node-icon-img" src="/images/icons/check-48-success.png" mode="aspectFit"></image>
              <image wx:if="{{!item.done && item.current}}" class="node-icon-img" src="/images/icons/play-48-primary.png" mode="aspectFit"></image>
              <text wx:if="{{!item.done && !item.current}}" class="node-num">{{item.number}}</text>
            </view>
            <view class="node-info">
              <text class="node-title">第 {{item.number}} 关</text>
              <text class="node-meta" wx:if="{{item.score > 0}}">得分: {{item.score}}</text>
              <text class="node-meta" wx:elif="{{item.current}}">进行中</text>
              <text class="node-meta locked" wx:else>未解锁</text>
            </view>
            <view wx:if="{{item.done}}" class="node-status done">
              <image class="status-icon-img" src="/images/icons/check-48-success.png" mode="aspectFit"></image>
            </view>
            <view wx:if="{{item.current && !item.done}}" class="node-status current">
              <text class="status-text">开始</text>
            </view>
          </view>
          <!-- 连接线 -->
          <view wx:if="{{index < pathNodes.length - 1}}" class="connector {{item.done ? 'conn-done' : ''}}"></view>
        </view>
      </block>
    </view>
  </scroll-view>

  <!-- 底部导航 -->
  <view class="bottom-nav">
    <view class="nav-item active">
      <view class="nav-icon-wrap nav-icon-active">
        <image class="nav-icon-img" src="/images/icons/swords-48-dark.png" mode="aspectFit"></image>
      </view>
      <text class="nav-text nav-text-active">闯关</text>
    </view>
    <view class="nav-item" bindtap="goToCourse">
      <view class="nav-icon-wrap">
        <image class="nav-icon-img" src="/images/icons/book-open-text-48-dark.png" mode="aspectFit"></image>
      </view>
      <text class="nav-text">课程</text>
    </view>
    <view class="nav-item" bindtap="goToWordbook">
      <view class="nav-icon-wrap">
        <image class="nav-icon-img" src="/images/icons/book-marked-48-dark.png" mode="aspectFit"></image>
      </view>
      <text class="nav-text">生词本</text>
    </view>
  </view>
</view>
