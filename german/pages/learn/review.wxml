<view class="container">
  <!-- 复习进行中 -->
  <block wx:if="{{!isFinished && questions.length > 0}}">
    <view class="progress-bar">
      <view class="progress-fill" style="width: {{currentQuestion / totalQuestions * 100}}%"></view>
      <text class="progress-text">{{currentQuestion + 1}} / {{totalQuestions}}</text>
    </view>

    <view class="stats">
      <text class="correct-count">认识: {{correct}}</text>
      <text class="wrong-count">不认识: {{wrong}}</text>
    </view>

    <view class="card">
      <view class="word">{{questions[currentQuestion].word}}</view>
      <view class="phonetic" wx:if="{{questions[currentQuestion].phonetic}}">
        /{{questions[currentQuestion].phonetic}}/
      </view>
      
      <view class="answer-section" wx:if="{{showAnswer}}">
        <view class="translation">{{questions[currentQuestion].translation}}</view>
      </view>
      
      <button class="show-btn" bindtap="toggleAnswer" wx:else>
        {{showAnswer ? '隐藏答案' : '显示答案'}}
      </button>
    </view>

    <view class="actions" wx:if="{{showAnswer}}">
      <button class="action-btn wrong" bindtap="markWrong">
        不认识
      </button>
      <button class="action-btn correct" bindtap="markCorrect">
        认识
      </button>
    </view>
  </block>

  <!-- 无复习内容 -->
  <block wx:elif="{{isFinished && totalQuestions === 0}}">
    <view class="empty-state">
      <text class="empty-icon">🎉</text>
      <text class="empty-title">太棒了！</text>
      <text class="empty-desc">暂无需要复习的内容</text>
    </view>
    <button class="back-btn" bindtap="goToLearn">返回首页</button>
  </block>

  <!-- 复习完成 -->
  <block wx:else-if="{{isFinished && totalQuestions > 0}}">
    <view class="finish-card">
      <text class="finish-icon">📚</text>
      <text class="finish-title">复习完成！</text>
      <view class="finish-stats">
        <view class="stat">
          <text class="stat-num correct">{{correct}}</text>
          <text class="stat-label">认识</text>
        </view>
        <view class="stat">
          <text class="stat-num wrong">{{wrong}}</text>
          <text class="stat-label">不认识</text>
        </view>
      </view>
      <view class="finish-message">
        <text wx:if="{{wrong === 0}}">太棒了！全部掌握！</text>
        <text wx:elif="{{wrong <= 2}}">很不错！继续加油！</text>
        <text wx:else>需要多加复习哦！</text>
      </view>
    </view>
    
    <view class="finish-actions">
      <button class="action-btn primary" bindtap="restartReview">再次复习</button>
      <button class="action-btn" bindtap="goToLearn">返回首页</button>
    </view>
  </block>
</view>