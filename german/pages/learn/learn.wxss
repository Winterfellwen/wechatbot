.container {
  padding: 24rpx;
  background: linear-gradient(180deg, #e8f4ff 0%, #f5f5f5 100%);
  min-height: 100vh;
}

.header {
  text-align: center;
  padding: 30rpx 0 40rpx;
  background: linear-gradient(135deg, #1890ff 0%, #40a9ff 100%);
  border-radius: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(24, 144, 255, 0.25);
}

.title {
  font-size: 52rpx;
  font-weight: bold;
  color: #fff;
  display: block;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.1);
}

.subtitle {
  font-size: 26rpx;
  color: rgba(255,255,255,0.9);
  margin-top: 12rpx;
  display: block;
}

.stats-bar {
  display: flex;
  justify-content: space-around;
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
}

.stat-item {
  text-align: center;
  flex: 1;
}

.stat-num {
  font-size: 44rpx;
  font-weight: bold;
  background: linear-gradient(135deg, #1890ff 0%, #40a9ff 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  display: block;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
  display: block;
}

.section {
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  padding-left: 16rpx;
  border-left: 8rpx solid #1890ff;
}

.level-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 16rpx;
}

.level-card {
  width: calc(50% - 8rpx);
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 0;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
  transition: all 0.3s ease;
  border: 2rpx solid transparent;
}

.level-card:active {
  transform: scale(0.98);
}

.level-card.active {
  border: 4rpx solid #1890ff;
  background: linear-gradient(135deg, #e6f7ff 0%, #fff 100%);
}

.level-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.level-name {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}

.level-badge {
  font-size: 22rpx;
  color: #1890ff;
  background: linear-gradient(135deg, #e6f7ff 0%, #bae7ff 100%);
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

.level-desc {
  font-size: 24rpx;
  color: #666;
  display: block;
  line-height: 1.5;
}

.level-buttons {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
}

.level-btn {
  width: 92rpx;
  height: 88rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #1890ff 0%, #40a9ff 100%);
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(24,144,255,0.3);
  transition: all 0.2s;
}

.level-btn:active {
  transform: scale(0.95);
  box-shadow: 0 2rpx 8rpx rgba(24,144,255,0.3);
}

.level-btn.locked {
  background: linear-gradient(135deg, #d9d9d9 0%, #bfbfbf 100%);
  box-shadow: none;
}

.level-btn.unlocked {
  background: linear-gradient(135deg, #52c41a 0%, #73d13d 100%);
  box-shadow: 0 4rpx 12rpx rgba(82,196,26,0.3);
}

.level-btn-num {
  font-size: 30rpx;
  font-weight: bold;
}

.level-btn-status {
  font-size: 18rpx;
  margin-top: 2rpx;
  opacity: 0.9;
}

.quick-links {
  display: flex;
  gap: 16rpx;
}

.quick-link {
  flex: 1;
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 20rpx;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

.quick-link:active {
  transform: scale(0.98);
}

.quick-link::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 6rpx;
  background: linear-gradient(90deg, #1890ff, #40a9ff);
}

.quick-icon {
  font-size: 44rpx;
  display: block;
  margin-bottom: 12rpx;
}

.quick-text {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

.quick-badge {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  background: linear-gradient(135deg, #ff4d4f 0%, #ff7875 100%);
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  font-weight: 500;
}