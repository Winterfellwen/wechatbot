/* german/pages/learn/learn.wxss - UI/UX Pro Max 优化版 */
/* 设计系统: Glassmorphism, Primary #2563EB */
/* 优化：紧凑布局，保持可访问性 */

page {
  background: linear-gradient(180deg, #EFF6FF 0%, #F8FAFC 100%);
}

/* ========== 基础容器 ========== */
.container {
  padding: 20rpx;
  background: linear-gradient(180deg, #EFF6FF 0%, #F8FAFC 100%);
  min-height: 100vh;
  padding-bottom: calc(80rpx + env(safe-area-inset-bottom));
}

/* ========== 头部区域 ========== */
.header {
  text-align: center;
  padding: 28rpx 24rpx;
  background: linear-gradient(135deg, #2563EB 0%, #3B82F6 100%);
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 6rpx 24rpx rgba(37, 99, 235, 0.2);
  position: relative;
  overflow: hidden;
}

.header::before {
  content: '';
  position: absolute;
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.06);
  top: -60rpx;
  right: -30rpx;
}

.title {
  font-size: 44rpx;
  font-weight: 700;
  color: #fff;
  display: block;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.1);
  position: relative;
  z-index: 1;
}

.subtitle {
  font-size: 24rpx;
  color: rgba(255,255,255,0.9);
  margin-top: 8rpx;
  display: block;
  position: relative;
  z-index: 1;
}

/* ========== 统计栏 ========== */
.stats-bar {
  display: flex;
  justify-content: space-around;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.stat-item {
  text-align: center;
  flex: 1;
}

.stat-num {
  font-size: 36rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #2563EB 0%, #3B82F6 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  display: block;
}

.stat-label {
  font-size: 22rpx;
  color: #64748B;
  margin-top: 4rpx;
  display: block;
}

/* ========== 区块标题 ========== */
.section {
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1E293B;
  margin-bottom: 14rpx;
  padding-left: 12rpx;
  border-left: 4rpx solid #2563EB;
}

/* ========== 等级卡片网格 ========== */
.level-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 14rpx;
}

.level-card {
  width: calc(50% - 7rpx);
  background: #ffffff;
  border-radius: 20rpx;
  padding: 18rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  transition: all 0.2s ease;
  border: 2rpx solid transparent;
  cursor: pointer;
  min-height: 110rpx;
}

.level-card:active {
  transform: scale(0.97);
  box-shadow: 0 1rpx 8rpx rgba(0,0,0,0.06);
}

.level-card.active {
  border: 3rpx solid #2563EB;
  background: linear-gradient(135deg, #EFF6FF 0%, #ffffff 100%);
  box-shadow: 0 4rpx 16rpx rgba(37, 99, 235, 0.12);
}

.level-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.level-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1E293B;
}

.level-badge {
  font-size: 20rpx;
  color: #2563EB;
  background: linear-gradient(135deg, #EFF6FF 0%, #DBEAFE 100%);
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
  font-weight: 500;
}

.level-desc {
  font-size: 22rpx;
  color: #64748B;
  display: block;
  line-height: 1.4;
}

/* ========== 关卡按钮 ========== */
.level-buttons {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 18rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.level-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #2563EB 0%, #3B82F6 100%);
  color: #fff;
  box-shadow: 0 3rpx 10rpx rgba(37, 99, 235, 0.2);
  transition: all 0.2s ease;
  cursor: pointer;
}

.level-btn:active {
  transform: scale(0.92);
  box-shadow: 0 1rpx 6rpx rgba(37, 99, 235, 0.3);
}

.level-btn.locked {
  background: linear-gradient(135deg, #F1F5F9 0%, #E2E8F0 100%);
  box-shadow: none;
  cursor: not-allowed;
}

.level-btn.unlocked {
  background: linear-gradient(135deg, #22C55E 0%, #16A34A 100%);
  box-shadow: 0 3rpx 10rpx rgba(34, 197, 94, 0.2);
}

.level-btn-num {
  font-size: 26rpx;
  font-weight: 600;
}

.level-btn.locked .level-btn-num {
  color: #94A3B8;
}

.level-btn-status {
  font-size: 16rpx;
  margin-top: 2rpx;
  opacity: 0.9;
}

.level-btn.locked .level-btn-status {
  color: #CBD5E1;
}

/* ========== 快速链接 ========== */
.quick-links {
  display: flex;
  gap: 12rpx;
}

.quick-link {
  flex: 1;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 18rpx 12rpx;
  text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  transition: all 0.2s ease;
  position: relative;
  overflow: hidden;
  cursor: pointer;
  min-height: 120rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.quick-link:active {
  transform: scale(0.97);
  box-shadow: 0 1rpx 8rpx rgba(0,0,0,0.06);
}

.quick-link::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: linear-gradient(90deg, #2563EB, #3B82F6);
}

.quick-icon-wrap {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #EFF6FF 0%, #DBEAFE 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 10rpx;
  transition: transform 0.2s ease;
}

.quick-link:active .quick-icon-wrap {
  transform: scale(0.9);
}

.quick-icon-course {
  background: linear-gradient(135deg, #FEF3C7 0%, #FDE68A 100%);
}

.quick-icon-book {
  background: linear-gradient(135deg, #DCFCE7 0%, #BBF7D0 100%);
}

.quick-icon {
  font-size: 24rpx;
  font-weight: 600;
  color: #2563EB;
}

.quick-icon-course .quick-icon {
  color: #D97706;
}

.quick-icon-book .quick-icon {
  color: #16A34A;
}

.quick-text {
  font-size: 22rpx;
  color: #1E293B;
  font-weight: 500;
}

.quick-badge {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  background: linear-gradient(135deg, #EF4444 0%, #DC2626 100%);
  color: #fff;
  font-size: 18rpx;
  padding: 4rpx 10rpx;
  border-radius: 16rpx;
  font-weight: 500;
  min-width: 30rpx;
  text-align: center;
}
