/* german/pages/learn/learn.wxss - UI/UX Pro Max 优化版 */
/* 设计系统: Glassmorphism, Primary #2563EB */

/* ========== 基础容器 ========== */
.container {
  padding: 24rpx;
  background: linear-gradient(180deg, #EFF6FF 0%, #F8FAFC 100%);
  min-height: 100vh;
  padding-bottom: env(safe-area-inset-bottom);
}

/* ========== 头部区域 ========== */
.header {
  text-align: center;
  padding: 36rpx 0 44rpx;
  background: linear-gradient(135deg, #2563EB 0%, #3B82F6 100%);
  border-radius: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(37, 99, 235, 0.25);
  position: relative;
  overflow: hidden;
}

.header::before {
  content: '';
  position: absolute;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.06);
  top: -80rpx;
  right: -40rpx;
}

.title {
  font-size: 52rpx;
  font-weight: 700;
  color: #fff;
  display: block;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.1);
  position: relative;
  z-index: 1;
}

.subtitle {
  font-size: 26rpx;
  color: rgba(255,255,255,0.9);
  margin-top: 12rpx;
  display: block;
  position: relative;
  z-index: 1;
}

/* ========== 统计栏 ========== */
.stats-bar {
  display: flex;
  justify-content: space-around;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.04);
}

.stat-item {
  text-align: center;
  flex: 1;
}

.stat-num {
  font-size: 44rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #2563EB 0%, #3B82F6 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  display: block;
}

.stat-label {
  font-size: 24rpx;
  color: #64748B;
  margin-top: 8rpx;
  display: block;
}

/* ========== 区块标题 ========== */
.section {
  margin-bottom: 28rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1E293B;
  margin-bottom: 20rpx;
  padding-left: 16rpx;
  border-left: 6rpx solid #2563EB;
}

/* ========== 等级卡片网格 ========== */
.level-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 16rpx;
}

.level-card {
  width: calc(50% - 8rpx);
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 0;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.04);
  transition: all 0.2s ease;
  border: 3rpx solid transparent;
  cursor: pointer;
  min-height: 160rpx;
}

.level-card:active {
  transform: scale(0.97);
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.level-card.active {
  border: 4rpx solid #2563EB;
  background: linear-gradient(135deg, #EFF6FF 0%, #ffffff 100%);
  box-shadow: 0 8rpx 24rpx rgba(37, 99, 235, 0.15);
}

.level-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.level-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1E293B;
}

.level-badge {
  font-size: 22rpx;
  color: #2563EB;
  background: linear-gradient(135deg, #EFF6FF 0%, #DBEAFE 100%);
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

.level-desc {
  font-size: 24rpx;
  color: #64748B;
  display: block;
  line-height: 1.5;
}

/* ========== 关卡按钮 ========== */
.level-buttons {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.04);
}

.level-btn {
  width: 100rpx;
  height: 100rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #2563EB 0%, #3B82F6 100%);
  color: #fff;
  box-shadow: 0 4rpx 16rpx rgba(37, 99, 235, 0.25);
  transition: all 0.2s ease;
  cursor: pointer;
  min-width: 88rpx;
  min-height: 88rpx;
}

.level-btn:active {
  transform: scale(0.92);
  box-shadow: 0 2rpx 10rpx rgba(37, 99, 235, 0.3);
}

.level-btn.locked {
  background: linear-gradient(135deg, #F1F5F9 0%, #E2E8F0 100%);
  box-shadow: none;
  cursor: not-allowed;
}

.level-btn.unlocked {
  background: linear-gradient(135deg, #22C55E 0%, #16A34A 100%);
  box-shadow: 0 4rpx 16rpx rgba(34, 197, 94, 0.25);
}

.level-btn-num {
  font-size: 32rpx;
  font-weight: 600;
}

.level-btn.locked .level-btn-num {
  color: #94A3B8;
}

.level-btn-status {
  font-size: 18rpx;
  margin-top: 4rpx;
  opacity: 0.9;
}

.level-btn.locked .level-btn-status {
  color: #CBD5E1;
}

/* ========== 快速链接 ========== */
.quick-links {
  display: flex;
  gap: 16rpx;
}

.quick-link {
  flex: 1;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx 20rpx;
  text-align: center;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.04);
  transition: all 0.2s ease;
  position: relative;
  overflow: hidden;
  cursor: pointer;
  min-height: 160rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.quick-link:active {
  transform: scale(0.97);
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.quick-link::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 6rpx;
  background: linear-gradient(90deg, #2563EB, #3B82F6);
}

.quick-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #EFF6FF 0%, #DBEAFE 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
  min-width: 88rpx;
  min-height: 88rpx;
  transition: transform 0.2s ease;
}

.quick-link:active .quick-icon-wrap {
  transform: scale(0.95);
}

.quick-icon-course {
  background: linear-gradient(135deg, #FEF3C7 0%, #FDE68A 100%);
}

.quick-icon-book {
  background: linear-gradient(135deg, #DCFCE7 0%, #BBF7D0 100%);
}

.quick-icon {
  font-size: 28rpx;
  font-weight: 600;
  color: #2563EB;
}

.quick-icon-course .quick-icon {
  color: #D97706;
}

.quick-icon-book .quick-icon {
  color: #16A34A;
}

.quick-text {
  font-size: 26rpx;
  color: #1E293B;
  font-weight: 500;
}

.quick-badge {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  background: linear-gradient(135deg, #EF4444 0%, #DC2626 100%);
  color: #fff;
  font-size: 20rpx;
  padding: 6rpx 14rpx;
  border-radius: 20rpx;
  font-weight: 500;
  min-width: 36rpx;
  text-align: center;
}
