.container { height: 100vh; background: #f5f5f5; }
.header { padding: 40rpx 30rpx; background: #2196F3; color: #fff; display: flex; align-items: center; }
.title { font-size: 36rpx; font-weight: bold; }
.progress { font-size: 28rpx; opacity: 0.8; margin-left: 20rpx; }
.path-scroll { height: calc(100vh - 200rpx); }
.level-header { padding: 20rpx 30rpx; color: #fff; font-weight: bold; margin: 20rpx 0; border-radius: 8rpx; }
.lesson-node { display: flex; align-items: center; padding: 30rpx; background: #fff; margin: 10rpx 20rpx; border-radius: 16rpx; }
.node-circle { width: 60rpx; height: 60rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #fff; font-weight: bold; margin-right: 20rpx; font-size: 28rpx; }
.node-title { font-size: 28rpx; flex: 1; }
.node-info { font-size: 24rpx; color: #999; }
.done .node-circle { background: #4CAF50 !important; }
.current { border: 2rpx solid #2196F3; }
.tab-bar { display: flex; background: #fff; padding: 20rpx 0; border-top: 1rpx solid #eee; position: fixed; bottom: 0; width: 100%; }
.tab { flex: 1; text-align: center; color: #999; font-size: 28rpx; }
.tab.active { color: #2196F3; font-weight: bold; }