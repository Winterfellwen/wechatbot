/* german/pages/learn/learn.wxss - 路径学习模式 */
/* 设计系统: Glassmorphism, Primary #2563EB */

page {
  background: #F8FAFC;
}

/* ========== 基础容器 ========== */
.container { 
  min-height: 100vh; 
  background: #F8FAFC;
}

/* ========== 顶部状态栏 ========== */
.top-bar {
  display: flex; 
  align-items: center; 
  gap: 16rpx;
  padding: 20rpx 24rpx;
  background: linear-gradient(135deg, #2563EB 0%, #3B82F6 100%);
}

.level-badge {
  width: 72rpx; 
  height: 72rpx; 
  border-radius: 50%;
  background: rgba(255,255,255,0.25); 
  color: #fff;
  font-size: 28rpx; 
  font-weight: 700; 
  text-align: center;
  line-height: 72rpx; 
  flex-shrink: 0;
  box-shadow: inset 0 -4rpx 8rpx rgba(0,0,0,0.1), 0 4rpx 12rpx rgba(37,99,235,0.3);
}

.exp-bar-wrap { flex: 1; }

.exp-bar { 
  height: 14rpx; 
  background: rgba(255,255,255,0.3); 
  border-radius: 7rpx; 
  overflow: hidden; 
}

.exp-fill { 
  height: 100%; 
  background: linear-gradient(90deg, #FFD700, #FFA500); 
  border-radius: 7rpx; 
  transition: width 0.3s ease;
  box-shadow: 0 0 8rpx rgba(255,215,0,0.4);
}

.exp-text { 
  font-size: 22rpx; 
  color: rgba(255,255,255,0.9); 
  margin-top: 6rpx; 
  display: block; 
}

.stats-pill {
  display: flex;
  align-items: center;
  gap: 6rpx;
  background: rgba(255,255,255,0.2);
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
}

.stats-pill-icon {
  font-size: 24rpx;
}

.stats-pill-text {
  font-size: 24rpx;
  color: #fff;
  font-weight: 600;
}

/* ========== 级别选择器 ========== */
.level-bar {
  background: linear-gradient(135deg, #2563EB 0%, #3B82F6 100%);
  padding: 12rpx 24rpx 16rpx;
  display: flex;
  justify-content: center;
}

.level-picker {
  background: rgba(255,255,255,0.25);
  padding: 12rpx 28rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  cursor: pointer;
  transition: background 0.2s ease;
}

.level-picker:active {
  background: rgba(255,255,255,0.35);
}

.level-label { color: #fff; }

.picker-arrow {
  font-size: 18rpx;
  margin-left: 8rpx;
  color: rgba(255,255,255,0.7);
}

/* ========== 学习路径容器 ========== */
.path-scroll { 
  height: calc(100vh - 220rpx);
  padding-bottom: 80rpx;
}

.path-container { 
  padding: 24rpx 24rpx 40rpx; 
}

/* ========== 课程节点 ========== */
.path-row { position: relative; }

.node-wrap {
  display: flex; 
  align-items: center; 
  gap: 20rpx;
  padding: 24rpx; 
  background: #ffffff; 
  border-radius: 20rpx;
  border: 2rpx solid #E2E8F0; 
  position: relative; 
  z-index: 1;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  transition: all 0.2s ease;
  cursor: pointer;
}

.node-wrap:active {
  transform: scale(0.98);
  box-shadow: 0 1rpx 8rpx rgba(0,0,0,0.06);
}

/* 已完成状态 */
.node-wrap.done {
  border-color: #22C55E; 
  background: #F0FDF4;
}

/* 当前状态 */
.node-wrap.current {
  border-color: #2563EB; 
  background: #ffffff;
  box-shadow: 0 0 0 6rpx rgba(37,99,235,0.08), 0 4rpx 16rpx rgba(37,99,235,0.12);
}

/* 锁定状态 */
.node-wrap.locked {
  border-color: #F1F5F9; 
  background: #F8FAFC; 
  opacity: 0.8;
  cursor: not-allowed;
}

/* ========== 节点圆形图标 ========== */
.node-circle {
  width: 72rpx; 
  height: 72rpx; 
  border-radius: 50%;
  display: flex; 
  align-items: center; 
  justify-content: center;
  flex-shrink: 0; 
  border: 3rpx solid #CBD5E1; 
  background: #ffffff;
  transition: all 0.2s ease;
}

.node-wrap.done .node-circle { 
  border-color: #22C55E; 
  background: #22C55E; 
  box-shadow: 0 4rpx 12rpx rgba(34,197,94,0.25);
}

.node-wrap.current .node-circle { 
  border-color: #2563EB; 
  background: #ffffff; 
  box-shadow: 0 4rpx 12rpx rgba(37,99,235,0.2);
}

.node-wrap.locked .node-circle { 
  border-color: #E2E8F0; 
  background: #F8FAFC;
}

.node-icon { 
  font-size: 28rpx; 
  color: #ffffff; 
  font-weight: bold;
}

.node-wrap.current .node-icon { 
  color: #2563EB; 
}

.node-num { 
  font-size: 28rpx; 
  color: #64748B; 
  font-weight: 600; 
}

.node-wrap.locked .node-num { 
  color: #CBD5E1; 
}

/* ========== 节点信息 ========== */
.node-info { 
  flex: 1; 
  min-width: 0;
}

.node-title { 
  font-size: 30rpx; 
  font-weight: 600; 
  color: #1E293B; 
  display: block; 
  line-height: 1.3;
}

.node-wrap.locked .node-title { 
  color: #94A3B8;
}

.node-meta { 
  font-size: 24rpx; 
  color: #64748B; 
  margin-top: 4rpx; 
  display: block; 
}

.node-meta.locked {
  color: #CBD5E1;
}

/* ========== 节点状态标签 ========== */
.node-status {
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.node-status.done {
  background: #22C55E;
  color: #fff;
}

.node-status.current {
  background: #2563EB;
  color: #fff;
}

.status-icon {
  font-size: 22rpx;
}

.status-text {
  font-size: 22rpx;
}

/* ========== 连接线 ========== */
.connector {
  width: 3rpx; 
  height: 32rpx;
  background: #CBD5E1; 
  margin-left: 59rpx;
  transition: background 0.2s ease;
}

.connector.conn-done { 
  background: #22C55E;
}

/* ========== 底部导航 ========== */
.bottom-nav {
  position: fixed; 
  bottom: 0; 
  left: 0; 
  right: 0; 
  display: flex;
  background: rgba(255,255,255,0.95);
  backdrop-filter: blur(20px);
  box-shadow: 0 -4rpx 24rpx rgba(0,0,0,0.06);
  padding: 8rpx 0 env(safe-area-inset-bottom, 8rpx);
  z-index: 999;
}

.nav-item { 
  flex: 1; 
  padding: 12rpx 0; 
  text-align: center; 
  display: flex; 
  flex-direction: column; 
  align-items: center;
  cursor: pointer;
  transition: transform 0.2s ease;
}

.nav-item:active {
  transform: scale(0.95);
}

.nav-icon-wrap {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  background: #F1F5F9;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 4rpx;
  transition: all 0.2s ease;
}

.nav-icon-active {
  background: linear-gradient(135deg, #2563EB 0%, #3B82F6 100%);
  box-shadow: 0 4rpx 12rpx rgba(37,99,235,0.25);
}

.nav-icon-text {
  font-size: 24rpx;
  font-weight: 600;
  color: #64748B;
}

.nav-item.active .nav-icon-text {
  color: #ffffff;
}

.nav-text { 
  font-size: 22rpx; 
  color: #64748B; 
  transition: color 0.2s ease;
}

.nav-text-active {
  color: #2563EB;
  font-weight: 600;
}

.nav-item.active .nav-text {
  color: #2563EB;
  font-weight: 600;
}
