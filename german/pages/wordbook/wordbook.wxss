.container {
  min-height: 100vh;
  background: #f5f5f5;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 40rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.empty-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 28rpx;
  color: #999;
}

.main-content {
  padding: 20rpx;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.word-count {
  font-size: 28rpx;
  color: #666;
}

.review-btn {
  background: #1890ff;
  color: #fff;
  font-size: 26rpx;
  padding: 12rpx 24rpx;
  border-radius: 30rpx;
  border: none;
}

.word-list {
  height: calc(100vh - 120rpx);
}

.word-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.word-main {
  flex: 1;
}

.word-text {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.word {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}

.audio-icon {
  font-size: 32rpx;
}

.word-translation {
  font-size: 28rpx;
  color: #666;
  margin-top: 8rpx;
}

.word-phonetic {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

.word-example {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
  font-style: italic;
}

.word-actions {
  margin-left: 20rpx;
}

.delete-btn {
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  background: #fff;
  color: #ff4d4f;
  border: 1rpx solid #ff4d4f;
  border-radius: 8rpx;
}

.review-mode {
  padding: 20rpx;
}

.review-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 40rpx;
}

.progress {
  font-size: 28rpx;
  color: #666;
}

.back-btn {
  font-size: 26rpx;
  padding: 12rpx 24rpx;
  background: #fff;
  color: #666;
  border: 1rpx solid #d9d9d9;
  border-radius: 8rpx;
}

.review-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 60rpx 40rpx;
  text-align: center;
  margin-bottom: 40rpx;
}

.card-word {
  font-size: 56rpx;
  font-weight: bold;
  color: #333;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 16rpx;
}

.card-phonetic {
  font-size: 32rpx;
  color: #999;
  margin-top: 20rpx;
}

.card-answer {
  margin-top: 40rpx;
  padding: 30rpx;
  background: #f6ffed;
  border-radius: 16rpx;
  border: 2rpx solid #52c41a;
}

.answer-translation {
  font-size: 36rpx;
  color: #52c41a;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.answer-example {
  font-size: 26rpx;
  color: #666;
}

.show-answer-btn {
  margin-top: 40rpx;
  background: #e6f7ff;
  color: #1890ff;
  border: 2rpx solid #1890ff;
  border-radius: 12rpx;
  font-size: 30rpx;
  padding: 24rpx;
}

.review-actions {
  display: flex;
  gap: 30rpx;
}

.unknown-btn, .known-btn {
  flex: 1;
  padding: 28rpx;
  border-radius: 16rpx;
  font-size: 32rpx;
}

.unknown-btn {
  background: #fff;
  color: #ff4d4f;
  border: 2rpx solid #ff4d4f;
}

.known-btn {
  background: #52c41a;
  color: #fff;
  border: none;
}