/*pages/wordbook/wordbook.wxss*/
.container { min-height: 100vh; background: #F0F9FF; padding-bottom: 20rpx; }

.header { padding: 20rpx 30rpx; background: #fff; box-shadow: 0 2rpx 12rpx rgba(14,165,233,0.06); }
.header-row { display: flex; align-items: center; justify-content: space-between; }
.back-btn { width: 60rpx; height: 60rpx; display: flex; align-items: center; justify-content: center; }
.back-icon { font-size: 40rpx; color: #0EA5E9; font-weight: bold; }
.header-title { font-size: 36rpx; font-weight: bold; color: #0F172A; }
.header-placeholder { width: 60rpx; }

.search-bar { padding: 20rpx; background: #fff; position: relative; margin-bottom: 2rpx; }
.search-input { height: 76rpx; background: #F0F9FF; border-radius: 40rpx; padding: 0 60rpx 0 44rpx; font-size: 28rpx; }
.clear-btn { position: absolute; right: 40rpx; top: 50%; transform: translateY(-50%); width: 48rpx; height: 48rpx; line-height: 44rpx; text-align: center; font-size: 36rpx; color: #94A3B8; }

.stats-bar {
  display: flex; padding: 32rpx; margin: 24rpx; background: linear-gradient(135deg, #0EA5E9, #38BDF8);
  border-radius: 20rpx; box-shadow: 0 6rpx 20rpx rgba(14,165,233,0.15);
}
.stat-item { flex: 1; text-align: center; }
.stat-divider { border-left: 1rpx solid rgba(255,255,255,0.3); border-right: 1rpx solid rgba(255,255,255,0.3); }
.stat-num { display: block; font-size: 44rpx; font-weight: bold; color: #fff; }
.stat-label { display: block; font-size: 26rpx; color: rgba(255,255,255,0.85); margin-top: 6rpx; }

.word-list { padding: 0 24rpx; height: calc(100vh - 370rpx); }

.word-card { display: flex; align-items: flex-start; background: #fff; border-radius: 20rpx; padding: 28rpx; margin-bottom: 18rpx; box-shadow: 0 2rpx 8rpx rgba(14,165,233,0.04); }
.word-main { flex: 1; }
.word-row { display: flex; align-items: center; flex-wrap: wrap; }
.word-japanese { font-size: 36rpx; font-weight: bold; color: #0F172A; }
.word-reading { font-size: 26rpx; color: #64748B; margin-left: 14rpx; }
.word-meaning { font-size: 30rpx; color: #475569; margin-top: 10rpx; }

.word-example { margin-top: 14rpx; padding: 14rpx 18rpx; background: #F0F9FF; border-radius: 12rpx; border-left: 4rpx solid #0EA5E9; }
.example-jp { font-size: 26rpx; color: #475569; display: block; }
.example-cn { font-size: 24rpx; color: #94A3B8; display: block; margin-top: 4rpx; }

.word-star { width: 64rpx; height: 64rpx; display: flex; align-items: center; justify-content: center; flex-shrink: 0; margin-left: 18rpx; }
.star-icon { font-size: 40rpx; color: #CBD5E1; }
.word-star.starred .star-icon { color: #F59E0B; }
