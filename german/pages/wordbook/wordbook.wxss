.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #e8f4ff 0%, #f5f5f5 100%);
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 40rpx;
}

.empty-icon {
  font-size: 140rpx;
  margin-bottom: 30rpx;
}

.empty-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 28rpx;
  color: #999;
}

.main-content {
  padding: 24rpx;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  background: #fff;
  padding: 24rpx;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.06);
}

.word-count {
  font-size: 28rpx;
  color: #666;
}

.review-btn {
  background: linear-gradient(135deg, #1890ff 0%, #40a9ff 100%);
  color: #fff;
  font-size: 26rpx;
  padding: 14rpx 28rpx;
  border-radius: 30rpx;
  border: none;
  box-shadow: 0 4rpx 12rpx rgba(24,144,255,0.3);
  font-weight: 500;
}

.word-list {
  height: calc(100vh - 140rpx);
}

.word-item {
  background: #fff;
  border-radius: 18rpx;
  padding: 26rpx;
  margin-bottom: 18rpx;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.06);
  transition: all 0.2s;
}

.word-item:active {
  transform: scale(0.99);
}

.word-main {
  flex: 1;
}

.word-text {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.word {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.audio-icon {
  font-size: 32rpx;
}

.word-translation {
  font-size: 28rpx;
  color: #666;
  margin-top: 10rpx;
}

.word-phonetic {
  font-size: 24rpx;
  color: #999;
  margin-top: 6rpx;
}

.word-example {
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
  font-style: italic;
}

.word-actions {
  margin-left: 20rpx;
}

.delete-btn {
  font-size: 24rpx;
  padding: 10rpx 20rpx;
  background: #fff;
  color: #ff4d4f;
  border: 2rpx solid #ff4d4f;
  border-radius: 10rpx;
  font-weight: 500;
}

.delete-btn:active {
  background: #fff1f0;
}

.review-mode {
  padding: 24rpx;
}

.review-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 40rpx;
  background: #fff;
  padding: 20rpx;
  border-radius: 14rpx;
}

.progress {
  font-size: 28rpx;
  color: #666;
  font-weight: bold;
}

.back-btn {
  font-size: 26rpx;
  padding: 14rpx 28rpx;
  background: #fff;
  color: #666;
  border: 2rpx solid #d9d9d9;
  border-radius: 10rpx;
}

.review-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 60rpx 40rpx;
  text-align: center;
  margin-bottom: 40rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.1);
}

.card-word {
  font-size: 60rpx;
  font-weight: bold;
  color: #333;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 18rpx;
}

.card-phonetic {
  font-size: 34rpx;
  color: #999;
  margin-top: 24rpx;
}

.card-answer {
  margin-top: 40rpx;
  padding: 32rpx;
  background: linear-gradient(135deg, #f6ffed 0%, #d9f7be 100%);
  border-radius: 16rpx;
  border: 2rpx solid #52c41a;
}

.answer-translation {
  font-size: 38rpx;
  color: #52c41a;
  font-weight: bold;
  margin-bottom: 14rpx;
}

.answer-example {
  font-size: 26rpx;
  color: #666;
}

.show-answer-btn {
  margin-top: 40rpx;
  background: linear-gradient(135deg, #e6f7ff 0%, #bae7ff 100%);
  color: #1890ff;
  border: 2rpx solid #1890ff;
  border-radius: 14rpx;
  font-size: 32rpx;
  padding: 26rpx;
  font-weight: bold;
  box-shadow: 0 4rpx 12rpx rgba(24,144,255,0.2);
}

.review-actions {
  display: flex;
  gap: 24rpx;
}

.unknown-btn, .known-btn {
  flex: 1;
  padding: 28rpx;
  border-radius: 16rpx;
  font-size: 34rpx;
  font-weight: bold;
}

.unknown-btn {
  background: #fff;
  color: #ff4d4f;
  border: 2rpx solid #ff4d4f;
  box-shadow: 0 4rpx 12rpx rgba(255,77,79,0.2);
}

.known-btn {
  background: linear-gradient(135deg, #52c41a 0%, #73d13d 100%);
  color: #fff;
  border: none;
  box-shadow: 0 4rpx 16rpx rgba(82,196,26,0.3);
}