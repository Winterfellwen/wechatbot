.container {
  min-height: 100vh;
  background: #F8FAFC;
}

.top-bar {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background: linear-gradient(135deg, #2563EB 0%, #3B82F6 100%);
  color: #fff;
}

.back-btn {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.2s ease;
}

.back-btn:active {
  transform: scale(0.9);
}

.back-icon {
  font-size: 32rpx;
  font-weight: 700;
}

.back-icon-img {
  width: 36rpx;
  height: 36rpx;
}

.top-title {
  flex: 1;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
}

.top-placeholder {
  width: 60rpx;
}

.book-list {
  padding: 24rpx;
}

.book-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.04);
  border: 2rpx solid #E2E8F0;
  cursor: pointer;
  transition: all 0.2s ease;
}

.book-card:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.book-cover {
  width: 120rpx;
  height: 140rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.book-level {
  font-size: 40rpx;
  font-weight: 800;
  color: #fff;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.2);
}

.book-info {
  flex: 1;
}

.book-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1E293B;
  display: block;
  margin-bottom: 12rpx;
}

.book-progress {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.progress-bar {
  flex: 1;
  height: 12rpx;
  background: #F1F5F9;
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #2563EB, #3B82F6);
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

.progress-text {
  font-size: 22rpx;
  color: #64748B;
  font-weight: 600;
}

.book-meta {
  font-size: 24rpx;
  color: #94A3B8;
}

.book-arrow {
  font-size: 32rpx;
  color: #CBD5E1;
  margin-left: 16rpx;
}

.lesson-list {
  padding: 24rpx;
}

.lesson-item {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  border: 2rpx solid #E2E8F0;
  cursor: pointer;
  transition: all 0.2s ease;
}

.lesson-item:active {
  transform: scale(0.98);
}

.lesson-num {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  border: 3rpx solid #E2E8F0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
  color: #94A3B8;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.lesson-num.done {
  background: #22C55E;
  border-color: #22C55E;
  color: #fff;
}

.lesson-info {
  flex: 1;
}

.lesson-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1E293B;
  display: block;
}

.lesson-meta {
  font-size: 22rpx;
  color: #94A3B8;
  margin-top: 4rpx;
  display: block;
}

.lesson-arrow {
  font-size: 28rpx;
  color: #CBD5E1;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 40rpx;
}

.empty-icon-wrap {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #EFF6FF 0%, #DBEAFE 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.empty-icon-text {
  font-size: 52rpx;
  font-weight: 800;
  color: #2563EB;
}

.empty-icon-img {
  width: 64rpx;
  height: 64rpx;
}

.empty-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1E293B;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #94A3B8;
}