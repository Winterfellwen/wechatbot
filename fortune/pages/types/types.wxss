.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.header {
  padding: 40rpx 0;
  text-align: center;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
}

.types-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.descriptions {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
}

.description-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eee;
}

.description-item:last-child {
  border-bottom: none;
}

.desc-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 10rpx;
}

.desc-text {
  font-size: 26rpx;
  color: #666;
}
