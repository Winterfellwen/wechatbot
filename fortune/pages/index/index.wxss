.page-container {
  min-height: 100vh;
  color: #fff;
}

.page-content {
  position: relative;
  z-index: 1;
  padding: 0 0 48rpx;
}

/* --- 导航栏 --- */
.nav-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 32rpx 16rpx;
}

.nav-title {
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.nav-actions {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.nav-action {
  font-size: 32rpx;
  opacity: 0.6;
  padding: 8rpx;
  transition: opacity 0.2s;
}
.nav-action:active {
  opacity: 1;
}

/* --- 标语 --- */
.tagline {
  text-align: center;
  padding: 32rpx 40rpx 12rpx;
}

.tagline-cn {
  display: block;
  font-size: 34rpx;
  font-weight: 400;
  letter-spacing: 8rpx;
  color: rgba(255,255,255,0.85);
}

.tagline-la {
  display: block;
  font-size: 15rpx;
  letter-spacing: 3rpx;
  color: rgba(255,255,255,0.28);
  margin-top: 6rpx;
  font-style: italic;
}

/* --- 紧凑档案行 --- */
.profile-row {
  margin: 16rpx 28rpx 24rpx;
  padding: 16rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  border-radius: 40rpx;
  background: rgba(255,255,255,0.05);
  border: 1rpx solid rgba(255,255,255,0.08);
  transition: all 0.2s;
}
.profile-row:active {
  background: rgba(255,255,255,0.1);
}

.profile-avatar-sm {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #d97757, #818cf8);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.profile-row-info {
  flex: 1;
  min-width: 0;
}

.profile-row-name {
  display: block;
  font-size: 26rpx;
  font-weight: 500;
  color: rgba(255,255,255,0.9);
}

.profile-row-detail {
  display: block;
  font-size: 20rpx;
  color: rgba(255,255,255,0.4);
  margin-top: 2rpx;
}

.profile-row-arrow {
  font-size: 28rpx;
  opacity: 0.35;
}

/* --- 三大测算入口 — 纵向大卡片 --- */
.main-entries {
  padding: 0 28rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.entry-card {
  position: relative;
  border-radius: 28rpx;
  overflow: hidden;
  padding: 36rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 160rpx;
  transition: transform 0.15s ease;
}
.entry-card:active {
  transform: scale(0.98);
}

.entry-card-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 0;
}

.entry-card-content {
  position: relative;
  z-index: 1;
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: 20rpx;
}

.entry-card-top {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.entry-icon {
  font-size: 48rpx;
  line-height: 1;
}

.entry-tags {
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
}

.entry-tag {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  background: rgba(255,255,255,0.12);
  color: rgba(255,255,255,0.8);
  border: 1rpx solid rgba(255,255,255,0.1);
}

.entry-card-bottom {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.entry-title {
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: #fff;
}

.entry-desc {
  font-size: 22rpx;
  color: rgba(255,255,255,0.55);
  letter-spacing: 1rpx;
}

.entry-card-arrow {
  position: relative;
  z-index: 1;
  font-size: 36rpx;
  opacity: 0.4;
  padding-left: 16rpx;
}

/* 易学 — 暖色 */
.entry-chinese .entry-card-bg {
  background: linear-gradient(135deg, rgba(180,80,50,0.35), rgba(140,60,40,0.2));
  border: 1rpx solid rgba(217,119,87,0.35);
}
.entry-chinese .entry-tag {
  background: rgba(217,119,87,0.2);
  border-color: rgba(217,119,87,0.25);
}

/* 西方 — 冷色 */
.entry-western .entry-card-bg {
  background: linear-gradient(135deg, rgba(80,70,180,0.3), rgba(40,60,140,0.2));
  border: 1rpx solid rgba(129,140,248,0.35);
}
.entry-western .entry-tag {
  background: rgba(129,140,248,0.18);
  border-color: rgba(129,140,248,0.25);
}

/* 塔罗 — 紫罗兰 */
.entry-tarot .entry-card-bg {
  background: linear-gradient(135deg, rgba(100,60,160,0.35), rgba(60,40,100,0.2));
  border: 1rpx solid rgba(167,139,250,0.35);
}
.entry-tarot .entry-tag {
  background: rgba(167,139,250,0.18);
  border-color: rgba(167,139,250,0.25);
}

/* --- 底部方法说明 --- */
.footer-hint {
  text-align: center;
  padding: 32rpx 40rpx 16rpx;
}

.footer-line {
  display: block;
  font-size: 20rpx;
  color: rgba(255,255,255,0.25);
  letter-spacing: 1rpx;
  line-height: 1.8;
}
