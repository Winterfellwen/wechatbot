<view class="page-container fortune-page bg-neutral">
  <view class="page-content">
    <!-- 顶部导航 -->
    <view class="nav-bar">
      <text class="nav-title">☯ AI命理</text>
      <text class="nav-icon" bindtap="handleHistoryTap">📜</text>
    </view>

    <!-- 标语 -->
    <view class="tagline">
      <text class="tagline-cn">顺天应时</text>
      <text class="tagline-la">TEMPORA SEQUERE</text>
    </view>

    <!-- 档案卡 -->
    <view class="glass-card profile-card" bindtap="handleShowProfileForm">
      <view class="profile-avatar">{{profile ? profile.name[0] : '?'}}</view>
      <view class="profile-info">
        <text class="profile-name">{{profile ? profile.name : '点击填写档案'}}</text>
        <text class="profile-detail" wx:if="{{profile}}">{{profile.birthday}} · {{profile.gender === 'male' ? '♂' : '♀'}}{{profile.birthTime ? ' · ' + profile.birthTime : ''}}</text>
      </view>
      <text class="arrow">›</text>
    </view>

    <!-- 双入口网格 -->
    <view class="grid">
      <view class="grid-item grid-chinese" data-category="chinese" bindtap="handleCategoryTap">
        <text class="grid-icon">☯</text>
        <text class="grid-title">易学命理</text>
        <text class="grid-sub">八字·紫微·易经</text>
      </view>
      <view class="grid-item grid-western" data-category="western" bindtap="handleCategoryTap">
        <text class="grid-icon">⭐</text>
        <text class="grid-title">西方星象</text>
        <text class="grid-sub">星座·占星</text>
      </view>
    </view>

    <!-- 塔罗占卜独立入口 -->
    <view class="tarot-entry" bindtap="handleTarotTap">
      <view class="tarot-entry-left">
        <text class="tarot-entry-icon">🃏</text>
        <view class="tarot-entry-info">
          <text class="tarot-entry-title">塔罗占卜</text>
          <text class="tarot-entry-desc">洗牌·切牌·抽牌·AI解读</text>
        </view>
      </view>
      <text class="tarot-entry-arrow">›</text>
    </view>

    <!-- 方法介绍（左右分栏） -->
    <view class="intro-grid">
      <view class="intro-col">
        <view class="intro-item" wx:for="{{chineseMethods}}" wx:key="name" wx:for-item="m">
          <text class="intro-name">{{m.name}}</text>
          <text class="intro-desc">{{m.desc}}</text>
        </view>
      </view>
      <view class="intro-col">
        <view class="intro-item" wx:for="{{westernMethods}}" wx:key="name" wx:for-item="m">
          <text class="intro-name">{{m.name}}</text>
          <text class="intro-desc">{{m.desc}}</text>
        </view>
      </view>
    </view>

    <!-- 历史记录入口 -->
    <view class="glass-card history-entry" bindtap="handleHistoryTap">
      <text class="history-label">📜 历史记录</text>
      <text class="arrow">›</text>
    </view>
  </view>

  <!-- 档案表单弹层 -->
  <profile-form wx:if="{{showProfileForm}}" visible="{{showProfileForm}}" bind:close="handleCloseProfileForm" bind:save="handleSaveProfile" profile="{{profile}}" />
</view>
