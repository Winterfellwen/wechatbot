<view class="page-container fortune-page bg-neutral">
  <view class="page-content">
    <!-- 顶部导航 -->
    <view class="nav-bar">
      <text class="nav-title">☯ AI命理</text>
      <view class="nav-actions">
        <text class="nav-action" bindtap="handleHistoryTap">📜</text>
      </view>
    </view>

    <!-- 标语 -->
    <view class="tagline">
      <text class="tagline-cn">顺天应时</text>
      <text class="tagline-la">TEMPORA SEQUERE</text>
    </view>

    <!-- 紧凑档案行 -->
    <view class="profile-row" bindtap="handleShowProfileForm">
      <view class="profile-avatar-sm">{{profile ? profile.name[0] : '?'}}</view>
      <view class="profile-row-info">
        <text class="profile-row-name">{{profile ? profile.name : '点击填写档案'}}</text>
        <text class="profile-row-detail" wx:if="{{profile}}">{{profile.birthday}} · {{profile.gender === 'male' ? '♂' : '♀'}}</text>
      </view>
      <text class="profile-row-arrow">›</text>
    </view>

    <!-- 三大测算入口 — 纵向大卡片 -->
    <view class="main-entries">
      <view class="entry-card entry-chinese" data-category="chinese" bindtap="handleCategoryTap">
        <view class="entry-card-bg"></view>
        <view class="entry-card-content">
          <view class="entry-card-top">
            <text class="entry-icon">☯</text>
            <view class="entry-tags">
              <text class="entry-tag">八字</text>
              <text class="entry-tag">紫微</text>
              <text class="entry-tag">易经</text>
            </view>
          </view>
          <view class="entry-card-bottom">
            <text class="entry-title">易学命理</text>
            <text class="entry-desc">四柱八字 · 紫微斗数 · 六十四卦</text>
          </view>
        </view>
        <view class="entry-card-arrow">›</view>
      </view>

      <view class="entry-card entry-western" data-category="western" bindtap="handleCategoryTap">
        <view class="entry-card-bg"></view>
        <view class="entry-card-content">
          <view class="entry-card-top">
            <text class="entry-icon">⭐</text>
            <view class="entry-tags">
              <text class="entry-tag">星座</text>
              <text class="entry-tag">占星</text>
            </view>
          </view>
          <view class="entry-card-bottom">
            <text class="entry-title">西方星象</text>
            <text class="entry-desc">十二星座 · 星盘宫位 · 行星推演</text>
          </view>
        </view>
        <view class="entry-card-arrow">›</view>
      </view>

      <view class="entry-card entry-tarot" bindtap="handleTarotTap">
        <view class="entry-card-bg"></view>
        <view class="entry-card-content">
          <view class="entry-card-top">
            <text class="entry-icon">🃏</text>
            <view class="entry-tags">
              <text class="entry-tag">洗牌</text>
              <text class="entry-tag">抽牌</text>
              <text class="entry-tag">AI解</text>
            </view>
          </view>
          <view class="entry-card-bottom">
            <text class="entry-title">塔罗占卜</text>
            <text class="entry-desc">大阿卡纳 · 直觉抽牌 · 深度解读</text>
          </view>
        </view>
        <view class="entry-card-arrow">›</view>
      </view>
    </view>

    <!-- 底部方法说明（弱化） -->
    <view class="footer-hint">
      <text class="footer-line">八字定格局 · 紫微观轨迹 · 易经通变化</text>
      <text class="footer-line">星座察性格 · 占星看宫位 · 塔罗启直觉</text>
    </view>
  </view>

  <!-- 档案表单弹层 -->
  <profile-form wx:if="{{showProfileForm}}" visible="{{showProfileForm}}" bind:close="handleCloseProfileForm" bind:save="handleSaveProfile" profile="{{profile}}" />
</view>
