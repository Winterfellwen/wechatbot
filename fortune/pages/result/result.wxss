.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.header {
  padding: 40rpx 0;
  text-align: center;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
}

.loading {
  text-align: center;
  padding: 100rpx 0;
}

.loading-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.loading-text {
  font-size: 32rpx;
  color: #333;
  display: block;
  margin-bottom: 10rpx;
}

.loading-sub {
  font-size: 26rpx;
  color: #666;
}

.error {
  text-align: center;
  padding: 100rpx 0;
}

.error-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.error-text {
  font-size: 32rpx;
  color: #ff4d4f;
  display: block;
  margin-bottom: 30rpx;
}

.retry-btn {
  background: #667eea;
  color: white;
  border-radius: 8rpx;
  font-size: 28rpx;
  padding: 15rpx 40rpx;
  display: inline-block;
}

.result {
  margin-bottom: 20rpx;
}

.footer {
  display: flex;
  gap: 20rpx;
  margin-top: 40rpx;
}

.footer-btn {
  flex: 1;
  border-radius: 8rpx;
  font-size: 28rpx;
  padding: 20rpx;
}

.back-btn {
  background: #f5f5f5;
  color: #333;
}

.home-btn {
  background: #667eea;
  color: white;
}
