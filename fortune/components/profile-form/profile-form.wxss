/* fortune/components/profile-form/profile-form.wxss */
/* 弹窗遮罩层 - 深色半透明背景 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

/* 表单卡片 - 深色背景 + 圆角 + 白色文字 */
.modal-content {
  width: 80%;
  max-width: 600rpx;
  background: #292524;
  border: 1px solid rgba(255, 255, 255, 0.15);
  border-radius: 32rpx;
  padding: 40rpx;
  color: #fff;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
}

.modal-close {
  font-size: 48rpx;
  color: rgba(255, 255, 255, 0.6);
  line-height: 1;
}

.form {
  width: 100%;
}

.form-item {
  margin-bottom: 24rpx;
}

/* 标签 - 半透明白色 */
.label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-bottom: 8rpx;
  display: block;
}

/* 输入框 - 半透明白色背景 */
.input {
  background: rgba(255, 255, 255, 0.1);
  border: 1px solid rgba(255, 255, 255, 0.15);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  color: #fff;
  font-size: 26rpx;
  width: 100%;
  box-sizing: border-box;
}

/* picker 选择器 - 半透明白色背景 */
.picker {
  background: rgba(255, 255, 255, 0.1);
  border: 1px solid rgba(255, 255, 255, 0.15);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
}

.picker-text {
  font-size: 26rpx;
  color: #fff;
}

.error {
  font-size: 22rpx;
  color: #ef4444;
  margin-top: 8rpx;
  display: block;
}

.hint {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.4);
  margin-top: 8rpx;
  display: block;
}

/* 保存按钮 - 赭橙渐变 */
.save-btn {
  background: linear-gradient(135deg, #d97757, #92400e);
  color: #fff;
  border: none;
  border-radius: 24rpx;
  font-size: 28rpx;
  font-weight: 600;
  padding: 20rpx;
  margin-top: 16rpx;
  width: 100%;
  text-align: center;
  line-height: 1.5;
}

.save-btn::after {
  border: none;
}
