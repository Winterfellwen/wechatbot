.fortune-card {
  background: white;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  position: relative;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
  background: linear-gradient(135deg, #faf5ff, #fdf2f8);
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1E293B;
}

.status-badge {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.status-pending {
  background: #f1f5f9;
  color: #64748b;
}

.status-loading {
  background: #dbeafe;
  color: #2563eb;
}

.status-streaming {
  background: #fef3c7;
  color: #d97706;
}

.status-completed {
  background: #d1fae5;
  color: #059669;
}

.status-error {
  background: #fee2e2;
  color: #dc2626;
}

.card-body {
  padding: 30rpx;
  min-height: 120rpx;
}

/* 思考动画覆盖层 */
.thinking-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

/* 中式风格 */
.chinese-style {
  background: linear-gradient(135deg, rgba(139, 92, 246, 0.12), rgba(217, 70, 239, 0.12));
}

.chinese-style .thinking-symbol {
  animation: float 3s ease-in-out infinite, spinY 8s linear infinite;
}

.chinese-style .thinking-line {
  color: #7c3aed;
  text-shadow: 0 0 20px rgba(124, 58, 237, 0.3);
}

.chinese-style .status-label {
  color: #6d28d9;
}

/* 西式风格 */
.western-style {
  background: linear-gradient(135deg, rgba(59, 130, 246, 0.12), rgba(147, 51, 234, 0.12));
}

.western-style .thinking-symbol {
  animation: float 3s ease-in-out infinite, pulse 2s ease-in-out infinite;
}

.western-style .thinking-line {
  color: #3b82f6;
  text-shadow: 0 0 20px rgba(59, 130, 246, 0.3);
  font-style: italic;
}

.western-style .status-label {
  color: #2563eb;
}

/* 思考动画内容 */
.thinking-animation {
  display: flex;
  flex-direction: column;
  align-items: center;
  border-radius: 16rpx;
  padding: 40rpx;
  width: 100%;
}

.thinking-symbol {
  width: 100rpx;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 30rpx;
}

.symbol-text {
  font-size: 80rpx;
}

.thinking-lines {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 30rpx;
}

.thinking-line {
  font-size: 26rpx;
  margin-bottom: 12rpx;
  opacity: 0;
  animation: fadeSlideIn 1.5s ease-in-out infinite;
}

.line1 {
  animation-delay: 0s;
}

.line2 {
  animation-delay: 0.5s;
}

.line3 {
  animation-delay: 1s;
}

.thinking-status {
  margin-top: 10rpx;
}

.status-label {
  font-size: 24rpx;
  font-weight: 500;
  animation: pulse 1.5s ease-in-out infinite;
}

/* 加载状态 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #e5e7eb;
  border-top-color: #8b5cf6;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

.loading-text {
  font-size: 26rpx;
  color: #64748b;
  margin-top: 20rpx;
}

/* 内容显示 */
.content-state {
  line-height: 1.8;
}

.section {
  margin-bottom: 24rpx;
}

.section-header {
  margin-bottom: 12rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #7c3aed;
  display: block;
  padding-bottom: 8rpx;
  border-bottom: 2rpx solid #ede9fe;
}

.section-body {
  padding-left: 8rpx;
}

.section-text {
  font-size: 28rpx;
  color: #333;
  white-space: pre-wrap;
  line-height: 1.8;
}

.content-text {
  font-size: 28rpx;
  color: #333;
  white-space: pre-wrap;
  line-height: 1.8;
}

.cursor {
  color: #8b5cf6;
  animation: blink 1s infinite;
}

/* 错误状态 */
.error-state {
  text-align: center;
  padding: 20rpx 0;
}

.error-text {
  font-size: 26rpx;
  color: #dc2626;
  display: block;
  margin-bottom: 20rpx;
}

.retry-btn {
  background: #8b5cf6;
  color: white;
  font-size: 26rpx;
  padding: 12rpx 40rpx;
  border-radius: 8rpx;
  display: inline-block;
}

/* 动画关键帧 */
@keyframes spin {
  to { transform: rotate(360deg); }
}

@keyframes blink {
  0%, 50% { opacity: 1; }
  51%, 100% { opacity: 0; }
}

@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10rpx); }
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

@keyframes spinY {
  from { transform: rotateY(0deg); }
  to { transform: rotateY(360deg); }
}

@keyframes fadeSlideIn {
  0% { opacity: 0; transform: translateY(10rpx); }
  50% { opacity: 1; transform: translateY(0); }
  100% { opacity: 0; transform: translateY(-10rpx); }
}
