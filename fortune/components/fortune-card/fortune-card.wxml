<view class="fortune-card">
  <view class="card-header">
    <text class="card-title">{{typeName}}</text>
    <view class="status-badge status-{{status}}">
      <text wx:if="{{status === 'pending'}}">排队中</text>
      <text wx:elif="{{status === 'loading'}}">推演中...</text>
      <text wx:elif="{{status === 'streaming'}}">解读中</text>
      <text wx:elif="{{status === 'completed'}}">已完成</text>
      <text wx:elif="{{status === 'error'}}">失败</text>
    </view>
  </view>
  
  <!-- 全屏思考动画 -->
  <view class="thinking-overlay" wx:if="{{showThinkingAnimation}}">
    <view class="thinking-animation {{category === 'chinese' ? 'chinese-style' : 'western-style'}}">
      <view class="thinking-symbol">
        <text class="symbol-text" wx:if="{{category === 'chinese'}}">☯</text>
        <text class="symbol-text" wx:else>⭐</text>
      </view>
      <view class="thinking-lines">
        <text class="thinking-line line1">{{thinkingTexts[0]}}</text>
        <text class="thinking-line line2">{{thinkingTexts[1]}}</text>
        <text class="thinking-line line3">{{thinkingTexts[2]}}</text>
      </view>
      <view class="thinking-status">
        <text class="status-label">{{category === 'chinese' ? '天机推演中...' : 'Star Reading...'}}</text>
      </view>
    </view>
  </view>
  
  <view class="card-body">
    <view class="loading-state" wx:if="{{status === 'loading'}}">
      <view class="loading-spinner"></view>
      <text class="loading-text">正在分析{{typeName}}...</text>
    </view>
    
    <view class="content-state" wx:elif="{{status === 'streaming' || status === 'completed'}}">
      <view class="section" wx:for="{{sections}}" wx:key="index">
        <view class="section-header" wx:if="{{item.header}}">
          <text class="section-title">{{item.header}}</text>
        </view>
        <view class="section-body" wx:if="{{item.body}}">
          <text class="section-text">{{item.body}}</text>
        </view>
      </view>
      <view wx:if="{{sections.length === 0 && displayContent}}">
        <text class="content-text">{{displayContent}}</text>
      </view>
      <text class="cursor" wx:if="{{showCursor}}">|</text>
    </view>
    
    <view class="error-state" wx:elif="{{status === 'error'}}">
      <text class="error-text">分析失败，请重试</text>
      <button class="retry-btn" bindtap="handleRetry">重试</button>
    </view>
  </view>
</view>
