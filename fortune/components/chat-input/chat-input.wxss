/* fortune/components/chat-input/chat-input.wxss — Celestial Oracle 风格 */
.input-wrap {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.input {
  flex: 1;
  min-width: 0;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 44rpx;
  padding: 18rpx 28rpx;
  font-size: 28rpx;
  color: #fff;
  caret-color: #c4b5fd;
}

.input::placeholder {
  color: rgba(255, 255, 255, 0.25);
}
